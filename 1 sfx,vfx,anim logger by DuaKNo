	"SoundId", "Volume", "PlaybackSpeed", "Looped", "TimePosition",
	"RollOffMode", "RollOffMinDistance", "RollOffMaxDistance",
}

function K.readProps(inst, list)
	local props = {}
	for _, name in ipairs(list) do
		local ok, v = pcall(function() return inst[name] end)
		if ok then
			local l = K.lit(v)
			if l then props[#props + 1] = { name, l } end
		end
	end
	return props
end

function K.attachMount(att, model)
	if not att then return nil end
	local part = att.Parent
	if part and part:IsA("BasePart") then
		if model and part:IsDescendantOf(model) then return { part = part.Name, cf = att.CFrame } end
		local root = model and model:FindFirstChild("HumanoidRootPart")
		local world = part.CFrame * att.CFrame
		return { part = nil, cf = root and root.CFrame:ToObjectSpace(world) or world }
	end
	return nil
end

function K.mountInfo(inst, model)
	local parent = inst.Parent
	if parent and parent:IsA("Attachment") then
		return K.attachMount(parent, model) or { cf = CFrame.new() }
	end
	if parent and parent:IsA("BasePart") then
		if model and parent:IsDescendantOf(model) then return { part = parent.Name, cf = CFrame.new() } end
		local root = model and model:FindFirstChild("HumanoidRootPart")
		return { part = nil, cf = root and root.CFrame:ToObjectSpace(parent.CFrame) or parent.CFrame }
	end
	return { part = nil, cf = CFrame.new() }
end

function K.buildVFXEvent(inst, model, t)
	local class = inst.ClassName
	local list = VFX_PROPS[class]
	if not list then return nil end
	local ev = {
		kind = "vfx", class = class, name = inst.Name, t = math.max(t or 0, 0),
		mount = K.mountInfo(inst, model), props = K.readProps(inst, list), enabled = false,
	}
	local okE, en = pcall(function() return inst.Enabled end)
	if okE then ev.enabled = en end
	if class == "ParticleEmitter" then
		ev.emit = tonumber(inst:GetAttribute("EmitCount")) or 15
		if not ev.enabled then ev.dur = inst.Lifetime.Max + 0.5 end
	elseif class == "Beam" or class == "Trail" then
		ev.att0 = K.attachMount(inst.Attachment0, model)
		ev.att1 = K.attachMount(inst.Attachment1, model)
	end
	return ev
end

function K.buildSFXEvent(s, _model, t)
	local ev = {
		kind = "sfx", name = s.Name, t = math.max(t or 0, 0), props = K.readProps(s, SFX_PROPS),
		pos = s.Parent ~= nil and (s.Parent:IsA("BasePart") or s.Parent:IsA("Attachment")),
	}
	local len, speed = s.TimeLength, math.max(s.PlaybackSpeed, 0.1)
	if len > 0 and not s.Looped then ev.dur = len / speed end
	return ev
end


--// Spawned objects (swords, dummies, parts...) and cutscene cameras ----------------------------------
K.OBJ_PROPS = { "Size", "Color", "Material", "Transparency", "Reflectance" }
K.OBJ_EXTRA = { Part = { "Shape" }, MeshPart = { "MeshId", "TextureID" } }
K.OBJ_KIDS = {
	SpecialMesh = { "MeshId", "TextureId", "Scale", "Offset", "MeshType", "VertexColor" },
	Decal = { "Texture", "Face", "Transparency", "Color3" },
	Texture = { "Texture", "Face", "Transparency", "Color3", "StudsPerTileU", "StudsPerTileV" },
	SurfaceAppearance = { "ColorMap", "NormalMap", "MetalnessMap", "RoughnessMap", "AlphaMode" },
	PointLight = { "Brightness", "Range", "Color", "Enabled" },
	SpotLight = { "Brightness", "Range", "Color", "Angle", "Enabled" },
}
K.OBJ_CLASS = { Part = true, WedgePart = true, CornerWedgePart = true, TrussPart = true, MeshPart = true }

function K.objPivot(inst)
	if inst:IsA("BasePart") then return inst.CFrame end
	local h = inst:FindFirstChild("Handle")
	if h and h:IsA("BasePart") then return h.CFrame end
	local ok, cf = pcall(inst.GetPivot, inst)
	if ok and cf then return cf end
	local p = inst:FindFirstChildWhichIsA("BasePart", true)
	return p and p.CFrame
end

-- a tool / accessory held or worn by the character: which body part is it attached to?
function K.objMount(inst, model, pivot)
	if not (model and inst:IsDescendantOf(model)) then return nil end
	local handle = inst:IsA("BasePart") and inst or inst:FindFirstChild("Handle") or inst:FindFirstChildWhichIsA("BasePart", true)
	if not handle then return nil end
	local ok, joints = pcall(handle.GetJoints, handle)
	if not ok then return nil end
	for _, j in ipairs(joints) do
		local okJ, other = pcall(function() return j.Part0 == handle and j.Part1 or j.Part0 end)
		if okJ and other and other ~= handle and other:IsA("BasePart") and other:IsDescendantOf(model) and not other:IsDescendantOf(inst) then
			return { part = other.Name, cf = other.CFrame:ToObjectSpace(pivot) }
		end
	end
	return nil
end

function K.buildObjEvent(inst, model, t)
	local root = (model and model:FindFirstChild("HumanoidRootPart")) or K.getRoot()
	if not root then return nil end
	local pivot = K.objPivot(inst)
	if not pivot then return nil end
	local list = {}
	if inst:IsA("BasePart") then
		list[1] = inst
	else
		for _, d in ipairs(inst:GetDescendants()) do
			if d:IsA("BasePart") and #list < 120 then list[#list + 1] = d end
		end
	end
	if #list == 0 then return nil end
	local parts = {}
	for _, d in ipairs(list) do
		local cls = K.OBJ_CLASS[d.ClassName] and d.ClassName or "Part"
		local names = table.clone(K.OBJ_PROPS)
		for _, n in ipairs(K.OBJ_EXTRA[cls] or {}) do names[#names + 1] = n end
		local kids = {}
		for _, k in ipairs(d:GetChildren()) do
			local kp = K.OBJ_KIDS[k.ClassName]
			if kp and #kids < 6 then kids[#kids + 1] = { cls = k.ClassName, props = K.readProps(k, kp) } end
		end
		parts[#parts + 1] = { cls = cls, name = d.Name, rel = pivot:ToObjectSpace(d.CFrame), props = K.readProps(d, names), kids = kids }
	end
	return {
		kind = "obj", class = inst.ClassName, name = inst.Name, t = math.max(t or 0, 0), props = {},
		spec = { parts = parts }, rel = root.CFrame:ToObjectSpace(pivot), _root0 = root.CFrame,
		dummy = inst:IsA("Model") and inst:FindFirstChildWhichIsA("Humanoid", true) ~= nil,
		mount = K.objMount(inst, model, pivot),
	}
end

--// 2D (GUI) recording: a ScreenGui / full-screen image that shows up is saved as a tree of elements + every change it goes through
X.guiCache = setmetatable({}, { __mode = "k" })
X.guiActive = 0
X.GUI_COMMON = { "AnchorPoint", "Position", "Size", "Rotation", "BackgroundColor3", "BackgroundTransparency", "BorderSizePixel", "Visible", "ZIndex", "ClipsDescendants", "LayoutOrder" }
X.GUI_IMG = { "Image", "ImageColor3", "ImageTransparency", "ScaleType", "SliceCenter", "ImageRectOffset", "ImageRectSize", "TileSize" }
X.GUI_TXT = { "Text", "TextColor3", "TextSize", "Font", "TextTransparency", "TextStrokeColor3", "TextStrokeTransparency", "TextScaled", "TextXAlignment", "TextYAlignment", "RichText", "TextWrapped" }
X.GUI_OBJ = {
	Frame = {}, ScrollingFrame = {}, CanvasGroup = { "GroupTransparency", "GroupColor3" },
	ImageLabel = X.GUI_IMG, ImageButton = X.GUI_IMG, TextLabel = X.GUI_TXT, TextButton = X.GUI_TXT,
	ViewportFrame = { "Ambient", "LightColor", "ImageColor3", "ImageTransparency" },
}
X.GUI_MOD = {
	UICorner = { "CornerRadius" }, UIStroke = { "Color", "Thickness", "Transparency", "ApplyStrokeMode", "LineJoinMode" },
	UIGradient = { "Color", "Transparency", "Rotation", "Offset" }, UIScale = { "Scale" },
	UIAspectRatioConstraint = { "AspectRatio", "AspectType", "DominantAxis" },
	UIListLayout = { "FillDirection", "HorizontalAlignment", "VerticalAlignment", "Padding", "SortOrder" },
	UIPadding = { "PaddingBottom", "PaddingLeft", "PaddingRight", "PaddingTop" },
	UISizeConstraint = { "MaxSize", "MinSize" }, UITextSizeConstraint = { "MaxTextSize", "MinTextSize" },
}
do -- what is watched for changes (kept short: it is read 20 times a second)
	local base = { "Position", "Size", "Rotation", "AnchorPoint", "BackgroundTransparency", "BackgroundColor3", "Visible" }
	local function join(extra)
		local t = table.clone(base)
		for _, n in ipairs(extra) do t[#t + 1] = n end
		return t
	end
	local img = join({ "ImageTransparency", "ImageColor3", "Image", "ImageRectOffset", "ImageRectSize" })
	local txt = join({ "Text", "TextTransparency", "TextColor3", "TextStrokeTransparency" })
	X.GUI_TRACK = {
		Frame = base, ScrollingFrame = base, CanvasGroup = join({ "GroupTransparency" }), ViewportFrame = img,
		ImageLabel = img, ImageButton = img, TextLabel = txt, TextButton = txt,
		UIStroke = { "Transparency", "Thickness", "Color" }, UIGradient = { "Offset", "Rotation", "Transparency", "Color" },
		UIScale = { "Scale" }, UICorner = { "CornerRadius" },
	}
end

function X.guiTrack(ev, insts, target, flat)
	if X.guiActive >= 4 then return end
	X.guiActive += 1
	task.spawn(function()
		local g = ev.gui
		local tracked, last = {}, {}
		for i = 1, 160 do
			local inst = insts[i]
			local plist = inst and X.GUI_TRACK[inst.ClassName]
			if plist and #tracked < 80 then
				tracked[#tracked + 1] = { i, inst, plist }
				local l = {}
				for _, pn in ipairs(plist) do
					local ok, v = pcall(function() return inst[pn] end)
					l[pn] = ok and K.lit(v) or nil
				end
				last[i] = l
			end
		end
		local t0 = os.clock()
		while Run.alive and os.clock() - t0 < 25 do
			task.wait(0.05)
			local dt = os.clock() - t0
			for _, tr in ipairs(tracked) do
				local i, inst, plist = tr[1], tr[2], tr[3]
				if inst.Parent then
					local cur = last[i]
					pcall(function()
						for _, pn in ipairs(plist) do
							if not (flat and i == 2 and (pn == "Position" or pn == "Size" or pn == "AnchorPoint")) then
								local l = K.lit(inst[pn])
								if l and l ~= cur[pn] then
									cur[pn] = l
									if #g.keys < 4000 then g.keys[#g.keys + 1] = { math.floor(dt * 100 + 0.5) / 100, i, pn, l } end
								end
							end
						end
					end)
				end
			end
			g.dur = dt
			local gone = not target.Parent
			if not gone then
				if target:IsA("ScreenGui") then gone = not target.Enabled else gone = not target.Visible end
			end
			if gone then break end
		end
		g.dur = math.max(g.dur or 0, 0.3)
		X.guiActive -= 1
	end)
end

-- static = true: just copy it (used by "Find related": things that are not on screen right now)
function X.snapshotGui(target, static)
	if target:GetAttribute("_Replay") then return nil end
	local isSg = target:IsA("ScreenGui")
	if not isSg and not target:IsA("GuiObject") then return nil end
	if not static then
		if isSg and not target.Enabled then return nil end
		if not isSg and not target.Visible then return nil end
		-- only what covers a good part of the screen (images, flashes, bars, titles) - unless a cutscene is running
		local cam = workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
		local best = 0
		for _, o in ipairs(isSg and target:GetChildren() or { target }) do
			if o:IsA("GuiObject") and o.Visible then
				local a = (o.AbsoluteSize.X * o.AbsoluteSize.Y) / math.max(vp.X * vp.Y, 1)
				if a > best then best = a end
			end
		end
		if best < 0.18 and not X.inCutscene() then return nil end
	end
	local owner = isSg and target or target:FindFirstAncestorOfClass("ScreenGui")
	local ign = owner and owner.IgnoreGuiInset
	if ign == nil then ign = true end
	local nodes, insts = {}, {}
	nodes[1] = { c = "ScreenGui", n = "Replay2D", p = 0, pr = {
		{ "DisplayOrder", K.g(owner and owner.DisplayOrder or 998) }, { "IgnoreGuiInset", tostring(ign) }, { "ResetOnSpawn", "false" },
	} }
	insts[1] = isSg and target or nil
	local queue, head = {}, 1
	if isSg then
		for _, ch in ipairs(target:GetChildren()) do queue[#queue + 1] = { ch, 1 } end
	else
		queue[1] = { target, 1 }
	end
	while queue[head] and #nodes < 150 do
		local item = queue[head]
		head += 1
		local inst, parentIdx = item[1], item[2]
		local cls = inst.ClassName
		local plist, mod = X.GUI_OBJ[cls], X.GUI_MOD[cls]
		if plist or mod then
			local names = {}
			local pr = {}
			if plist then
				for _, n in ipairs(X.GUI_COMMON) do names[#names + 1] = n end
				for _, n in ipairs(plist) do names[#names + 1] = n end
				pr[1] = { "Active", "false" } -- a replayed button must not eat your clicks
			else
				names = mod
			end
			for _, pn in ipairs(names) do
				local ok, v = pcall(function() return inst[pn] end)
				if ok then
					local l = K.lit(v)
					if l then pr[#pr + 1] = { pn, l } end
				end
			end
			nodes[#nodes + 1] = { c = cls, n = inst.Name, p = parentIdx, pr = pr }
			insts[#nodes] = inst
			local idx = #nodes
			for _, ch in ipairs(inst:GetChildren()) do queue[#queue + 1] = { ch, idx } end
		end
	end
	if #nodes < 2 then return nil end
	local flat = false
	if not isSg and nodes[2] and target.Parent ~= owner then -- nested somewhere: place it by its real position on screen
		flat = true
		for _, kv in ipairs(nodes[2].pr) do
			if kv[1] == "Position" then
				kv[2] = string.format("UDim2.fromOffset(%s,%s)", K.g(target.AbsolutePosition.X), K.g(target.AbsolutePosition.Y))
			elseif kv[1] == "Size" then
				kv[2] = string.format("UDim2.fromOffset(%s,%s)", K.g(target.AbsoluteSize.X), K.g(target.AbsoluteSize.Y))
			elseif kv[1] == "AnchorPoint" then
				kv[2] = "Vector2.new(0,0)"
			end
		end
	end
	local ev = {
		kind = "gui", class = target.ClassName, name = "2D: " .. target.Name, t = 0, props = {}, dur = 3,
		gui = { nodes = nodes, keys = {}, dur = static and 3 or 0.3 },
	}
	if not static then X.guiTrack(ev, insts, target, flat) end
	return ev
end

function K.buildGuiEvent(inst, model, t)
	local ev = X.guiCache[inst]
	if ev == nil then
		ev = X.snapshotGui(inst, false) or false
		X.guiCache[inst] = ev
	end
	if not ev then return nil end
	local c = table.clone(ev)
	c.t = math.max(t or 0, 0)
	return c
end

function K.specStr(sp)
	local L = { "{ parts = {" }
	for _, d in ipairs(sp.parts) do
		local ps, ks = {}, {}
		for _, kv in ipairs(d.props) do ps[#ps + 1] = string.format("{%q, %s}", kv[1], kv[2]) end
		for _, k in ipairs(d.kids) do
			local kp = {}
			for _, kv in ipairs(k.props) do kp[#kp + 1] = string.format("{%q, %s}", kv[1], kv[2]) end
			ks[#ks + 1] = string.format("{ cls = %q, props = { %s } }", k.cls, table.concat(kp, ", "))
		end
		L[#L + 1] = string.format("{ cls = %q, name = %q, rel = %s, props = { %s }, kids = { %s } },", d.cls, d.name, K.cfStr(d.rel), table.concat(ps, ", "), table.concat(ks, ", "))
	end
	L[#L + 1] = "} }"
	return table.concat(L, "\n")
end

-- a cutscene camera is only worth keeping when it really moves / is far away (not a normal follow camera)
function K.camKeep(e)
	local sm = e.cam
	if not sm or #sm < 2 then return false end
	if e.forced and sm[#sm][1] >= 0.5 then return true end -- recorded for a cutscene animation: always keep
	local p0, fov0 = sm[1][2].Position, sm[1][3]
	local mv, df, far = 0, 0, 0
	for _, f in ipairs(sm) do
		mv = math.max(mv, (f[2].Position - p0).Magnitude)
		df = math.max(df, math.abs(f[3] - fov0))
		far = math.max(far, f[2].Position.Magnitude)
	end
	return mv > 1.5 or df > 3 or far > 20
end

--// GET tool: the animation as a Tool you can click ---------------------------------------------------
function K.findAnimContext(id) -- the modules / models that live next to this animation in the game
	local nid = tostring(id):match("%d+")
	local res = { modules = {}, models = {}, scripts = {} }
	if not nid then return res end
	local roots = { game:GetService("ReplicatedStorage"), game:GetService("StarterPack"), game:GetService("StarterPlayer"), game:GetService("Lighting"), workspace }
	local bp = lp:FindFirstChildOfClass("Backpack")
	if bp then table.insert(roots, 1, bp) end
	if lp.Character then table.insert(roots, 1, lp.Character) end
	local anim, n = nil, 0
	for _, root in ipairs(roots) do
		for _, d in ipairs(root:GetDescendants()) do
			n += 1
			if n % 3000 == 0 then task.wait() end
			if d:IsA("Animation") and tostring(d.AnimationId):find(nid, 1, true) then
				anim = d
				break
			end
		end
		if anim then break end
	end
	if not anim then return res end
	local top = anim:FindFirstAncestorOfClass("Tool")
	if not top then
		top = anim.Parent
		for _ = 1, 2 do
			local p = top and top.Parent
			if p and p ~= game and p.Parent ~= game then top = p else break end
		end
	end
	res.anim, res.top = anim, top
	if not top then return res end
	local list = top:GetDescendants()
	table.insert(list, 1, top)
	for i, d in ipairs(list) do
		if i % 2000 == 0 then task.wait() end
		if d:IsA("ModuleScript") then
			if #res.modules < 12 then
				local src
				if decompile then
					local ok, text = pcall(decompile, d)
					if ok and type(text) == "string" then src = text:sub(1, 60000) end
				end
				res.modules[#res.modules + 1] = { path = d:GetFullName(), class = d.ClassName, source = src }
			end
		elseif d:IsA("Script") or d:IsA("LocalScript") then
			if #res.scripts < 12 then res.scripts[#res.scripts + 1] = d:GetFullName() end
		elseif (d:IsA("Model") or d:IsA("Tool") or d:IsA("Accoutrement")) and #res.models < 4 then
			local ok, ev = pcall(K.buildObjEvent, d, nil, 0)
			if ok and ev and ev.spec then res.models[#res.models + 1] = { name = d.Name, path = d:GetFullName(), spec = ev.spec } end
		end
	end
	return res
end

function K.longStr(str) -- a Lua long string that cannot be broken by the text inside it
	local n = 0
	while str:find("]" .. string.rep("=", n) .. "]", 1, true) do n += 1 end
	local eq = string.rep("=", n)
	return "[" .. eq .. "[\n" .. str .. "\n]" .. eq .. "]"
end

function K.buildToolCode(id, animCode, ctx, label)
	local name = tostring(label or "Animation"):gsub("[^%w _%-]", ""):sub(1, 28)
	if name == "" then name = "Animation" end
	local L = {}
	local function add(t) L[#L + 1] = t end
	add("-- TOOL generated by the FX / Animation Logger")
	add("-- Equip / hold the tool and click (or tap) to play: " .. name)
	add("-- Models and modules found next to the animation are listed in MODELS and MODULES below.")
	if ctx and ctx.top then add("-- Found in: " .. ctx.top:GetFullName()) end
	for _, sp in ipairs(ctx and ctx.scripts or {}) do add("-- script: " .. sp) end
	add("")
	add("local NAME = " .. string.format("%q", name))
	add("local ANIM = " .. K.longStr(animCode))
	add("")
	add("local MODELS = {")
	for _, m in ipairs(ctx and ctx.models or {}) do
		add(string.format("\t{ name = %q, path = %q, spec = %s },", m.name, m.path, (K.specStr(m.spec):gsub("\n", "\n\t"))))
	end
	add("}")
	add("local MODULES = {")
	for _, m in ipairs(ctx and ctx.modules or {}) do
		add(string.format("\t{ path = %q, class = %q, source = %s },", m.path, m.class, m.source and K.longStr(m.source) or "nil"))
	end
	add("}")
	add("local GENV = getgenv and getgenv() or _G")
	add("GENV.AVL_ToolModules = MODULES")
	add([==[

local Players = game:GetService("Players")
local lp = Players.LocalPlayer

local function mkPart(d)
	local ok, o = pcall(Instance.new, d.cls)
	local p = (ok and o and o:IsA("BasePart")) and o or Instance.new("Part")
	for _, kv in ipairs(d.props) do pcall(function() p[kv[1]] = kv[2] end) end
	p.Name = d.name
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	for _, k in ipairs(d.kids or {}) do
		local okK, o2 = pcall(Instance.new, k.cls)
		if okK and o2 then
			for _, kv in ipairs(k.props) do pcall(function() o2[kv[1]] = kv[2] end) end
			o2.Parent = p
		end
	end
	return p
end

-- the first model found next to the animation becomes what you hold
local function buildHandle(tool)
	local m = MODELS[1]
	if not (m and m.spec and m.spec.parts[1]) then return false end
	local made, first = {}, nil
	for i, d in ipairs(m.spec.parts) do
		local ok, p = pcall(mkPart, d)
		if ok and p then
			made[i] = p
			first = first or i
		end
	end
	if not first then return false end
	local h = made[first]
	h.Name = "Handle"
	h.Parent = tool
	local base = m.spec.parts[first].rel
	for i, p in pairs(made) do
		if p ~= h then
			p.CFrame = h.CFrame * (base:Inverse() * m.spec.parts[i].rel)
			local w = Instance.new("WeldConstraint")
			w.Part0 = h
			w.Part1 = p
			w.Parent = p
			p.Parent = tool
		end
	end
	return true
end

local last = 0
local function onActivated()
	if os.clock() - last < 0.25 then return end
	last = os.clock()
	local loader = loadstring or load
	local fn, err = loader(ANIM)
	if not fn then return warn("[tool] " .. tostring(err)) end
	task.spawn(function()
		local ok, e = pcall(fn)
		if not ok then warn("[tool] " .. tostring(e)) end
	end)
end

local function giveTool()
	local backpack = lp:FindFirstChildOfClass("Backpack") or lp:WaitForChild("Backpack", 5)
	if not backpack then return end
	local function clean(c)
		for _, t in ipairs(c:GetChildren()) do
			if t:IsA("Tool") and t:GetAttribute("_AVLTool") == NAME then t:Destroy() end
		end
	end
	clean(backpack)
	if lp.Character then clean(lp.Character) end
	local tool = Instance.new("Tool")
	tool.Name = NAME
	tool.CanBeDropped = false
	tool.ToolTip = "Plays: " .. NAME
	tool:SetAttribute("_AVLTool", NAME)
	tool.RequiresHandle = false
	if buildHandle(tool) then tool.RequiresHandle = true end
	tool.Activated:Connect(onActivated)
	tool.Parent = backpack
end

local G = getgenv and getgenv() or _G
if G.__AVLToolConn then pcall(function() G.__AVLToolConn:Disconnect() end) end
giveTool()
G.__AVLToolConn = lp.CharacterAdded:Connect(function()
	task.wait(1)
	giveTool()
end)
]==])
	return table.concat(L, "\n")
end

-- search categories: movesets, attacks, hits, block, movement, emotes
function K.animCat(e)
	local nm = tostring(e.name or ""):lower()
	local hp = nm .. " " .. tostring(e.path or ""):lower()
	local function has(h, list)
		for _, w in ipairs(list) do
			if h:find(w, 1, true) then return true end
		end
		return false
	end
	if X.cutIds[e.id] or (X.isCutText and X.isCutText(hp)) then return "Cutscenes" end
	if has(nm, { "hit", "hurt", "damage", "stun", "knock", "ragdoll", "flinch", "getup", "recoil", "impact", "pain", "stagger" }) then return "Hits" end
	if has(nm, { "block", "parry", "guard", "deflect", "defend" }) then return "Block" end
	if has(nm, { "emote", "dance", "wave", "laugh", "cheer", "point", "salute", "taunt", "bow", "clap" }) then return "Emotes" end
	if has(hp, { "moveset", "skill", "abilit", "special", "ultimate", "spell", "cast", "technique", "finisher", "awaken", "stance", "charge", "beam", "blast", "move1", "move2", "move3", "move4", "move5", "move 1", "move 2", "move 3", "move 4" }) then return "Movesets" end
	if has(nm, { "m1", "m2", "punch", "slash", "swing", "attack", "combo", "kick", "strike", "uppercut", "stab", "shoot", "throw", "light", "heavy" }) then return "Attacks" end
	if has(nm, { "walk", "run", "idle", "jump", "fall", "climb", "swim", "sprint", "dash", "slide", "crouch", "roll", "dodge", "land", "sit", "fly" }) then return "Movement" end
	return "Other"
end

