--// 3D viewer: a window with the dummy playing the animation; drag to spin, wheel / pinch / buttons to zoom -----
function X.v3Close()
	local V = X.v3
	X.v3 = nil
	if not V then return end
	V.alive = false
	for _, c in ipairs(V.conns) do pcall(function() c:Disconnect() end) end
	pcall(X.v3World, V, false)
	pcall(function() V.win.destroy() end)
end

function X.v3World(V, on) -- World view: orbit the real camera around the dummy (particles, beams, trails and lights all draw)
	local cam = workspace.CurrentCamera
	if on and not V.world and cam then
		V.world = true
		V.old = { cam.CameraType, cam.CameraSubject, cam.FieldOfView }
		cam.CameraType = Enum.CameraType.Scriptable
		V.vp.Visible = false
		local ov = Instance.new("TextButton") -- full-screen layer behind the windows that catches the drag / wheel
		ov.AutoButtonColor = false
		ov.Text = ""
		ov.BackgroundTransparency = 1
		ov.BorderSizePixel = 0
		ov.Size = UDim2.new(1, 0, 1, 0)
		ov.ZIndex = 0
		ov.Active = true
		ov.Parent = gui
		V.ov = ov
		V.bindDrag(ov)
	elseif not on and V.world then
		V.world = false
		if cam and V.old then
			cam.CameraType = V.old[1]
			if V.old[2] and V.old[2].Parent then cam.CameraSubject = V.old[2] end
			cam.FieldOfView = V.old[3]
		end
		if V.ov then V.ov:Destroy() end
		V.ov = nil
		if V.vp.Parent then V.vp.Visible = true end
	end
end

function X.v3Open(id)
	local P = X.tpEnsure(id)
	if not P then return end
	X.v3Close()
	local win = createWindow({
		title = "3D Viewer - " .. K.animName(id),
		size = Vector2.new(400, 440),
		pos = UDim2.new(0.5, -200, 0.5, -220),
		minSize = Vector2.new(300, 330),
		miniText = "3D",
		onClose = function() X.v3Close() end,
	})
	local V = { id = id, win = win, conns = {}, alive = true, yaw = math.pi, pitch = 0.2, ui = {}, spin = false }
	X.v3 = V
	local content = win.content

	local vp = Instance.new("ViewportFrame")
	vp.Position = UDim2.new(0, 6, 0, 6)
	vp.Size = UDim2.new(1, -12, 1, -112)
	vp.BackgroundColor3 = Color3.fromRGB(26, 28, 34)
	vp.BorderSizePixel = 0
	vp.Ambient = Color3.fromRGB(150, 150, 160)
	vp.LightColor = Color3.fromRGB(255, 250, 240)
	vp.LightDirection = Vector3.new(-0.5, -1, -0.6)
	vp.Active = true
	vp.Parent = content
	V.vp = vp
	local wm = Instance.new("WorldModel")
	wm.Parent = vp
	local cam = Instance.new("Camera")
	cam.FieldOfView = 45
	cam.Parent = vp
	vp.CurrentCamera = cam

	local src = P.rig
	local was = src.Archivable
	src.Archivable = true
	local model = src:Clone()
	src.Archivable = was
	if not model then
		X.v3Close()
		return out("3D viewer: could not copy the dummy")
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("LuaSourceContainer") or d:IsA("Sound") or d:IsA("Animator") or d:IsA("BillboardGui") or VFX_CLASSES[d.ClassName] then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
		end
	end
	local root = model:FindFirstChild("HumanoidRootPart")
	if not root then
		X.v3Close()
		return out("3D viewer: the dummy has no root part")
	end
	model:PivotTo(CFrame.new(0, 0, 0))
	model.Parent = wm

	-- joints: solved here every frame (a viewport has no animation system of its own)
	local all, offsets, srcMap = {}, {}, {}
	for _, d in ipairs(src:GetDescendants()) do
		if d:IsA("Motor6D") and d.Part1 then srcMap[d.Name .. ">" .. d.Part1.Name] = d end
	end
	for _, d in ipairs(model:GetDescendants()) do
		if (d:IsA("Motor6D") or d:IsA("Weld")) and d.Part0 and d.Part1 then
			all[#all + 1] = d
		elseif d:IsA("WeldConstraint") and d.Part0 and d.Part1 then
			offsets[d] = d.Part0.CFrame:ToObjectSpace(d.Part1.CFrame)
			all[#all + 1] = d
		end
	end
	local done, ordered, pending = { [root] = true }, {}, all
	local progress = true
	while progress and #pending > 0 do
		progress = false
		local rest = {}
		for _, j in ipairs(pending) do
			if done[j.Part0] then
				if not done[j.Part1] then
					ordered[#ordered + 1] = j
					done[j.Part1] = true
				end
				progress = true
			else
				rest[#rest + 1] = j
			end
		end
		pending = rest
	end
	local srcOf = {}
	for _, j in ipairs(ordered) do
		if j:IsA("Motor6D") then srcOf[j] = srcMap[j.Name .. ">" .. j.Part1.Name] end
	end

	local bbCF, bbSize = model:GetBoundingBox()
	V.focus = bbCF.Position
	V.dist = math.max(bbSize.Magnitude * 1.3, 6)
	V.dist0 = V.dist
	local floor = Instance.new("Part")
	floor.Shape = Enum.PartType.Cylinder
	floor.Anchored = true
	floor.CanCollide = false
	floor.Material = Enum.Material.SmoothPlastic
	floor.Color = Color3.fromRGB(52, 56, 68)
	floor.Size = Vector3.new(0.15, bbSize.Magnitude * 1.6, bbSize.Magnitude * 1.6)
	floor.CFrame = CFrame.new(bbCF.Position.X, bbCF.Position.Y - bbSize.Y / 2 - 0.08, bbCF.Position.Z) * CFrame.Angles(0, 0, math.pi / 2)
	floor.Parent = wm

	-- spawned objects (swords, parts...) of the effects are copied in too
	local clones = {}
	local function mirror(base)
		for real, c in pairs(clones) do
			if not real.Parent then
				c.model:Destroy()
				clones[real] = nil
			end
		end
		for _, o in ipairs(workspace:GetChildren()) do
			if o:IsA("Model") and o:GetAttribute("_Replay") and not clones[o] then
				local okC, cl = pcall(function() return o:Clone() end)
				if okC and cl then
					local pairsList, ra, ca = {}, o:GetDescendants(), cl:GetDescendants()
					for i2, d in ipairs(ra) do
						if d:IsA("BasePart") and ca[i2] and ca[i2]:IsA("BasePart") then
							ca[i2].Anchored = true
							pairsList[#pairsList + 1] = { d, ca[i2] }
						end
					end
					cl.Parent = wm
					clones[o] = { model = cl, parts = pairsList }
				end
			end
		end
		for real, c in pairs(clones) do
			for _, pr in ipairs(c.parts) do
				if pr[1].Parent then pr[2].CFrame = base * pr[1].CFrame end
			end
		end
	end

	local function orbit(rootCF, focusOffset)
		return rootCF * CFrame.new(focusOffset) * CFrame.Angles(0, V.yaw, 0) * CFrame.Angles(-V.pitch, 0, 0) * CFrame.new(0, 0, V.dist)
	end
	table.insert(V.conns, RunService.RenderStepped:Connect(function(dt)
		if not V.alive then return end
		local rig = X.pv and X.pv.rig
		if not (rig and rig.Parent) then return X.v3Close() end
		if V.spin and not V.dragging then V.yaw += dt * 0.8 end
		for _, j in ipairs(ordered) do
			local p0, p1 = j.Part0, j.Part1
			if j:IsA("Motor6D") then
				local sm = srcOf[j]
				local tr = (sm and sm.Parent) and sm.Transform or j.Transform
				j.Transform = tr
				p1.CFrame = p0.CFrame * j.C0 * tr * j.C1:Inverse()
			elseif j:IsA("Weld") then
				p1.CFrame = p0.CFrame * j.C0 * j.C1:Inverse()
			else
				p1.CFrame = p0.CFrame * offsets[j]
			end
		end
		local srcRoot = rig:FindFirstChild("HumanoidRootPart")
		if srcRoot then pcall(mirror, root.CFrame * srcRoot.CFrame:Inverse()) end
		cam.CFrame = orbit(CFrame.new(V.focus), Vector3.zero) -- the dummy stands at the origin facing -Z
		if V.world and srcRoot then
			local wc = workspace.CurrentCamera
			if wc then
				wc.CameraType = Enum.CameraType.Scriptable
				wc.FieldOfView = 55
				wc.CFrame = orbit(srcRoot.CFrame, Vector3.new(0, 0.5, 0))
			end
		end
	end))

	function V.bindDrag(obj)
		obj.InputBegan:Connect(function(input)
			if not K.isPress(input) then return end
			V.dragging = true
			local last = input.Position
			local conn
			conn = UserInputService.InputChanged:Connect(function(i2)
				if not isMove(i2) or V.pinching then return end
				local d = i2.Position - last
				last = i2.Position
				V.yaw -= d.X * 0.012
				V.pitch = math.clamp(V.pitch + d.Y * 0.012, -1.45, 1.45)
			end)
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					conn:Disconnect()
					V.dragging = false
				end
			end)
		end)
		obj.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseWheel then
				V.dist = math.clamp(V.dist * (1 - input.Position.Z * 0.1), 1.5, 200)
			end
		end)
	end
	V.bindDrag(vp)
	local lastScale = 1
	table.insert(V.conns, UserInputService.TouchPinch:Connect(function(positions, scale, _, state)
		local c = Vector2.zero
		for _, p in ipairs(positions) do c += p end
		if #positions > 0 then c /= #positions end
		local ap, as = vp.AbsolutePosition, vp.AbsoluteSize
		local inside = V.world or (c.X >= ap.X and c.X <= ap.X + as.X and c.Y >= ap.Y and c.Y <= ap.Y + as.Y)
		if not inside then return end
		if state == Enum.UserInputState.Begin then
			V.pinching, lastScale = true, 1
		elseif state == Enum.UserInputState.Change then
			V.dist = math.clamp(V.dist / math.max(scale / lastScale, 0.2), 1.5, 200)
			lastScale = scale
		else
			V.pinching = false
		end
	end))

	V.scrub = X.mkScrub(content, UDim2.new(0, 6, 1, -102), UDim2.new(1, -12, 0, 24))
	local bar = X.mkBar(content, 0, 34)
	bar.Position = UDim2.new(0, 6, 1, -72)
	V.ui.play = X.mkTool(bar, "Play", 66, C.green, function() X.tpToggle(X.pv) end)
	X.mkTool(bar, "Restart", 66, C.btn, function()
		X.tpPlay(X.pv, 0, false)
	end)
	X.mkTool(bar, "Zoom -", 60, C.btn, function() V.dist = math.clamp(V.dist * 1.25, 1.5, 200) end)
	X.mkTool(bar, "Zoom +", 60, C.btn, function() V.dist = math.clamp(V.dist / 1.25, 1.5, 200) end)
	X.mkTool(bar, "Reset view", 80, C.btn, function()
		V.yaw, V.pitch, V.dist = math.pi, 0.2, V.dist0
	end)
	X.mkTool(bar, "Auto spin: Off", 112, C.btn, function(b)
		V.spin = not V.spin
		b.Text = V.spin and "Auto spin: On" or "Auto spin: Off"
		K.paint(b, V.spin and C.sel or C.btn)
	end)
	X.mkTool(bar, "World view: Off", 118, C.btn, function(b)
		X.v3World(V, not V.world)
		b.Text = V.world and "World view: On" or "World view: Off"
		K.paint(b, V.world and C.sel or C.btn)
		V.note.Text = V.world and "World view: the whole screen is the 3D scene. Drag = spin, wheel / pinch = zoom. Every effect (particles, beams, trails) is visible." or "Drag = spin | wheel / pinch / Zoom = zoom | particles, beams and trails cannot draw inside a window: use World view to see them."
	end)
	X.mkTool(bar, "Save", 54, C.green, function(b) X.edsSave(id, b) end)
	local note = Instance.new("TextLabel")
	note.Position = UDim2.new(0, 8, 1, -34)
	note.Size = UDim2.new(1, -16, 0, 32)
	note.BackgroundTransparency = 1
	note.TextWrapped = true
	note.TextColor3 = C.sub
	note.Font = Th.font
	note.TextSize = 12
	note.TextXAlignment = Enum.TextXAlignment.Left
	note.TextYAlignment = Enum.TextYAlignment.Top
	note.Text = "Drag = spin | wheel / pinch / Zoom = zoom | particles, beams and trails cannot draw inside a window: use World view to see them."
	note.Parent = content
	V.note = note
	P.len = X.tpLen(P)
	X.tpHeads(P)
	X.tpUI(P)
end

