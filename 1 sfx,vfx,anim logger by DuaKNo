local accumulated = 0
local index = 1
local lastFrame
local conns = {}
local stopped = false
local startClock = os.clock()

local function stop()
	if stopped then return end
	stopped = true
	for _, c in ipairs(conns) do c:Disconnect() end
	table.clear(conns)
	for _, m in pairs(motors) do m.Transform = CFrame.new() end

	-- give the character its original Animator(s) back
	if #detached > 0 then
		for _, a in ipairs(hum:GetChildren()) do
			if a:IsA("Animator") then a:Destroy() end -- any replacement made while we played
		end
		for _, a in ipairs(detached) do a.Parent = hum end
	end
	if animate and DISABLE_DEFAULT_ANIMATE then animate.Disabled = animateWasDisabled end
	_G.StopRecreatedAnim = nil
end

table.insert(conns, hum.Died:Connect(stop))

table.insert(conns, RunService.Heartbeat:Connect(function(dt)
	if stopped then return end

	-- you moved / jumped: hand control back so your own animations work
	if CANCEL_ON_MOVE and os.clock() - startClock > 0.25 then
		if hum.MoveDirection.Magnitude > 0.1 or hum.Jump then
			stop()
			return
		end
	end

	accumulated += dt * SPEED
	if DISABLE_DEFAULT_ANIMATE then detachAnimators() end

	-- advance through the captured frames
	while frames[index] and accumulated >= frames[index].dt do
		accumulated -= frames[index].dt
		lastFrame = frames[index]
		index += 1
	end

	local nextFrame = frames[index]
	if not nextFrame then
		-- reached the end
		if lastFrame then apply(lastFrame.j) end
		if LOOP_FOREVER then
			index, accumulated = 1, 0
		else
			stop()
		end
		return
	end

	if lastFrame and SMOOTH then
		-- blend from the last frame toward the next one
		local alpha = math.clamp(accumulated / math.max(nextFrame.dt, 1e-6), 0, 1)
		for name, cf in pairs(nextFrame.j) do
			local m = motors[name]
			local from = lastFrame.j[name]
			if m and from then m.Transform = from:Lerp(cf, alpha) end
		end
	elseif lastFrame then
		apply(lastFrame.j)
	end
end))

