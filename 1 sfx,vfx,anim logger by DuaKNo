--// Saved anims / favorites (tiny file: id + name only, code is rebuilt when you copy it) ---------------
X.SAVED_FILE = "AnimLogger_saved.json"
X.KEY_FILE = "AnimLogger_key.txt"

function X.svLoad()
	if not (isfile and readfile) then return end
	local ok, data = pcall(function()
		if isfile(X.SAVED_FILE) then return HttpService:JSONDecode(readfile(X.SAVED_FILE)) end
	end)
	if not (ok and type(data) == "table") then return end
	for _, e in ipairs(type(data.a) == "table" and data.a or {}) do
		if type(e) == "table" and e.i and #X.sv.list < 500 then
			local id = tostring(e.i)
			if id:match("^%d+$") then id = "rbxassetid://" .. id end
			if not X.sv.map[id] then
				local r = { id = id, name = tostring(e.n or id):sub(1, 60), fav = e.f == 1, t = tonumber(e.t) or 0 }
				table.insert(X.sv.list, r)
				X.sv.map[id] = r
			end
		end
	end
	if type(data.j) == "table" then X.ds.joy = X.joyNew(data.j) end
	if type(data.jp) == "table" then X.ds.jump = X.jumpNew(data.jp) end
	if type(data.d) == "table" then
		for _, b in ipairs(data.d) do
			if type(b) == "table" and #X.ds.buttons < 30 then X.dsNew(b, true) end
		end
	end
end

function X.svWrite()
	if not writefile then return end
	local a = {}
	for i, r in ipairs(X.sv.list) do
		a[i] = { i = r.id:match("^rbxassetid://(%d+)$") or r.id, n = r.name, f = r.fav and 1 or nil, t = r.t }
	end
	local d = {}
	for i, b in ipairs(X.ds.buttons) do d[i] = b end
	local ok, json = pcall(function() return HttpService:JSONEncode({ v = 1, a = a, d = d, j = X.ds.joy, jp = X.ds.jump }) end)
	if ok then pcall(writefile, X.SAVED_FILE, json) end
end

function X.svAfter()
	X.svDirty = true
	if X.svReady then X.svRender() end
end

function X.svToggle(id, name)
	local r = X.sv.map[id]
	if r then
		table.remove(X.sv.list, table.find(X.sv.list, r))
		X.sv.map[id] = nil
		if X.kept[id] then
			X.kept[id] = nil
			X.keptDirty = true
		end
	elseif #X.sv.list < 500 then
		r = { id = id, name = tostring(name or id):sub(1, 60), fav = false, t = os.time() }
		table.insert(X.sv.list, r)
		X.sv.map[id] = r
		if X.keepFrames then X.keepFrames(id) end -- keep its frames so it can be generated in other games too
	end
	X.svAfter()
end

function X.svFav(id, name)
	local r = X.sv.map[id]
	if not r then
		X.svToggle(id, name)
		r = X.sv.map[id]
	end
	if r then r.fav = not r.fav end
	X.svAfter()
end

function X.svRender()
	local sf = lists.Saved
	if not (sf and sf.Parent) then return end
	for _, c in ipairs(sf:GetChildren()) do
		if c:IsA("GuiObject") then c:Destroy() end
	end
	local items, favs = {}, 0
	for _, r in ipairs(X.sv.list) do
		if r.fav then favs += 1 end
		local q = X.svQuery or ""
		if (X.svFilter == "all" or r.fav) and (q == "" or (r.name .. " " .. r.id):lower():find(q, 1, true)) then items[#items + 1] = r end
	end
	table.sort(items, function(a, b)
		if a.fav ~= b.fav then return a.fav end
		return (a.t or 0) > (b.t or 0)
	end)
	X.svInfo.Text = string.format("%d saved, %d favorite%s. Only id + name are stored (tiny file); code is built when you copy it.", #X.sv.list, favs, favs == 1 and "" or "s")
	for k, b in pairs(X.svChips) do K.paint(b, k == X.svFilter and C.sel or C.btn) end
	pcall(X.edsRows, sf)
	if #items == 0 then
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(1, -6, 0, 60)
		l.BackgroundTransparency = 1
		l.TextWrapped = true
		l.Text = "Nothing here yet. Press Save or Fav on any animation (Animations or Search tab)."
		l.TextColor3 = C.sub
		l.Font = Th.font
		l.TextSize = 15
		l.Parent = sf
		return
	end
	for i, r in ipairs(items) do
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, -6, 0, 78)
		row.BackgroundColor3 = i % 2 == 1 and C.row1 or C.row2
		row.BorderSizePixel = 0
		row.LayoutOrder = i
		row.Parent = sf
		local lbl = Instance.new("TextLabel")
		lbl.Position = UDim2.new(0, 8, 0, 2)
		lbl.Size = UDim2.new(1, -16, 0, 36)
		lbl.BackgroundTransparency = 1
		lbl.RichText = true
		lbl.TextXAlignment = Enum.TextXAlignment.Left
		lbl.TextTruncate = Enum.TextTruncate.AtEnd
		lbl.Font = Th.font
		lbl.TextSize = 15
		lbl.TextColor3 = C.text
		lbl.Text = string.format('<b>%s%s</b>\n<font color="%s">%s%s</font>', r.fav and "* " or "", K.esc(r.name), K.hex(C.sub), K.esc(r.id), X.kept[r.id] and "   [frames kept: works in any game]" or "")
		lbl.Parent = row
		local bar = X.mkBar(row, 40, 34)
		X.mkTool(bar, r.fav and "Unfav" or "Fav", 60, C.btn, function() X.svFav(r.id, r.name) end)
		X.mkTool(bar, "Frames", 66, C.sel, function(b) X.copyAnim(X.savedId(r.id), nil, b, "Frames") end)
		X.mkTool(bar, "Full-FX-CUTSCENE", 132, C.sel, function(b) X.copyAnim(X.savedId(r.id), "cut", b, "Full-FX-CUTSCENE") end)
		X.mkTool(bar, "View", 52, C.sel, function() X.openAnimViewer(X.savedId(r.id)) end)
		X.mkTool(bar, "Preview", 66, C.green, function() X.pvOpen(r.id, { id = r.id, name = r.name }) end)
		X.mkTool(bar, X.convLabel(r.id), 66, C.sel, function(b) X.convCopy(X.savedId(r.id), b) end)
		if not X.kept[r.id] then
			X.mkTool(bar, "Keep", 52, C.btn, function(b)
				X.keepFail[r.id] = nil
				X.keepFrames(r.id, b)
			end)
		end
		if not tostring(r.id):find("#s%d+") then X.mkTool(bar, "Run", 46, C.green, function() K.playAnim(r.id) end) end
		X.mkTool(bar, "Stop", 52, C.danger, function(b)
			local n = stopAnimId(r.id)
			local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
			local animator = hum and hum:FindFirstChildOfClass("Animator")
			if animator then
				for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
					if tr.Animation and tr.Animation.AnimationId == r.id then
						tr:Stop(0)
						n += 1
					end
				end
			end
			K.flash(b, n > 0 and "Stopped" or "None")
		end)
		X.mkTool(bar, "Rename", 70, C.btn, function()
			X.prompt("Rename animation", r.name, function(text)
				local nv = tostring(text):gsub("^%s+", ""):gsub("%s+$", "")
				if nv == "" then return end
				r.name = nv:sub(1, 60)
				animLabel[r.id] = r.name
				X.svAfter()
			end)
		end)
		X.mkTool(bar, "To Design", 78, C.btn, function(b)
			X.dsNew({ anim = r.id, animName = r.name, label = tostring(r.name):sub(1, 5) })
			X.svDirty = true
			K.flash(b, "Added")
