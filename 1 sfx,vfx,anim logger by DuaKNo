function X.pvStatus(text)
	local P = X.pv
	if P and P.status and P.status.Parent then P.status.Text = text end
end

function X.pvWatch(on, P)
	P = P or X.pv
	local cam = workspace.CurrentCamera
	if not P or not cam then return end
	if on then
		P.oldSubject = cam.CameraSubject
		cam.CameraSubject = P.hum
		P.watching = true
	else
		local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
		cam.CameraSubject = (P.oldSubject and P.oldSubject.Parent) and P.oldSubject or hum
		P.watching = false
	end
end

function X.pvPlace()
	local P, root = X.pv, getRoot()
	if not P or not root or not P.rig.Parent then return end
	P.rig:PivotTo(root.CFrame * CFrame.new(0, 0, -7) * CFrame.Angles(0, math.pi, 0))
end

function X.pvClose()
	local P = X.pv
	X.pv = nil
	if not P then return end
	P.token += 1
	pcall(function() if P.track then P.track:Stop(0) end end)
	pcall(function() if P.watching then X.pvWatch(false, P) end end)
	pcall(function() P.rig:Destroy() end)
	pcall(function() P.win.destroy() end)
end

-- run FX events on any model (the preview rig) instead of your own character
function X.runOn(events, title, rig)
	if not loadstring then error("loadstring is not available in this executor") end
	local code = genStandaloneFX(events, title)
	code = code:gsub("local lp = Players%.LocalPlayer", "local lp = { Character = (getgenv and getgenv() or _G).__AVL_PreviewRig }", 1)
	local fn, err = loadstring(code)
	if not fn then error(err) end
	local env = (getgenv and getgenv()) or _G
	env.__AVL_PreviewRig = rig
	fn()
end

function X.pvPlay()
	local P = X.pv
	if not P or not P.rig.Parent then return end
	P.token += 1
	local my = P.token
	task.spawn(function()
		pcall(function() if P.track then P.track:Stop(0) end end)
		local anim = Instance.new("Animation")
		anim.AnimationId = P.id
		local ok, track = pcall(function() return P.animator:LoadAnimation(anim) end)
		if not ok or not track then return X.pvStatus("Could not load this animation on the preview rig.") end
		ownTracks[track] = true
		P.track = track
		local waited = 0
		while track.Length == 0 and waited < 4 do waited += RunService.Heartbeat:Wait() end
		if my ~= P.token then return end
		if track.Length == 0 then return X.pvStatus("Animation did not load (not allowed / invalid id).") end
		track.Looped = P.loop
		track:Play(0.1, 1, P.speed)
		local len = track.Length / P.speed
		local list = P.fx and fxWindows.liveFor(P.id) or nil
		X.pvStatus(string.format("%s\n%.2fs at %sx | loop %s | %s", P.id, len, tostring(P.speed), P.loop and "on" or "off",
			P.fx and (list and (#list .. " FX events") or "no FX recorded yet (play it in-game or press Capture)") or "FX off"))
		local function fxOnce()
			if not list or #list == 0 then return end
			local scaled = {}
			for _, e in ipairs(list) do
				local c = table.clone(e)
				c.t = (e.t or 0) / P.speed
				scaled[#scaled + 1] = c
			end
			local okF, errF = pcall(X.runOn, scaled, "Preview", P.rig)
			if not okF then X.pvStatus("FX failed: " .. tostring(errF)) end
		end
		fxOnce()
		while P.loop and my == P.token and P.rig.Parent do
			task.wait(math.max(len, 0.3))
			if my ~= P.token or not P.loop then break end
			fxOnce()
		end
	end)
end

function X.pvOpen(id, e)
	if e and (e.search or X.guess) then X.prepareFX(e) end
	local P = X.pv
	if P and P.rig.Parent then
		P.id = id
		X.pvPlay()
		return
	end
	X.pvClose()
	local char, root = lp.Character, getRoot()
	if not (char and root) then error("no character") end
	local wasArch = char.Archivable
	char.Archivable = true
	local rig = char:Clone()
	char.Archivable = wasArch
	if not rig then error("could not clone your character") end
	for _, d in ipairs(rig:GetDescendants()) do
		if d:IsA("LuaSourceContainer") then
			d:Destroy()
		else
			if d:IsA("BasePart") then
				d.CanCollide = false
				d.CanQuery = false
				d.CanTouch = false
			end
			if d:IsA("Animator") or d:IsA("Sound") or VFX_CLASSES[d.ClassName] then d:SetAttribute("_LoggerClone", true) end
		end
	end
	local hum = rig:FindFirstChildOfClass("Humanoid")
	local rroot = rig:FindFirstChild("HumanoidRootPart")
	if not hum or not rroot then
		rig:Destroy()
		error("clone has no humanoid")
	end
	rroot.Anchored = true -- only the root: the limbs must stay free to animate
	pcall(function() hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end)
	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator:SetAttribute("_LoggerClone", true)
		animator.Parent = hum
	end
	rig:SetAttribute("_LoggerClone", true)
	rig.Name = "AnimPreview"
	rig.Parent = workspace

	local win = createWindow({
		title = "Live Preview",
		size = Vector2.new(380, 230),
		pos = UDim2.new(1, -400, 0, 70),
		minSize = Vector2.new(330, 200),
		miniText = "PV",
		onClose = function() X.pvClose() end,
	})
	P = { id = id, rig = rig, hum = hum, animator = animator, loop = false, speed = 1, fx = true, token = 0, win = win }
	X.pv = P

	local grid = Instance.new("Frame")
	grid.Size = UDim2.new(1, -12, 0, 96)
	grid.Position = UDim2.new(0, 6, 0, 6)
	grid.BackgroundTransparency = 1
	grid.Parent = win.content
	local gl = Instance.new("UIGridLayout")
	gl.CellSize = UDim2.new(1 / 3, -6, 0, 42)
	gl.CellPadding = UDim2.new(0, 6, 0, 8)
	gl.SortOrder = Enum.SortOrder.LayoutOrder
	gl.Parent = grid
	local function mk(text, order, color, fn)
		local b = newButton(grid, text, color or C.btn)
		b.LayoutOrder = order
		b.MouseButton1Click:Connect(function() fn(b) end)
		return b
	end
	mk("Replay", 1, C.sel, function() X.pvPlay() end)
	mk("Loop: Off", 2, C.btn, function(b)
		P.loop = not P.loop
		b.Text = P.loop and "Loop: On" or "Loop: Off"
		paint(b, P.loop and C.sel or C.btn)
		X.pvPlay()
	end)
	mk("Speed: 1x", 3, C.btn, function(b)
		local i = table.find(X.speeds, P.speed) or 3
		P.speed = X.speeds[i % #X.speeds + 1]
		b.Text = "Speed: " .. tostring(P.speed) .. "x"
		X.pvPlay()
	end)
	mk("FX: On", 4, C.sel, function(b)
		P.fx = not P.fx
		b.Text = P.fx and "FX: On" or "FX: Off"
		paint(b, P.fx and C.sel or C.btn)
		X.pvPlay()
	end)
	mk("Move to me", 5, C.btn, function() X.pvPlace() end)
	mk("Watch: Off", 6, C.btn, function(b)
		X.pvWatch(not P.watching, P)
		b.Text = P.watching and "Watch: On" or "Watch: Off"
		paint(b, P.watching and C.sel or C.btn)
	end)

	local status = Instance.new("TextLabel")
	status.Position = UDim2.new(0, 8, 0, 108)
	status.Size = UDim2.new(1, -16, 1, -114)
	status.BackgroundTransparency = 1
	status.TextColor3 = C.sub
	status.Font = Th.font
	status.TextSize = 14
	status.TextWrapped = true
	status.TextXAlignment = Enum.TextXAlignment.Left
	status.TextYAlignment = Enum.TextYAlignment.Top
	status.Text = id
	status.Parent = win.content
	P.status = status

	X.pvPlace()
	X.pvPlay()
end

--// Saving settings -------------------------------------------------------------------------------
local lastSavedJson
saveSettings = function()
	if not writefile then return end
	local function labelsFor(set, labels)
		local t = {}
		for id in pairs(set) do t[id] = labels[id] or "" end
		return t
	end
	local ok, json = pcall(function()
		return HttpService:JSONEncode({
			version = 2, theme = Th.cur.name, filter = X.filter, compact = X.compact, deepHook = X.deep,
			thorough = X.thorough, guessFX = X.guess, fxPre = X.pre,
			quality = QUALITY, ownOnly = ownOnly, uniqueOnly = uniqueOnly, detailedMode = detailedMode,
			tab = lastLogTab,
			excluded = labelsFor(excluded, animLabel),
			blocked = labelsFor(blocked, animLabel),
			excludedVFX = labelsFor(excludedVFX, vfxLabel),
			excludedSFX = labelsFor(excludedSFX, sfxLabel),
			window = mainWin.getState(),
		})
	end)
	if ok and json ~= lastSavedJson then
		if pcall(writefile, SETTINGS_FILE, json) then lastSavedJson = json end
	end
end

task.spawn(function()
	while gui.Parent do
		task.wait(2)
		saveSettings()
	end
end)

Run.cleanup = function()
	Run.alive = false
	pcall(X.pvClose)
	pcall(saveSettings)
	for _, c in ipairs(Run.conns) do pcall(function() c:Disconnect() end) end
	pcall(function() gui:Destroy() end)
end

