function X.dsDraw()
	local pv = X.dsPv
	if not (pv and pv.Parent) then return end
	for _, c in ipairs(pv:GetChildren()) do
		if c:GetAttribute("dsBtn") then c:Destroy() end
	end
	local function circle(item, key, text, color, transp, z)
		local b = Instance.new("TextButton")
		b:SetAttribute("dsBtn", true)
		b:SetAttribute("dsKey", tostring(key))
		b:SetAttribute("NoCorner", true)
		b.AutoButtonColor = false
		b.AnchorPoint = Vector2.new(0.5, 0.5)
		b.Position = UDim2.new(item.x, 0, item.y, 0)
		b.Size = UDim2.new(item.size, 0, 0, 0)
		b.BackgroundColor3 = color
		b.BackgroundTransparency = transp
		b.BorderSizePixel = 0
		b.Text = text
		b.TextColor3 = Color3.new(1, 1, 1)
		b.Font = Enum.Font.GothamBold
		b.TextScaled = true
		b.ZIndex = z
		local ar = Instance.new("UIAspectRatioConstraint")
		ar.AspectRatio = 1
		ar.Parent = b
		local cr = Instance.new("UICorner")
		cr.CornerRadius = UDim.new(1, 0)
		cr.Parent = b
		local ts = Instance.new("UITextSizeConstraint")
		ts.MaxTextSize = 16
		ts.Parent = b
		local mn = Instance.new("UISizeConstraint") -- never smaller than a fingertip while designing
		mn.MinSize = Vector2.new(key == "joy" and 54 or 34, key == "joy" and 54 or 34)
		mn.Parent = b
		local st = Instance.new("UIStroke")
		st.Name = "St"
		st.Color = Color3.new(1, 1, 1)
		st.Transparency = 0.6
		st.Thickness = 2
		st.Parent = b
		b.Parent = pv
		X.dsDrag(b, item, key)
		return b
	end
	local function round(o)
		local cr = Instance.new("UICorner")
		cr.CornerRadius = UDim.new(1, 0)
		cr.Parent = o
	end
	local jy = X.ds.joy
	if jy then
		local base = circle(jy, "joy", "", Color3.fromRGB(44, 50, 66), 0.35, 2)
		local thumb = Instance.new("Frame")
		thumb:SetAttribute("NoCorner", true)
		thumb.AnchorPoint = Vector2.new(0.5, 0.5)
		thumb.Position = UDim2.new(0.5, 0, 0.5, 0)
		thumb.Size = UDim2.new(0.42, 0, 0.42, 0)
		thumb.BackgroundColor3 = Color3.fromRGB(190, 196, 214)
		thumb.BorderSizePixel = 0
		round(thumb)
		thumb.Parent = base
	end
	local jp = X.ds.jump
	if jp then circle(jp, "jump", jp.label, Color3.fromRGB(70, 90, 130), 0.15, 3) end
	for i, b in ipairs(X.ds.buttons) do
		local el = circle(b, i, b.label, Color3.fromRGB(46, 160, 98), 0.15, 4)
		if b.anim == "" then -- tiny red dot = no animation picked yet (the finished script needs one)
			local dot = Instance.new("Frame")
			dot.Name = "Badge"
			dot:SetAttribute("NoCorner", true)
			dot.AnchorPoint = Vector2.new(0.5, 0.5)
			dot.Position = UDim2.new(0.85, 0, 0.15, 0)
			dot.Size = UDim2.new(0.24, 0, 0.24, 0)
			dot.BackgroundColor3 = Color3.fromRGB(235, 70, 70)
			dot.BorderSizePixel = 0
			dot.ZIndex = 6
			round(dot)
			dot.Parent = el
		end
	end
	if X.dsHint then X.dsHint.Visible = (#X.ds.buttons == 0 and not X.ds.joy and not X.ds.jump) end
	X.dsMark()
end

function X.dsProps() -- options of the selected button
	if not X.dsPanelShow() then return end
	local props = X.dsPropsFrame
	if not (props and props.Parent) then return end
	for _, c in ipairs(props:GetChildren()) do
		if c:IsA("GuiObject") then c:Destroy() end
	end
	local b = X.ds.buttons[X.ds.sel or 0]
	local order = 0
	local function row(label)
		order += 1
		local r = Instance.new("Frame")
		r.Size = UDim2.new(1, 0, 0, 34)
		r.BackgroundColor3 = order % 2 == 0 and C.row1 or C.row2
		r.BorderSizePixel = 0
		r.LayoutOrder = order
		r.Parent = props
		local l = Instance.new("TextLabel")
		l.Position = UDim2.new(0, 8, 0, 0)
		l.Size = UDim2.new(0.42, -8, 1, 0)
		l.TextWrapped = true
		l.BackgroundTransparency = 1
		l.Text = label
		l.TextColor3 = C.text
		l.Font = Th.font
		l.TextSize = 13
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.Parent = r
		return r
	end
	local function changed()
		X.svDirty = true
		X.dsDraw()
	end
	local function boxRow(label, get, set, numeric, placeholder)
		local r = row(label)
		local tb = X.mkBox(r, 10, tostring(get()), placeholder)
		tb.Position = UDim2.new(0.42, 0, 0.5, -14)
		tb.Size = UDim2.new(0.58, -8, 0, 28)
		tb.FocusLost:Connect(function()
			if numeric then
				local v = tonumber(tb.Text)
				if v then set(v) end
				tb.Text = tostring(get())
			else
				set(tb.Text)
			end
			changed()
		end)
	end
	local function btnRow(label, text, color, fn)
		local r = row(label)
		local bt = K.newButton(r, text, color)
		bt.Position = UDim2.new(0.42, 0, 0.5, -14)
		bt.Size = UDim2.new(0.58, -8, 0, 28)
		bt.TextSize = 13
		bt.TextTruncate = Enum.TextTruncate.AtEnd
		bt.MouseButton1Click:Connect(function()
			fn()
			changed()
			X.dsProps()
		end)
	end
	local function posRows(item, lim)
		boxRow("Left / right (0-1)", function() return math.floor(item.x * 1000 + 0.5) / 1000 end, function(v) item.x = math.clamp(v, lim[1], lim[2]) end, true)
		boxRow("Up / down (0-1)", function() return math.floor(item.y * 1000 + 0.5) / 1000 end, function(v) item.y = math.clamp(v, lim[3], lim[4]) end, true)
	end
	if X.ds.sel == "jump" and X.ds.jump then
		local j = X.ds.jump
		boxRow("Label", function() return j.label end, function(v) j.label = tostring(v):sub(1, 8) end, false)
		posRows(j, X.DS_LIM.jump)
		boxRow("Size (0.03-0.2)", function() return j.size end, function(v) j.size = math.clamp(v, 0.03, 0.2) end, true)
