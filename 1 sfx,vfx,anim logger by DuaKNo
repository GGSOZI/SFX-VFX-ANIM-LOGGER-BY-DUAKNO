local viewerCount = 0
local function openViewer(titleText, variants, startIndex)
	viewerCount += 1
	local off = (viewerCount % 6) * 22
	local win = createWindow({
		title = titleText,
		size = Vector2.new(560, 440),
		pos = UDim2.new(0.5, -280 + off, 0.5, -220 + off),
