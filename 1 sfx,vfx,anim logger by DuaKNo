end
function X.guiScale() -- big grows with the screen (so it is not tiny on big / high-resolution screens); small and tiny shrink from there
	local vp = X.viewSize()
	return math.clamp(math.min(vp.X / 1100, vp.Y / 540), 1, 3) * (X.GUI_FACTOR[X.guiSize] or 1)
end

local loaded = K.loadSettings()
if loaded then
	local function applyMap(target, src, labels)
		if type(src) ~= "table" then return end
		for id, label in pairs(src) do
			target[id] = true
			if labels and type(label) == "string" and label ~= "" then labels[id] = label end
		end
	end
	applyMap(excluded, loaded.excluded, animLabel)
	applyMap(excludedVFX, loaded.excludedVFX, vfxLabel)
	applyMap(excludedSFX, loaded.excludedSFX, sfxLabel)
	applyMap(blocked, loaded.blocked, animLabel)
	if type(loaded.logVariants) == "boolean" then X.variants = loaded.logVariants end
	if type(loaded.strictFX) == "boolean" then X.strict = loaded.strictFX end
	if type(loaded.fxAll) == "boolean" then X.fxAll = loaded.fxAll end
	if X.GUI_FACTOR[loaded.guiSize] then X.guiSize = loaded.guiSize end
	if type(loaded.logCutscenes) == "boolean" then X.cutscenes = loaded.logCutscenes end
	applyMap(X.blockV, loaded.blockedVFX, vfxLabel)
	applyMap(X.blockS, loaded.blockedSFX, sfxLabel)
	-- settings saved by older versions of this script never override the new ON defaults
	if (tonumber(loaded.version) or 1) >= 2 then
		if type(loaded.ownOnly) == "boolean" then ownOnly = loaded.ownOnly end
		if type(loaded.uniqueOnly) == "boolean" then uniqueOnly = loaded.uniqueOnly end
	end
	if type(loaded.detailedMode) == "boolean" then detailedMode = loaded.detailedMode end
	if QUALITY_TOL[loaded.quality] then QUALITY = loaded.quality end
	if type(loaded.tab) == "string" then currentTab = loaded.tab end
	if type(loaded.filter) == "string" then X.filter = loaded.filter end
	if type(loaded.compact) == "boolean" then X.compact = loaded.compact end
	if type(loaded.deepHook) == "boolean" then X.deep = loaded.deepHook end
	if type(loaded.thorough) == "boolean" and (tonumber(loaded.version) or 1) >= 3 then X.thorough = loaded.thorough end
	if type(loaded.guessFX) == "boolean" then X.guess = loaded.guessFX end
	if type(loaded.objOn) == "boolean" then X.objOn = loaded.objOn end
	if type(loaded.gui2d) == "boolean" then X.gui2d = loaded.gui2d end
	if type(loaded.guardOn) == "boolean" then X.guardOn = loaded.guardOn end
	if tonumber(loaded.fxPre) then X.pre = math.clamp(tonumber(loaded.fxPre), 1, 10) end
end

--// Helpers -------------------------------------------------------------------
function K.esc(s)
	return (tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

function K.shortPath(inst)
	local parts, cur = {}, inst
	while cur and cur ~= workspace and cur ~= game do
		table.insert(parts, 1, cur.Name)
		cur = cur.Parent
	end
	if #parts > 3 then parts = { "..", parts[#parts - 2], parts[#parts - 1], parts[#parts] } end
	return table.concat(parts, ".")
end

function K.isOwn(inst)
	local char = lp.Character
	return char ~= nil and inst:IsDescendantOf(char)
end

-- Player filter (Settings): when set it replaces "Own character only"
function X.player()
	local t = X.filter:lower()
	if t == "" then return nil end
	local best
	for _, p in ipairs(Players:GetPlayers()) do
		local n, d = p.Name:lower(), p.DisplayName:lower()
		if n == t or d == t then return p end
		if not best and (n:find(t, 1, true) or d:find(t, 1, true)) then best = p end
	end
	return best
end
function X.passes(inst)
	if X.filter ~= "" then
		local p = X.player()
		local ch = p and p.Character
		return ch ~= nil and inst:IsDescendantOf(ch)
	end
	return (not ownOnly) or K.isOwn(inst)
end

function K.countKeys(t)
	local n = 0
	for _ in pairs(t) do n += 1 end
	return n
end

function K.getRoot()
	local char = lp.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local Clip = {} -- one table (Luau limits a script to 200 locals)
Clip.HEADER = "-- This was generated by Dua's VFX/SFX/ANIMATION LOGGER"
function Clip.stamp(text) -- adds the header to Lua code (not to XML files like .rbxmx)
	text = tostring(text)
	if text:sub(1, #Clip.HEADER) == Clip.HEADER or text:match("^%s*<") then return text end
	return Clip.HEADER .. "\n" .. text
end
function K.animName(id) -- "TrackName / Owner" -> "TrackName"
	local l = animLabel[id] or ""
	l = l:match("^(.-) / ") or l
	l = l:gsub("[\r\n]", " ")
	if l == "" then l = "(unnamed)" end
	return l
end
function Clip.set(text)
	if not setclip then return false end
	return (pcall(setclip, Clip.stamp(text)))
end

function K.g(n) -- number -> Lua/XML text
	if n == math.huge then return "math.huge" end
	if n == -math.huge then return "-math.huge" end
	if n ~= n then return "0" end
	return string.format("%.6g", n)
end

function K.num(n)
	local s = string.format("%.4f", n):gsub("0+$", ""):gsub("%.$", "")
	if s == "-0" or s == "" then s = "0" end
	return s
end

function K.cfStr(cf)
	local c = { cf:GetComponents() }
	for i, v in ipairs(c) do c[i] = K.num(v) end
	return "CFrame.new(" .. table.concat(c, ",") .. ")"
end

function K.cfDiffers(a, b)
	return (a.Position - b.Position).Magnitude > 0.002
		or (a.XVector - b.XVector).Magnitude > 0.002
		or (a.YVector - b.YVector).Magnitude > 0.002
end

-- runs fn in its own thread, gives up after `seconds` (returns nil on timeout / error)
function K.withTimeout(seconds, fn)
	local done, result = false, nil
	task.spawn(function()
		local ok, r = pcall(fn)
		if ok then result = r end
		done = true
	end)
	local t0 = os.clock()
	while not done and os.clock() - t0 < seconds do task.wait(0.05) end
	return result
end

-- value -> Lua literal text (nil if unsupported)
function K.lit(v)
	local t = typeof(v)
	if t == "number" then
		return K.g(v)
	elseif t == "boolean" then
		return tostring(v)
	elseif t == "string" then
		return string.format("%q", v)
	elseif t == "Vector3" then
		return string.format("Vector3.new(%s,%s,%s)", K.g(v.X), K.g(v.Y), K.g(v.Z))
	elseif t == "Vector2" then
		return string.format("Vector2.new(%s,%s)", K.g(v.X), K.g(v.Y))
	elseif t == "Color3" then
		return string.format("Color3.new(%s,%s,%s)", K.g(v.R), K.g(v.G), K.g(v.B))
	elseif t == "NumberRange" then
		return string.format("NumberRange.new(%s,%s)", K.g(v.Min), K.g(v.Max))
	elseif t == "NumberSequence" then
		local kps = {}
		for _, k in ipairs(v.Keypoints) do
			kps[#kps + 1] = string.format("NumberSequenceKeypoint.new(%s,%s,%s)", K.g(k.Time), K.g(k.Value), K.g(k.Envelope))
		end
		return "NumberSequence.new({" .. table.concat(kps, ",") .. "})"
	elseif t == "ColorSequence" then
		local kps = {}
		for _, k in ipairs(v.Keypoints) do
			kps[#kps + 1] = string.format(
				"ColorSequenceKeypoint.new(%s,Color3.new(%s,%s,%s))",
				K.g(k.Time), K.g(k.Value.R), K.g(k.Value.G), K.g(k.Value.B)
			)
		end
		return "ColorSequence.new({" .. table.concat(kps, ",") .. "})"
	elseif t == "EnumItem" then
		return tostring(v)
	elseif t == "UDim2" then
		return string.format("UDim2.new(%s,%s,%s,%s)", K.g(v.X.Scale), K.g(v.X.Offset), K.g(v.Y.Scale), K.g(v.Y.Offset))
	elseif t == "UDim" then
		return string.format("UDim.new(%s,%s)", K.g(v.Scale), K.g(v.Offset))
	elseif t == "Rect" then
		return string.format("Rect.new(%s,%s,%s,%s)", K.g(v.Min.X), K.g(v.Min.Y), K.g(v.Max.X), K.g(v.Max.Y))
	elseif t == "CFrame" then
		return K.cfStr(v)
	end
	return nil
end

function K.playAnim(id)
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then error("no humanoid") end
	local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
	local a = Instance.new("Animation")
	a.AnimationId = id
	local track = animator:LoadAnimation(a)
	ownTracks[track] = true
	track:Play()
end

--// Frame simplification -------------------------------------------------------
-- Drops frames that can be rebuilt (within a tolerance) by blending the neighbouring kept frames.
function K.frameError(a, b)
	return (a.Position - b.Position).Magnitude
		+ (a.XVector - b.XVector).Magnitude
		+ (a.YVector - b.YVector).Magnitude
end

function K.simplifyJoints(joints, tol)
	local n = #joints[1].frames
	if tol <= 0 or n <= 2 then return joints, n, n end

	local keep = { [1] = true, [n] = true }
	local stack = { { 1, n } }
	local ops = 0
	local times = joints[1].frames
	while #stack > 0 do
		local seg = table.remove(stack)
		local i, j = seg[1], seg[2]
		if j - i > 1 then
			local ti, tj = times[i][1], times[j][1]
			local span = math.max(tj - ti, 1e-6)
			local worst, worstK = 0, nil
			for k = i + 1, j - 1 do
				local alpha = (times[k][1] - ti) / span
				local e = 0
				for _, jt in ipairs(joints) do
					local f = jt.frames
					local err = K.frameError(f[k][2], f[i][2]:Lerp(f[j][2], alpha))
					if err > e then e = err end
				end
				if e > worst then worst, worstK = e, k end
				ops += #joints
			end
			if worst > tol and worstK then
				keep[worstK] = true
				stack[#stack + 1] = { i, worstK }
				stack[#stack + 1] = { worstK, j }
			end
			if ops > 40000 then
				ops = 0
				if coroutine.isyieldable() then task.wait() end
			end
		end
	end

	local out, kept = {}, 0
	for _, jt in ipairs(joints) do
		local list = {}
		for idx, f in ipairs(jt.frames) do
			if keep[idx] then list[#list + 1] = f end
		end
		kept = #list
		out[#out + 1] = { name = jt.name, part0 = jt.part0, part1 = jt.part1, frames = list }
	end
	return out, kept, n
end

