--// Animation editor ---------------------------------------------------------------------------------
-- Edits the captured frames of an animation: cut, delete a part, change speed, reverse, ping-pong, repeat,
-- loop, undo / redo. Every edit is written back, so Copy Full / Copy +FX / RBXMX / Run all use the edited
-- animation, and the Preview rig plays it live. Effects (FX) follow the edits (speed, cuts, reverse).
X.aeData = {}
X.aeFrame = 1 / 30

function K.aeEval(list, t) -- pose of one joint at time t (linear blend between the neighbouring frames)
	local n = #list
	if n == 0 then return CFrame.new() end
	if t <= list[1][1] then return list[1][2] end
	if t >= list[n][1] then return list[n][2] end
	local lo, hi = 1, n
	while hi - lo > 1 do
		local mid = (lo + hi) // 2
		if list[mid][1] <= t then lo = mid else hi = mid end
	end
	local a, b = list[lo], list[hi]
	local span = b[1] - a[1]
	if span <= 1e-6 then return b[2] end
	return a[2]:Lerp(b[2], (t - a[1]) / span)
end

function K.aeInsert(list, t) -- makes sure there is a frame exactly at time t
	local out, done = {}, false
	for _, f in ipairs(list) do
		if not done then
			if math.abs(f[1] - t) <= 1e-4 then
				done = true
			elseif f[1] > t then
				out[#out + 1] = { t, K.aeEval(list, t) }
				done = true
			end
		end
		out[#out + 1] = f
	end
	if not done then out[#out + 1] = { t, K.aeEval(list, t) } end
	return out
end

function K.aeSlice(list, a, b) -- frames between a and b, shifted so a becomes 0
	local out = { { 0, K.aeEval(list, a) } }
	for _, f in ipairs(list) do
		if f[1] > a + 1e-4 and f[1] < b - 1e-4 then out[#out + 1] = { f[1] - a, f[2] } end
	end
	out[#out + 1] = { b - a, K.aeEval(list, b) }
	return out
end

function K.aeDelete(list, a, b, len) -- remove [a, b] and close the gap
	local out = {}
	if a > 1e-4 then
		for _, f in ipairs(K.aeSlice(list, 0, a)) do out[#out + 1] = f end
	end
	if b < len - 1e-4 then
		local off = (a > 1e-4) and (a + X.aeFrame) or 0
		for _, f in ipairs(K.aeSlice(list, b, len)) do out[#out + 1] = { f[1] + off, f[2] } end
	end
	return out
end

function K.aeSpeed(list, a, b, f) -- play [a, b] at f times the speed
	local l = K.aeInsert(K.aeInsert(list, a), b)
	local d = (b - a) * (1 / f - 1)
	local out = {}
	for _, fr in ipairs(l) do
		local t = fr[1]
		if t > b + 1e-4 then
			t += d
		elseif t > a then
			t = a + (t - a) / f
		end
		out[#out + 1] = { t, fr[2] }
	end
	return out
end

function K.aeReverse(list, a, b)
	local l = K.aeInsert(K.aeInsert(list, a), b)
	local before, mid, after = {}, {}, {}
	for _, fr in ipairs(l) do
		if fr[1] < a - 1e-4 then
			before[#before + 1] = fr
		elseif fr[1] > b + 1e-4 then
			after[#after + 1] = fr
		else
			mid[#mid + 1] = fr
		end
	end
	local out = before
	for i = #mid, 1, -1 do out[#out + 1] = { a + b - mid[i][1], mid[i][2] } end
	for _, fr in ipairs(after) do out[#out + 1] = fr end
	return out
end

function K.aePingPong(list, len)
	local out = {}
	for _, f in ipairs(list) do out[#out + 1] = f end
	for i = #list - 1, 1, -1 do out[#out + 1] = { len + (len - list[i][1]), list[i][2] } end
	return out
end

function K.aeRepeat(list, len, n)
	local out = {}
	for k = 0, n - 1 do
		local off = k * (len + X.aeFrame)
		for _, f in ipairs(list) do out[#out + 1] = { f[1] + off, f[2] } end
	end
	return out
end

function X.aeFxList(A, create) -- the FX events that belong to this animation (edits go to your own copy)
	local id = A.id
	if X.ed and X.ed.id == id then
		if create then
			X.fxEdit[id] = X.ed.events
			X.ed.dirty = true
		end
		return X.ed.events
	end
	local l = X.fxEdit[id]
	if not l and create then
		l = fxWindows.rawFor(id)
		if l then X.fxEdit[id] = l end
	end
	return l
end

function X.aeSnap(A)
	local s = { tr = A.tr, len = A.len, looped = A.looped, a = A.a, b = A.b, fx = {}, fxHad = X.fxEdit[A.id] ~= nil,
		base = A.base, baseLen = A.baseLen, baseFxMap = A.baseFxMap, selClip = A.selClip, clips = {} }
	for i, c in ipairs(A.clips) do s.clips[i] = table.clone(c) end
	local list = X.aeFxList(A, false)
	if list then
		for i, e in ipairs(list) do s.fx[i] = { e = e, t = e.t, dur = e.dur, off = e.off } end
	end
	return s
end

function X.aeApplyData(A) -- write the working copy back into the captured animation
	local d = A.d
	for i, j in ipairs(d.joints) do j.frames = A.tr[A.slotJ[i]] end
	for i, m in ipairs(d.allMotors or {}) do m.samples = A.tr[A.slotM[i]] end
	local len = 0
	for _, arr in ipairs(A.tr) do
		local l = arr[#arr] and arr[#arr][1] or 0
		if l > len then len = l end
	end
	A.len = len
	d.length = len
	d.looped = A.looped
	d.cache = {}
	d.rawFrames = #d.joints[1].frames
	X.lens[A.id] = len
	rbxmxCache[A.id] = nil
	pcall(refreshExtra, A.id)
end

function X.aeRestore(A, snap)
	A.tr, A.looped = snap.tr, snap.looped
	A.base, A.baseLen, A.baseFxMap, A.selClip = snap.base, snap.baseLen, snap.baseFxMap, snap.selClip
	A.clips = {}
	for i, c in ipairs(snap.clips) do A.clips[i] = table.clone(c) end
	for _, r in ipairs(snap.fx) do r.e.t, r.e.dur, r.e.off = r.t, r.dur, r.off end
	if not snap.fxHad and X.fxEdit[A.id] and not (X.ed and X.ed.id == A.id and #X.ed.undo > 0) then
		X.fxEdit[A.id] = nil
		if X.ed and X.ed.id == A.id then
			X.ed.events = fxWindows.rawFor(A.id) or {}
			X.ed.dirty = false
		end
	end
	X.aeApplyData(A)
	A.a = math.clamp(snap.a, 0, A.len)
	A.b = math.clamp(snap.b, A.a, A.len)
	A.head = math.clamp(A.head, 0, A.len)
	X.edSync(A.id)
end

function X.aeInit(id)
	local A = X.aeData[id]
	if A then return A end
	local d = details[id]
	local tr, idx, slotJ, slotM = {}, {}, {}, {}
	local function reg(arr)
		local i = idx[arr]
		if not i then
			tr[#tr + 1] = arr
			i = #tr
			idx[arr] = i
		end
		return i
	end
	for i, j in ipairs(d.joints) do slotJ[i] = reg(j.frames) end
	for i, m in ipairs(d.allMotors or {}) do slotM[i] = reg(m.samples) end
	A = {
		id = id, d = d, tr = tr, slotJ = slotJ, slotM = slotM, len = d.length, looped = d.looped and true or false,
		undo = {}, redo = {}, a = 0, b = d.length, head = 0, fxOn = true, fxPrev = true, token = 0, status = "",
	}
	X.aeResetClips(A)
	A.orig = X.aeSnap(A)
	X.aeData[id] = A
	return A
end

function X.aeNote(A, text)
	A.status = text
	X.aeRefresh(A)
end

-- the one place every edit goes through: keeps undo / redo, updates FX, saves into the animation
function X.aeDo(A, label, newTr, newLooped, fxFn, newSel)
	X.aeStop(A)
	table.insert(A.undo, X.aeSnap(A))
	if #A.undo > 60 then table.remove(A.undo, 1) end
	A.redo = {}
	A.tr = newTr
	if newLooped ~= nil then A.looped = newLooped end
	if A.fxOn and fxFn then
		local list = X.aeFxList(A, true)
		if list then
			for _, e in ipairs(list) do fxFn(e) end
		end
	end
	X.aeApplyData(A)
	if A._keep then -- a clip edit: keep the clip session
		A.clips, A.selClip = A._newClips, A._newSel
	else
		X.aeResetClips(A) -- any other edit becomes the new starting point for clips
	end
	A._keep, A._newClips, A._newSel = nil, nil, nil
	if newSel then
		A.a, A.b = math.clamp(newSel[1], 0, A.len), math.clamp(newSel[2], 0, A.len)
	else
		A.a, A.b = 0, A.len
	end
	A.head = math.clamp(A.head, 0, A.len)
	A.status = label
	X.edSync(A.id)
	X.aeRefresh(A)
end

function X.aeMap(A, fn)
	local nt = {}
	for i, arr in ipairs(A.tr) do nt[i] = fn(arr) end
	return nt
end

function X.aeUndo(A)
	if #A.undo == 0 then return X.aeNote(A, "Nothing to undo") end
	X.aeStop(A)
	table.insert(A.redo, X.aeSnap(A))
	X.aeRestore(A, table.remove(A.undo))
	X.aeNote(A, "Undone")
end

function X.aeRedo(A)
	if #A.redo == 0 then return X.aeNote(A, "Nothing to redo") end
	X.aeStop(A)
	table.insert(A.undo, X.aeSnap(A))
	X.aeRestore(A, table.remove(A.redo))
	X.aeNote(A, "Redone")
end

function X.aeResetAll(A)
	X.aeStop(A)
	table.insert(A.undo, X.aeSnap(A))
	A.redo = {}
	X.aeRestore(A, A.orig)
	A.a, A.b, A.head = 0, A.len, 0
	X.aeNote(A, "Back to the original animation")
end

function X.aeTrim(A, a, b)
	if b - a < 0.05 then return X.aeNote(A, "Selection is too short") end
	if a <= 1e-4 and b >= A.len - 1e-4 then return X.aeNote(A, "Select a part first - the selection is the whole animation") end
	X.aeDo(A, string.format("Kept %.2fs - %.2fs", a, b), X.aeMap(A, function(l) return K.aeSlice(l, a, b) end), nil, function(e)
		if e.t < a - 1e-4 or e.t > b + 1e-4 then
			e.off = true
		else
			e.t = math.max(e.t - a, 0)
		end
	end)
end

function X.aeCutOut(A, a, b)
	if b - a < 0.02 then return X.aeNote(A, "Selection is too short") end
	if a <= 1e-4 and b >= A.len - 1e-4 then return X.aeNote(A, "Can't delete the whole animation") end
	local len, gap = A.len, X.aeFrame
	local shift = (a > 1e-4) and (b - a - gap) or (b - a)
	X.aeDo(A, string.format("Deleted %.2fs - %.2fs", a, b), X.aeMap(A, function(l) return K.aeDelete(l, a, b, len) end), nil, function(e)
		if e.t >= a - 1e-4 and e.t < b - 1e-4 then
			e.off = true
		elseif e.t >= b - 1e-4 then
			e.t = math.max(e.t - shift, 0)
		end
	end)
end

function X.aeSetSpeed(A, f)
	local a, b = A.a, A.b
	if not f or f < 0.05 or f > 20 then return X.aeNote(A, "Speed must be between 0.05 and 20") end
	if b - a < 0.05 then return X.aeNote(A, "Selection is too short") end
	local d = (b - a) * (1 / f - 1)
	local function M(t)
		if t > b + 1e-4 then return t + d end
		if t > a then return a + (t - a) / f end
		return t
	end
	X.aeDo(A, string.format("Speed x%g on %.2fs - %.2fs", f, a, b), X.aeMap(A, function(l) return K.aeSpeed(l, a, b, f) end), nil, function(e)
		local nt = M(e.t)
		if e.dur then e.dur = math.max(M(e.t + e.dur) - nt, 0.05) end
		e.t = nt
	end, { a, a + (b - a) / f })
end

function X.aeReverse(A, a, b)
	if b - a < 0.05 then return X.aeNote(A, "Selection is too short") end
	X.aeDo(A, string.format("Reversed %.2fs - %.2fs", a, b), X.aeMap(A, function(l) return K.aeReverse(l, a, b) end), nil, function(e)
		if e.t >= a - 1e-4 and e.t <= b + 1e-4 then
			local dur = (e.emit and not e.enabled) and 0 or (e.dur or 0)
			e.t = math.clamp(a + b - (e.t + dur), a, b)
		end
	end, { a, b })
end

function X.aePingPong(A)
	local len = A.len
	X.aeDo(A, "Added a reversed copy (ping-pong)", X.aeMap(A, function(l) return K.aePingPong(l, len) end), nil, nil)
end

function X.aeRepeat(A, n)
	local len = A.len
	X.aeDo(A, string.format("Repeated x%d", n), X.aeMap(A, function(l) return K.aeRepeat(l, len, n) end), nil, nil)
end

--// Preview on the preview rig (poses are applied straight to the rig's joints) ------------------
function X.aeMotors(A, P)
	if A.mRig ~= P.rig then
		A.mRig, A.motors = P.rig, {}
		for i, j in ipairs(A.d.joints) do
			for _, m in ipairs(P.rig:GetDescendants()) do
				if m:IsA("Motor6D") and m.Name == j.name and m.Part1 and m.Part1.Name == j.part1 then
					A.motors[i] = m
					break
				end
			end
		end
	end
	return A.motors
end

function X.aeTake(A, P) -- stop the normal animation on the preview rig so the editor's poses win
	if A.took ~= P.rig then
		A.took = P.rig
		P.token += 1
		pcall(function() if P.track then P.track:Stop(0) end end)
	end
	pcall(function()
		for _, t in ipairs(P.animator:GetPlayingAnimationTracks()) do t:Stop(0) end
	end)
end

function X.aePose(A, t)
	local P = X.pv
	if not (P and P.rig.Parent) then return end
	X.aeTake(A, P)
	for i, m in pairs(X.aeMotors(A, P)) do
		m.Transform = K.aeEval(A.tr[A.slotJ[i]], t)
	end
end

function X.aeStop(A)
	A.token += 1
	if A.playing then
		A.playing = false
		if X.ae == A then X.aeRefresh(A) end
	end
end

function X.aePlay(A, startAt, endAt)
	if A.playing then return X.aeStop(A) end
	local P = X.pv
	if not (P and P.rig.Parent) then
		local ok, err = pcall(X.pvOpen, A.id)
		if not ok then return out("Preview failed: " .. tostring(err)) end
		P = X.pv
	end
	if not P then return end
	X.aeTake(A, P)
	startAt = startAt or A.head
	endAt = endAt or A.len
	if startAt >= endAt - 0.02 then startAt = (endAt == A.len) and 0 or A.a end
	A.token += 1
	local my = A.token
	A.playing = true
	X.aeRefresh(A)
	task.spawn(function()
		local function runFx()
			if not A.fxPrev or startAt > 0.01 then return end
			local list = fxWindows.liveFor(A.id)
			if list and #list > 0 then
				local ok, err = pcall(X.runOn, list, "Preview", P.rig)
				if not ok then out("FX preview failed: " .. tostring(err)) end
			end
		end
		runFx()
		local t0 = os.clock() - startAt
		while my == A.token and P.rig.Parent do
			local t = os.clock() - t0
			if t >= endAt then
				if A.looped then
					t0 = os.clock() - startAt
					t = startAt
					runFx()
				else
					t = endAt
				end
			end
			for i, m in pairs(X.aeMotors(A, P)) do
				m.Transform = K.aeEval(A.tr[A.slotJ[i]], t)
			end
			A.head = t
			X.aeMoveHead(A)
			if t >= endAt and not A.looped then break end
			RunService.RenderStepped:Wait()
		end
		if my == A.token then
			A.playing = false
			if X.ae == A then X.aeRefresh(A) end
		end
	end)
end


--// Clips (CapCut style): split, drag to reorder, drag the edges to trim ------------------------------
-- A.base = the animation when the clip session started. A.clips = pieces of it { a, b, speed, rev } in play
-- order. Every clip edit rebuilds the animation from A.base, so clips can be moved, trimmed and re-ordered freely.
function X.aeResetClips(A)
	A.base, A.baseLen, A.baseFxMap = A.tr, A.len, nil
	A.clips = { { a = 0, b = A.len, speed = 1, rev = false } }
	A.selClip = 1
end

function X.aeJoins(p, c) -- two neighbouring clips that are still one continuous piece
	return not p.rev and not c.rev and math.abs(p.speed - c.speed) < 1e-6 and math.abs(p.b - c.a) < 1e-4
end

function X.aeLayout(clips)
	local starts, ends, cursor = {}, {}, 0
	for i, c in ipairs(clips) do
		local s = cursor
		if i > 1 and not X.aeJoins(clips[i - 1], c) then s = cursor + X.aeFrame end
		starts[i] = s
		ends[i] = s + (c.b - c.a) / c.speed
		cursor = ends[i]
	end
	return starts, ends, cursor
end

function X.aeBuild(A, clips)
	local starts, ends, total = X.aeLayout(clips)
	local nt = {}
	for ai, l in ipairs(A.base) do
		local out = {}
		for i, c in ipairs(clips) do
			local seg = K.aeSlice(l, c.a, c.b)
			local segLen = c.b - c.a
			local piece = {}
			if c.rev then
				for k = #seg, 1, -1 do piece[#piece + 1] = { (segLen - seg[k][1]) / c.speed, seg[k][2] } end
			else
				for k = 1, #seg do piece[#piece + 1] = { seg[k][1] / c.speed, seg[k][2] } end
			end
			local skip = (i > 1 and X.aeJoins(clips[i - 1], c)) and 1 or 0
			for k = 1 + skip, #piece do out[#out + 1] = { piece[k][1] + starts[i], piece[k][2] } end
		end
		nt[ai] = out
	end
	return nt, starts
end

function X.aeClipOp(A, label, clips, sel)
	if A.fxOn and not A.baseFxMap then
		A.baseFxMap = {}
		local list = X.aeFxList(A, true)
		if list then
			for _, e in ipairs(list) do A.baseFxMap[e] = { t = e.t, dur = e.dur, off = e.off } end
		end
	end
	local newTr, starts = X.aeBuild(A, clips)
	local map = A.baseFxMap
	local fxFn
	if map then
		fxFn = function(e)
			local r = map[e]
			if not r then return end
			local dur0 = (e.emit and not e.enabled) and 0 or (r.dur or 0)
			for i, c in ipairs(clips) do
				if r.t >= c.a - 1e-4 and r.t <= c.b + 1e-4 then
					if c.rev then
						e.t = starts[i] + math.max(c.b - (r.t + dur0), 0) / c.speed
					else
						e.t = starts[i] + (r.t - c.a) / c.speed
					end
					if r.dur then e.dur = math.max(r.dur / c.speed, 0.05) end
					e.off = r.off
					return
				end
			end
			e.off = true -- this effect is not inside any clip any more
		end
	end
	A._keep, A._newClips, A._newSel = true, clips, math.clamp(sel or A.selClip or 1, 1, #clips)
	X.aeDo(A, label, newTr, nil, fxFn, nil)
end

function X.aeCopyClips(A)
	local nc = {}
	for i, c in ipairs(A.clips) do nc[i] = table.clone(c) end
	return nc
end

function X.aeSplit(A)
	local starts, ends = X.aeLayout(A.clips)
	local h = A.head
	for i, c in ipairs(A.clips) do
		if h > starts[i] + 1e-4 and h < ends[i] - 1e-4 then
			local u = (h - starts[i]) * c.speed
			if u < 0.05 or (c.b - c.a) - u < 0.05 then
				return X.aeNote(A, "Too close to the edge of the clip - move the playhead a bit")
			end
			local first, second = table.clone(c), table.clone(c)
			if c.rev then
				first.a = c.b - u
				second.b = c.b - u
			else
				first.b = c.a + u
				second.a = c.a + u
			end
			local nc = {}
			for k, cc in ipairs(A.clips) do
				if k == i then
					nc[#nc + 1] = first
					nc[#nc + 1] = second
				else
					nc[#nc + 1] = table.clone(cc)
				end
			end
			return X.aeClipOp(A, string.format("Split at %.2fs", h), nc, i + 1)
		end
	end
	X.aeNote(A, "Move the playhead onto a clip first (tap the timeline), then Split")
end

function X.aeDelClip(A)
	local i = A.selClip
	if #A.clips <= 1 then return X.aeNote(A, "That is the only clip - Split first, then delete a piece") end
	local nc = {}
	for k, c in ipairs(A.clips) do
		if k ~= i then nc[#nc + 1] = table.clone(c) end
	end
	X.aeClipOp(A, "Deleted clip " .. i, nc, math.min(i, #nc))
end

function X.aeDupClip(A)
	local nc = X.aeCopyClips(A)
	table.insert(nc, A.selClip + 1, table.clone(A.clips[A.selClip]))
	X.aeClipOp(A, "Duplicated clip " .. A.selClip, nc, A.selClip + 1)
end

function X.aeRevClip(A)
	local nc = X.aeCopyClips(A)
	nc[A.selClip].rev = not nc[A.selClip].rev
	X.aeClipOp(A, "Reversed clip " .. A.selClip, nc, A.selClip)
end

function X.aeClipSpeed(A, v)
	if not v or v < 0.1 or v > 10 then return X.aeNote(A, "Clip speed must be between 0.1 and 10") end
	local nc = X.aeCopyClips(A)
	nc[A.selClip].speed = v
	X.aeClipOp(A, string.format("Clip %d speed x%g", A.selClip, v), nc, A.selClip)
end

function X.aeMoveClip(A, from, to)
	to = math.clamp(to, 1, #A.clips)
	if from == to then return X.aeRefresh(A) end
	local nc = X.aeCopyClips(A)
	local c = table.remove(nc, from)
	table.insert(nc, to, c)
	X.aeClipOp(A, string.format("Moved clip %d to position %d", from, to), nc, to)
end

function X.aeJoinAll(A)
	if #A.clips <= 1 then return X.aeNote(A, "Already one clip") end
	X.aeDo(A, "Joined all clips into one", A.tr, nil, nil, { A.a, A.b })
end

function X.aeClipDrag(A, i, blk, input) -- tap = select + move playhead, drag = re-order
	local bar = A.bar
	local W = math.max(bar.AbsoluteSize.X, 1)
	local len = math.max(A.len, 0.01)
	local starts, ends = X.aeLayout(A.clips)
	local startX, lastX, moved = input.Position.X, input.Position.X, false
	local baseOffset = blk.AbsolutePosition.X - bar.AbsolutePosition.X
	local bw = blk.AbsoluteSize.X
	local conn = UserInputService.InputChanged:Connect(function(i2)
		if not isMove(i2) then return end
		lastX = i2.Position.X
		if math.abs(lastX - startX) > 6 then moved = true end
		if moved then
			blk.ZIndex = 9
			blk.Position = UDim2.new(0, math.clamp(baseOffset + (lastX - startX), 0, math.max(W - bw, 0)), 0, 62)
		end
	end)
	input.Changed:Connect(function()
		if input.UserInputState ~= Enum.UserInputState.End then return end
		conn:Disconnect()
		if moved then
			local center = (baseOffset + (lastX - startX) + bw / 2) / W * len
			local newIdx = 1
			for k = 1, #A.clips do
				if k ~= i and (starts[k] + ends[k]) / 2 < center then newIdx += 1 end
			end
			A.selClip = i
			X.aeMoveClip(A, i, newIdx)
		else
			A.selClip = i
			if A.playing then X.aeStop(A) end
			A.head = math.clamp((startX - bar.AbsolutePosition.X) / W, 0, 1) * len
			X.aePose(A, A.head)
			X.aeRefresh(A)
		end
	end)
end

function X.aeClipTrim(A, i, side, handle, blk, input) -- drag a clip's edge to shorten / extend it
	local bar = A.bar
	local W = math.max(bar.AbsoluteSize.X, 1)
	local len = math.max(A.len, 0.01)
	local c = A.clips[i]
	local startX = input.Position.X
	local x0 = blk.AbsolutePosition.X - bar.AbsolutePosition.X
	local w0 = blk.AbsoluteSize.X
	local na, nb, changed = c.a, c.b, false
	local conn = UserInputService.InputChanged:Connect(function(i2)
		if not isMove(i2) then return end
		local d = (i2.Position.X - startX) / W * len * c.speed -- seconds of the source animation
		local a, b = c.a, c.b
		if not c.rev then
			if side == "left" then a = a + d else b = b + d end
		else
			if side == "left" then b = b - d else a = a - d end
		end
		a = math.clamp(a, 0, b - 0.05)
		b = math.clamp(b, a + 0.05, A.baseLen)
		na, nb, changed = a, b, true
		local nw = math.max((b - a) / c.speed / len * W, 8)
		local nx = (side == "left") and (x0 + w0 - nw) or x0
		blk.Position = UDim2.new(0, nx, 0, 62)
		blk.Size = UDim2.new(0, nw, 0, 36)
		handle.Position = UDim2.new(0, (side == "left") and nx or (nx + nw - 12), 0, 62)
	end)
	input.Changed:Connect(function()
		if input.UserInputState ~= Enum.UserInputState.End then return end
		conn:Disconnect()
		if changed then
			local nc = X.aeCopyClips(A)
			nc[i].a, nc[i].b = na, nb
			X.aeClipOp(A, string.format("Trimmed clip %d", i), nc, i)
		end
	end)
end

function X.aeRun(A)
	if not loadstring then error("loadstring is not available in this executor") end
	local fn, err = loadstring(K.buildAnimCode(A.id, A.fxPrev and "all" or nil))
	if not fn then error(err) end
	task.spawn(fn)
end

--// Anim editor window -------------------------------------------------------------------------------------
function X.aeClose()
	local A = X.ae
	X.ae = nil
	if A then
		pcall(X.aeStop, A)
		pcall(function() A.win.destroy() end)
	end
end

function X.aeMoveHead(A)
	if A.headLine and A.headLine.Parent then
		A.headLine.Position = UDim2.new(math.clamp(A.head / math.max(A.len, 0.01), 0, 1), -1, 0, 0)
	end
	if A.headBox and A.headBox.Parent and not A.headBox:IsFocused() then A.headBox.Text = string.format("%.2f", A.head) end
end

function X.aeDrawBar(A)
	local bar = A.bar
	if not bar or not bar.Parent then return end
	for _, c in ipairs(bar:GetChildren()) do c:Destroy() end
	local len = math.max(A.len, 0.01)
	local function frame(px, sx, py, w, h, color, tr, z)
		local f = Instance.new("Frame")
		f.Position = UDim2.new(px, 0, 0, py)
		f.Size = UDim2.new(sx, w, 0, h)
		f.BackgroundColor3 = color
		f.BackgroundTransparency = tr or 0
		f.BorderSizePixel = 0
		f.ZIndex = z or 1
		f:SetAttribute("NoCorner", true)
		f.Parent = bar
		return f
	end
	-- the part you selected
	frame(A.a / len, 0, 0, 1, 56, C.sub, 0.3, 3)
	frame(A.b / len, 0, 0, 1, 56, C.sub, 0.3, 3)
	-- one tick per stored frame
	local first = A.tr[A.slotJ[1] or 1]
	local n = #first
	local stepN = math.max(1, math.floor(n / 300))
	for i = 1, n, stepN do frame(first[i][1] / len, 0, 40, 1, 14, C.anim, 0.4, 1) end
	-- time labels
	for k = 0, 4 do
		local tt = len * k / 4
		local l = Instance.new("TextLabel")
		l.Position = UDim2.new(k / 4, k == 4 and -44 or 3, 0, 1)
		l.Size = UDim2.fromOffset(42, 14)
		l.BackgroundTransparency = 1
		l.Text = string.format("%.2fs", tt)
		l.TextColor3 = C.sub
		l.Font = Th.font
		l.TextSize = 11
		l.TextXAlignment = k == 4 and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left
		l.ZIndex = 4
		l.Parent = bar
	end
	-- clip lane (like CapCut): tap a clip to select it, drag it to re-order, drag its edges to trim
	frame(0, 1, 59, 0, 42, C.row2, 0, 1)
	local starts, ends = X.aeLayout(A.clips)
	for i, c in ipairs(A.clips) do
		local b = Instance.new("TextButton")
		b.AutoButtonColor = false
		b.Position = UDim2.new(starts[i] / len, 1, 0, 62)
		b.Size = UDim2.new((ends[i] - starts[i]) / len, -2, 0, 36)
		b.BackgroundColor3 = (i % 2 == 1) and Color3.fromRGB(62, 110, 180) or Color3.fromRGB(86, 140, 205)
		b.BorderSizePixel = 0
		b.ZIndex = 3
		b.TextColor3 = Color3.fromRGB(255, 255, 255)
		b.Font = Th.font
		b.TextSize = 12
		b.TextWrapped = true
		b.TextTruncate = Enum.TextTruncate.AtEnd
		if #A.clips == 1 then
			b.Text = "Whole animation - move the playhead, then press Split"
		else
			b.Text = string.format("%d  (%.1fs)%s%s", i, ends[i] - starts[i], c.rev and " rev" or "", math.abs(c.speed - 1) > 1e-6 and (" x" .. tostring(c.speed)) or "")
		end
		b:SetAttribute("NoCorner", true)
		if i == A.selClip then b.Text = "> " .. b.Text end -- selected clip is marked with an arrow, not a highlight
		b.InputBegan:Connect(function(input)
			if K.isPress(input) then X.aeClipDrag(A, i, b, input) end
		end)
		b.Parent = bar
		if i == A.selClip then
			for _, side in ipairs({ "left", "right" }) do
				local h = Instance.new("TextButton")
				h.AutoButtonColor = false
				h.Text = ""
				h.Active = true
				h.BackgroundColor3 = C.sub
				h.BackgroundTransparency = 0.2
				h.BorderSizePixel = 0
				h.ZIndex = 6
				h.Size = UDim2.new(0, 12, 0, 36)
				if side == "left" then
					h.Position = UDim2.new(starts[i] / len, 1, 0, 62)
				else
					h.Position = UDim2.new(ends[i] / len, -13, 0, 62)
				end
				h:SetAttribute("NoCorner", true)
				h.InputBegan:Connect(function(input)
					if K.isPress(input) then X.aeClipTrim(A, i, side, h, b, input) end
				end)
				h.Parent = bar
			end
		end
	end
	A.headLine = frame(0, 0, 0, 2, 102, Color3.fromRGB(255, 90, 90), 0, 7)
	X.aeMoveHead(A)
end

function X.aeRefresh(A)
	if X.ae ~= A or not A.bar or not A.bar.Parent then return end
	X.aeDrawBar(A)
	local frames = #A.tr[A.slotJ[1] or 1]
	A.info.Text = string.format(
		"%.2fs  |  %d frames  |  clip %d of %d  |  loop %s  |  %s",
		A.len, frames, A.selClip, #A.clips, A.looped and "on" or "off", A.status ~= "" and A.status or "tap the timeline to place the playhead, then Split"
	)
	if not A.aBox:IsFocused() then A.aBox.Text = string.format("%.2f", A.a) end
	if not A.bBox:IsFocused() then A.bBox.Text = string.format("%.2f", A.b) end
	local u = A.ui
	u.undo.TextTransparency = #A.undo > 0 and 0 or 0.6
	u.redo.TextTransparency = #A.redo > 0 and 0 or 0.6
	u.play.Text = A.playing and "Stop" or "Play"
	K.paint(u.play, A.playing and C.danger or C.green)
	u.loop.Text = A.looped and "Loop: On" or "Loop: Off"
	K.paint(u.loop, A.looped and C.sel or C.btn)
	u.fx.Text = A.fxOn and "FX follow edits: On" or "FX follow edits: Off"
	K.paint(u.fx, A.fxOn and C.sel or C.btn)
	u.fxp.Text = A.fxPrev and "Preview FX: On" or "Preview FX: Off"
	K.paint(u.fxp, A.fxPrev and C.sel or C.btn)
end

function X.aeOpen(id)
	if not details[id] then
		out("Capturing the frames for the Anim Editor...")
		requestDetail(id, function(ok, res)
			if ok then X.aeOpen(id) else out("Anim Editor: " .. tostring(res)) end
		end)
		return
	end
	local old = X.aeData[id]
	if old and old.d ~= details[id] then X.aeData[id] = nil end
	local A = X.aeInit(id)
	X.aeClose()
	local win = createWindow({
		title = "Anim Editor - " .. K.animName(id),
		size = Vector2.new(500, 470),
		pos = UDim2.new(0.5, -250, 0.5, -235),
		minSize = Vector2.new(300, 260),
		miniText = "AE",
		onClose = function()
			pcall(X.aeStop, A)
			if X.ae == A then X.ae = nil end
		end,
	})
	A.win = win
	A.ui = {}
	X.ae = A
	local content = win.content

	-- toolbar
	local tb = X.mkBar(content, 6, 34)
	A.ui.undo = X.mkTool(tb, "Undo", 54, C.btn, function() X.aeUndo(A) end)
	A.ui.redo = X.mkTool(tb, "Redo", 54, C.btn, function() X.aeRedo(A) end)
	A.ui.play = X.mkTool(tb, "Play", 60, C.green, function() X.aePlay(A) end)
	X.mkTool(tb, "Split", 56, C.sel, function() X.aeSplit(A) end)
	X.mkTool(tb, "Del clip", 66, C.danger, function() X.aeDelClip(A) end)
	A.ui.loop = X.mkTool(tb, "Loop: Off", 84, C.btn, function()
		X.aeDo(A, A.looped and "Loop turned off" or "Loop turned on", A.tr, not A.looped, nil, { A.a, A.b })
	end)
	X.mkTool(tb, "Reset all", 70, C.btn, function() X.aeResetAll(A) end)
	X.mkTool(tb, "Run on me", 80, C.btn, function(b)
		X.aeRun(A)
		K.flash(b, "Ran!")
	end)
	X.mkTool(tb, "Copy Frames", 88, C.sel, function(b) X.copyAnim(id, false, b, "Copy Frames") end)
	X.mkTool(tb, "Copy Everything", 110, C.sel, function(b) X.copyAnim(id, "all", b, "Copy Everything") end)
	X.mkTool(tb, "FX Editor", 76, C.btn, function() X.edOpen(id) end)

	-- timeline: tap or drag to move the red playhead; the blue part is your selection
	local bar = Instance.new("Frame")
	bar.Position = UDim2.new(0, 6, 0, 46)
	bar.Size = UDim2.new(1, -12, 0, 104)
	bar.BackgroundColor3 = C.code
	bar.BorderSizePixel = 0
	bar.Active = true
	bar.Parent = content
	A.bar = bar
	bar.InputBegan:Connect(function(input)
		if not K.isPress(input) then return end
		local function setFrom(pos)
			local rel = (pos.X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1)
			if A.playing then X.aeStop(A) end
			A.head = math.clamp(rel, 0, 1) * A.len
			X.aeMoveHead(A)
			X.aePose(A, A.head)
		end
		setFrom(input.Position)
		local conn = UserInputService.InputChanged:Connect(function(i2)
			if isMove(i2) then setFrom(i2.Position) end
		end)
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then conn:Disconnect() end
		end)
	end)

	local info = Instance.new("TextLabel")
	info.Position = UDim2.new(0, 8, 0, 152)
	info.Size = UDim2.new(1, -16, 0, 18)
	info.BackgroundTransparency = 1
	info.TextColor3 = C.sub
	info.Font = Th.font
	info.TextSize = 14
	info.TextXAlignment = Enum.TextXAlignment.Left
	info.TextTruncate = Enum.TextTruncate.AtEnd
	info.Parent = content
	A.info = info

	-- selection + playhead controls
	local rb = X.mkBar(content, 172, 34)
	X.mkLabel(rb, "Start", 36)
	A.aBox = X.mkBox(rb, 58, "0")
	X.mkTool(rb, "Set [", 52, C.btn, function()
		A.a = math.min(A.head, A.b - 0.02)
		X.aeRefresh(A)
	end)
	X.mkLabel(rb, "End", 28)
	A.bBox = X.mkBox(rb, 58, "0")
	X.mkTool(rb, "Set ]", 52, C.btn, function()
		A.b = math.max(A.head, A.a + 0.02)
		X.aeRefresh(A)
	end)
	X.mkTool(rb, "All", 40, C.btn, function()
		A.a, A.b = 0, A.len
		X.aeRefresh(A)
	end)
	X.mkLabel(rb, "Head", 36)
	A.headBox = X.mkBox(rb, 58, "0")
	X.mkTool(rb, "-1f", 40, C.btn, function()
		A.head = math.max(A.head - X.aeFrame, 0)
		X.aeMoveHead(A)
		X.aePose(A, A.head)
	end)
	X.mkTool(rb, "+1f", 40, C.btn, function()
		A.head = math.min(A.head + X.aeFrame, A.len)
		X.aeMoveHead(A)
		X.aePose(A, A.head)
	end)
	A.aBox.FocusLost:Connect(function()
		local v = tonumber(A.aBox.Text)
		if v then A.a = math.clamp(v, 0, A.b - 0.02) end
		X.aeRefresh(A)
	end)
	A.bBox.FocusLost:Connect(function()
		local v = tonumber(A.bBox.Text)
		if v then A.b = math.clamp(v, A.a + 0.02, A.len) end
		X.aeRefresh(A)
	end)
	A.headBox.FocusLost:Connect(function()
		local v = tonumber(A.headBox.Text)
		if v then
			A.head = math.clamp(v, 0, A.len)
			X.aePose(A, A.head)
		end
		X.aeMoveHead(A)
	end)

	-- tool tabs: one group at a time keeps the editor tidy
	A.tabs = {}
	local tabBtns = {}
	local function showTab(name)
		A.tab = name
		for tn, items in pairs(A.tabs) do
			for _, o in ipairs(items) do o.Visible = (tn == name) end
		end
		for tn, b in pairs(tabBtns) do K.paint(b, tn == name and C.sel or C.btn) end
	end
	local tabBar = X.mkBar(content, 210, 34)
	for _, tn in ipairs({ "Clips", "Cut", "Speed", "Direction", "Effects" }) do
		tabBtns[tn] = X.mkTool(tabBar, tn, 76, C.btn, function() showTab(tn) end)
