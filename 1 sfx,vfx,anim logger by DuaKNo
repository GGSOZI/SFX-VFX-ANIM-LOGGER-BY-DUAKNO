local MAX_ENTRIES = 150
local POLL_RATE = 0.1 -- seconds between animation checks (every frame while something is blocked)
local CAPTURE_STEP = 1 / 30 -- Detailed capture sample interval

--// State
local paused = false
local ownOnly = false
local uniqueOnly = false
local detailedMode = false
