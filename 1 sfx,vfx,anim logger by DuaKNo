function X.pvWatch(on, P)
	P = P or X.pv
	local cam = workspace.CurrentCamera
	if not P or not cam then return end
	if on then
		P.oldSubject = cam.CameraSubject
		cam.CameraSubject = P.hum
		P.watching = true
	else
		local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
		cam.CameraSubject = (P.oldSubject and P.oldSubject.Parent) and P.oldSubject or hum
		P.watching = false
