X.FXOK = {
	ParticleEmitter = true, Fire = true, Smoke = true, Sparkles = true,
	PointLight = true, SpotLight = true, SurfaceLight = true, Highlight = true,
}

-- Guess the effects that belong to an animation that was never seen playing:
-- everything in the same Tool / Model / folder as its Animation object, plus effects and
-- sounds in ReplicatedStorage whose name (or parent folder name) matches the animation name.
function X.relatedFX(e)
	local out, seen = {}, {}
	local function consider(d)
		if #out >= 60 or seen[d] then return end
		seen[d] = true
		local cls = d.ClassName
		if cls == "Sound" then
			if d.SoundId == "" then return end
			local ok, ev = pcall(buildSFXEvent, d, nil, 0)
			if ok and ev then
				ev.pos = true
				out[#out + 1] = ev
			end
		elseif X.FXOK[cls] then
			local ok, ev = pcall(buildVFXEvent, d, nil, tonumber(d:GetAttribute("EmitDelay")) or 0)
			if ok and ev then
				ev.mount = { cf = CFrame.new() } -- at your character
				out[#out + 1] = ev
			end
		end
	end

	local roots = {}
	local inst = e.inst
	if inst then
		local c = inst:FindFirstAncestorWhichIsA("Tool") or inst:FindFirstAncestorOfClass("Model")
		if c then roots[#roots + 1] = c end
		local p = inst.Parent
		if p and p.Parent and p.Parent ~= game and p ~= c then roots[#roots + 1] = p end
	end
	for _, r in ipairs(roots) do
		local n = 0
		for _, d in ipairs(r:GetDescendants()) do
			n += 1
			if n > 3000 then break end
			consider(d)
		end
	end

	local full = tostring(e.name or ""):lower():gsub("[^%w]", "")
	local tokens = {}
	if #full >= 3 then tokens[1] = full end
	for w in tostring(e.name or ""):gmatch("%u?%l+") do
		if #w >= 5 then tokens[#tokens + 1] = w:lower() end
	end
	if #tokens > 0 then
		local rs = game:GetService("ReplicatedStorage")
		local n = 0
		for _, d in ipairs(rs:GetDescendants()) do
			n += 1
			if n > 40000 then break end
			if d.ClassName == "Sound" or X.FXOK[d.ClassName] then
				local hay, p = d.Name:lower(), d.Parent
				for _ = 1, 3 do
					if p and p ~= rs then
						hay = hay .. " " .. p.Name:lower()
						p = p.Parent
					end
				end
				for _, t in ipairs(tokens) do
					if hay:find(t, 1, true) then
						consider(d)
						break
					end
				end
			end
		end
	end
	return out
end

function X.prepareFX(e)
	if fxWindows.related[e.id] then return end
	local ok, list = pcall(X.relatedFX, e)
	fxWindows.related[e.id] = (ok and list) or {}
end

-- play an animation on your own character while recording the FX the game triggers
function X.capture(id, btn)
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if not animator then error("no animator on your character") end
	btn.Text = "Loading..."
	task.spawn(function()
		local anim = Instance.new("Animation")
		anim.AnimationId = id
		local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
		local function fail()
			if btn.Parent then btn.Text = "Fail" end
			task.delay(1.5, function() if btn.Parent then btn.Text = "Capture" end end)
		end
		if not ok or not track then return fail() end
		ownTracks[track] = true
		local waited = 0
		while track.Length == 0 and waited < 4 do waited += RunService.Heartbeat:Wait() end
		if track.Length == 0 then return fail() end
		openFXWindow(id, animator, track)
		track:Play()
		if btn.Parent then btn.Text = "Recording..." end
		task.wait(track.Length + FX_POST + 0.6)
		if btn.Parent then btn.Text = "Done" end
		task.delay(1.5, function() if btn.Parent then btn.Text = "Capture" end end)
	end)
end

function X.searchActions(e)
	local id = e.id
	local function frameBtn(text, withFX, w)
		return act(text, function(btn)
			local function finish()
				if withFX then X.prepareFX(e) end
				local okC, code = pcall(buildAnimCode, id, withFX)
				if okC then
					toClip(code, "the frame-by-frame script")
					btn.Text = "Copied!"
				else
					out("Failed: " .. tostring(code))
					btn.Text = "Fail"
				end
				task.delay(1.5, function() if btn.Parent then btn.Text = text end end)
			end
			if details[id] then return finish() end
			btn.Text = "Working..."
			requestDetail(id, function(ok, res)
				if not btn.Parent then return end
				if ok then
					finish()
				else
					out("Frame-by-frame failed: " .. tostring(res))
					btn.Text = "Fail"
					task.delay(1.5, function() if btn.Parent then btn.Text = text end end)
				end
			end, function(t) if btn.Parent then btn.Text = t:sub(1, 16) end end)
		end, C.sel, 1, w)
	end
	return {
		frameBtn("Copy", false, 1),
		frameBtn("Full+FX", true, 1.3),
		act("Preview", function() X.pvOpen(id, e) end, C.green, 1, 1),
		act("VIEW FULL CODE", function()
			X.prepareFX(e)
			openAnimViewer(id)
		end, C.sel, 1, 2.2),
		act("Capture", function(btn) X.capture(id, btn) end, nil, 2),
		runAct(function() playAnim(id) end, 2, 1),
		copyAct("Code", function() return simpleCode(id) end, "the AnimationId script", 2),
		copyAct("ID", function() return id end, "the AnimationId", 2),
	}
end

function X.addRow(e)
	local id = e.id
	animLabel[id] = animLabel[id] or e.name
	animInfo[id] = animInfo[id] or { priority = "Action", looped = false, speed = 1 }
	local detail = id .. "\n" .. e.path
	if #e.alt > 0 then detail = detail .. "\nAlso named: " .. table.concat(e.alt, ", ") end
	local ent = addEntry("Search", id, e.name, detail, id, X.searchActions(e), C.anim)
	if ent then
		entriesById[id] = entriesById[id] or {}
		table.insert(entriesById[id], ent)
		refreshExtra(id)
	end
end

function X.more()
	local list = lists.Search
	local old = list:FindFirstChild("MoreBtn")
	if old then old:Destroy() end
	local to = math.min(X.shown + X.PAGE, #X.matches)
	for i = X.shown + 1, to do X.addRow(X.matches[i]) end
	X.shown = to
	X.sInfo.Text = string.format("%d of %d animations match - showing %d", #X.matches, #X.db, X.shown)
	if X.shown < #X.matches then
		local b = newButton(list, string.format("Show more (%d left)", #X.matches - X.shown), C.btn)
		b.Name = "MoreBtn"
		b.Size = UDim2.new(1, -6, 0, 34)
		b.LayoutOrder = 1000000
		b.MouseButton1Click:Connect(X.more)
	end
end

function X.render()
	if not X.db then
		X.sInfo.Text = "Press Scan game to list every animation in this game."
		return
	end
	local tokens = {}
	for w in X.sBox.Text:lower():gmatch("%S+") do tokens[#tokens + 1] = w end
	local matches = {}
	for _, e in ipairs(X.db) do
		local ok = true
		for _, t in ipairs(tokens) do
			if not e.hay:find(t, 1, true) then
				ok = false
				break
			end
		end
		if ok then matches[#matches + 1] = e end
	end
	X.matches, X.shown = matches, 0
	clearKind("Search")
	X.more()
end

function X.scan()
	if X.scanning then return end
	X.scanning = true
	X.sScan.Text = "Scanning..."
	X.sInfo.Text = "Scanning the whole game for animations..."
	local db, byId, count = {}, {}, 0
	local function add(id, name, path, inst)
		if type(id) ~= "string" or id == "" or not id:find("%d") or id == "rbxassetid://0" then return end
		local e = byId[id]
		if e then
			if name ~= e.name and #e.alt < 8 and not table.find(e.alt, name) then e.alt[#e.alt + 1] = name end
			if not e.inst and inst then e.inst = inst end
			return
		end
		e = { id = id, name = (name ~= "" and name) or "(unnamed)", path = path or "?", inst = inst, alt = {} }
		byId[id] = e
		db[#db + 1] = e
	end
	local function visit(list)
		for _, d in ipairs(list) do
			count += 1
			if count % 2000 == 0 then task.wait() end
			if d.ClassName == "Animation" then
				pcall(function() add(d.AnimationId, d.Name, d:GetFullName(), d) end)
			end
		end
	end
	local ok, err = pcall(function()
		local done = false
		if getinstances then done = pcall(function() visit(getinstances()) end) end
		if not done then
			visit(game:GetDescendants())
			if getnilinstances then
				for _, n in ipairs(getnilinstances()) do
					if n.ClassName == "Animation" then add(n.AnimationId, n.Name, "(nil) " .. n.Name, n) end
					pcall(function() visit(n:GetDescendants()) end)
				end
			end
		end
		for id, label in pairs(animLabel) do add(id, label, "(seen playing in this session)", nil) end
		for _, e in ipairs(db) do
			e.hay = (e.name .. " " .. e.path .. " " .. e.id .. " " .. table.concat(e.alt, " ")):lower()
		end
		table.sort(db, function(a, b) return a.name:lower() < b.name:lower() end)
	end)
	X.scanning = false
	if X.sScan.Parent then X.sScan.Text = "Rescan" end
	if not ok then
		X.sInfo.Text = "Scan failed: " .. tostring(err)
		return
	end
	X.db = db
	X.render()
end

