local outBox
local function out(text)
	text = tostring(text)
	if outBox then outBox.Text = #text > 150000 and text:sub(1, 150000) or text end
	local first = text:match("^[^\n]*") or text
	statusLbl.Text = #first > 140 and (first:sub(1, 140) .. "...") or first
end

local function toClip(text, what)
	text = Clip.stamp(text)
	local copied = Clip.set(text)
	if outBox then outBox.Text = #text > 150000 and text:sub(1, 150000) or text end
	statusLbl.Text = copied
		and string.format("Copied %s to the clipboard (%d characters).", what or "text", #text)
		or "No clipboard in this executor - the text is in the Console tab."
	return copied
end

