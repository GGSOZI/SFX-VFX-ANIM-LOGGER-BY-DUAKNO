		b.BackgroundColor3 = baseColor[b]:Lerp(Color3.new(1, 1, 1), 0.12)
	end)
	b.MouseLeave:Connect(function()
		b.BackgroundColor3 = baseColor[b]
	end)
	b.Parent = parent
	return b
end

function K.flash(btn, text)
	local old = btn.Text
	btn.Text = text
	task.delay(1, function()
		if btn.Parent then btn.Text = old end
	end)
end

function K.isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function isMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
end

local function makeDraggable(target, handle, onClick, conns)
	local dragging, startMouse, startPos, moved = false, nil, nil, false
	handle.InputBegan:Connect(function(input)
		if K.isPress(input) then
			dragging, moved = true, false
			startMouse, startPos = input.Position, target.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					if not moved and onClick then onClick() end
				end
			end)
		end
	end)
	table.insert(conns, UserInputService.InputChanged:Connect(function(input)
		if dragging and isMove(input) then
			local d = input.Position - startMouse
			if math.abs(d.X) + math.abs(d.Y) > 5 then moved = true end
			target.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + d.X,
				startPos.Y.Scale, startPos.Y.Offset + d.Y
			)
		end
	end))
end

-- opts: title, size (Vector2), pos (UDim2), minSize (Vector2), miniText, onClose, startMinimized
local function createWindow(opts)
	local win, conns = {}, {}

	-- keep the window inside the screen (small phones): clamp size, minSize and re-centre
	do
		local vp = X.viewSize()
		local sc = X.guiScale()
		local maxW, maxH = math.max((vp.X - 16) / sc, 200), math.max(vp.Y * 0.8 / sc, 180)
		local ow, oh = opts.size.X, opts.size.Y
		local nw, nh = math.min(ow, maxW), math.min(oh, maxH)
		if nw ~= ow or nh ~= oh then
			local p = opts.pos
			local px, py = p.X, p.Y
			if px.Scale == 0.5 then px = UDim.new(0.5, px.Offset + ow / 2 - nw / 2) end
			if py.Scale == 0.5 then py = UDim.new(0.5, py.Offset + oh / 2 - nh / 2) end
			opts.pos = UDim2.new(px.Scale, px.Offset, py.Scale, py.Offset)
			opts.size = Vector2.new(nw, nh)
		end
		if sc ~= 1 then -- a scaled window is bigger/smaller on screen: keep centred windows centred
			local p = opts.pos
			local px, py = p.X, p.Y
			if px.Scale == 0.5 then px = UDim.new(0.5, px.Offset + opts.size.X * (1 - sc) / 2) end
			if py.Scale == 0.5 then py = UDim.new(0.5, py.Offset + opts.size.Y * (1 - sc) / 2) end
			opts.pos = UDim2.new(px.Scale, px.Offset, py.Scale, py.Offset)
		end
		if opts.minSize then
			opts.minSize = Vector2.new(math.min(opts.minSize.X, nw), math.min(opts.minSize.Y, nh))
		end
	end

	local frame = Instance.new("Frame")
	frame.Name = opts.title
	frame:SetAttribute("WinCorner", true)
	frame.Size = UDim2.fromOffset(opts.size.X, opts.size.Y)
	frame.Position = opts.pos
	frame.BackgroundColor3 = C.win
	frame.BorderSizePixel = 0
	frame.ClipsDescendants = true
	frame.Active = true
	frame.Parent = gui
	local fscale = Instance.new("UIScale")
	fscale.Name = "AVLScale"
	fscale.Scale = X.guiScale()
	fscale.Parent = frame
	local stroke = Instance.new("UIStroke")
	stroke.Color = C.outline
	stroke.Thickness = 1
	stroke.Parent = frame

	local titleBar = Instance.new("Frame")
	titleBar.Size = UDim2.new(1, 0, 0, 28)
	titleBar:SetAttribute("NoCorner", true)
	titleBar.BackgroundColor3 = C.title
	titleBar.BorderSizePixel = 0
	titleBar.Parent = frame

	local titleLbl = Instance.new("TextLabel")
	titleLbl.Position = UDim2.new(0, 8, 0, 0)
	titleLbl.Size = UDim2.new(1, -72, 1, 0)
	titleLbl.BackgroundTransparency = 1
	titleLbl.Text = opts.title
	titleLbl.TextColor3 = C.text
	titleLbl.Font = Th.bold
	titleLbl.TextSize = 16
	titleLbl.TextXAlignment = Enum.TextXAlignment.Left
	titleLbl.TextTruncate = Enum.TextTruncate.AtEnd
	titleLbl.Parent = titleBar

	local minBtn = K.newButton(titleBar, "-", C.title)
	minBtn.Size = UDim2.new(0, 28, 0, 28)
	minBtn.Position = UDim2.new(1, -56, 0, 0)
	minBtn.TextSize = 18

	local closeBtn = K.newButton(titleBar, "X", C.title)
	closeBtn.Size = UDim2.new(0, 28, 0, 28)
	closeBtn.Position = UDim2.new(1, -28, 0, 0)

	local content = Instance.new("Frame")
	content.Position = UDim2.new(0, 0, 0, 28)
	content.Size = UDim2.new(1, 0, 1, -28)
	content.BackgroundTransparency = 1
	content.Parent = frame

	-- resize grip (bottom-right)
	local grip = Instance.new("Frame")
	grip.Size = UDim2.fromOffset(16, 16)
	grip.Position = UDim2.new(1, -16, 1, -16)
	grip.BackgroundTransparency = 1
	grip.Active = true
	grip.ZIndex = 20
	grip.Parent = frame
	for _, p in ipairs({ { 12, 12 }, { 8, 12 }, { 12, 8 }, { 4, 12 }, { 8, 8 }, { 12, 4 } }) do
		local dot = Instance.new("Frame")
		dot.Size = UDim2.fromOffset(2, 2)
		dot.Position = UDim2.fromOffset(p[1], p[2])
		dot.BackgroundColor3 = C.sub
		dot.BorderSizePixel = 0
		dot:SetAttribute("NoCorner", true)
		dot.ZIndex = 21
		dot.Parent = grip
	end

	local resizing, rStart, rSize = false, nil, nil
	grip.InputBegan:Connect(function(input)
		if K.isPress(input) then
			resizing, rStart, rSize = true, input.Position, frame.AbsoluteSize / X.guiScale()
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then resizing = false end
			end)
		end
	end)
	table.insert(conns, UserInputService.InputChanged:Connect(function(input)
		if resizing and isMove(input) then
			local d = (input.Position - rStart) / X.guiScale()
			frame.Size = UDim2.fromOffset(
				math.max(opts.minSize.X, rSize.X + d.X),
				math.max(opts.minSize.Y, rSize.Y + d.Y)
			)
		end
	end))

	-- minimized square
	local mini = K.newButton(gui, opts.miniText or "+", C.title)
	mini.Size = UDim2.fromOffset(40, 40)
	mini.Font = Th.bold
	mini.TextSize = 17
	mini.Visible = false
	local mscale = Instance.new("UIScale")
	mscale.Name = "AVLScale"
	mscale.Scale = X.guiScale()
	mscale.Parent = mini
	local topMini = opts.topMini
	if topMini then mini.AnchorPoint = Vector2.new(0.5, 0) end
	local miniStroke = Instance.new("UIStroke")
	miniStroke.Color = C.outline
	miniStroke.Parent = mini

	function win.setMinimized(v)
		if v then
			mini.Position = topMini and UDim2.new(0.5, 0, 0, 2) or frame.Position
			frame.Visible = false
			mini.Visible = true
		else
			if topMini then -- always reopens in the middle of the screen
				local sc = X.guiScale()
				frame.Position = UDim2.new(0.5, -frame.Size.X.Offset * sc / 2, 0.5, -frame.Size.Y.Offset * sc / 2)
			else
				frame.Position = mini.Position
			end
			mini.Visible = false
			frame.Visible = true
		end
	end

	function win.getState()
		local pos = (frame.Visible or topMini) and frame.AbsolutePosition or mini.AbsolutePosition
		return {
			x = pos.X, y = pos.Y,
			w = frame.Size.X.Offset, h = frame.Size.Y.Offset,
			minimized = not frame.Visible,
		}
	end

	function win.destroy()
		for _, c in ipairs(conns) do c:Disconnect() end
		frame:Destroy()
		mini:Destroy()
	end

	minBtn.MouseButton1Click:Connect(function() win.setMinimized(true) end)
	closeBtn.MouseButton1Click:Connect(function()
		local function doClose()
			if opts.onClose then opts.onClose() end
			win.destroy()
		end
		if opts.confirmClose then
			X.confirm("Close the logger?", "Are you sure you want to close it? Your settings are saved. Run the script again to reopen it.", doClose)
		else
			doClose()
		end
	end)

	makeDraggable(frame, titleBar, nil, conns)
	if topMini then
		mini.MouseButton1Click:Connect(function() win.setMinimized(false) end) -- fixed square: tap to open, no dragging
	else
		makeDraggable(mini, mini, function() win.setMinimized(false) end, conns)
	end

	win.frame, win.content, win.mini = frame, content, mini
	if opts.startMinimized then win.setMinimized(true) end
	return win
end

function X.setGuiSize(name)
	if not X.GUI_FACTOR[name] then return end
	X.guiSize = name
	local sc = X.guiScale()
	local vp = X.viewSize()
	for _, o in ipairs(gui:GetChildren()) do
		local us = o:FindFirstChild("AVLScale")
		if us then
			us.Scale = sc
			if o:GetAttribute("WinCorner") then -- keep windows on the screen
				local w, h = o.Size.X.Offset, o.Size.Y.Offset
				local nw = math.min(w, math.max((vp.X - 16) / sc, 200))
				local nh = math.min(h, math.max(vp.Y * 0.8 / sc, 180))
				if nw ~= w or nh ~= h then o.Size = UDim2.fromOffset(nw, nh) end
			end
		end
	end
end

--// Lua syntax highlighting + virtualized code view ---------------------------------
local KW, BI = {}, {}
for w in ("and break do else elseif end false for function if in local nil not or repeat return then true until while continue"):gmatch("%S+") do
	KW[w] = true
end
for w in (
	"game workspace script task math string table os print warn pairs ipairs pcall error type typeof tostring "
	.. "tonumber select next require loadstring getgenv setmetatable getmetatable rawget rawset unpack Instance "
	.. "CFrame Vector3 Vector2 Color3 Enum NumberRange NumberSequence NumberSequenceKeypoint ColorSequence "
	.. "ColorSequenceKeypoint UDim UDim2 TweenInfo RaycastParams Random BrickColor Ray Rect _G"
):gmatch("%S+") do
	BI[w] = true
end

local HL = { kw = "#f86d7c", str = "#adf195", num = "#ffc600", com = "#666666", bi = "#84d6f7", fn = "#fdfbac" }

local function highlightLine(line)
	local out, plain, i, n = {}, {}, 1, #line
	local function flushPlain()
		if #plain > 0 then
			out[#out + 1] = K.esc(table.concat(plain))
			plain = {}
		end
	end
	local function tok(color, text)
		flushPlain()
		out[#out + 1] = '<font color="' .. color .. '">' .. K.esc(text) .. "</font>"
	end

	while i <= n do
		local c = line:sub(i, i)
		if c == "-" and line:sub(i + 1, i + 1) == "-" then
			tok(HL.com, line:sub(i))
			break
		elseif c == '"' or c == "'" then
			local j = i + 1
			while j <= n do
				local d = line:sub(j, j)
				if d == "\\" then
					j += 2
				elseif d == c then
					break
				else
					j += 1
				end
			end
			tok(HL.str, line:sub(i, math.min(j, n)))
			i = j + 1
		elseif c:match("%d") or (c == "-" and line:sub(i + 1, i + 1):match("%d")
			and not (i > 1 and line:sub(i - 1, i - 1):match("[%w_%)%]]"))) then
			local s = line:match("^%-?%d[%d%.]*[eE][%-+]?%d+", i) or line:match("^%-?%d[%d%.]*", i)
			tok(HL.num, s)
			i += #s
		elseif c:match("[%a_]") then
			local w = line:match("^[%a_][%w_]*", i)
			if KW[w] then
				tok(HL.kw, w)
			elseif BI[w] then
				tok(HL.bi, w)
			elseif line:match("^%s*%(", i + #w) then
				tok(HL.fn, w)
			else
				plain[#plain + 1] = w
			end
			i += #w
		else
			plain[#plain + 1] = c
			i += 1
		end
	end
	flushPlain()
	return table.concat(out)
end

local CODE_TEXT_SIZE, LINE_H = 15, 18
local CHAR_W = 8
pcall(function()
	CHAR_W = TextService:GetTextSize("0000000000", CODE_TEXT_SIZE, Enum.Font.Code, Vector2.new(10000, 100)).X / 10
end)

local function splitLines(code)
	local out = {}
	for line in (code .. "\n"):gmatch("(.-)\r?\n") do out[#out + 1] = (line:gsub("\t", "    ")) end
	return out
end

-- Only the visible lines are ever created/highlighted, so even huge scripts open instantly.
local function createCodeView(parent, position, size)
	local view = {}
	local sf = Instance.new("ScrollingFrame")
	sf.Position, sf.Size = position, size
	sf.BackgroundColor3 = C.code
	sf.BorderSizePixel = 0
	sf.ScrollBarThickness = 16
	sf.ElasticBehavior = Enum.ElasticBehavior.Never
	sf.ScrollingEnabled = true
	sf.Active = true
	sf.CanvasSize = UDim2.new()
	sf.ScrollingDirection = Enum.ScrollingDirection.XY
	sf.Parent = parent
	view.frame = sf

	local lines, cache, pool = {}, {}, {}

	local function lineText(i)
		local c = cache[i]
		if not c then
			local ok, hl = pcall(highlightLine, lines[i])
			if not ok or type(hl) ~= "string" then
				hl = tostring(lines[i]):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
			end
			c = string.format('<font color="#6b6b6b">%5d</font>  %s', i, hl)
			cache[i] = c
		end
		return c
	end

	local function refresh()
		local total = #lines
		local first = math.max(math.floor(sf.CanvasPosition.Y / LINE_H), 0) + 1
		local visible = math.min(math.max(math.ceil(sf.AbsoluteSize.Y / LINE_H) + 2, 45), 120)
		while #pool < visible do
			local lbl = Instance.new("TextLabel")
			lbl.BackgroundTransparency = 1
			lbl.RichText = true
			lbl.TextWrapped = false
			lbl.Font = Enum.Font.Code
			lbl.TextSize = CODE_TEXT_SIZE
			lbl.TextColor3 = Color3.fromRGB(204, 204, 204)
			lbl.TextXAlignment = Enum.TextXAlignment.Left
			lbl.TextYAlignment = Enum.TextYAlignment.Top
			lbl.Active = false -- let drags/wheel reach the ScrollingFrame
			lbl.Size = UDim2.fromOffset(sf.CanvasSize.X.Offset, LINE_H)
			lbl.Visible = false
			lbl.Parent = sf
			pool[#pool + 1] = lbl
		end
		for k, lbl in ipairs(pool) do
			local idx = first + k - 1
			if k <= visible and idx <= total then
				if lbl:GetAttribute("L") ~= idx then
					lbl:SetAttribute("L", idx)
					lbl.Text = lineText(idx)
					lbl.Position = UDim2.fromOffset(4, (idx - 1) * LINE_H + 4)
				end
				lbl.Visible = true
			else
				lbl.Visible = false
			end
		end
	end

	sf:GetPropertyChangedSignal("CanvasPosition"):Connect(refresh)
	sf:GetPropertyChangedSignal("AbsoluteSize"):Connect(refresh)

	function view.setCode(code)
		view.code = code
		lines = splitLines(code)
		table.clear(cache)
		local maxLen = 0
		for _, l in ipairs(lines) do
			if #l > maxLen then maxLen = #l end
		end
		local w = (maxLen + 8) * CHAR_W + 40
		sf.CanvasSize = UDim2.fromOffset(w, #lines * LINE_H + 12)
		for _, lbl in ipairs(pool) do
			lbl:SetAttribute("L", nil)
			lbl.Size = UDim2.fromOffset(w, LINE_H)
		end
		sf.CanvasPosition = Vector2.zero
		refresh()
		task.defer(refresh)
		return #lines
	end

	-- plain-text fallback: always works, even if rich text rendering misbehaves
	function view.showRaw(code)
		for _, lbl in ipairs(pool) do lbl.Visible = false end
		if not view.rawBox then
			local tb = Instance.new("TextBox")
			tb.Size = UDim2.new(1, 0, 1, 0)
			tb.BackgroundColor3 = C.code
			tb.BorderSizePixel = 0
			tb.ClearTextOnFocus = false
			tb.MultiLine = true
			tb.TextEditable = false
			tb.TextWrapped = false
			tb.Font = Enum.Font.Code
			tb.TextSize = CODE_TEXT_SIZE
			tb.TextColor3 = Color3.fromRGB(204, 204, 204)
			tb.TextXAlignment = Enum.TextXAlignment.Left
			tb.TextYAlignment = Enum.TextYAlignment.Top
			tb.ZIndex = 5
			tb.Parent = parent
			view.rawBox = tb
		end
		view.rawBox.Position, view.rawBox.Size = sf.Position, sf.Size
		view.rawBox.Text = #code > 190000 and code:sub(1, 190000) or code
		view.rawBox.Visible = true
	end
	function view.hideRaw()
		if view.rawBox then view.rawBox.Visible = false end
	end

	return view
end

