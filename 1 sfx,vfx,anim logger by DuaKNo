local selectedRow

-- actions = { { text=, color=, fn=function(btn) end, state=function() return text, on end }, ... }
local function addEntry(kind, key, title, detail, copyText, actions, titleColor)
	if not Run.alive or (paused and kind ~= "Search") then return end
	if uniqueOnly then
		if seenKeys[kind][key] then return end
		seenKeys[kind][key] = true
	end

	counter += 1

	local log = exportLog[kind]
	table.insert(log, { title = title, detail = detail, copy = copyText })
	if #log > MAX_EXPORT then table.remove(log, 1) end

	local base = counter % 2 == 0 and C.row1 or C.row2
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -6, 0, 0)
	row.AutomaticSize = Enum.AutomaticSize.Y
	row.BackgroundColor3 = base
	row.BorderSizePixel = 0
	row.LayoutOrder = kind == "Search" and counter or -counter -- newest on top (search: in order)
	rowBase[row] = base
	searchOf[row] = (title .. " " .. detail):lower()
	row.Parent = lists[kind]
	local rowLayout = Instance.new("UIListLayout")
	rowLayout.Padding = UDim.new(0, 4)
	rowLayout.SortOrder = Enum.SortOrder.LayoutOrder
	rowLayout.Parent = row
	local rowPad = Instance.new("UIPadding")
	rowPad.PaddingBottom = UDim.new(0, 5)
	rowPad.Parent = row

	local label = Instance.new("TextButton")
	label.AutoButtonColor = false
	label.Size = UDim2.new(1, 0, 0, 0)
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.BackgroundTransparency = 1
	label.RichText = true
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.Font = Th.font
	label.TextSize = 16
	label.TextColor3 = C.text
	label.LayoutOrder = 1
	local labelPad = Instance.new("UIPadding")
	labelPad.PaddingLeft = UDim.new(0, 6)
	labelPad.PaddingTop = UDim.new(0, 4)
	labelPad.Parent = label
	label.Parent = row

	label.MouseButton1Click:Connect(function()
		if selectedRow and selectedRow.Parent then selectedRow.BackgroundColor3 = rowBase[selectedRow] end
		selectedRow = row
		row.BackgroundColor3 = C.sel
	end)

	local lastExtra
	local lineFrames = {}
	local function render(extra)
		lastExtra = extra
		local tcol = K.hex(titleColor and Th.remap(titleColor) or C.text)
		local text
		if X.compact then
			local first = detail:match("^[^\n]*") or detail
			text = string.format('<font color="%s"><b>%s</b></font>  <font color="%s">%s</font>', tcol, K.esc(title), K.hex(C.sub), K.esc(first))
		else
			text = string.format(
				'<font color="%s"><b>%s</b></font>\n<font color="%s">%s</font>',
				tcol, K.esc(title), K.hex(C.sub), K.esc(detail)
			)
			if extra then
				text ..= string.format('\n<font color="#8fd3ff">%s</font>', K.esc(extra))
			end
		end
		label.TextWrapped = not X.compact
		label.TextTruncate = X.compact and Enum.TextTruncate.AtEnd or Enum.TextTruncate.None
		label.Text = text
		for ln, f in pairs(lineFrames) do f.Visible = (not X.compact) or ln == 1 end
	end
	render()
	table.insert(Th.rerender, function()
		if not label.Parent then return false end
		render(lastExtra)
		return true
	end)

	local btnHost = Instance.new("Frame")
	btnHost.Size = UDim2.new(1, -8, 0, 0)
	btnHost.AutomaticSize = Enum.AutomaticSize.Y
	btnHost.BackgroundTransparency = 1
	btnHost.LayoutOrder = 2
	btnHost.Parent = row
	local hostLayout = Instance.new("UIListLayout")
	hostLayout.Padding = UDim.new(0, 4)
	hostLayout.SortOrder = Enum.SortOrder.LayoutOrder
	hostLayout.Parent = btnHost
	local hostPad = Instance.new("UIPadding")
	hostPad.PaddingLeft = UDim.new(0, 6)
	hostPad.Parent = btnHost

	-- group the actions into button lines; line 1 holds the important buttons
	local groups, lineNos = {}, {}
	for _, a in ipairs(actions) do
		local ln = a.line or 1
		if not groups[ln] then
			groups[ln] = {}
			lineNos[#lineNos + 1] = ln
		end
		table.insert(groups[ln], a)
	end
	table.sort(lineNos)

	for _, ln in ipairs(lineNos) do
		local list = groups[ln]
		local total = 0
		for _, a in ipairs(list) do total += (a.w or 1) end
		local gaps = 4 * (#list - 1)

		local lineFrame = Instance.new("Frame")
		lineFrame.Size = UDim2.new(1, 0, 0, 30)
		lineFrame.BackgroundTransparency = 1
		lineFrame.LayoutOrder = ln
		lineFrames[ln] = lineFrame
		lineFrame.Parent = btnHost
		local lineLayout = Instance.new("UIListLayout")
		lineLayout.FillDirection = Enum.FillDirection.Horizontal
		lineLayout.SortOrder = Enum.SortOrder.LayoutOrder
		lineLayout.Padding = UDim.new(0, 4)
		lineLayout.Parent = lineFrame

		for i, a in ipairs(list) do
			local frac = (a.w or 1) / total
			local b = K.newButton(lineFrame, a.text or "", a.color or C.btn)
			b.LayoutOrder = i
			b.Size = UDim2.new(frac, -gaps * frac, 1, 0)
			b.TextScaled = true
			local limit = Instance.new("UITextSizeConstraint")
			limit.MaxTextSize = 16
			limit.MinTextSize = 10
			limit.Parent = b

			if a.state then
				local function upd()
					if not b.Parent then return false end
					local txt, on = a.state()
					b.Text = txt
					K.paint(b, on and C.danger or Th.remap(a.color or C.btn))
					return true
				end
				upd()
				table.insert(updaters, upd)
			end

			b.MouseButton1Click:Connect(function()
				local ok, err = pcall(a.fn, b)
				if not ok then
					out("Error: " .. tostring(err))
					K.flash(b, "Fail")
				end
			end)
		end
	end

	render(lastExtra)

	local q = queues[kind]
	table.insert(q, row)
	if #q > (kind == "Search" and 8000 or MAX_ENTRIES) then
		table.remove(q, 1):Destroy()
	end
	updateTabText(kind)
	applyFilter(kind)

	return { setExtra = function(extra) if label.Parent then render(extra) end end }
end

local function act(text, fn, color, line, w)
	return { text = text, fn = fn, color = color, line = line, w = w }
end

local function copyAct(text, getText, what, line, w)
	return act(text, function(btn)
		toClip(getText(), what)
		K.flash(btn, "Copied!")
	end, nil, line, w)
end

local function runAct(runFn, line, w)
	return act("Run", function(btn)
		local ok, err = pcall(runFn)
		if not ok then out("Run failed: " .. tostring(err)) end
		K.flash(btn, ok and "Ran!" or "Fail")
	end, C.green, line, w)
end

--// Frame-by-frame generation queue ------------------------------------------------------
local function extraFor(id)
	local parts = {}
	if details[id] then
		local ok, s = pcall(K.summaryFor, id)
		if ok then parts[#parts + 1] = s end
	elseif detailErr[id] then
		parts[#parts + 1] = "Frame-by-frame failed: " .. detailErr[id]
	end
	local fx = animFX[id]
	if fx and #fx > 0 then
		local v, s = 0, 0
		for _, e in ipairs(fx) do
			if e.kind == "vfx" then v += 1 else s += 1 end
		end
		parts[#parts + 1] = string.format("FX seen with this anim: %d VFX, %d SFX", v, s)
	end
	return #parts > 0 and table.concat(parts, "\n") or nil
end

local function refreshExtra(id)
	local text = extraFor(id)
	if not text then return end
	for _, ent in ipairs(entriesById[id] or {}) do pcall(ent.setExtra, text) end
end

local function sendProgress(id, text)
	for _, f in ipairs(progressListeners[id] or {}) do pcall(f, text) end
end

-- cb(ok, record | error); progress(text) is optional
local function requestDetail(id, cb, progress)
	if details[id] then
		if cb then cb(true, details[id]) end
		return
	end
	local savedSrc = (X.skipSaved ~= id) and (X.eds.items[id] or X.kept[id]) or nil -- your saved EDIT wins over the kept original frames
	if savedSrc and X.edsApply then -- frames kept with the saved anim: no need to load the animation in this game
		pcall(X.edsApply, id, savedSrc)
		if details[id] then
			if cb then cb(true, details[id]) end
			return
		end
	end
	if progress then
		progressListeners[id] = progressListeners[id] or {}
		table.insert(progressListeners[id], progress)
		progress("Waiting...")
	end
	local job = detailJobs[id]
	if job then
		if cb then table.insert(job, cb) end
		return
	end
	detailJobs[id] = { cb }
	table.insert(detailQueue, id)

	if detailWorking then return end
	detailWorking = true
	task.spawn(function()
		while #detailQueue > 0 do
			local nextId = table.remove(detailQueue, 1)
			local ok, res = pcall(K.captureDetail, nextId, function(t) sendProgress(nextId, t) end)
			local callbacks = detailJobs[nextId]
			detailJobs[nextId] = nil
			if ok then
				details[nextId] = res
				detailErr[nextId] = nil
				if X.origRemember then pcall(X.origRemember, nextId) end -- the game's own frames: what Reset goes back to
				sendProgress(nextId, "Simplifying frames...")
				pcall(K.simplified, nextId)
			else
				detailErr[nextId] = tostring(res)
			end
			progressListeners[nextId] = nil
			refreshExtra(nextId)
			for _, f in ipairs(callbacks or {}) do pcall(f, ok, res) end
		end
		detailWorking = false
	end)
end

local function requestRbxmx(id, cb) -- cb(ok, xmlOrError, source)
	requestDetail(id, function(ok, res)
		if not ok then return cb(false, res) end
		local cached = rbxmxCache[id]
		if cached then return cb(true, cached.xml, cached.source) end
		local okX, xml = pcall(K.rbxmxFromCapture, "Anim_" .. (id:match("%d+") or "x"), res.looped, res.priorityValue, res.allMotors)
		if not okX then return cb(false, xml) end
		rbxmxCache[id] = { xml = xml, source = "captured" }
		cb(true, xml, "captured")
	end)
end

--// FX recording (VFX / SFX that happen with an animation) ------------------------------------
-- Ways the logger makes sure nothing is missed:
--  1. a rolling buffer remembers every effect/sound near you for the last few seconds, so
--     effects that fired BEFORE the animation was detected are pulled in when it starts;
--  2. the recording window runs well past the end of the animation (late effects);
--  3. effects / sounds that are already running when the animation starts are captured too;
--  4. the deep hook sees :Emit() and :Play() calls that never change any property;
--  5. every time the animation plays, new events are MERGED into what was recorded before;
--  6. keyframe names reached during the animation are saved as a comment in the script;
--  7. optional: dormant emitters (Thorough) and effects from the same tool/folder (Related guess).
local FX_POST = 2.5 -- seconds recorded after the animation ends
fxWindows.buf = {}
fxWindows.related = {} -- [animId] = guessed events (Related FX guess / Search tab)

fxWindows.pos = function(inst)
	if inst:IsA("Model") then
		local okM, cf = pcall(inst.GetPivot, inst)
		if okM and cf then return cf.Position end
	elseif inst:IsA("Tool") or inst:IsA("Accoutrement") then
		local h = inst:FindFirstChild("Handle")
		if h and h:IsA("BasePart") then return h.Position end
	end
	local part = inst:IsA("BasePart") and inst or inst:FindFirstAncestorWhichIsA("BasePart")
	if part then return part.Position end
	local m = inst:FindFirstAncestorOfClass("Model")
	if m then
		local ok, p = pcall(m.GetPivot, m)
		if ok then return p.Position end
	end
	return nil
end

-- does this effect / sound belong to the animation that is playing on w.model?
-- Strict mode (default): never anything that sits on another character (the hit on your opponent, their sounds),
-- and only things that happen close to the animating character.
local function fxBelongs(inst, w, pos)
	if inst:IsDescendantOf(w.model) then return true end
	-- idle / run / other looping animations are always playing: they only get the character's own effects, nothing from around the map
	if w.looped and not w.cut then return false end
	if inst:IsA("GuiBase2d") then return w.model == lp.Character or w.cut == true end -- 2D things: your own moves and cutscenes
	if X.fxAll then
		if w.cut then return true end -- cutscenes keep everything that happens
		-- "everything" still leaves out what clearly is not part of the move:
		if inst:IsA("Sound") then
			local okL, lp2 = pcall(function() return inst.Looped end)
			if okL and lp2 then return false end -- ambient loops / music
		end
		local m = inst:FindFirstAncestorOfClass("Model")
		while m do -- effects and sounds of ANOTHER player
			if m ~= w.model then
				local pl = Players:GetPlayerFromCharacter(m)
				if pl then return false end
			end
			m = m.Parent and m.Parent:FindFirstAncestorOfClass("Model")
		end
		if pos == nil then pos = fxWindows.pos(inst) end
		local root = w.model:FindFirstChild("HumanoidRootPart")
		if pos ~= nil and root and (pos - root.Position).Magnitude > 120 then return false end -- too far away to be this move
		if pos == nil and inst:IsA("Sound") then
			local okT, tl = pcall(function() return inst.TimeLength end)
			if okT and tl > 12 then return false end -- long non-positional sound = music
		end
		return true
	end
	if X.strict then
		local m = inst:FindFirstAncestorOfClass("Model")
		while m do
			if m ~= w.model and m:FindFirstChildOfClass("Humanoid") then return false end
			m = m.Parent and m.Parent:FindFirstAncestorOfClass("Model")
		end
	end
	if pos == nil then pos = fxWindows.pos(inst) end
	if pos == nil then return inst:IsA("Sound") and w.model == lp.Character end
	local root = w.model:FindFirstChild("HumanoidRootPart")
	if not root then return false end
	local d = (pos - root.Position).Magnitude
	if not X.strict then return d < 60 end
	if d > 16 then return false end
	for _, p in ipairs(Players:GetPlayers()) do -- closer to somebody else than to us: it is theirs
		local ch = p.Character
		local r = ch and ch ~= w.model and ch:FindFirstChild("HumanoidRootPart")
		if r then
			local od = (pos - r.Position).Magnitude
			if od < d and od < 8 then return false end
		end
	end
	return true
end

-- when a looping effect switches off / gets destroyed, store how long it lasted
fxWindows.dur = function(inst, ev, since)
	if ev.kind ~= "vfx" or not ev.enabled or ev.dur then return end
	local function ended()
		if not ev.dur then ev.dur = math.max(os.clock() - since, 0.1) end
	end
	inst.Destroying:Connect(ended)
	pcall(function()
		inst:GetPropertyChangedSignal("Enabled"):Connect(function()
			if not inst.Enabled then ended() end
		end)
	end)
end

local function evKey(e)
	if e.kind == "cam" then return "cam|" .. tostring(e.segId or math.floor(e.t * 2 + 0.5)) end -- one camera path per cutscene
	local id = ""
	for _, p in ipairs(e.props or {}) do
		if p[1] == "SoundId" or p[1] == "Texture" then
			id = p[2]
			break
		end
	end
	local bucket = (e.emit and not e.enabled) and 20 or 2 -- bursts keep their exact timing
	return string.format("%s|%s|%s|%s|%d", e.kind, tostring(e.class), tostring(e.name), id, math.floor(e.t * bucket + 0.5))
end

-- merge lists of FX events (older list first); copies, so durations can be defaulted safely
fxWindows.merge = function(...)
	local out, seen, ncam = {}, {}, 0
	for i = 1, select("#", ...) do
		local list = select(i, ...)
		for _, e in ipairs(list or {}) do
			local k = evKey(e)
			local isCam = e.kind == "cam"
			if not seen[k] and (isCam and ncam < 16 or (not isCam and #out - ncam < 300)) and (not isCam or K.camKeep(e)) then
				seen[k] = true
				if isCam then ncam += 1 end
				local c = table.clone(e)
				if not c.dur then c.dur = c.kind == "sfx" and 3 or (c.kind == "obj" and 2.5 or (c.enabled and 1.5 or 1)) end
				if c.kind == "cam" and c.cam and #c.cam > 0 then c.dur = c.cam[#c.cam][1] end
				if c.kind == "gui" and c.gui then c.dur = math.max(c.gui.dur or 3, 0.3) end
				out[#out + 1] = c
			end
		end
	end
	table.sort(out, function(x, y) return x.t < y.t end)
	return out
end

-- everything recorded for this animation so far, including windows that are still open
fxWindows.rawFor = function(id) -- everything recorded (not edited)
	local old, rel, extra = animFX[id], fxWindows.related[id], {}
	for _, w in ipairs(fxWindows) do
		if w.id == id and #w.events > 0 then extra[#extra + 1] = w.events end
	end
	if not old and #extra == 0 and not (rel and #rel > 0) then return nil end
	return fxWindows.merge(old, rel, table.unpack(extra))
end

-- what Copy / Preview / Run use: your edits from the FX Editor if there are any, else the recording
fxWindows.liveFor = function(id)
	local src = X.fxEdit[id] or fxWindows.rawFor(id)
	if not src then return nil end
	local out = {}
	for _, e in ipairs(src) do
		if not e.off and not X.fxBlocked(e) then out[#out + 1] = e end -- OFF events and blocked VFX / SFX are left out
	end
	return #out > 0 and out or nil
end

-- an object's lifetime and (when it moves on its own) its path
fxWindows.durObj = function(inst, ev, since)
	local function ended()
		if not ev.dur then ev.dur = math.max(os.clock() - since, 0.1) end
	end
	inst.Destroying:Connect(ended)
	inst.AncestryChanged:Connect(function(_, parent)
		if not parent then ended() end
	end)
	if (ev.mount and ev.mount.part) or not ev._root0 then return end -- worn: moves with the animation
	local root0 = ev._root0
	local path = { { 0, ev.rel } }
	ev.path = path
	task.spawn(function()
		local t0 = os.clock()
		while inst.Parent and not ev.dur and os.clock() - t0 < 10 and #path < 200 do
			task.wait(0.05)
			local pv = inst.Parent and K.objPivot(inst)
			if pv then
				local rel = root0:ToObjectSpace(pv)
				if (rel.Position - path[#path][2].Position).Magnitude > 0.2 or (rel.LookVector - path[#path][2].LookVector).Magnitude > 0.1 then path[#path + 1] = { os.clock() - t0, rel } end
			end
		end
	end)
end

-- kind = "vfx" / "sfx" / "obj"; extra = fields to force on the event (e.g. the real Emit count); at = time of the call
local function recordFX(kind, inst, extra, at)
	if kind == "sfx" and tostring(inst.SoundId):find("^rbxasset://sounds/") then return end -- default Roblox sounds
	local now = at or os.clock()
	local build = kind == "vfx" and K.buildVFXEvent or (kind == "obj" and K.buildObjEvent or (kind == "gui" and K.buildGuiEvent or K.buildSFXEvent))
	local function applyExtra(ev)
		if extra then
			for k, v in pairs(extra) do ev[k] = v end
		end
	end

	-- 1) rolling history (works even when no animation is being recorded yet)
	local root = K.getRoot()
	local pos = fxWindows.pos(inst)
	if root and (X.fxAll or kind == "gui" or (pos and (pos - root.Position).Magnitude < 150) or (pos == nil and kind == "sfx")) then
		local mdl = inst:FindFirstAncestorOfClass("Model") or lp.Character
		local ok, ev = pcall(build, inst, mdl, 0)
		if ok and ev then
			applyExtra(ev)
			fxWindows.dur(inst, ev, now)
			if kind == "obj" then fxWindows.durObj(inst, ev, now) end
			local buf = fxWindows.buf
			buf[#buf + 1] = { kind = kind, ev = ev, at = now, pos = pos, inst = inst }
			while #buf > 400 or (buf[1] and now - buf[1].at > X.pre + 3) do table.remove(buf, 1) end
		end
	end

	-- 2) live recording for animations that are open right now
	if #fxWindows == 0 then return end
	for _, w in ipairs(fxWindows) do
		if now >= w.opened and now <= w.finish and fxBelongs(inst, w, pos) then
			local ok, ev = pcall(build, inst, w.model, math.max(now - w.start, 0))
			if ok and ev then
				applyExtra(ev)
				table.insert(w.events, ev)
				fxWindows.dur(inst, ev, now)
				if kind == "obj" then fxWindows.durObj(inst, ev, now) end
			end
		end
	end
end

local function finalizeFX(w)
	if w.conn then pcall(function() w.conn:Disconnect() end) end
	if w.camConn then pcall(function() w.camConn:Disconnect() end) end
	if #w.keys > 0 then
		local have = X.markers[w.id]
		if not have or #w.keys > #have then X.markers[w.id] = w.keys end
	end
	if #w.events == 0 then return end
	animFX[w.id] = fxWindows.merge(animFX[w.id], w.events)
	refreshExtra(w.id)
end

local function openFXWindow(id, animator, track)
	local model = animator:FindFirstAncestorOfClass("Model") or (animator.Parent and animator.Parent.Parent) or animator.Parent
	if not model or #fxWindows >= 20 then return end
	local now = os.clock()
	local len = math.min(math.max(track.Length, 0.5), 15)
	X.lens[id] = track.Length
	local into = 0
	pcall(function() into = math.clamp(track.TimePosition, 0, len) end)
	local w = {
		id = id, model = model, events = {}, keys = {},
		looped = track.Looped == true, cut = X.cutIds[id] == true,
		start = now - into, -- real start of the animation (we may detect it up to 0.1s late)
		opened = now,
		finish = now + math.max(len - into, 0) + (X.fxAll and 4 or FX_POST),
	}
	table.insert(fxWindows, w)
	X.lastAnim = { id = id, start = w.start }
	X.winLog[#X.winLog + 1] = { id = id, start = w.start, finish = w.finish }
	while #X.winLog > 16 do table.remove(X.winLog, 1) end
	if X.objOn then -- cutscenes that started just before / during this animation belong to it
		for _, sg in ipairs(X.camSegs) do
			if sg.start >= w.start - X.pre - 1 and sg.start <= w.finish then
				sg.attached = true
				local cl = table.clone(sg.ev)
				cl.t = math.max(sg.start - w.start, 0)
				table.insert(w.events, cl)
			end
		end
	end
	pcall(function()
		w.conn = track.KeyframeReached:Connect(function(name)
			w.keys[#w.keys + 1] = { name, os.clock() - w.start }
		end)
	end)

	-- effects / sounds that already fired before we noticed the animation
	for _, item in ipairs(fxWindows.buf) do
		if item.at >= w.start - X.pre and item.at < now and fxBelongs(item.inst, w, item.pos) then
			local ev = table.clone(item.ev)
			ev.t = math.max(item.at - w.start, 0)
			table.insert(w.events, ev)
		end
	end

	-- effects that are already running (or dormant, in Thorough mode) when the animation starts
	-- (a looping animation such as idle / run never takes the effects that were simply already on)
	local n = w.looped and 60 or 0
	for _, d in ipairs(model:GetDescendants()) do
		if n >= 60 then break end
		local cls = d.ClassName
		if d:GetAttribute("_LoggerClone") or d:GetAttribute("_Replay") then
			-- our own copies: ignore
		elseif cls == "Sound" then
			local okS, playing = pcall(function() return d.Playing and not d.Looped and d.SoundId ~= "" and not d.SoundId:find("^rbxasset://sounds/") end)
			if okS and playing then
				local ok, ev = pcall(K.buildSFXEvent, d, model, 0)
				if ok and ev then
					n += 1
					table.insert(w.events, ev)
				end
			end
		elseif VFX_CLASSES[cls] then
			local okE, en = pcall(function() return d.Enabled end)
			if okE and en then
				local ok, ev = pcall(K.buildVFXEvent, d, model, 0)
				if ok and ev then
					n += 1
					fxWindows.dur(d, ev, now)
					table.insert(w.events, ev)
				end
			elseif cls == "ParticleEmitter" and X.thorough and d:GetAttribute("EmitCount") then
				local ok, ev = pcall(K.buildVFXEvent, d, model, tonumber(d:GetAttribute("EmitDelay")) or 0)
				if ok and ev then
					n += 1
					table.insert(w.events, ev)
				end
			end
		end
	end

	task.delay(math.max(len - into, 0) + (X.fxAll and 4 or FX_POST) + 0.3, function()
		local i = table.find(fxWindows, w)
		if i then table.remove(fxWindows, i) end
		finalizeFX(w)
	end)
end

--// 2D logging: ScreenGuis / full-screen images / titles that show up while a move or cutscene plays ------------
function X.inCutscene()
	if X.camSeg then return true end
	for _, w in ipairs(fxWindows) do
		if w.cut then return true end
	end
	return false
end

function X.guiWatchStart()
	local pg = lp:WaitForChild("PlayerGui")
	local wired = setmetatable({}, { __mode = "k" })
	local pending = setmetatable({}, { __mode = "k" })
	local recent = setmetatable({}, { __mode = "k" })
	local nconn = 0
	local function keep(c)
		nconn += 1
		if nconn < 3000 then table.insert(Run.conns, c) end
		return c
	end
	local function mine(o)
		if o == gui or o:IsDescendantOf(gui) then return true end
		local sgA = o:IsA("ScreenGui") and o or o:FindFirstAncestorOfClass("ScreenGui")
		if sgA and (sgA:GetAttribute("_Replay") or sgA:GetAttribute("_LoggerClone")) then return true end
		return false
	end
	local function appeared(target)
		if not (X.gui2d and X.objOn) or pending[target] or not target.Parent then return end
		if mine(target) then return end
		local now = os.clock()
		local p = target.Parent
		for _ = 1, 8 do -- its parent was just recorded: it is part of that recording
			if not p or p == pg then break end
			if recent[p] and now - recent[p] < 1.5 then return end
			p = p.Parent
		end
		recent[target] = now
		pending[target] = true
		task.delay(0.3, function() pending[target] = nil end)
		task.defer(function() -- let the game finish setting it up
			if not target.Parent then return end
			X.guiCache[target] = nil
			pcall(recordFX, "gui", target, nil, now)
		end)
	end
	local function wire(o, depth)
		if wired[o] then return end
		wired[o] = true
		keep(o:GetPropertyChangedSignal("Visible"):Connect(function()
			if o.Visible then appeared(o) end
		end))
		if depth < 3 then
			for _, ch in ipairs(o:GetChildren()) do
				if ch:IsA("GuiObject") then wire(ch, depth + 1) end
			end
			keep(o.ChildAdded:Connect(function(ch)
				if ch:IsA("GuiObject") then
					wire(ch, depth + 1)
					appeared(ch)
				end
			end))
		end
	end
	local function wireSg(sg, fresh)
		if not sg:IsA("ScreenGui") or wired[sg] then return end
		wired[sg] = true
		keep(sg:GetPropertyChangedSignal("Enabled"):Connect(function()
			if sg.Enabled then appeared(sg) end
		end))
		for _, ch in ipairs(sg:GetChildren()) do
			if ch:IsA("GuiObject") then wire(ch, 1) end
		end
		keep(sg.ChildAdded:Connect(function(ch)
			if ch:IsA("GuiObject") then
				wire(ch, 1)
				appeared(ch)
			end
		end))
		if fresh and sg.Enabled then appeared(sg) end
	end
	for _, sg in ipairs(pg:GetChildren()) do wireSg(sg, false) end
	keep(pg.ChildAdded:Connect(function(ch) wireSg(ch, true) end))
end
