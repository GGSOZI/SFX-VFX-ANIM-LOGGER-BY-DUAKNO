local VFX_PROPS = {
	ParticleEmitter = {
		"Texture", "Rate", "Lifetime", "Speed", "Size", "Color", "Transparency", "Rotation", "RotSpeed",
		"SpreadAngle", "Acceleration", "Drag", "EmissionDirection", "LightEmission", "LightInfluence",
		"LockedToPart", "ZOffset", "Orientation", "VelocityInheritance", "TimeScale", "Squash", "Shape",
		"ShapeInOut", "ShapeStyle", "ShapePartial", "FlipbookLayout", "FlipbookMode", "FlipbookFramerate",
		"FlipbookStartRandom", "Brightness",
	},
	Beam = {
		"Texture", "TextureLength", "TextureMode", "TextureSpeed", "Color", "Transparency", "LightEmission",
		"LightInfluence", "Width0", "Width1", "Segments", "CurveSize0", "CurveSize1", "FaceCamera", "ZOffset",
	},
	Trail = {
		"Texture", "TextureLength", "TextureMode", "Color", "Transparency", "LightEmission", "LightInfluence",
		"Lifetime", "MinLength", "MaxLength", "WidthScale", "FaceCamera",
	},
	Fire = { "Color", "SecondaryColor", "Size", "Heat", "TimeScale" },
	Smoke = { "Color", "Size", "Opacity", "RiseVelocity", "TimeScale" },
	Sparkles = { "SparkleColor", "TimeScale" },
	PointLight = { "Brightness", "Color", "Range", "Shadows" },
	SpotLight = { "Brightness", "Color", "Range", "Shadows", "Angle", "Face" },
	SurfaceLight = { "Brightness", "Color", "Range", "Shadows", "Angle", "Face" },
	Highlight = { "FillColor", "FillTransparency", "OutlineColor", "OutlineTransparency", "DepthMode" },
	Explosion = { "BlastRadius", "DestroyJointRadiusPercent", "ExplosionType", "Visible" },
}
local SFX_PROPS = {
	"SoundId", "Volume", "PlaybackSpeed", "Looped", "TimePosition",
	"RollOffMode", "RollOffMinDistance", "RollOffMaxDistance",
}

local function readProps(inst, list)
	local props = {}
	for _, name in ipairs(list) do
		local ok, v = pcall(function() return inst[name] end)
		if ok then
			local l = lit(v)
			if l then props[#props + 1] = { name, l } end
		end
	end
	return props
end

local function attachMount(att, model)
	if not att then return nil end
	local part = att.Parent
	if part and part:IsA("BasePart") then
		if model and part:IsDescendantOf(model) then return { part = part.Name, cf = att.CFrame } end
		local root = model and model:FindFirstChild("HumanoidRootPart")
		local world = part.CFrame * att.CFrame
		return { part = nil, cf = root and root.CFrame:ToObjectSpace(world) or world }
	end
	return nil
end

local function mountInfo(inst, model)
	local parent = inst.Parent
	if parent and parent:IsA("Attachment") then
		return attachMount(parent, model) or { cf = CFrame.new() }
	end
	if parent and parent:IsA("BasePart") then
		if model and parent:IsDescendantOf(model) then return { part = parent.Name, cf = CFrame.new() } end
		local root = model and model:FindFirstChild("HumanoidRootPart")
		return { part = nil, cf = root and root.CFrame:ToObjectSpace(parent.CFrame) or parent.CFrame }
	end
	return { part = nil, cf = CFrame.new() }
end

local function buildVFXEvent(inst, model, t)
	local class = inst.ClassName
	local list = VFX_PROPS[class]
	if not list then return nil end
	local ev = {
		kind = "vfx", class = class, name = inst.Name, t = math.max(t or 0, 0),
		mount = mountInfo(inst, model), props = readProps(inst, list), enabled = false,
	}
	local okE, en = pcall(function() return inst.Enabled end)
	if okE then ev.enabled = en end
	if class == "ParticleEmitter" then
		ev.emit = tonumber(inst:GetAttribute("EmitCount")) or 15
		if not ev.enabled then ev.dur = inst.Lifetime.Max + 0.5 end
	elseif class == "Beam" or class == "Trail" then
		ev.att0 = attachMount(inst.Attachment0, model)
		ev.att1 = attachMount(inst.Attachment1, model)
	end
	return ev
end

local function buildSFXEvent(s, _model, t)
	local ev = {
		kind = "sfx", name = s.Name, t = math.max(t or 0, 0), props = readProps(s, SFX_PROPS),
		pos = s.Parent ~= nil and (s.Parent:IsA("BasePart") or s.Parent:IsA("Attachment")),
	}
	local len, speed = s.TimeLength, math.max(s.PlaybackSpeed, 0.1)
	if len > 0 and not s.Looped then ev.dur = len / speed end
	return ev
end

