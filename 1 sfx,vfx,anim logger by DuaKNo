		l.Font = Th.bold
		l.TextSize = 16
		l.TextXAlignment = Enum.TextXAlignment.Left
		local p = Instance.new("UIPadding")
		p.PaddingLeft = UDim.new(0, 8)
		p.Parent = l
		l.Parent = sf
	end

	local function addRow(kindColor, title, subtitle, btnText, onClick)
		order += 1
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, -6, 0, 52)
		row.BackgroundColor3 = order % 2 == 0 and C.row1 or C.row2
		row.BorderSizePixel = 0
		row.LayoutOrder = order
		row.Parent = sf

		local lbl = Instance.new("TextLabel")
		lbl.Size = UDim2.new(1, -92, 1, 0)
		lbl.BackgroundTransparency = 1
		lbl.RichText = true
		lbl.TextWrapped = true
		lbl.TextXAlignment = Enum.TextXAlignment.Left
		lbl.TextYAlignment = Enum.TextYAlignment.Top
		lbl.Font = Th.font
		lbl.TextSize = 16
		lbl.TextColor3 = C.text
		lbl.Text = string.format(
			'<font color="%s"><b>%s</b></font>\n<font color="%s">%s</font>',
			K.hex(kindColor), K.esc(title ~= "" and title or "(unnamed)"), K.hex(C.sub), K.esc(subtitle)
		)
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft = UDim.new(0, 8)
		pad.PaddingTop = UDim.new(0, 3)
		pad.Parent = lbl
		lbl.Parent = row

		local b = K.newButton(row, btnText, C.btn)
		b.Size = UDim2.new(0, 82, 0, 32)
		b.Position = UDim2.new(1, -88, 0, 10)
		b.MouseButton1Click:Connect(onClick)
	end

	local total = K.countKeys(excluded) + K.countKeys(excludedVFX) + K.countKeys(excludedSFX) + K.countKeys(blocked)
		+ K.countKeys(X.blockV) + K.countKeys(X.blockS)
	if total == 0 then
		header("Nothing excluded or blocked")
		return
	end

	order += 1
	local resetAll = K.newButton(sf, "Reset all (unexclude + unblock everything)", C.danger)
	resetAll.Size = UDim2.new(1, -6, 0, 32)
	resetAll.LayoutOrder = order
	resetAll.MouseButton1Click:Connect(function()
		table.clear(excluded)
		table.clear(excludedVFX)
		table.clear(excludedSFX)
		table.clear(blocked)
		table.clear(blockedLogged)
		table.clear(X.blockV)
		table.clear(X.blockS)
		task.spawn(function() pcall(X.blockApply) end)
		refreshAll()
	end)

	if K.countKeys(excluded) > 0 then
		header("Excluded animations (" .. K.countKeys(excluded) .. ")")
		for id in pairs(excluded) do
			addRow(C.anim, animLabel[id] or "", id, "Unexcl", function()
				excluded[id] = nil
				refreshAll()
			end)
		end
	end
	if K.countKeys(blocked) > 0 then
		header("Blocked animations (" .. K.countKeys(blocked) .. ")")
		for id in pairs(blocked) do
			addRow(C.anim, animLabel[id] or "", id, "Unblock", function()
				blocked[id] = nil
				blockedLogged[id] = nil
				refreshAll()
			end)
		end
	end
	if K.countKeys(X.blockV) > 0 then
		header("Blocked VFX (" .. K.countKeys(X.blockV) .. ")  -  switched off in-game, left out of every script")
		for key in pairs(X.blockV) do
			addRow(C.vfx, vfxLabel[key] or key, key, "Unblock", function() X.blockToggle("v", key) end)
		end
	end
	if K.countKeys(X.blockS) > 0 then
		header("Blocked SFX (" .. K.countKeys(X.blockS) .. ")  -  stopped in-game, left out of every script")
		for id in pairs(X.blockS) do
