--// Helpers
local function esc(s)
	return (tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

local function shortPath(inst)
	local parts, cur = {}, inst
	while cur and cur ~= workspace and cur ~= game do
		table.insert(parts, 1, cur.Name)
		cur = cur.Parent
	end
	if #parts > 3 then parts = { "..", parts[#parts - 2], parts[#parts - 1], parts[#parts] } end
	return table.concat(parts, ".")
end

local function isOwn(inst)
	local char = lp.Character
	return char ~= nil and inst:IsDescendantOf(char)
end

local function fmtColor(c)
	return string.format("%d,%d,%d", c.R * 255, c.G * 255, c.B * 255)
end

local function countKeys(t)
	local n = 0
	for _ in pairs(t) do n += 1 end
	return n
end

--// Re-run helpers (play an animation / spawn a VFX on your own character)
local function getRoot()
	local char = lp.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function playAnim(id)
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then error("no humanoid") end
	local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
	local a = Instance.new("Animation")
	a.AnimationId = id
	local track = animator:LoadAnimation(a)
	ownTracks[track] = true
	track:Play()
end

local function playVFX(inst)
	local root = getRoot()
	if not root then error("no root") end
	local clone = inst:Clone()
	if not clone then error("clone failed") end
	clone:SetAttribute("_LoggerClone", true)
	for _, d in ipairs(clone:GetDescendants()) do d:SetAttribute("_LoggerClone", true) end

	local cls = clone.ClassName
	local life = 5
	if cls == "ParticleEmitter" then
		clone.Enabled = false
		clone.Parent = root
		clone:Emit(math.max(clone.Rate, 20))
		life = clone.Lifetime.Max + 1
	elseif cls == "Beam" then
		local a0 = Instance.new("Attachment", root)
		local a1 = Instance.new("Attachment", root)
		a1.Position = Vector3.new(0, 0, -10)
		a0:SetAttribute("_LoggerClone", true)
		a1:SetAttribute("_LoggerClone", true)
		clone.Attachment0, clone.Attachment1 = a0, a1
		clone.Enabled = true
		clone.Parent = root
		Debris:AddItem(a0, life)
		Debris:AddItem(a1, life)
	elseif cls == "Trail" then
		local a0 = Instance.new("Attachment", root)
		local a1 = Instance.new("Attachment", root)
		a0.Position, a1.Position = Vector3.new(0, 1, 0), Vector3.new(0, -1, 0)
		a0:SetAttribute("_LoggerClone", true)
		a1:SetAttribute("_LoggerClone", true)
		clone.Attachment0, clone.Attachment1 = a0, a1
		clone.Enabled = true
		clone.Parent = root
		life = 8 -- move around to see it
		Debris:AddItem(a0, life)
		Debris:AddItem(a1, life)
	elseif cls == "Explosion" then
		clone.BlastPressure = 0
		clone.Position = root.Position
		clone.Parent = workspace
	elseif cls == "Highlight" then
		clone.Adornee = lp.Character
		clone.Parent = lp.Character
	else
		clone.Enabled = true
		clone.Parent = root
	end
	Debris:AddItem(clone, life)
end

--// Code generation -------------------------------------------------------

local function num(n)
	local s = string.format("%.4f", n):gsub("0+$", ""):gsub("%.$", "")
	if s == "-0" or s == "" then s = "0" end
	return s
end

local function cfStr(cf)
	local c = { cf:GetComponents() }
	for i, v in ipairs(c) do c[i] = num(v) end
	return "CFrame.new(" .. table.concat(c, ",") .. ")"
end

local function cfDiffers(a, b)
	return (a.Position - b.Position).Magnitude > 0.002
		or (a.XVector - b.XVector).Magnitude > 0.002
		or (a.YVector - b.YVector).Magnitude > 0.002
end

-- Simple code: plays the original animation by id in any game
local function simpleCode(id)
	local info = animInfo[id] or {}
	return string.format([==[-- Play animation %s on your character
-- (the animation must be usable by that game/account - otherwise use the Detail script)
local Players = game:GetService("Players")
local char = Players.LocalPlayer.Character or Players.LocalPlayer.CharacterAdded:Wait()
local hum = char:WaitForChild("Humanoid")
local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)

local anim = Instance.new("Animation")
anim.AnimationId = "%s"
local track = animator:LoadAnimation(anim)
track.Priority = Enum.AnimationPriority.%s
track.Looped = %s
track:Play(0.1, 1, %s)
]==], id, id, info.priority or "Action", tostring(info.looped or false), num(info.speed or 1))
end

-- Playback part of the Detail script. Works like RobAnimator: the Animator is removed so
-- nothing else rewrites the joints, then every Motor6D.Transform is set on Heartbeat.
local PLAYBACK_CODE = [==[
-- stop a previous run of this script (if any)
if _G.StopRecreatedAnim then pcall(_G.StopRecreatedAnim) end

local char = lp.Character or lp.CharacterAdded:Wait()
local hum = char:WaitForChild("Humanoid")

local function notify(text)
	print("[RecreatedAnim] " .. text)
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", {
			Title = "Recreated anim", Text = text, Duration = 4,
		})
	end)
end

if hum.RigType.Name ~= RIG then
	notify("Captured on " .. RIG .. " but your character is " .. hum.RigType.Name .. " - can't play here.")
	return
end

local motors, count = {}, 0
for _, d in ipairs(char:GetDescendants()) do
	if d:IsA("Motor6D") and JOINTS[d.Name] and d.Part1 and not motors[d.Name] then
		motors[d.Name] = d
		count += 1
	end
end
if count == 0 then
	notify("No matching joints found on your character.")
	return
end

local function apply(pose)
	for name, cf in pairs(pose) do
		local m = motors[name]
		if m then m.Transform = cf end
	end
end

-- remove the Animator + disable Animate so nothing overwrites the pose
local animate = char:FindFirstChild("Animate")
local animateWasDisabled = animate and animate.Disabled
local removedAnimator = false

local function removeAnimator()
	local a = hum:FindFirstChildOfClass("Animator")
	if a then
		a:Destroy()
		removedAnimator = true
	end
end

if DISABLE_DEFAULT_ANIMATE then
	if animate then animate.Disabled = true end
	removeAnimator()
end

local accumulated = 0
local index = 1
local lastFrame
local conn

local function stop()
	if conn then conn:Disconnect() conn = nil end
	for _, m in pairs(motors) do m.Transform = CFrame.new() end
	if removedAnimator and not hum:FindFirstChildOfClass("Animator") then
		Instance.new("Animator").Parent = hum -- give the character its Animator back
	end
	if animate and DISABLE_DEFAULT_ANIMATE then animate.Disabled = animateWasDisabled end
	_G.StopRecreatedAnim = nil
end

conn = RunService.Heartbeat:Connect(function(dt)
	accumulated += dt * SPEED
	if DISABLE_DEFAULT_ANIMATE then removeAnimator() end

	-- advance through the captured frames
	while frames[index] and accumulated >= frames[index].dt do
		accumulated -= frames[index].dt
		lastFrame = frames[index]
		index += 1
	end

	local nextFrame = frames[index]
	if not nextFrame then
		-- reached the end
		if lastFrame then apply(lastFrame.j) end
		if LOOPED or LOOP_FOREVER then
			index, accumulated = 1, 0
		else
			stop()
		end
		return
	end

	if lastFrame and SMOOTH then
		-- blend from the last frame toward the next one
		local alpha = math.clamp(accumulated / math.max(nextFrame.dt, 1e-6), 0, 1)
		for name, cf in pairs(nextFrame.j) do
			local m = motors[name]
			local from = lastFrame.j[name]
			if m and from then m.Transform = from:Lerp(cf, alpha) end
		end
	elseif lastFrame then
		apply(lastFrame.j)
	end
end)

-- call _G.StopRecreatedAnim() to stop early (only you can see this - it's client-side)
_G.StopRecreatedAnim = stop
notify(string.format("Playing (%d joints, %.2fs)", count, LENGTH))
]==]

-- joints = { { name, part0, part1, frames = { {t, cf}, ... } }, ... }
local function genDetailedCode(id, rig, length, looped, joints)
	local L = {}
	local function add(s) table.insert(L, s) end

	local names = {}
	for _, j in ipairs(joints) do table.insert(names, j.part1 .. " [" .. j.name .. "]") end

	add("-- Recreated animation - runs WITHOUT the original animation")
	add("-- Source AnimationId: " .. id)
	add(string.format("-- Rig: %s | Length: %.2fs | Looped: %s", rig, length, tostring(looped)))
	add("-- Parts moved: " .. table.concat(names, ", "))
	add("-- Every frame lists where each joint goes - e.g. the 'Left Shoulder' joint is")
	add("-- what moves the Left Arm (rot = degrees XYZ, just for reading).")
	add("")
	add('local Players = game:GetService("Players")')
	add('local RunService = game:GetService("RunService")')
	add("local lp = Players.LocalPlayer")
	add("")
	add("local LENGTH = " .. num(length))
	add("local LOOPED = " .. tostring(looped))
	add("local SPEED = 1")
	add(string.format("local RIG = %q -- rig type this was captured on (must match yours)", rig))
	add("local SMOOTH = true -- blend between captured frames (false = exact frame steps)")
	add("local LOOP_FOREVER = false -- set true to repeat until you call _G.StopRecreatedAnim()")
	add("local DISABLE_DEFAULT_ANIMATE = true -- removes the Animator while playing, restored after")
	add("")
	add("local JOINTS = { -- the Motor6D joints this animation moves")
	for _, j in ipairs(joints) do
		add(string.format("\t[%q] = true, -- %s  (%s -> %s)", j.name, j.part1, j.part0, j.part1))
	end
	add("}")
	add("")
	add("-- one entry per captured frame: dt = seconds since the previous frame,")
	add("-- j = where every joint goes")
	add("local frames = {")
	local base = joints[1].frames
	for i = 1, #base do
		local dt = i > 1 and (base[i][1] - base[i - 1][1]) or 0
		add(string.format("\t{ dt = %s, j = {", num(dt)))
		for _, j in ipairs(joints) do
			local cf = j.frames[i][2]
			local rx, ry, rz = cf:ToEulerAnglesXYZ()
			add(string.format(
				"\t\t[%q] = %s, -- %s rot %d, %d, %d",
				j.name, cfStr(cf), j.part1,
				math.floor(math.deg(rx) + 0.5), math.floor(math.deg(ry) + 0.5), math.floor(math.deg(rz) + 0.5)
			))
		end
		add("\t} },")
	end
	add("}")
	add("")
	add(PLAYBACK_CODE)
	return table.concat(L, "\n")
end

--// RBXMX (KeyframeSequence) export ---------------------------------------
local function g(n) return string.format("%.6g", n) end

local function xmlEsc(s)
	return (tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;"))
end

local CF_TAGS = { "X", "Y", "Z", "R00", "R01", "R02", "R10", "R11", "R12", "R20", "R21", "R22" }
local function cfXml(cf)
	local c = { cf:GetComponents() }
	local parts = { '<CoordinateFrame name="CFrame">' }
	for i, tag in ipairs(CF_TAGS) do
		parts[#parts + 1] = "<" .. tag .. ">" .. g(c[i]) .. "</" .. tag .. ">"
	end
	parts[#parts + 1] = "</CoordinateFrame>"
	return table.concat(parts)
end

local RBXMX_HEAD = '<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" '
	.. 'xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" '
	.. 'xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">'

local function buildRbxmx(name, loop, priority, emitKeyframes)
	local lines, refN = {}, -1
	local function w(s) lines[#lines + 1] = s end
	local function ref() refN += 1 return refN end

	w(RBXMX_HEAD)
	w('<Meta name="ExplicitAutoJoints">true</Meta>')
	w(string.format('<Item class="KeyframeSequence" referent="RBX%d"><Properties>', ref()))
	w(string.format(
		'<bool name="Loop">%s</bool><string name="Name">%s</string><token name="Priority">%d</token>',
		tostring(loop), xmlEsc(name), priority
	))
	w("</Properties>")
	emitKeyframes(w, ref)
	w("</Item>")
	w("</roblox>")
	return table.concat(lines, "\n")
end

local function keyframeOpen(ref, t)
	return string.format(
		'<Item class="Keyframe" referent="RBX%d"><Properties><string name="Name">Keyframe</string><float name="Time">%s</float></Properties>',
		ref(), g(t)
	)
end

-- from the original KeyframeSequence instance (exact: keeps easing styles)
local function emitPoseInst(w, ref, pose)
	w(string.format('<Item class="Pose" referent="RBX%d"><Properties>', ref()))
	w(cfXml(pose.CFrame))
	w(string.format(
		'<token name="EasingDirection">%d</token><token name="EasingStyle">%d</token>',
		pose.EasingDirection.Value, pose.EasingStyle.Value
	))
	w(string.format('<string name="Name">%s</string><float name="Weight">%s</float>', xmlEsc(pose.Name), g(pose.Weight)))
	w("</Properties>")
	for _, c in ipairs(pose:GetChildren()) do
		if c:IsA("Pose") then emitPoseInst(w, ref, c) end
	end
	w("</Item>")
end

local function rbxmxFromInstance(ks)
	local kfs = {}
	for _, c in ipairs(ks:GetChildren()) do
		if c:IsA("Keyframe") then table.insert(kfs, c) end
	end
	table.sort(kfs, function(a, b) return a.Time < b.Time end)
	if #kfs == 0 then error("empty KeyframeSequence") end
	return buildRbxmx(ks.Name, ks.Loop, ks.Priority.Value, function(w, ref)
		for _, kf in ipairs(kfs) do
			w(keyframeOpen(ref, kf.Time))
			for _, p in ipairs(kf:GetChildren()) do
				if p:IsA("Pose") then emitPoseInst(w, ref, p) end
			end
			w("</Item>")
		end
	end)
end

-- from captured samples (the pose tree follows the rig: HumanoidRootPart -> Torso -> arms ...)
local function emitCapturedPose(w, ref, name, cf, weight, kids, i)
	w(string.format('<Item class="Pose" referent="RBX%d"><Properties>', ref()))
	w(cfXml(cf))
	w('<token name="EasingDirection">0</token><token name="EasingStyle">0</token>')
	w(string.format('<string name="Name">%s</string><float name="Weight">%d</float>', xmlEsc(name), weight))
	w("</Properties>")
	for _, k in ipairs(kids[name] or {}) do
		emitCapturedPose(w, ref, k.name, k.samples[i][2], 1, kids, i)
	end
	w("</Item>")
end

local function rbxmxFromCapture(name, loop, priority, motorsInfo)
	local kids, isChild, roots, seenRoot = {}, {}, {}, {}
	for _, mi in ipairs(motorsInfo) do
		kids[mi.parent] = kids[mi.parent] or {}
		table.insert(kids[mi.parent], mi)
		isChild[mi.name] = true
	end
	for _, mi in ipairs(motorsInfo) do
		if not isChild[mi.parent] and not seenRoot[mi.parent] then
			seenRoot[mi.parent] = true
			table.insert(roots, mi.parent)
		end
	end
	local n = math.huge
	for _, mi in ipairs(motorsInfo) do n = math.min(n, #mi.samples) end

	return buildRbxmx(name, loop, priority, function(w, ref)
		for i = 1, n do
			w(keyframeOpen(ref, motorsInfo[1].samples[i][1]))
			for _, rootName in ipairs(roots) do
				emitCapturedPose(w, ref, rootName, CFrame.new(), 0, kids, i)
			end
			w("</Item>")
		end
	end)
end

-- try to get the real KeyframeSequence of an animation asset
local function fetchOriginalSequence(id)
	local ok, objs = pcall(function() return game:GetObjects(id) end)
	if ok and typeof(objs) == "table" then
		for _, o in ipairs(objs) do
			if o:IsA("KeyframeSequence") then return o end
			local inner = o:FindFirstChildWhichIsA("KeyframeSequence", true)
			if inner then return inner end
		end
	end
	local ok2, ks = pcall(function()
		return game:GetService("KeyframeSequenceProvider"):GetKeyframeSequenceAsync(id)
	end)
	if ok2 and ks then return ks end
	return nil
end

--// Detail capture --------------------------------------------------------
-- Plays the animation on a hidden clone of your character (so nothing else interferes),
-- samples every Motor6D.Transform over time, builds the rebuild-script and an rbxmx.
local function captureDetail(id)
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not (char and hum and getRoot()) then error("character not ready") end

	local oldArch = char.Archivable
	char.Archivable = true
	local dummy = char:Clone()
	char.Archivable = oldArch
	if not dummy then error("couldn't clone your character") end

	dummy.Name = "_AnimCaptureDummy"
	dummy:SetAttribute("_LoggerClone", true)
	for _, d in ipairs(dummy:GetDescendants()) do
		d:SetAttribute("_LoggerClone", true)
		if d:IsA("LuaSourceContainer") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = true
		end
	end
	dummy:PivotTo(CFrame.new(0, 20000, 0))

	local dHum = dummy:FindFirstChildOfClass("Humanoid")
	if not dHum then dummy:Destroy() error("clone has no humanoid") end
	pcall(function() dHum.EvaluateStateMachine = false end)
	local animator = dHum:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator:SetAttribute("_LoggerClone", true)
		animator.Parent = dHum
	end
	dummy.Parent = workspace

	local motors = {}
	for _, d in ipairs(dummy:GetDescendants()) do
		if d:IsA("Motor6D") and d.Part0 and d.Part1 then table.insert(motors, d) end
	end

	local anim = Instance.new("Animation")
	anim.AnimationId = id
	local okLoad, track = pcall(function() return animator:LoadAnimation(anim) end)
	if not okLoad or not track then
		dummy:Destroy()
		error("couldn't load animation (not allowed / invalid id)")
	end
	ownTracks[track] = true

	local looped, priority, speed = track.Looped, track.Priority.Name, track.Speed
	local priorityValue = track.Priority.Value
	animInfo[id] = animInfo[id] or { priority = priority, looped = looped, speed = speed }
	track.Looped = false

	local waited = 0
	while track.Length == 0 and waited < 5 do waited += RunService.Heartbeat:Wait() end
	if track.Length == 0 then
		dummy:Destroy()
		error("animation failed to load (not allowed / invalid id)")
	end
	local maxTime = track.Length + 3

	local samples = {}
	for _, m in ipairs(motors) do samples[m] = {} end

	track:Play(0, 1, 1)
	local startClock, nextT, firstPos = os.clock(), 0, nil
	while track.IsPlaying and os.clock() - startClock < maxTime do
		RunService.Heartbeat:Wait()
		local pos = track.TimePosition
		if pos > 0 and pos >= nextT then
			firstPos = firstPos or pos
			for _, m in ipairs(motors) do
				table.insert(samples[m], { pos - firstPos, m.Transform })
			end
			nextT = pos + CAPTURE_STEP
		end
	end
	track:Stop(0)
	dummy:Destroy()

	-- keep only joints that actually moved (for the Lua script)
	local identity = CFrame.new()
	local joints, totalFrames, totalLength = {}, 0, 0
	local allMotors = {}
	for _, m in ipairs(motors) do
		local s = samples[m]
		if #s >= 2 then
			table.insert(allMotors, { name = m.Part1.Name, parent = m.Part0.Name, samples = s })
		end
		local moved = false
		for _, f in ipairs(s) do
			if cfDiffers(f[2], identity) then moved = true break end
		end
		if moved and #s >= 2 then
			-- keep every frame so all joints stay in sync
			totalFrames = math.max(totalFrames, #s)
			totalLength = math.max(totalLength, s[#s][1])
			table.insert(joints, { name = m.Name, part0 = m.Part0.Name, part1 = m.Part1.Name, frames = s })
		end
	end

	if #joints == 0 then
		error("no joints moved - rig mismatch? (your rig is " .. hum.RigType.Name .. ")")
	end

	local names = {}
	for _, j in ipairs(joints) do table.insert(names, j.part1 .. " (" .. j.name .. ")") end
	local summary = string.format(
		"Moved: %s | %d frames | %.2fs | %s",
		table.concat(names, ", "), totalFrames, totalLength, hum.RigType.Name
	)

	local seqName = "Anim_" .. (id:match("%d+") or "x")
	return {
		code = genDetailedCode(id, hum.RigType.Name, totalLength, looped, joints),
		summary = summary,
		rbxmx = rbxmxFromCapture(seqName, looped, priorityValue, allMotors),
	}
end

