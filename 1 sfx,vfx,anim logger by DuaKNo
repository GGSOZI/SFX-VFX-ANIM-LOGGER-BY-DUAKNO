--// Saving settings -------------------------------------------------------------------------------
local lastSavedJson
saveSettings = function()
	if not writefile then return end
	local function labelsFor(set, labels)
		local t = {}
		for id in pairs(set) do t[id] = labels[id] or "" end
		return t
	end
	local ok, json = pcall(function()
		return HttpService:JSONEncode({
			version = 2, theme = Th.cur.name, filter = X.filter, compact = X.compact, deepHook = X.deep,
			thorough = X.thorough, guessFX = X.guess, objOn = X.objOn, fxPre = X.pre,
			quality = QUALITY, ownOnly = ownOnly, uniqueOnly = uniqueOnly, detailedMode = detailedMode,
			tab = lastLogTab,
			excluded = labelsFor(excluded, animLabel),
			blocked = labelsFor(blocked, animLabel),
			excludedVFX = labelsFor(excludedVFX, vfxLabel),
			excludedSFX = labelsFor(excludedSFX, sfxLabel),
			window = mainWin.getState(),
		})
	end)
	if ok and json ~= lastSavedJson then
		if pcall(writefile, SETTINGS_FILE, json) then lastSavedJson = json end
	end
end

task.spawn(function()
	while gui.Parent do
