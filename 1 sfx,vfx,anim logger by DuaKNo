--// FX library: effects you saved (from the FX editor, the VFX / SFX / OBJ tabs or the Search tab) to put on ANY animation -------------
X.FXLIB_FILE = "AnimLogger_fxlib.json"
X.fxlib = { items = {}, order = {} }

function X.libLoad()
	if not (isfile and readfile) then return end
	local ok, data = pcall(function()
		if isfile(X.FXLIB_FILE) then return HttpService:JSONDecode(readfile(X.FXLIB_FILE)) end
	end)
	if not (ok and type(data) == "table" and type(data.items) == "table") then return end
	for key, it in pairs(data.items) do
		if type(it) == "table" and type(it.evs) == "table" then
			X.fxlib.items[key] = it
			X.fxlib.order[#X.fxlib.order + 1] = key
		end
	end
	table.sort(X.fxlib.order, function(a, b)
		local ta, tb = X.fxlib.items[a].t or 0, X.fxlib.items[b].t or 0
		if ta ~= tb then return ta > tb end
		return a < b
	end)
end

function X.libWrite()
	if not writefile then return false end
	local ok, json = pcall(function() return HttpService:JSONEncode({ v = 1, items = X.fxlib.items }) end)
	if not ok then return false end
	return (pcall(writefile, X.FXLIB_FILE, json))
end

-- evs = a list of FX events (VFX / SFX / OBJ / CAM). Their times are kept relative to the first one.
function X.libSave(evs, name, btn)
	local function say(t)
		if btn and btn.Parent then K.flash(btn, t) end
	end
	local t0 = math.huge
	for _, e in ipairs(evs or {}) do
		if type(e) == "table" and e.kind then t0 = math.min(t0, e.t or 0) end
	end
	local list = {}
	for _, e in ipairs(evs or {}) do
		if type(e) == "table" and e.kind then
			local ok, enc = pcall(X.enc, e)
			if ok and type(enc) == "table" then
				enc.t = math.max((e.t or 0) - t0, 0)
				enc.off = nil
				list[#list + 1] = enc
			end
		end
	end
	if #list == 0 then
		out("Nothing to save to the FX library.")
		return say("Nothing")
	end
	if #X.fxlib.order >= 600 then
		out("The FX library is full (600). Delete some first.")
		return say("Full")
	end
	X.libN = (X.libN or 0) + 1
	local key = string.format("fx%d_%d", os.time(), X.libN)
	while X.fxlib.items[key] do
		X.libN += 1
		key = string.format("fx%d_%d", os.time(), X.libN)
	end
	if not name or name == "" then
		local title = X.evLines(evs[1])
		name = tostring(title)
		if #list > 1 then name = name .. string.format(" (+%d more)", #list - 1) end
	end
	local it = { key = key, name = tostring(name):sub(1, 70), t = os.time(), evs = list }
	X.fxlib.items[key] = it
	table.insert(X.fxlib.order, 1, key)
	local wrote = X.libWrite()
	out(string.format("Saved \"%s\" to the FX library (%d effect%s).%s", it.name, #list, #list == 1 and "" or "s",
		wrote and "" or " This executor cannot write files, so it only lasts until you close the game."))
	say("In library")
	if X.libList and X.libList.Parent then pcall(X.libRender) end
	if X.svReady then pcall(X.svRender) end
end

function X.libEvents(it, T) -- the saved effects as events, starting at time T
	local list = {}
	for _, sv in ipairs(it.evs) do
		local c = X.dec(sv)
		c.t = math.max((T or 0) + (c.t or 0), 0)
		list[#list + 1] = c
	end
	return list
end

function X.libAdd(it, T, btn)
	local E = X.ed
	if not E then
		if btn and btn.Parent then K.flash(btn, "Open FX editor") end
		return out("Open the FX editor of the animation you want first (Animations tab or Saved tab > FX Edit), then press Add.")
	end
	local list = X.libEvents(it, T)
	X.edChange(function()
		for _, c in ipairs(list) do table.insert(E.events, c) end
		E.sel = list[#list]
	end)
	out(string.format("Added \"%s\" to %s at %.2fs.", it.name, K.animName(E.id), tonumber(T) or 0))
	if btn and btn.Parent then K.flash(btn, "Added") end
end

function X.libRender()
	local sf = X.libList
	if not (sf and sf.Parent) then return end
	for _, ch in ipairs(sf:GetChildren()) do
		if ch:IsA("GuiObject") then ch:Destroy() end
	end
	local q = (X.libSearch and X.libSearch.Text or ""):lower()
	local shown = 0
	for _, key in ipairs(X.fxlib.order) do
		local it = X.fxlib.items[key]
		if it then
			local hay = tostring(it.name) .. " "
			local nv, ns, no, nc = 0, 0, 0, 0
			for _, e in ipairs(it.evs) do
				hay = hay .. tostring(e.name) .. " " .. tostring(e.class or "") .. " " .. tostring(e.kind) .. " "
				for _, pr in ipairs(e.props or {}) do hay = hay .. tostring(pr[2]) .. " " end
				if e.kind == "vfx" then nv += 1 elseif e.kind == "sfx" then ns += 1 elseif e.kind == "obj" or e.kind == "gui" then no += 1 else nc += 1 end
			end
			hay = hay:lower()
			local ok = true
			for w in q:gmatch("%S+") do
				if not hay:find(w, 1, true) then
					ok = false
					break
				end
			end
			if ok then
				shown += 1
				local row = Instance.new("Frame")
				row.Size = UDim2.new(1, -6, 0, 78)
				row.BackgroundColor3 = shown % 2 == 1 and C.row1 or C.row2
				row.BorderSizePixel = 0
				row.LayoutOrder = shown
				row.Parent = sf
				local lbl = Instance.new("TextLabel")
				lbl.Position = UDim2.new(0, 8, 0, 2)
				lbl.Size = UDim2.new(1, -16, 0, 36)
				lbl.BackgroundTransparency = 1
				lbl.RichText = true
				lbl.TextXAlignment = Enum.TextXAlignment.Left
				lbl.TextTruncate = Enum.TextTruncate.AtEnd
				lbl.Font = Th.font
				lbl.TextSize = 15
				lbl.TextColor3 = C.text
				lbl.Text = string.format('<b>%s</b>\n<font color="%s">%d VFX  %d SFX  %d OBJ  %d CAM</font>', K.esc(it.name), K.hex(C.sub), nv, ns, no, nc)
				lbl.Parent = row
				local bar = X.mkBar(row, 40, 34)
				X.mkTool(bar, "Add", 50, C.green, function(b)
					X.libAdd(it, tonumber(X.libStart and X.libStart.Text) or 0, b)
				end)
				X.mkTool(bar, "Run", 46, C.green, function() K.runEvents(X.libEvents(it, 0), it.name) end)
				X.mkTool(bar, "Copy", 52, C.sel, function(b)
					toClip(K.genStandaloneFX(X.libEvents(it, 0), it.name), "the FX script")
					K.flash(b, "Copied!")
				end)
				X.mkTool(bar, "Rename", 66, C.btn, function()
					X.prompt("Rename FX", it.name, function(text)
						local nv2 = tostring(text):match("^%s*(.-)%s*$")
						if nv2 == "" then return end
						it.name = nv2:sub(1, 70)
						X.libWrite()
						X.libRender()
					end)
				end)
				X.mkTool(bar, "Delete", 58, C.danger, function()
					X.fxlib.items[key] = nil
					local i = table.find(X.fxlib.order, key)
					if i then table.remove(X.fxlib.order, i) end
					X.libWrite()
					X.libRender()
					if X.svReady then pcall(X.svRender) end
				end)
			end
		end
	end
	if shown == 0 then
		local l = Instance.new("TextLabel")
