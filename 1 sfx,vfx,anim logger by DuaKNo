local counter = 0
local exportLog = { Anim = {}, VFX = {} } -- full history for Download / Copy All
local ownTracks = setmetatable({}, { __mode = "k" }) -- tracks we played ourselves (don't log/block)
local MAX_EXPORT = 2000

