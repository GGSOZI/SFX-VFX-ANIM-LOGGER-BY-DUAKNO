--// Detailed capture queue ------------------------------------------------
local function requestDetail(id, cb)
	if details[id] then
		if cb then cb(true, details[id]) end
		return
	end
	local job = detailJobs[id]
	if job then
		if cb then table.insert(job, cb) end
		return
	end
	detailJobs[id] = { cb }
	table.insert(detailQueue, id)

	if detailWorking then return end
	detailWorking = true
	task.spawn(function()
		while #detailQueue > 0 do
			local nextId = table.remove(detailQueue, 1)
			local ok, res = pcall(captureDetail, nextId)
			local callbacks = detailJobs[nextId]
			detailJobs[nextId] = nil
			if ok then details[nextId] = res end
			for _, ent in ipairs(entriesById[nextId] or {}) do
				pcall(ent.setExtra, ok and res.summary or ("Detail failed: " .. tostring(res)))
			end
			for _, f in ipairs(callbacks or {}) do pcall(f, ok, res) end
		end
		detailWorking = false
	end)
end

-- rbxmx: try the real KeyframeSequence first, otherwise fall back to the captured poses
local function requestRbxmx(id, cb) -- cb(ok, xmlOrError, source)
	local cached = rbxmxCache[id]
	if cached then return cb(true, cached.xml, cached.source) end
	task.spawn(function()
		local ks = fetchOriginalSequence(id)
		if ks then
			local ok, xml = pcall(rbxmxFromInstance, ks)
			if ok then
				rbxmxCache[id] = { xml = xml, source = "original" }
				return cb(true, xml, "original")
			end
		end
		requestDetail(id, function(ok, res)
			if ok then
				rbxmxCache[id] = { xml = res.rbxmx, source = "captured" }
				cb(true, res.rbxmx, "captured")
			else
				cb(false, res)
			end
		end)
	end)
end

