local Clip = {} -- one table (Luau limits a script to 200 locals)
Clip.HEADER = "-- This was generated by Dua's VFX/SFX/ANIMATION LOGGER"
function Clip.stamp(text) -- adds the header to Lua code (not to XML files like .rbxmx)
	text = tostring(text)
	if text:sub(1, #Clip.HEADER) == Clip.HEADER or text:match("^%s*<") then return text end
	return Clip.HEADER .. "\n" .. text
end
function Clip.set(text)
	if not setclip then return false end
	return (pcall(setclip, Clip.stamp(text)))
end

local function g(n) -- number -> Lua/XML text
	if n == math.huge then return "math.huge" end
	if n == -math.huge then return "-math.huge" end
	if n ~= n then return "0" end
	return string.format("%.6g", n)
end

local function num(n)
	local s = string.format("%.4f", n):gsub("0+$", ""):gsub("%.$", "")
	if s == "-0" or s == "" then s = "0" end
	return s
end

local function cfStr(cf)
	local c = { cf:GetComponents() }
	for i, v in ipairs(c) do c[i] = num(v) end
	return "CFrame.new(" .. table.concat(c, ",") .. ")"
end

local function cfDiffers(a, b)
	return (a.Position - b.Position).Magnitude > 0.002
		or (a.XVector - b.XVector).Magnitude > 0.002
		or (a.YVector - b.YVector).Magnitude > 0.002
end

-- runs fn in its own thread, gives up after `seconds` (returns nil on timeout / error)
local function withTimeout(seconds, fn)
	local done, result = false, nil
	task.spawn(function()
		local ok, r = pcall(fn)
		if ok then result = r end
		done = true
	end)
	local t0 = os.clock()
	while not done and os.clock() - t0 < seconds do task.wait(0.05) end
	return result
end

-- value -> Lua literal text (nil if unsupported)
local function lit(v)
	local t = typeof(v)
	if t == "number" then
		return g(v)
	elseif t == "boolean" then
		return tostring(v)
	elseif t == "string" then
		return string.format("%q", v)
	elseif t == "Vector3" then
		return string.format("Vector3.new(%s,%s,%s)", g(v.X), g(v.Y), g(v.Z))
	elseif t == "Vector2" then
		return string.format("Vector2.new(%s,%s)", g(v.X), g(v.Y))
	elseif t == "Color3" then
		return string.format("Color3.new(%s,%s,%s)", g(v.R), g(v.G), g(v.B))
	elseif t == "NumberRange" then
		return string.format("NumberRange.new(%s,%s)", g(v.Min), g(v.Max))
	elseif t == "NumberSequence" then
		local kps = {}
		for _, k in ipairs(v.Keypoints) do
			kps[#kps + 1] = string.format("NumberSequenceKeypoint.new(%s,%s,%s)", g(k.Time), g(k.Value), g(k.Envelope))
		end
		return "NumberSequence.new({" .. table.concat(kps, ",") .. "})"
	elseif t == "ColorSequence" then
		local kps = {}
		for _, k in ipairs(v.Keypoints) do
			kps[#kps + 1] = string.format(
				"ColorSequenceKeypoint.new(%s,Color3.new(%s,%s,%s))",
				g(k.Time), g(k.Value.R), g(k.Value.G), g(k.Value.B)
			)
		end
		return "ColorSequence.new({" .. table.concat(kps, ",") .. "})"
	elseif t == "EnumItem" then
		return tostring(v)
	elseif t == "CFrame" then
		return cfStr(v)
	end
	return nil
end

local function playAnim(id)
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then error("no humanoid") end
	local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
	local a = Instance.new("Animation")
	a.AnimationId = id
	local track = animator:LoadAnimation(a)
	ownTracks[track] = true
	track:Play()
end

--// Frame simplification -------------------------------------------------------
-- Drops frames that can be rebuilt (within a tolerance) by blending the neighbouring kept frames.
local function frameError(a, b)
	return (a.Position - b.Position).Magnitude
		+ (a.XVector - b.XVector).Magnitude
		+ (a.YVector - b.YVector).Magnitude
end

local function simplifyJoints(joints, tol)
	local n = #joints[1].frames
	if tol <= 0 or n <= 2 then return joints, n, n end

	local keep = { [1] = true, [n] = true }
	local stack = { { 1, n } }
	local ops = 0
	local times = joints[1].frames
	while #stack > 0 do
		local seg = table.remove(stack)
		local i, j = seg[1], seg[2]
		if j - i > 1 then
			local ti, tj = times[i][1], times[j][1]
			local span = math.max(tj - ti, 1e-6)
			local worst, worstK = 0, nil
			for k = i + 1, j - 1 do
				local alpha = (times[k][1] - ti) / span
				local e = 0
				for _, jt in ipairs(joints) do
					local f = jt.frames
					local err = frameError(f[k][2], f[i][2]:Lerp(f[j][2], alpha))
					if err > e then e = err end
				end
				if e > worst then worst, worstK = e, k end
				ops += #joints
			end
			if worst > tol and worstK then
				keep[worstK] = true
				stack[#stack + 1] = { i, worstK }
				stack[#stack + 1] = { worstK, j }
			end
			if ops > 40000 then
				ops = 0
				if coroutine.isyieldable() then task.wait() end
			end
		end
	end

	local out, kept = {}, 0
	for _, jt in ipairs(joints) do
		local list = {}
		for idx, f in ipairs(jt.frames) do
			if keep[idx] then list[#list + 1] = f end
		end
		kept = #list
		out[#out + 1] = { name = jt.name, part0 = jt.part0, part1 = jt.part1, frames = list }
	end
	return out, kept, n
end

