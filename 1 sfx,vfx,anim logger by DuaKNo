function X.dsSer(v) -- value -> Lua source text
	local t = type(v)
	if t == "number" then return K.g(v) end
	if t == "boolean" then return tostring(v) end
	if t == "string" then return string.format("%q", v) end
	if t == "table" then
		local parts = {}
		if #v > 0 then
			for i = 1, #v do parts[#parts + 1] = X.dsSer(v[i]) end
		else
			local keys = {}
			for k in pairs(v) do keys[#keys + 1] = k end
			table.sort(keys)
			for _, k in ipairs(keys) do parts[#parts + 1] = k .. " = " .. X.dsSer(v[k]) end
		end
		return "{ " .. table.concat(parts, ", ") .. " }"
	end
	return "nil"
end

function X.dsLocal() -- the finished LocalScript: every button is placed exactly where it is on the design screen
	local L = {
		"-- Design Script: " .. #X.ds.buttons .. " button(s)" .. (X.ds.joy and " + joystick" or "") .. (X.ds.jump and " + jump button" or ""),
		"-- Positions are screen fractions (0-1) with the ScreenGui ignoring the top bar, so each button is exactly where you put it.",
		"local BUTTONS = " .. X.dsSer(X.dsPayload()),
	}
	local jy, jp = X.ds.joy, X.ds.jump
	if jy then
		L[#L + 1] = "local JOY = " .. X.dsSer({
			x = jy.x, y = jy.y, size = jy.size, deadzone = jy.deadzone, runAt = jy.runAt, sprintAt = jy.sprintAt,
			walkSpeed = jy.walkSpeed, runSpeed = jy.runSpeed, sprintSpeed = jy.sprintSpeed, animSpeed = jy.animSpeed,
			strafe = jy.strafe, hideDefault = jy.hideDefault, type = jy.type,
			a = { idle = jy.a.idle, walk = jy.a.walk, run = jy.a.run, sprint = jy.a.sprint, back = jy.a.back, left = jy.a.left, right = jy.a.right },
			codes = { idle = jy.codes.idle, walk = jy.codes.walk, run = jy.codes.run, sprint = jy.codes.sprint, back = jy.codes.back, left = jy.codes.left, right = jy.codes.right },
		})
	else
		L[#L + 1] = "local JOY = nil"
	end
	if jp then
		L[#L + 1] = "local JUMP = " .. X.dsSer({
			x = jp.x, y = jp.y, size = jp.size, label = jp.label, height = jp.height, extra = jp.extra,
			hideDefault = jp.hideDefault, anim = jp.anim, fall = jp.fall, type = jp.type, code = jp.code, fallCode = jp.fallCode,
		})
	else
		L[#L + 1] = "local JUMP = nil"
	end
	L[#L + 1] = X.DS_RUNTIME
	return table.concat(L, "\n")
end

