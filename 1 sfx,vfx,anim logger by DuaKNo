	if okSpec and spec then sfxSpec[id] = spec end
	local function script() return genStandaloneFX({ sfxSpec[id] }, "SFX " .. (sfxLabel[id] or id)) end

	local detail = string.format(
		"%s\n%s\nVolume: %.2f | Speed: %.2f | Loop: %s | Length: %.2fs",
		shortPath(s), id, s.Volume, s.PlaybackSpeed, tostring(s.Looped), s.TimeLength
	)
	local actions = {
