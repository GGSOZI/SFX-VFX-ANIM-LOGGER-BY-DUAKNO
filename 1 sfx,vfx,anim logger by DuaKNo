--// Saved edits: your edited animations / effects, kept in a file (with their code, viewable + editable) --------
X.EDITS_FILE = "AnimLogger_edits.json"
X.eds = { items = {}, order = {} }

function X.enc(v) -- value -> JSON-safe value (CFrame / Vector3 / Color3 / special numbers are tagged)
	local tv = typeof(v)
	if tv == "number" then
		if v ~= v then return { __n = "nan" } end
		if v == math.huge then return { __n = "inf" } end
		if v == -math.huge then return { __n = "-inf" } end
		return math.floor(v * 1e5 + 0.5) / 1e5
	elseif tv == "string" or tv == "boolean" then
		return v
	elseif tv == "CFrame" then
		local c = { v:GetComponents() }
		for i, n in ipairs(c) do c[i] = math.floor(n * 1e6 + 0.5) / 1e6 end
		return { __cf = c }
	elseif tv == "Vector3" then
		return { __v3 = { v.X, v.Y, v.Z } }
	elseif tv == "Color3" then
		return { __c3 = { v.R, v.G, v.B } }
	elseif tv == "table" then
		local n, isArr = #v, true
		for k in pairs(v) do
			if type(k) ~= "number" then
				isArr = false
				break
			end
		end
		local out = {}
		if isArr then
			for i = 1, n do
				local e = X.enc(v[i])
				if e == nil then e = false end
				out[i] = e
			end
		else
			for k, val in pairs(v) do
				if type(k) == "string" and k:sub(1, 1) ~= "_" then
					local e = X.enc(val)
					if e ~= nil then out[k] = e end
				end
			end
		end
		return out
	end
	return nil
end

function X.dec(v)
	if type(v) ~= "table" then return v end
	if v.__cf then return CFrame.new(table.unpack(v.__cf)) end
	if v.__v3 then return Vector3.new(table.unpack(v.__v3)) end
	if v.__c3 then return Color3.new(table.unpack(v.__c3)) end
	if v.__n then return v.__n == "nan" and 0 or (v.__n == "inf" and math.huge or -math.huge) end
	local out = {}
	for k, val in pairs(v) do out[k] = X.dec(val) end
	return out
end

function X.edsLoad()
	if not (isfile and readfile) then return end
	local ok, data = pcall(function()
		if isfile(X.EDITS_FILE) then return HttpService:JSONDecode(readfile(X.EDITS_FILE)) end
	end)
	if not (ok and type(data) == "table" and type(data.items) == "table") then return end
	for id, it in pairs(data.items) do
		if type(it) == "table" then
			X.eds.items[id] = it
			X.eds.order[#X.eds.order + 1] = id
		end
	end
	table.sort(X.eds.order, function(a, b) return (X.eds.items[a].t or 0) > (X.eds.items[b].t or 0) end)
end

function X.edsWrite()
	if not writefile then return false end
	local ok, json = pcall(function() return HttpService:JSONEncode({ v = 1, items = X.eds.items }) end)
	if not ok then return false end
	return (pcall(writefile, X.EDITS_FILE, json))
end

function X.packAnim(id) -- the frames of an animation as plain data (what a saved edit / kept frames store)
	local d = details[id]
	if not (d and d.joints and #d.joints > 0) then return nil end
	local idx, tr = {}, {}
	local function slot(arr)
		local i = idx[arr]
		if not i then
			local rows = {}
			for k, f in ipairs(arr) do
				local c = { f[2]:GetComponents() }
				local row = { math.floor(f[1] * 1e5 + 0.5) / 1e5 }
				for _, n in ipairs(c) do row[#row + 1] = math.floor(n * 1e5 + 0.5) / 1e5 end
				rows[k] = row
			end
			tr[#tr + 1] = rows
			i = #tr
			idx[arr] = i
		end
		return i
	end
	local joints, motors = {}, {}
	for i, j in ipairs(d.joints) do joints[i] = { name = j.name, part0 = j.part0, part1 = j.part1, slot = slot(j.frames) } end
	for i, m in ipairs(d.allMotors or {}) do motors[i] = { name = m.name, parent = m.parent, slot = slot(m.samples) } end
	local info = animInfo[id] or {}
	return {
		rig = d.rig, length = d.length, looped = d.looped and true or false, source = d.source or "saved",
		priorityValue = d.priorityValue, priority = info.priority or "Action", tr = tr, joints = joints, motors = motors,
	}
end

X.origPack = {} -- [animId] = the GAME's own frames, before any edit: "Reset" goes back to these
function X.origRemember(id)
	local d = details[id]
	if X.origPack[id] or not d or d.fromSaved then return end
	local ok, pack = pcall(X.packAnim, id)
	if ok and pack then X.origPack[id] = pack end
end

function X.edsPack(id) -- what is saved: the edited frames + your edited effects (+ your own code edits, if any) + the game's original (for Reset)
	local old = X.eds.items[id]
	local it = { id = id, name = K.animName(id), t = os.time(), code = old and old.code or nil }
	local anim = X.packAnim(id)
	if anim then it.anim = anim end
	local list = X.fxEdit[id] or fxWindows.rawFor(id)
	if list and #list > 0 then
		local fx, nfx = {}, 0
		for _, e in ipairs(list) do
			if e.kind == "cam" or nfx < 300 then
				if e.kind ~= "cam" then nfx += 1 end
				fx[#fx + 1] = X.enc(e)
			end
		end
		it.fx = fx
	end
	it.orig = X.origPack[id] or (old and old.orig) or nil
	local raw = fxWindows.rawFor(id)
	if raw and #raw > 0 then
		local fo, nfo = {}, 0
		for _, e in ipairs(raw) do
			if e.kind == "cam" or nfo < 300 then
				if e.kind ~= "cam" then nfo += 1 end
				fo[#fo + 1] = X.enc(e)
			end
		end
		it.fxOrig = fo
	elseif old and old.fxOrig then
		it.fxOrig = old.fxOrig
	end
	return it
end

function X.renameAnim(id) -- one name everywhere: editors, Saved list, Saved edits
	X.prompt("Rename saved script", K.animName(id), function(text)
		local nv = tostring(text):match("^%s*(.-)%s*$")
		if nv == "" then return end
		nv = nv:sub(1, 60)
		animLabel[id] = nv
		local r = X.sv.map[id]
		if r then r.name = nv end
		local it = X.eds.items[id]
		if it then
			it.name = nv
			X.edsWrite()
		end
		out("Renamed to \"" .. nv .. "\".")
		X.svAfter()
	end)
end

-- a number that changes when the saved frames / effects change (so Save can tell "same save again" from "edited again")
function X.hashVal(v, h)
	local M = 2147483629
	local tv = type(v)
	if tv == "number" then
		if v ~= v or v == math.huge or v == -math.huge then return (h * 31 + 11) % M end
		return (h * 31 + (math.floor(v * 1e6 + 0.5) % 1000003) + 7) % M
	elseif tv == "string" then
		h = (h * 31 + #v) % M
		for i = 1, #v, 5 do h = (h * 31 + v:byte(i)) % M end
		return h
	elseif tv == "boolean" then
		return (h * 31 + (v and 3 or 5)) % M
	elseif tv == "table" then
		if #v > 0 then
			for _, x in ipairs(v) do h = X.hashVal(x, (h * 31 + 1) % M) end
		else
			local keys = {}
			for k in pairs(v) do keys[#keys + 1] = tostring(k) end
			table.sort(keys)
			for _, k in ipairs(keys) do
				h = X.hashVal(k, (h * 31 + 2) % M)
				local x = v[k]
				if x == nil then x = v[tonumber(k) or k] end
				h = X.hashVal(x, h)
			end
		end
		return h
	end
	return h
end

function X.itemSig(it)
	local ok, h = pcall(function()
		return X.hashVal(it.fx or false, X.hashVal(it.anim or false, 17))
	end)
	return ok and h or nil
end

function X.edsSave(id, btn)
	local function say(t)
		if btn and btn.Parent then K.flash(btn, t) end
	end
	local okP, it = pcall(X.edsPack, id)
	if not okP then
		out("Save failed: " .. tostring(it))
		return say("Fail")
	end
	if not it.anim and not it.fx then
		out("Nothing to save yet for this animation: capture its frames (Copy / Anim Editor) or its effects first.")
		return say("Nothing")
	end
	local old = X.eds.items[id]
	local archivedAs
	it.sig = X.itemSig(it)
	if old then
		if old.sig == nil then old.sig = X.itemSig(old) end
		if it.sig ~= nil and old.sig == it.sig then
			it.code = old.code -- nothing changed since the last save: same save, refreshed
		else
			-- edited again: the earlier save is NOT replaced, it stays as its own entry in Saved edits
			it.code = nil -- the old script text belongs to the old frames
			local stamp = tonumber(old.t) or os.time()
			local key = id .. "#s" .. tostring(stamp)
			while X.eds.items[key] do key = key .. "x" end
			old.id = key
			old.name = tostring(old.name or id):sub(1, 40) .. " (older save " .. os.date("%d/%m %H:%M:%S", stamp) .. ")"
			X.eds.items[key] = old
			local pos = table.find(X.eds.order, id)
			if pos then X.eds.order[pos] = key else table.insert(X.eds.order, key) end
			table.insert(X.eds.order, 1, id)
			archivedAs = old.name
			-- the older version also gets its own row in the Saved list (frames kept, works in any game)
			if #X.sv.list < 500 and not X.sv.map[key] then
				local r = { id = key, name = old.name, fav = false, t = stamp }
				table.insert(X.sv.list, r)
				X.sv.map[key] = r
			end
			if old.anim then
				local kit = table.clone(old)
				kit.kept, kit.code, kit.orig, kit.fxOrig = true, nil, nil, nil
				X.kept[key] = kit
				X.keptDirty = true
			end
			X.svDirty = true
		end
	else
		table.insert(X.eds.order, 1, id)
	end
	X.eds.items[id] = it
	if it.anim then -- the Saved list / Design Screen use the kept frames: they must be the EDITED ones
		local kit = table.clone(it)
		kit.kept, kit.code, kit.orig, kit.fxOrig = true, nil, nil, nil
		X.kept[id] = kit
		X.keptDirty = true
	end
	local wrote = X.edsWrite()
	out(string.format("Saved edit \"%s\" (%s%s)%s. It is in the Saved tab > Saved edits.", it.name, it.anim and "animation" or "", (it.anim and it.fx) and " + effects" or (it.fx and "effects" or ""),
		wrote and "" or " - this executor cannot write files, so it only lasts until you close the game"))
	if archivedAs then out("The earlier save was kept too: \"" .. archivedAs .. "\".") end
	say("Saved!")
	if X.svReady then X.svRender() end
end

function X.edsApply(id, src) -- put a saved edit (or kept frames) back into this session (Copy / Preview / editors then use it)
	local it = src or X.eds.items[id]
	if not it then return false end
	pcall(X.origRemember, id) -- the live frames are still the game's own: keep them for Reset before they are replaced
	if it.orig and not X.origPack[id] then X.origPack[id] = it.orig end
	if it.anim then
		local a = it.anim
		local tr = {}
		for i, rows in ipairs(a.tr) do
			local arr = {}
			for k, r in ipairs(rows) do
				arr[k] = { r[1], CFrame.new(r[2], r[3], r[4], r[5], r[6], r[7], r[8], r[9], r[10], r[11], r[12], r[13]) }
			end
			tr[i] = arr
		end
		local joints, motors = {}, {}
		for i, j in ipairs(a.joints) do joints[i] = { name = j.name, part0 = j.part0, part1 = j.part1, frames = tr[j.slot] } end
		for i, m in ipairs(a.motors or {}) do motors[i] = { name = m.name, parent = m.parent, samples = tr[m.slot] } end
		if #joints > 0 then
			details[id] = {
				rig = a.rig, length = a.length, looped = a.looped, joints = joints, allMotors = motors,
				priorityValue = a.priorityValue, cache = {}, rawFrames = #joints[1].frames, source = "saved edit", fromSaved = true,
			}
			X.aeData[id] = nil
			X.lens[id] = a.length
			rbxmxCache[id] = nil
			animInfo[id] = animInfo[id] or { priority = a.priority or "Action", looped = a.looped, speed = 1 }
		end
	end
	if it.fx then
		local list = {}
		for i, e in ipairs(it.fx) do list[i] = X.dec(e) end
		X.fxEdit[id] = list
		if X.ed and X.ed.id == id then
			X.ed.events = list
			X.ed.dirty = true
			X.edRefresh()
		end
	end
	if not animLabel[id] then animLabel[id] = it.name end
	pcall(refreshExtra, id)
	return true
end

X.shadow = {}
-- The SAVED version of an animation lives under its own hidden id ("<id>#saved"), so Reset / editing the live copy can never
-- change what the Saved tab, the Design Screen and "Saved edits" copy. Returns the id itself when nothing is saved.
function X.savedId(id)
	if tostring(id):find("#saved$") then return id end
	local src = X.eds.items[id] or X.kept[id]
	if not (src and src.anim) then return id end
	local sid = id .. "#saved"
	if X.shadow[sid] ~= src or not details[sid] then
		X.shadow[sid] = src
		pcall(X.edsApply, sid, src)
		animLabel[sid] = animLabel[id] or src.name
		if X.markers then X.markers[sid] = X.markers[id] end
		if not src.fx then
			local r = fxWindows.rawFor(id)
			X.fxEdit[sid] = r and table.clone(r) or nil
		end
	end
	return details[sid] and sid or id
end

function X.edsCode(id) -- the full script of a saved edit (your own edited text when you changed it)
	local it = X.eds.items[id]
	if not it then error("not saved") end
	if it.code and it.code ~= "" then return it.code end
	local sid = X.savedId(id) -- the saved copy, not the live working copy
	if sid ~= id and details[sid] then return K.buildAnimCode(sid, "all") end
	local list = {}
	for _, e in ipairs(it.fx or {}) do
		local c = X.dec(e)
		if not c.off then list[#list + 1] = c end
	end
	if #list > 0 then return K.genStandaloneFX(list, it.name) end
	error("nothing saved to build a script from")
end

