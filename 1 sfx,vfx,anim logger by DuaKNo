local CORNER_CLASSES = { Frame = true, TextButton = true, TextLabel = true, TextBox = true, ScrollingFrame = true }
function Th.styleCorner(o)
	if not CORNER_CLASSES[o.ClassName] or o:GetAttribute("NoCorner") then return end
	local uc = o:FindFirstChildOfClass("UICorner")
	local r = o:GetAttribute("WinCorner") and Th.cur.wcorner or Th.cur.corner
	if o.BackgroundTransparency >= 1 or r <= 0 then
		if uc then uc:Destroy() end
		return
	end
	if not uc then
		uc = Instance.new("UICorner")
		uc.Parent = o
	end
	uc.CornerRadius = UDim.new(0, r)
end
table.insert(Run.conns, gui.DescendantAdded:Connect(function(o) Th.styleCorner(o) end))

function Th.remap(col)
	for _, t in ipairs(Th.list) do
		for role, c in pairs(t.c) do
			if c == col then return C[role] end
		end
	end
	return col
end

local baseColor = setmetatable({}, { __mode = "k" })
local rowBase = setmetatable({}, { __mode = "k" })

function Th.apply(name)
	local new = Th.byName[name]
	if not new then return end
	local function key(c) return string.format("%.4f,%.4f,%.4f", c.R, c.G, c.B) end
	local map = {}
	for role, oc in pairs(C) do
		if new.c[role] then map[key(oc)] = new.c[role] end
	end
	local function m(c) return map[key(c)] end
	local oldFont, oldBold = Th.font, Th.bold

	for _, o in ipairs(gui:GetDescendants()) do
		if o:IsA("GuiObject") then
			local n = m(o.BackgroundColor3)
			if n then o.BackgroundColor3 = n end
			if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
				local t = m(o.TextColor3)
				if t then o.TextColor3 = t end
				if o.Font == oldBold then o.Font = new.bold elseif o.Font == oldFont then o.Font = new.font end
				if o:IsA("TextBox") then
					local p = m(o.PlaceholderColor3)
					if p then o.PlaceholderColor3 = p end
				end
			end
		elseif o:IsA("UIStroke") then
			local n = m(o.Color)
			if n then o.Color = n end
		end
	end
	for obj, col in pairs(baseColor) do
		local n = m(col)
		if n then baseColor[obj] = n end
	end
	for obj, col in pairs(rowBase) do
		local n = m(col)
		if n then rowBase[obj] = n end
	end

	Th.cur, Th.font, Th.bold = new, new.font, new.bold
	for role, col in pairs(new.c) do C[role] = col end
	for _, o in ipairs(gui:GetDescendants()) do Th.styleCorner(o) end
	for i = #Th.rerender, 1, -1 do
		local ok, alive = pcall(Th.rerender[i])
		if not ok or not alive then table.remove(Th.rerender, i) end
	end
end

function Th.refreshRows()
	for i = #Th.rerender, 1, -1 do
		local ok, alive = pcall(Th.rerender[i])
		if not ok or not alive then table.remove(Th.rerender, i) end
	end
end

