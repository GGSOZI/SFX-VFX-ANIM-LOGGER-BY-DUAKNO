function X.dsPayload()
	local list = {}
	for i, b in ipairs(X.ds.buttons) do
		list[i] = {
			label = b.label, anim = b.anim, x = b.x, y = b.y, size = b.size, mode = b.mode, cd = b.cd, speed = b.speed, key = b.key,
			dmg = b.dmg, dmgAmt = b.dmgAmt, range = b.range, delay = b.delay, npcOnly = b.npcOnly, remote = b.remote,
			type = b.type, code = b.code,
		}
	end
	return list
end

function X.dsGenerate(cb, noWait)
	if #X.ds.buttons == 0 and not X.ds.joy and not X.ds.jump then return X.dsMsg("add a button (+ Button), the joystick (+ Joystick) or the jump button (+ Jump) first") end
	local function busy()
		for _, bb in ipairs(X.ds.buttons) do
			if bb.codeInfo == "generating..." then return true end
		end
		if X.ds.jump and X.ds.jump.codeInfo == "generating..." then return true end
		if X.ds.joy and X.ds.joy.codeInfo == "generating..." then return true end
		return false
	end
	if not noWait and busy() then
		X.dsMsg("still building the button scripts, one moment...")
		task.spawn(function()
			local t0 = os.clock()
			while busy() and os.clock() - t0 < 90 do task.wait(0.3) end
			X.dsGenerate(cb, true)
		end)
		return
	end
	local noAnim = {}
	for _, b in ipairs(X.ds.buttons) do
		if b.anim == "" then noAnim[#noAnim + 1] = b.label end
	end
	if #noAnim > 0 then -- still builds: those buttons just do nothing until you pick an animation (tap the button)
		X.dsMsg("no animation yet on: " .. table.concat(noAnim, ", ") .. " (tap the button to pick one)")
	end
	local notReady = {}
	for _, bb in ipairs(X.ds.buttons) do
		if bb.type ~= "id" and bb.anim ~= "" and bb.code == "" then notReady[#notReady + 1] = bb.label end
	end
	if #notReady > 0 then -- those buttons fall back to playing the AnimationId
		X.dsMsg("no script built yet on: " .. table.concat(notReady, ", ") .. " (tap the button > Script to rebuild)")
	end
	if not X.REQUIRE_KEY then -- built right here: no server, no key
		local okB, code = pcall(X.dsLocal)
		if not okB then return out("Design Script: " .. tostring(code)) end
		return cb(code)
	end
	out("Design Script: asking your server to build the script...")
	task.spawn(function()
		local data, err = X.httpPost("/generate", { key = X.access.key, userId = lp.UserId, hwid = X.hwid(), buttons = X.dsPayload(), joystick = X.ds.joy and { x = X.ds.joy.x, y = X.ds.joy.y, size = X.ds.joy.size, deadzone = X.ds.joy.deadzone, runAt = X.ds.joy.runAt, sprintAt = X.ds.joy.sprintAt, walkSpeed = X.ds.joy.walkSpeed, runSpeed = X.ds.joy.runSpeed, sprintSpeed = X.ds.joy.sprintSpeed, animSpeed = X.ds.joy.animSpeed, strafe = X.ds.joy.strafe, hideDefault = X.ds.joy.hideDefault, a = X.ds.joy.a } or nil, jump = X.ds.jump })
		if not data then
			out("Design Script: " .. tostring(err))
			return
		end
		cb(data.script)
	end)
end

-- Design Script is built right here. Set X.REQUIRE_KEY = true to bring back the owner-server key check.
X.REQUIRE_KEY = false

X.DS_RUNTIME = [==[
-- Uses Roblox's OWN controls: the thumbstick, the jump button and ContextActionService touch buttons.
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local CAS = game:GetService("ContextActionService")
local lp = Players.LocalPlayer
local env = (getgenv and getgenv()) or _G
if env.__DuaDesignStop then pcall(env.__DuaDesignStop) end

local alive, conns, tracks, casNames = true, {}, {}, {}
local function conn(c)
	conns[#conns + 1] = c
	return c
end

local function getHum()
	local ch = lp.Character
	return ch and ch:FindFirstChildOfClass("Humanoid"), ch
end

local function loadTrack(id, prio)
	local hum = getHum()
	if not hum or id == nil or id == "" then return nil end
	if not id:find("^rbx") and id:match("^%d+$") then id = "rbxassetid://" .. id end
	local key = id .. "|" .. prio.Name
	local c = tracks[key]
	if c and c.hum == hum then return c.track end
	local animator = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 2)
	if not animator then return nil end
	local a = Instance.new("Animation")
	a.AnimationId = id
	local ok, tr = pcall(function() return animator:LoadAnimation(a) end)
	if not ok or not tr then return nil end
	tr.Priority = prio
	tracks[key] = { hum = hum, track = tr }
	return tr
end

local function remoteFor(path)
	if path == nil or path == "" then return nil end
	local cur = game
	for part in path:gmatch("[^%.]+") do
		if part ~= "game" then
			cur = cur and cur:FindFirstChild(part)
		end
	end
	return cur
end

-- ===== stored scripts (Frames / Full-FX anim types) =====
local codeFns = {}
local function codeRun(code, speed, loop) -- runs one stored script (cached), speed / loop patched in
	local per = codeFns[code]
	if not per then
		per = {}
		codeFns[code] = per
	end
	local k = tostring(speed) .. "|" .. tostring(loop)
	local fn = per[k]
	if fn == nil then
		local src = code
		src = src:gsub("local SPEED = [^\n]*", "local SPEED = " .. tostring(speed), 1)
		src = src:gsub("local LOOP_FOREVER = [^\n]*", "local LOOP_FOREVER = " .. tostring(loop), 1)
		src = src:gsub("local CANCEL_ON_MOVE = [^\n]*", "local CANCEL_ON_MOVE = false", 1)
		local loader = loadstring or load
		fn = loader and loader(src) or false
		per[k] = fn
	end
	if fn then task.spawn(fn) end
end
local function codeStop()
	local st = _G.StopRecreatedAnim
	if st then pcall(st) end
end

-- ===== move buttons: ContextActionService (touch button on mobile, key on PC) =====
local function px(cfg)
	local vp = workspace.CurrentCamera.ViewportSize
	return math.max(math.floor(cfg.size * vp.X + 0.5), 24)
end

local casList = {}
local function bindBtn(cfg, name, onBegin, onEnd)
	-- same recipe as the JJS moveset: BindAction with createTouchButton = true and a real input, then SetTitle;
	-- the layout loop below keeps size + position right (CAS re-lays its buttons out by itself)
	local key
	if cfg.key and cfg.key ~= "" then
		local okK, kc = pcall(function() return Enum.KeyCode[cfg.key] end)
		if okK and kc then key = kc end
	end
	local okB = pcall(function()
		CAS:BindAction(name, function(_, state)
			if state == Enum.UserInputState.Begin then
				onBegin()
			elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
				onEnd()
			end
			return Enum.ContextActionResult.Pass
		end, true, key or Enum.KeyCode.F13)
	end)
	if not okB then return end
	casNames[#casNames + 1] = name
	casList[#casList + 1] = { name = name, cfg = cfg }
	pcall(function() CAS:SetTitle(name, cfg.label) end)
end

local function layoutCas()
	for _, it in ipairs(casList) do
		local btn = CAS:GetButton(it.name)
		local sg = btn and btn:FindFirstAncestorOfClass("ScreenGui")
		local parent = btn and btn.Parent
		if sg and parent then
			local size = px(it.cfg)
			local pa, sp, ss = parent.AbsolutePosition, sg.AbsolutePosition, sg.AbsoluteSize
			btn.AnchorPoint = Vector2.new(0.5, 0.5)
			btn.Size = UDim2.fromOffset(size, size)
			btn.Position = UDim2.fromOffset(sp.X + it.cfg.x * ss.X - pa.X, sp.Y + it.cfg.y * ss.Y - pa.Y)
		end
	end
end

for i, cfg in ipairs(BUTTONS) do
	local casName = "DuaBtn" .. i
	local cdUntil, active = 0, false
	local function dim(v)
		local b = CAS:GetButton(casName)
		if b then pcall(function() b.ImageTransparency = v end) end
	end
	local function getTr() -- a stored script behaves like a track: Play / Stop
		if cfg.code and cfg.code ~= "" then
			return { Looped = false, Play = function() codeRun(cfg.code, cfg.speed, cfg.mode ~= "once") end, Stop = function() codeStop() end }
		end
		return loadTrack(cfg.anim, Enum.AnimationPriority.Action4)
	end

	local function doDamage()
		if not cfg.dmg then return end
		local hum, ch = getHum()
		local root = ch and ch:FindFirstChild("HumanoidRootPart")
		if not root then return end
		local params = OverlapParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { ch }
		local hit = {}
		for _, p in ipairs(workspace:GetPartBoundsInRadius(root.Position, cfg.range, params)) do
			local m = p:FindFirstAncestorOfClass("Model")
			if m and not hit[m] then
				local h = m:FindFirstChildOfClass("Humanoid")
				if h and h.Health > 0 and not (cfg.npcOnly and Players:GetPlayerFromCharacter(m)) then
					hit[m] = true
					local rem = remoteFor(cfg.remote)
					if rem and rem:IsA("RemoteEvent") then
						pcall(function() rem:FireServer(m, cfg.dmgAmt) end)
					elseif rem and rem:IsA("RemoteFunction") then
						pcall(function() rem:InvokeServer(m, cfg.dmgAmt) end)
					else
						pcall(function() h:TakeDamage(cfg.dmgAmt) end)
					end
				end
			end
		end
	end

	local function start()
		local tr = getTr()
		if not tr then return end
		if cfg.mode == "once" then
			if os.clock() < cdUntil then return end
			cdUntil = os.clock() + cfg.cd
			tr.Looped = false
			tr:Play(0.1, 1, cfg.speed)
			if cfg.dmg then task.delay(cfg.delay, doDamage) end
			if cfg.cd > 0.15 then
				dim(0.6)
				task.delay(cfg.cd, function() dim(0) end)
			end
		elseif cfg.mode == "toggle" and active then
			active = false
			tr:Stop(0.15)
			dim(0)
		elseif not active then
			active = true
			tr.Looped = true
			tr:Play(0.1, 1, cfg.speed)
			dim(0.5)
			if cfg.dmg then
				task.spawn(function()
					while active and alive do
						task.wait(math.max(cfg.delay, 0.3))
						if active then doDamage() end
					end
				end)
			end
		end
	end

	local function release()
		if cfg.mode == "hold" and active then
			active = false
			local tr = getTr()
			if tr then tr:Stop(0.15) end
			dim(0)
		end
	end

	bindBtn(cfg, casName, start, release)
end
task.spawn(function()
	while alive do
		pcall(layoutCas)
		task.wait(0.5)
	end
end)

-- ===== joystick: Roblox's own thumbstick (how far you push it picks idle / walk / run / sprint) =====
local locoTrack, locoState, locoStop = nil, "", nil
if JOY then
	local function setLoco(key)
		if key == locoState then return end
		local code = JOY.codes and JOY.codes[key]
		local hasCode = code ~= nil and code ~= ""
		if hasCode or locoStop then
			-- a button move is playing: leave it alone and try again next frame
			if _G.StopRecreatedAnim ~= nil and _G.StopRecreatedAnim ~= locoStop then return end
		end
		locoState = key
		if locoTrack then
			locoTrack:Stop(0.2)
			locoTrack = nil
		end
		if locoStop and _G.StopRecreatedAnim == locoStop then codeStop() end
		locoStop = nil
		if hasCode then
			codeRun(code, JOY.animSpeed, true)
			locoStop = _G.StopRecreatedAnim
			return
		end
		local id = JOY.a[key]
		if id and id ~= "" then
			local tr = loadTrack(id, Enum.AnimationPriority.Action)
			if tr then
				tr.Looped = true
				tr:Play(0.2, 1, JOY.animSpeed)
				locoTrack = tr
			end
		end
	end

	conn(RunService.RenderStepped:Connect(function()
		local hum, ch = getHum()
		local root = ch and ch:FindFirstChild("HumanoidRootPart")
		if not hum or not root or hum.Health <= 0 then return end
		local moveDir = hum.MoveDirection
		local m = moveDir.Magnitude
		local tier = "idle"
		if m > JOY.deadzone then
			if m < JOY.runAt then tier = "walk" elseif m < JOY.sprintAt then tier = "run" else tier = "sprint" end
		end
		local spd = JOY.walkSpeed
		if tier == "run" then spd = JOY.runSpeed elseif tier == "sprint" then spd = JOY.sprintSpeed end
		hum.WalkSpeed = spd
		local key = tier
		if JOY.strafe then
			hum.AutoRotate = false
			local cf = workspace.CurrentCamera.CFrame
			local fwd = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
			if fwd.Magnitude > 0 then
				fwd = fwd.Unit
				root.CFrame = root.CFrame:Lerp(CFrame.lookAt(root.Position, root.Position + fwd), 0.35)
			end
			if tier ~= "idle" and moveDir.Magnitude > 0.1 then
				local rel = root.CFrame:VectorToObjectSpace(moveDir)
				if rel.Z > 0.5 and JOY.a.back ~= "" then
					key = "back"
				elseif rel.X < -0.6 and JOY.a.left ~= "" then
					key = "left"
				elseif rel.X > 0.6 and JOY.a.right ~= "" then
					key = "right"
				end
			end
		else
			hum.AutoRotate = true
		end
		if JOY.a[key] == "" and key ~= "idle" then key = (JOY.a[tier] ~= "") and tier or "walk" end
		if locoStop and _G.StopRecreatedAnim == nil then locoState = "" end -- our script ended (a move finished): start it again
		setLoco(key)
	end))
end

-- ===== jump: Roblox's own jump button / space bar (animation + extra jumps + height + fall animation) =====
local airJumps, lastJump, fallActive, fallStop = 0, 0, false, nil
if JUMP then
	local function jumpTr() -- a stored jump script behaves like a track
		if JUMP.code and JUMP.code ~= "" then
			return { Looped = false, Play = function() codeRun(JUMP.code, 1, false) end, Stop = function() codeStop() end }
		end
		return loadTrack(JUMP.anim, Enum.AnimationPriority.Action2)
	end

	conn(UIS.JumpRequest:Connect(function()
		local hum, ch = getHum()
		local root = ch and ch:FindFirstChild("HumanoidRootPart")
		if not hum or not root or hum.Health <= 0 then return end
		if os.clock() - lastJump < 0.2 then return end
		local grounded = hum.FloorMaterial ~= Enum.Material.Air
		if grounded then
			airJumps = 0 -- Roblox does this jump itself
		elseif airJumps < JUMP.extra then
			airJumps = airJumps + 1
			local power = math.sqrt(2 * workspace.Gravity * JUMP.height)
			local v = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(v.X, power, v.Z)
		else
			return
		end
		lastJump = os.clock()
		local tr = jumpTr()
		if tr then
			tr.Looped = false
			tr:Play(0.05, 1, 1)
		end
	end))

	conn(RunService.Heartbeat:Connect(function()
		local hum, ch = getHum()
		local root = ch and ch:FindFirstChild("HumanoidRootPart")
		if not hum or not root then return end
		pcall(function()
			hum.UseJumpPower = false
			hum.JumpHeight = JUMP.height
		end)
		if hum.FloorMaterial ~= Enum.Material.Air then airJumps = 0 end
		local falling = hum:GetState() == Enum.HumanoidStateType.Freefall and root.AssemblyLinearVelocity.Y < -8
		if JUMP.fallCode and JUMP.fallCode ~= "" then
			if falling and not fallActive then
				fallActive = true
				codeRun(JUMP.fallCode, 1, true)
				fallStop = _G.StopRecreatedAnim
			elseif not falling and fallActive then
				fallActive = false
				if fallStop and _G.StopRecreatedAnim == fallStop then codeStop() end
				fallStop = nil
			end
		elseif JUMP.fall ~= "" then
			local ft = loadTrack(JUMP.fall, Enum.AnimationPriority.Action2)
			if ft then
				if falling and not ft.IsPlaying then
					ft.Looped = true
					ft:Play(0.15)
				elseif not falling and ft.IsPlaying then
					ft:Stop(0.1)
				end
			end
		end
	end))
end

conn(lp.CharacterAdded:Connect(function()
	table.clear(tracks)
	locoTrack, locoState, locoStop = nil, "", nil
	fallActive, fallStop = false, nil
end))

env.__DuaDesignStop = function()
