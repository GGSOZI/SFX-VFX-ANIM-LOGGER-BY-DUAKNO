function X.logCam(seg) -- a row in the OBJ tab for a cutscene camera
	local ev = seg.ev
	local pts = ev.cam and #ev.cam or 0
	if pts < 2 then return end
	local dur = ev.cam[pts][1] or 0
	if not ev.dur or ev.dur <= 0 then ev.dur = dur end
	local key = "cam|" .. math.floor(seg.start * 10)
	local function script() return K.genStandaloneFX({ ev }, "Cutscene camera") end
	local detail = string.format("Cutscene camera | %d points | %.1fs\nThe game took over your camera (Scriptable / fixed / looking at something that is not you).", pts, dur)
	local actions = {
		act("Copy", function(btn)
			toClip(script(), "the cutscene camera script")
			K.flash(btn, "Copied!")
		end, C.sel, 1, 1),
		runAct(function() K.runEvents({ ev }, "Cutscene camera") end, 1, 0.9),
		act("VIEW FULL CODE", function()
			openViewer("Cutscene camera", { { name = "Script", get = function(cb) cb(script()) end } }, 1)
		end, C.sel, 1, 2.2),
		act("To library", function(btn) X.libSave({ ev }, "Cutscene camera " .. string.format("%.1fs", dur), btn) end, C.green, 2),
	}
	addEntry("OBJ", key, string.format("CAMERA: cutscene %.1fs", dur), detail, "cutscene camera", actions, Color3.fromRGB(190, 125, 235))
end

-- cutscene camera: watched all the time, so cutscenes are caught even when nothing plays on your own character
function X.camActive(c)
	if workspace:GetAttribute("_ReplayCam") then return false end -- our own replay
	local ct = c.CameraType
	if ct == Enum.CameraType.Scriptable or ct == Enum.CameraType.Fixed or ct == Enum.CameraType.Watch
		or ct == Enum.CameraType.Attach or ct == Enum.CameraType.Track then
		return true
	end
	local subj, ch = c.CameraSubject, lp.Character
	if subj ~= nil and ch ~= nil and not subj:IsDescendantOf(ch) then return true end -- looking at something that is not you
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	if root then
		local dist = (c.CFrame.Position - root.Position).Magnitude
		if dist > 200 then return true end -- far from you
		-- normal (Custom) camera but further away than the zoom limit allows: the game moves the camera itself
		local okZ, maxZ = pcall(function() return lp.CameraMaxZoomDistance end)
		if okZ and type(maxZ) == "number" and dist > maxZ + 12 then return true end
	end
	return false
end

function X.camAttachFinal(seg, wl) -- the finished camera path, trimmed to start with the animation, goes into that animation's effects
	local ev = seg.ev
	local segId = math.floor(seg.start * 100)
	local shift = math.max(wl.start - seg.start, 0)
	local cl = table.clone(ev)
	cl.segId = segId
	if shift > 0 then
		local pts = {}
		for _, pt in ipairs(ev.cam) do
			if pt[1] >= shift then pts[#pts + 1] = { pt[1] - shift, pt[2], pt[3] } end
		end
		if #pts < 2 then return end
		cl.cam = pts
		cl.t = 0
	else
		cl.t = seg.start - wl.start
	end
	cl.dur = cl.cam[#cl.cam][1]
	local out = {}
	for _, e in ipairs(animFX[wl.id] or {}) do
		if not (e.kind == "cam" and e.segId == segId) then out[#out + 1] = e end
	end
	animFX[wl.id] = fxWindows.merge(out, { cl })
	pcall(refreshExtra, wl.id)
end

function X.camEnd(seg)
	X.camSeg = nil
	X.camIdle = nil
	seg.endT = seg.endT or os.clock()
	if not K.camKeep(seg.ev) then return end
	pcall(X.logCam, seg)
	local hit = false
	for _, wl in ipairs(X.winLog) do -- every recent animation this camera move overlaps
		if seg.start <= wl.finish + 1.5 and seg.endT >= wl.start - 1 then
			X.camAttachFinal(seg, wl)
			hit = true
		end
	end
	if hit then
		seg.attached = true
		return
	end
	local la = X.lastAnim
	if la and seg.start >= la.start - (X.pre + 2) and seg.start - la.start < 12 then -- no overlap: the animation that just played
		X.camAttachFinal(seg, { id = la.id, start = la.start })
		seg.attached = true
	end
end

function X.camStep()
	local c = workspace.CurrentCamera
	if not c then return end
	local ch = lp.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	if root then X.lastRootCF = root.CFrame end
	local rootCF = (root and root.CFrame) or X.lastRootCF -- a cutscene may remove / freeze your character: keep the last place you stood
	if not rootCF then return end
	local now = os.clock()
	local seg = X.camSeg
	local forced = X.camForceUntil ~= nil and now < X.camForceUntil
	if X.camActive(c) or forced then
		X.camIdle = nil
		if not seg then
			seg = { start = now, rootCF = rootCF, ev = { kind = "cam", name = "Cutscene camera", t = 0, props = {}, cam = {}, dur = 0, segId = math.floor(now * 100), forced = forced or nil } }
			X.camSeg = seg
			X.camLastOn = now
			for _, pc in ipairs(X.pendCut) do -- animations that started just before the takeover are cutscene animations
				if now - pc.t < 6 then
					X.forceCut[pc.track] = true
					task.defer(logAnim, pc.animator, pc.track)
				end
			end
			X.pendCut = {}
			table.insert(X.camSegs, seg)
			while #X.camSegs > 12 do table.remove(X.camSegs, 1) end
			for _, w in ipairs(fxWindows) do
				if now <= w.finish then
					seg.attached = true
					local cl = table.clone(seg.ev)
					cl.t = math.max(now - w.start, 0)
					table.insert(w.events, cl)
				end
			end
		end
		if forced then seg.ev.forced = true end
		local dt = now - seg.start
		local pts = seg.ev.cam
		local last = pts[#pts]
		if dt < 150 and #pts < 2600 and (not last or dt - last[1] >= 0.04) then
			pts[#pts + 1] = { dt, seg.rootCF:ToObjectSpace(c.CFrame), c.FieldOfView }
		end
	elseif seg then
		-- the game may hand the camera back for a frame or two in the middle of a cutscene: wait before ending it
		X.camIdle = X.camIdle or now
		if now - X.camIdle >= 0.5 then
			seg.endT = X.camIdle
			X.camEnd(seg)
		end
	end
end

