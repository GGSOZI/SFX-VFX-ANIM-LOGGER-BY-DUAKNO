	filter = "", compact = false, deep = true, thorough = false, guess = false, pre = 3,
	markers = {}, lastRow = setmetatable({}, { __mode = "k" }), compactButtons = {}, sizeIdx = 2,
}
do
	local env = (getgenv and getgenv()) or _G
	local prev = env.__AnimVFXLogger
	if type(prev) == "table" and type(prev.cleanup) == "function" then pcall(prev.cleanup) end
	local pg = lp:FindFirstChildOfClass("PlayerGui")
	if pg then
		for _, old in ipairs(pg:GetChildren()) do
			if old.Name == "AnimVFXLogger" then pcall(function() old:Destroy() end) end
		end
	end
	env.__AnimVFXLogger = Run
end

