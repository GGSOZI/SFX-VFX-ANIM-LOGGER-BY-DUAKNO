--// Frames kept with saved anims: an animation can only be loaded in the game that owns it, so the frames are stored in a file ----
X.KEPT_FILE = "AnimLogger_frames.json"
X.keepFail = {}

function X.keptLoad()
	if not (isfile and readfile) then return end
	local ok, data = pcall(function()
		if isfile(X.KEPT_FILE) then return HttpService:JSONDecode(readfile(X.KEPT_FILE)) end
	end)
	if ok and type(data) == "table" and type(data.items) == "table" then
		for id, it in pairs(data.items) do
			if type(it) == "table" and type(it.anim) == "table" then X.kept[id] = it end
		end
	end
end

function X.keptWrite()
	if not writefile then return end
	local ok, json = pcall(function() return HttpService:JSONEncode({ v = 1, items = X.kept }) end)
	if ok and #json < 24000000 then pcall(writefile, X.KEPT_FILE, json) end
end

function X.keepFrames(id, btn) -- capture (when this game allows it) and store the frames of a saved anim
	if X.kept[id] or X.keepBusy then
		if btn and btn.Parent then K.flash(btn, X.kept[id] and "Kept" or "Busy") end
		return
	end
	X.keepBusy = true
	if btn and btn.Parent then btn.Text = "Working..." end
	task.spawn(function()
		local ok, err = pcall(function()
			if not details[id] then
				local finished = false
				requestDetail(id, function() finished = true end)
				local t0 = os.clock()
				while not finished and os.clock() - t0 < 45 do task.wait(0.25) end
			end
			if not details[id] then error("this game cannot load the animation") end
			local it = X.edsPack(id)
			it.kept, it.code, it.orig, it.fxOrig = true, nil, nil, nil
			if not it.anim then error("no frames") end
			X.kept[id] = it
			X.keptDirty = true
		end)
		X.keepBusy = false
		if not ok then
			X.keepFail[id] = true
			out("Could not keep the frames of " .. tostring(animLabel[id] or id) .. ": " .. tostring(err) .. ". Open this saved anim in the game it comes from and press Keep.")
		end
		if X.svReady then X.svRender() end
	end)
end

function X.keepNext() -- saved anims whose frames are already known are kept automatically
	for _, r in ipairs(X.sv.list) do
		if not X.kept[r.id] and details[r.id] and not X.keepFail[r.id] then return X.keepFrames(r.id) end
	end
end
X.keptLoad()

--// Anim types for Design Screen buttons + Save all ---------------------------------------------------
X.DS_TYPES = {
	{ key = "id", name = "AnimationId (original)" },
	{ key = "frames", name = "Frames (no original)", mode = false },
	{ key = "vfx", name = "Frames + VFX", mode = "vfx" },
	{ key = "sfx", name = "Frames + SFX", mode = "sfx" },
	{ key = "fx", name = "Full-FX (VFX + SFX)", mode = "fx" },
	{ key = "cut", name = "Full-FX + cutscene", mode = "cut" },
	{ key = "all", name = "Full-FX everything", mode = "all" },
}
X.dsTok = setmetatable({}, { __mode = "k" })

function X.dsTypeIndex(key)
	for i, t in ipairs(X.DS_TYPES) do
		if t.key == key then return i end
	end
	return 1
end

function X.saveAll(id, btn) -- keyframes + effects + code of one animation, kept in files (works in any game)
	local function say(t)
		if btn and btn.Parent then K.flash(btn, t) end
	end
	if not details[id] then return say("No frames") end
	do
		local okP, it = pcall(X.edsPack, id)
		if okP and it and it.anim then
			it.kept, it.code, it.orig, it.fxOrig = true, nil, nil, nil
			X.kept[id] = it
			X.keptDirty = true
		end
	end
	if not X.sv.map[id] then X.svToggle(id, animLabel[id] or K.animName(id)) end
	X.edsSave(id, btn)
end

function X.saveAllBtn(id, btn)
	if btn and btn.Parent then btn.Text = "Working..." end
	requestDetail(id, function(ok, res)
		if not ok then
			out("Save all failed: " .. tostring(res))
			if btn and btn.Parent then K.flash(btn, "Fail") end
			return
		end
		X.saveAll(id, btn)
	end, function(t)
		if btn and btn.Parent then btn.Text = t:sub(1, 16) end
	end)
end

function X.dsBuildCode(id, t, cb) -- cb(ok, code | error text, info text)
	task.spawn(function()
		local ok, res, info = pcall(function()
			local rid = X.savedId(id)
			local done, okD, resD = false, false, nil
			requestDetail(rid, function(o, r)
				done, okD, resD = true, o, r
			end)
			local t0 = os.clock()
			while not done and os.clock() - t0 < 90 do task.wait(0.2) end
			if not done then error("timed out loading the animation") end
			if not okD or not details[rid] then
				error(tostring(resD or "this game cannot load the animation (use a saved anim with kept frames)"))
			end
			local code = K.buildAnimCode(rid, t.mode)
			local fxN = 0
			if t.mode then fxN = #(K.fxFilter(fxWindows.liveFor(rid), t.mode) or {}) end
			if rid == id then pcall(X.saveAll, id) end -- never overwrite a saved edit with the live copy
			return code, string.format("ready, %d KB%s", math.max(1, math.floor(#code / 1024)), t.mode and string.format(", %d effect(s)", fxN) or "")
		end)
		cb(ok, ok and res or tostring(res), info)
	end)
end

function X.dsRefreshUI()
	pcall(function()
		if X.dsWin then
			X.dsDraw()
			X.dsProps()
		end
	end)
end

function X.dsGenJump(j) -- jump AND fall animation as stored scripts
	local t = X.DS_TYPES[X.dsTypeIndex(j.type)]
	j.type = t.key
	X.svDirty = true
	j.code, j.fallCode = "", ""
	local tok = (X.dsTok[j] or 0) + 1
	X.dsTok[j] = tok
	if t.key == "id" then
		j.codeInfo = ""
		return
	end
	if j.anim == "" and j.fall == "" then
		j.codeInfo = "pick an animation first"
		return
	end
	j.codeInfo = "generating..."
	task.spawn(function()
		local made, failed = 0, {}
		for _, slot in ipairs({ { "anim", "code", "jump" }, { "fall", "fallCode", "fall" } }) do
			local id = j[slot[1]]
			if id ~= "" then
				local done = false
				X.dsBuildCode(id, t, function(ok, res)
					if X.dsTok[j] == tok then
						if ok then
							j[slot[2]] = res
							made += 1
						else
							failed[#failed + 1] = slot[3]
						end
					end
					done = true
				end)
				while not done do task.wait(0.1) end
				if X.dsTok[j] ~= tok then return end
			end
		end
		j.codeInfo = string.format("ready, %d anim(s)%s", made, #failed > 0 and (", failed: " .. table.concat(failed, ", ")) or "")
		X.svDirty = true
		X.dsRefreshUI()
	end)
end

X.JOY_KEYS = { "idle", "walk", "run", "sprint", "back", "left", "right" }

function X.dsGenJoy(j) -- one stored script per joystick animation (idle, walk, run, ...)
	local t = X.DS_TYPES[X.dsTypeIndex(j.type)]
	j.type = t.key
	X.svDirty = true
	for _, k in ipairs(X.JOY_KEYS) do j.codes[k] = "" end
	local tok = (X.dsTok[j] or 0) + 1
	X.dsTok[j] = tok
	if t.key == "id" then
		j.codeInfo = ""
		return
	end
	j.codeInfo = "generating..."
	task.spawn(function()
		local made, failed = 0, {}
		for _, key in ipairs(X.JOY_KEYS) do
			local id = j.a[key]
			if id ~= "" then
				local done = false
				X.dsBuildCode(id, t, function(ok, res)
					if X.dsTok[j] == tok then
						if ok then
							j.codes[key] = res
							made += 1
						else
							failed[#failed + 1] = key
						end
					end
					done = true
				end)
				while not done do task.wait(0.1) end
				if X.dsTok[j] ~= tok then return end
			end
		end
		if made == 0 and #failed == 0 then
			j.codeInfo = "pick animations first"
		else
			j.codeInfo = string.format("ready, %d anim(s)%s", made, #failed > 0 and (", failed: " .. table.concat(failed, ", ")) or "")
		end
		X.svDirty = true
		X.dsRefreshUI()
	end)
end

function X.dsGenCode(b) -- builds the script for the button's anim type and stores it inside the button
	local t = X.DS_TYPES[X.dsTypeIndex(b.type)]
	b.type = t.key
	local tok = (X.dsTok[b] or 0) + 1
	X.dsTok[b] = tok
	X.svDirty = true
	if t.key == "id" or b.anim == "" then
		b.code, b.codeFor = "", ""
		b.codeInfo = (t.key ~= "id") and "pick an animation first" or ""
		return
	end
	local id = b.anim
	b.code, b.codeFor, b.codeInfo = "", "", "generating..."
	task.spawn(function()
		local okAll, err = pcall(function()
			local rid = X.savedId(id)
			local done, okD, resD = false, false, nil
			requestDetail(rid, function(ok, res)
				done, okD, resD = true, ok, res
			end)
			local t0 = os.clock()
			while not done and os.clock() - t0 < 90 do task.wait(0.2) end
			if not done then error("timed out loading the animation") end
			if not okD or not details[rid] then
				error(tostring(resD or "this game cannot load the animation (use a saved anim with kept frames)"))
			end
			local code = K.buildAnimCode(rid, t.mode)
			if X.dsTok[b] ~= tok then return end
			local fxN = 0
			if t.mode then fxN = #(K.fxFilter(fxWindows.liveFor(rid), t.mode) or {}) end
			b.code, b.codeFor = code, id .. "|" .. t.key
			b.codeInfo = string.format("ready, %d KB%s", math.max(1, math.floor(#code / 1024)), t.mode and string.format(", %d effect(s)", fxN) or "")
			if rid == id then pcall(X.saveAll, id) end -- never overwrite a saved edit with the live copy
		end)
		if not okAll and X.dsTok[b] == tok then
			b.code, b.codeInfo = "", "failed: " .. tostring(err):sub(1, 60)
			out("Design Script: could not build the script for " .. tostring(b.label) .. ": " .. tostring(err))
		end
		X.svDirty = true
		pcall(function()
			if X.dsWin then
				X.dsDraw()
				X.dsProps()
			end
		end)
	end)
end

