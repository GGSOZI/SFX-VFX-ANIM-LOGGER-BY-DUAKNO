--// Frame-by-frame generation queue ------------------------------------------------------
local function extraFor(id)
	local parts = {}
	if details[id] then
		local ok, s = pcall(K.summaryFor, id)
		if ok then parts[#parts + 1] = s end
	elseif detailErr[id] then
		parts[#parts + 1] = "Frame-by-frame failed: " .. detailErr[id]
	end
	local fx = animFX[id]
	if fx and #fx > 0 then
		local v, s = 0, 0
		for _, e in ipairs(fx) do
			if e.kind == "vfx" then v += 1 else s += 1 end
		end
		parts[#parts + 1] = string.format("FX seen with this anim: %d VFX, %d SFX", v, s)
	end
	return #parts > 0 and table.concat(parts, "\n") or nil
end

local function refreshExtra(id)
	local text = extraFor(id)
	if not text then return end
	for _, ent in ipairs(entriesById[id] or {}) do pcall(ent.setExtra, text) end
end

local function sendProgress(id, text)
	for _, f in ipairs(progressListeners[id] or {}) do pcall(f, text) end
end

-- cb(ok, record | error); progress(text) is optional
local function requestDetail(id, cb, progress)
	if details[id] then
		if cb then cb(true, details[id]) end
		return
	end
	if progress then
		progressListeners[id] = progressListeners[id] or {}
		table.insert(progressListeners[id], progress)
		progress("Waiting...")
	end
	local job = detailJobs[id]
	if job then
		if cb then table.insert(job, cb) end
		return
	end
	detailJobs[id] = { cb }
	table.insert(detailQueue, id)

	if detailWorking then return end
	detailWorking = true
	task.spawn(function()
		while #detailQueue > 0 do
			local nextId = table.remove(detailQueue, 1)
			local ok, res = pcall(K.captureDetail, nextId, function(t) sendProgress(nextId, t) end)
			local callbacks = detailJobs[nextId]
			detailJobs[nextId] = nil
			if ok then
				details[nextId] = res
				detailErr[nextId] = nil
				sendProgress(nextId, "Simplifying frames...")
				pcall(K.simplified, nextId)
			else
				detailErr[nextId] = tostring(res)
			end
			progressListeners[nextId] = nil
			refreshExtra(nextId)
			for _, f in ipairs(callbacks or {}) do pcall(f, ok, res) end
		end
		detailWorking = false
	end)
end

local function requestRbxmx(id, cb) -- cb(ok, xmlOrError, source)
	requestDetail(id, function(ok, res)
		if not ok then return cb(false, res) end
		local cached = rbxmxCache[id]
		if cached then return cb(true, cached.xml, cached.source) end
		local okX, xml = pcall(K.rbxmxFromCapture, "Anim_" .. (id:match("%d+") or "x"), res.looped, res.priorityValue, res.allMotors)
		if not okX then return cb(false, xml) end
		rbxmxCache[id] = { xml = xml, source = "captured" }
		cb(true, xml, "captured")
	end)
end

--// FX recording (VFX / SFX that happen with an animation) ------------------------------------
-- Ways the logger makes sure nothing is missed:
--  1. a rolling buffer remembers every effect/sound near you for the last few seconds, so
--     effects that fired BEFORE the animation was detected are pulled in when it starts;
--  2. the recording window runs well past the end of the animation (late effects);
--  3. effects / sounds that are already running when the animation starts are captured too;
--  4. the deep hook sees :Emit() and :Play() calls that never change any property;
--  5. every time the animation plays, new events are MERGED into what was recorded before;
--  6. keyframe names reached during the animation are saved as a comment in the script;
--  7. optional: dormant emitters (Thorough) and effects from the same tool/folder (Related guess).
local FX_POST = 2.5 -- seconds recorded after the animation ends
fxWindows.buf = {}
fxWindows.related = {} -- [animId] = guessed events (Related FX guess / Search tab)

fxWindows.pos = function(inst)
	if inst:IsA("Model") then
		local okM, cf = pcall(inst.GetPivot, inst)
		if okM and cf then return cf.Position end
	elseif inst:IsA("Tool") or inst:IsA("Accoutrement") then
		local h = inst:FindFirstChild("Handle")
		if h and h:IsA("BasePart") then return h.Position end
	end
	local part = inst:IsA("BasePart") and inst or inst:FindFirstAncestorWhichIsA("BasePart")
	if part then return part.Position end
	local m = inst:FindFirstAncestorOfClass("Model")
	if m then
		local ok, p = pcall(m.GetPivot, m)
		if ok then return p.Position end
	end
	return nil
end

local function fxBelongs(inst, w, pos)
	if inst:IsDescendantOf(w.model) then return true end
	if pos == nil then pos = fxWindows.pos(inst) end
	if pos == nil then return inst:IsA("Sound") and w.model == lp.Character end
	local root = w.model:FindFirstChild("HumanoidRootPart")
	return root ~= nil and (pos - root.Position).Magnitude < 60
end

-- when a looping effect switches off / gets destroyed, store how long it lasted
fxWindows.dur = function(inst, ev, since)
	if ev.kind ~= "vfx" or not ev.enabled or ev.dur then return end
	local function ended()
		if not ev.dur then ev.dur = math.max(os.clock() - since, 0.1) end
	end
	inst.Destroying:Connect(ended)
	pcall(function()
		inst:GetPropertyChangedSignal("Enabled"):Connect(function()
			if not inst.Enabled then ended() end
		end)
	end)
end

local function evKey(e)
	local id = ""
	for _, p in ipairs(e.props or {}) do
		if p[1] == "SoundId" or p[1] == "Texture" then
			id = p[2]
			break
		end
	end
	local bucket = (e.emit and not e.enabled) and 20 or 2 -- bursts keep their exact timing
	return string.format("%s|%s|%s|%s|%d", e.kind, tostring(e.class), tostring(e.name), id, math.floor(e.t * bucket + 0.5))
end

-- merge lists of FX events (older list first); copies, so durations can be defaulted safely
fxWindows.merge = function(...)
	local out, seen = {}, {}
	for i = 1, select("#", ...) do
		local list = select(i, ...)
		for _, e in ipairs(list or {}) do
			local k = evKey(e)
			if not seen[k] and #out < 300 and (e.kind ~= "cam" or K.camKeep(e)) then
				seen[k] = true
				local c = table.clone(e)
				if not c.dur then c.dur = c.kind == "sfx" and 3 or (c.kind == "obj" and 2.5 or (c.enabled and 1.5 or 1)) end
				if c.kind == "cam" and c.cam and #c.cam > 0 then c.dur = c.cam[#c.cam][1] end
				out[#out + 1] = c
			end
		end
	end
	table.sort(out, function(x, y) return x.t < y.t end)
	return out
end

-- everything recorded for this animation so far, including windows that are still open
fxWindows.rawFor = function(id) -- everything recorded (not edited)
	local old, rel, extra = animFX[id], fxWindows.related[id], {}
	for _, w in ipairs(fxWindows) do
		if w.id == id and #w.events > 0 then extra[#extra + 1] = w.events end
	end
	if not old and #extra == 0 and not (rel and #rel > 0) then return nil end
	return fxWindows.merge(old, rel, table.unpack(extra))
end

-- what Copy / Preview / Run use: your edits from the FX Editor if there are any, else the recording
fxWindows.liveFor = function(id)
	local ed = X.fxEdit[id]
	if ed then
		local out = {}
		for _, e in ipairs(ed) do
			if not e.off then out[#out + 1] = e end
		end
		return #out > 0 and out or nil
	end
	return fxWindows.rawFor(id)
end

-- an object's lifetime and (when it moves on its own) its path
fxWindows.durObj = function(inst, ev, since)
	local function ended()
		if not ev.dur then ev.dur = math.max(os.clock() - since, 0.1) end
	end
	inst.Destroying:Connect(ended)
	inst.AncestryChanged:Connect(function(_, parent)
		if not parent then ended() end
	end)
	if (ev.mount and ev.mount.part) or not ev._root0 then return end -- worn: moves with the animation
	local root0 = ev._root0
	local path = { { 0, ev.rel } }
	ev.path = path
	task.spawn(function()
		local t0 = os.clock()
		while inst.Parent and not ev.dur and os.clock() - t0 < 10 and #path < 200 do
			task.wait(0.05)
			local pv = inst.Parent and K.objPivot(inst)
			if pv then
				local rel = root0:ToObjectSpace(pv)
				if (rel.Position - path[#path][2].Position).Magnitude > 0.2 or (rel.LookVector - path[#path][2].LookVector).Magnitude > 0.1 then path[#path + 1] = { os.clock() - t0, rel } end
			end
		end
	end)
end

-- kind = "vfx" / "sfx" / "obj"; extra = fields to force on the event (e.g. the real Emit count); at = time of the call
local function recordFX(kind, inst, extra, at)
	if kind == "sfx" and tostring(inst.SoundId):find("^rbxasset://sounds/") then return end -- default Roblox sounds
	local now = at or os.clock()
	local build = kind == "vfx" and K.buildVFXEvent or (kind == "obj" and K.buildObjEvent or K.buildSFXEvent)
	local function applyExtra(ev)
		if extra then
			for k, v in pairs(extra) do ev[k] = v end
		end
	end

	-- 1) rolling history (works even when no animation is being recorded yet)
	local root = K.getRoot()
	local pos = fxWindows.pos(inst)
	if root and ((pos and (pos - root.Position).Magnitude < 150) or (pos == nil and kind == "sfx")) then
		local mdl = inst:FindFirstAncestorOfClass("Model") or lp.Character
		local ok, ev = pcall(build, inst, mdl, 0)
		if ok and ev then
			applyExtra(ev)
			fxWindows.dur(inst, ev, now)
			if kind == "obj" then fxWindows.durObj(inst, ev, now) end
			local buf = fxWindows.buf
			buf[#buf + 1] = { kind = kind, ev = ev, at = now, pos = pos, inst = inst }
			while #buf > 150 or (buf[1] and now - buf[1].at > X.pre + 3) do table.remove(buf, 1) end
		end
	end

	-- 2) live recording for animations that are open right now
	if #fxWindows == 0 then return end
	for _, w in ipairs(fxWindows) do
		if now >= w.opened and now <= w.finish and fxBelongs(inst, w, pos) then
			local ok, ev = pcall(build, inst, w.model, math.max(now - w.start, 0))
			if ok and ev then
				applyExtra(ev)
				table.insert(w.events, ev)
				fxWindows.dur(inst, ev, now)
				if kind == "obj" then fxWindows.durObj(inst, ev, now) end
			end
		end
	end
end

local function finalizeFX(w)
	if w.conn then pcall(function() w.conn:Disconnect() end) end
	if w.camConn then pcall(function() w.camConn:Disconnect() end) end
	if #w.keys > 0 then
		local have = X.markers[w.id]
		if not have or #w.keys > #have then X.markers[w.id] = w.keys end
	end
	if #w.events == 0 then return end
	animFX[w.id] = fxWindows.merge(animFX[w.id], w.events)
	refreshExtra(w.id)
end

local function openFXWindow(id, animator, track)
	local model = animator:FindFirstAncestorOfClass("Model")
	if not model or #fxWindows >= 20 then return end
	local now = os.clock()
	local len = math.min(math.max(track.Length, 0.5), 15)
	X.lens[id] = track.Length
	local into = 0
	pcall(function() into = math.clamp(track.TimePosition, 0, len) end)
	local w = {
		id = id, model = model, events = {}, keys = {},
		start = now - into, -- real start of the animation (we may detect it up to 0.1s late)
		opened = now,
		finish = now + math.max(len - into, 0) + FX_POST,
	}
	table.insert(fxWindows, w)
	X.lastAnim = { id = id, start = w.start }
	if X.objOn then -- cutscenes that started just before / during this animation belong to it
		for _, sg in ipairs(X.camSegs) do
			if sg.start >= w.start - X.pre - 1 and sg.start <= w.finish then
				sg.attached = true
				local cl = table.clone(sg.ev)
				cl.t = math.max(sg.start - w.start, 0)
				table.insert(w.events, cl)
			end
		end
	end
	pcall(function()
		w.conn = track.KeyframeReached:Connect(function(name)
			w.keys[#w.keys + 1] = { name, os.clock() - w.start }
		end)
	end)

	-- effects / sounds that already fired before we noticed the animation
	for _, item in ipairs(fxWindows.buf) do
		if item.at >= w.start - X.pre and item.at < now and fxBelongs(item.inst, w, item.pos) then
			local ev = table.clone(item.ev)
			ev.t = math.max(item.at - w.start, 0)
			table.insert(w.events, ev)
		end
	end

	-- effects that are already running (or dormant, in Thorough mode) when the animation starts
	local n = 0
	for _, d in ipairs(model:GetDescendants()) do
		if n >= 60 then break end
		local cls = d.ClassName
		if d:GetAttribute("_LoggerClone") or d:GetAttribute("_Replay") then
			-- our own copies: ignore
		elseif cls == "Sound" then
			local okS, playing = pcall(function() return d.Playing and not d.Looped and d.SoundId ~= "" and not d.SoundId:find("^rbxasset://sounds/") end)
			if okS and playing then
				local ok, ev = pcall(K.buildSFXEvent, d, model, 0)
				if ok and ev then
					n += 1
					table.insert(w.events, ev)
				end
			end
		elseif VFX_CLASSES[cls] then
			local okE, en = pcall(function() return d.Enabled end)
			if okE and en then
				local ok, ev = pcall(K.buildVFXEvent, d, model, 0)
				if ok and ev then
					n += 1
					fxWindows.dur(d, ev, now)
					table.insert(w.events, ev)
				end
			elseif cls == "ParticleEmitter" and X.thorough and d:GetAttribute("EmitCount") then
				local ok, ev = pcall(K.buildVFXEvent, d, model, tonumber(d:GetAttribute("EmitDelay")) or 0)
				if ok and ev then
					n += 1
					table.insert(w.events, ev)
				end
			end
		end
	end

	task.delay(math.max(len - into, 0) + FX_POST + 0.3, function()
		local i = table.find(fxWindows, w)
		if i then table.remove(fxWindows, i) end
		finalizeFX(w)
	end)
end

--// Animation logging -------------------------------------------------------------------------
local watched = {} -- [Animator] = { [track] = true }

local function stopAnimId(id)
	local n = 0
	for animator in pairs(watched) do
		for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
			if tr.Animation and tr.Animation.AnimationId == id then
				tr:Stop(0)
				n += 1
			end
		end
	end
	return n
end

stopMineFn = function()
	local n = 0
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if animator then
		for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
			if ownTracks[tr] then
				tr:Stop(0)
				n += 1
			end
		end
	end
	if _G.StopRecreatedAnim then
		if pcall(_G.StopRecreatedAnim) then n += 1 end
		_G.StopRecreatedAnim = nil
	end
	return n
end

local function openAnimViewer(id)
	local live = fxWindows.liveFor(id)
	local hasFX = live and #live > 0
	local function variant(name, mode, w)
		return { name = name, w = w, get = function(cb, setStatus)
			requestDetail(id, function(ok, res)
				if ok then
					local okC, code = pcall(K.buildAnimCode, id, mode)
					if okC then cb(code) else cb(nil, code) end
				else
					cb(nil, res)
				end
			end, setStatus)
		end }
	end
	openViewer("Anim - " .. (animLabel[id] or id), {
		variant("Frame by frame", nil, 112), -- only the animation, nothing else
		variant("Full - VFX", "vfx", 88), -- + VFX and SFX
		variant("Full-VFX-Cutscenes", "cut", 150), -- + cutscene camera
		variant("Full-Everything", "all", 122), -- + spawned parts / objects
		{ name = "Simple", w = 66, get = function(cb) cb(K.simpleCode(id)) end },
	}, hasFX and 2 or 1, id)
end

local function logAnim(animator, track)
	if not Run.alive or ownTracks[track] then return end -- played by our Run / capture
	local anim = track.Animation
	local id = anim and anim.AnimationId or ""
	if id == "" or id == "?" then id = "(no id: " .. track.Name .. ")" end -- keep id-less animations apart
	if excluded[id] then return end
	if not X.passes(animator) then
		if not X.hiddenHint then
			X.hiddenHint = true
			local mdl = animator:FindFirstAncestorOfClass("Model")
			out(string.format('Some animations are hidden by "Own character only" / the player filter (e.g. %s on %s). Turn it off in Settings if a move you expect is missing.', track.Name, mdl and mdl.Name or "?"))
		end
		return
	end
	if blocked[id] then
		if blockedLogged[id] then return end -- log a blocked anim only once
		blockedLogged[id] = true
	end

	animInfo[id] = animInfo[id] or { priority = track.Priority.Name, looped = track.Looped, speed = track.Speed }

	local owner = animator:FindFirstAncestorOfClass("Model")
	local ownerName = owner and owner.Name or animator.Parent and animator.Parent.Name or "?"
	animLabel[id] = track.Name .. " / " .. ownerName
	local detail = string.format(
		"%s\nTrack: %s | Len: %.2fs | Prio: %s | Loop: %s | Speed: %.2f",
		id, track.Name, track.Length, track.Priority.Name, tostring(track.Looped), track.Speed
	)

	openFXWindow(id, animator, track) -- start recording VFX/SFX that happen with this animation

	local function frameButton(text, withFX, w)
		return act(text, function(btn)
			if withFX and X.guess then X.prepareFX({ id = id, name = track.Name, inst = anim }) end
			if details[id] then
				local ok, code = pcall(K.buildAnimCode, id, withFX)
				if not ok then error(code) end
				toClip(code, "the frame-by-frame script")
				K.flash(btn, "Copied!")
				return
			end
			btn.Text = "Working..."
			requestDetail(id, function(ok, res)
				if not btn.Parent then return end
				if ok then
					local okC, code = pcall(K.buildAnimCode, id, withFX)
					if okC then
						toClip(code, "the frame-by-frame script")
						local fx = fxWindows.liveFor(id)
						btn.Text = (withFX and not (fx and #fx > 0)) and "No FX seen" or "Copied!"
					else
						out("Failed: " .. tostring(code))
						btn.Text = "Fail"
					end
				else
					out("Frame-by-frame failed: " .. tostring(res))
					btn.Text = "Fail"
				end
				task.delay(1.5, function()
					if btn.Parent then btn.Text = text end
				end)
			end, function(t) if btn.Parent then btn.Text = t:sub(1, 16) end end)
		end, C.sel, 1, w)
	end

	local actions = {
		-- line 1: the important buttons
		frameButton("Copy", false, 1),
		frameButton("Full-FX-CUTSCENE", "cut", 2.2),
		runAct(function() K.playAnim(id) end, 1, 0.9),
		act("VIEW FULL CODE", function() openAnimViewer(id) end, C.sel, 1, 2.2),
		-- line 2: more
		copyAct("Code", function() return K.simpleCode(id) end, "the AnimationId script", 2),
		copyAct("ID", function() return id end, "the AnimationId", 2),
		act("Preview", function() X.pvOpen(id, { id = id, name = track.Name, inst = anim }) end, C.green, 3),
		act("FX Editor", function() X.edOpen(id) end, C.sel, 3),
		act("Anim Editor", function() X.aeOpen(id) end, C.sel, 3),
		act("Stop", function(btn)
			K.flash(btn, stopAnimId(id) > 0 and "Stopped" or "None")
		end, nil, 2),
		{ line = 2, color = C.btn, state = function() return blocked[id] and "Unblock" or "Block", blocked[id] end,
			fn = function()
				blocked[id] = not blocked[id] or nil
				if blocked[id] then
					stopAnimId(id)
				else
					blockedLogged[id] = nil
				end
				refreshAll()
			end },
		{ line = 2, color = C.btn, state = function() return excluded[id] and "Unexcl" or "Excl", excluded[id] end,
			fn = function()
				excluded[id] = not excluded[id] or nil
				refreshAll()
			end },
		act("RBXMX", function(btn)
			btn.Text = "Working..."
			requestRbxmx(id, function(ok, xml, source)
				if not btn.Parent then return end
				if not ok then
					out("RBXMX failed: " .. tostring(xml))
					btn.Text = "Fail"
				else
					local fileName = "Anim_" .. (id:match("%d+") or "x") .. ".rbxmx"
					local howTo = 'game:GetObjects(getcustomasset("' .. fileName .. '"))[1]'
					if writefile and pcall(writefile, fileName, xml) then
						out(string.format("Saved %s (%s)\nLoad: %s", fileName, source, howTo))
						btn.Text = "Saved!"
					else
						toClip(xml, "the rbxmx")
						btn.Text = "Copied!"
					end
				end
				task.delay(1.5, function()
					if btn.Parent then btn.Text = "RBXMX" end
				end)
			end)
		end, nil, 2),
	}

	local ent = addEntry("Anim", id, ownerName, detail, id, actions, C.anim)
	if ent then
		entriesById[id] = entriesById[id] or {}
		table.insert(entriesById[id], ent)
		refreshExtra(id)
		if not details[id] and detailedMode and not blocked[id] then
			requestDetail(id)
		end
	end
end

local function blockIfNeeded(track)
	if not Run.alive or ownTracks[track] then return end
	local anim = track.Animation
	if anim and blocked[anim.AnimationId] then track:Stop(0) end
end

local function watchAnimator(animator)
	if watched[animator] then return end
	local seen = {}
	watched[animator] = seen
	-- the event fires for every played track, even ones that stop before the next poll
	-- (short moves, quick blocks, anything under 0.1s); "seen" stops the poll logging it twice
	local function onPlayed(track)
		if not Run.alive then return end
		blockIfNeeded(track)
		if seen[track] then return end
		seen[track] = true
		if not paused then logAnim(animator, track) end
	end
	animator.AnimationPlayed:Connect(onPlayed)
	local hum = animator.Parent
	if hum and hum:IsA("Humanoid") then pcall(function() hum.AnimationPlayed:Connect(onPlayed) end) end
end

local acc = 0
table.insert(Run.conns, RunService.Heartbeat:Connect(function(dt)
	if not Run.alive then return end
	acc += dt
	local slow = acc >= POLL_RATE
	if slow then acc = 0 end
	local all = next(blocked) ~= nil -- something is blocked: check everything every frame
	for animator, seen in pairs(watched) do
		if not animator.Parent then
			watched[animator] = nil
		else
			-- animators that pass your filters (e.g. your own character) are checked every frame
			if slow then X.fastAnim[animator] = X.passes(animator) or nil end
			if slow or all or X.fastAnim[animator] then
				local current = {}
				for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
					current[track] = true
					blockIfNeeded(track)
					if not seen[track] and not paused then
						seen[track] = true
						logAnim(animator, track)
					elseif not seen[track] then
						seen[track] = true -- remember it so it isn't logged after resume
					end
				end
				for t in pairs(seen) do
					if not current[t] then seen[t] = nil end
				end
			end
		end
	end
end))

--// VFX logging --------------------------------------------------------------------------------
local function describeVFX(inst)
	local c = inst.ClassName
	local function col(v) return string.format("%d,%d,%d", v.R * 255, v.G * 255, v.B * 255) end
	if c == "ParticleEmitter" then
		return inst.Texture, string.format(
			"Texture: %s\nRate: %s | Lifetime: %.1f-%.1f | Speed: %.1f-%.1f | Color: %s",
			inst.Texture, inst.Rate, inst.Lifetime.Min, inst.Lifetime.Max,
			inst.Speed.Min, inst.Speed.Max, col(inst.Color.Keypoints[1].Value)
		)
	elseif c == "Beam" then
		return inst.Texture, string.format("Texture: %s\nWidth: %.1f-%.1f | Segments: %d", inst.Texture, inst.Width0, inst.Width1, inst.Segments)
	elseif c == "Trail" then
		return inst.Texture, string.format("Texture: %s\nLifetime: %.2f | MinLength: %.2f", inst.Texture, inst.Lifetime, inst.MinLength)
	elseif c == "Fire" or c == "Smoke" then
		return "", string.format("Size: %.1f | Color: %s", inst.Size, col(inst.Color))
	elseif c == "Explosion" then
		return "", string.format("BlastRadius: %.1f | BlastPressure: %.0f", inst.BlastRadius, inst.BlastPressure)
	elseif c == "Highlight" then
		return "", string.format("Fill: %s | Outline: %s", col(inst.FillColor), col(inst.OutlineColor))
	elseif c:find("Light") then
		return "", string.format("Brightness: %.1f | Range: %.1f | Color: %s", inst.Brightness, inst.Range, col(inst.Color))
	end
	return "", ""
end

local function logVFX(inst, extra, at)
	if not Run.alive then return end
	recordFX("vfx", inst, extra, at) -- attach to any animation playing nearby (regardless of filters)
	if extra then -- from the deep hook: don't add a row for every single Emit
		local now = os.clock()
		if now - (X.lastRow[inst] or 0) < 0.5 then return end
		X.lastRow[inst] = now
	end

	if not X.passes(inst) then return end
	local ok, texture, detail = pcall(describeVFX, inst)
	if not ok then return end
	local path = K.shortPath(inst)
	local key = inst.ClassName .. "|" .. inst.Name .. "|" .. tostring(texture)
	if excludedVFX[key] then return end
	vfxLabel[key] = inst.ClassName .. ": " .. inst.Name

	local okSpec, spec = pcall(K.buildVFXEvent, inst, inst:FindFirstAncestorOfClass("Model"), 0)
	if okSpec and spec then vfxSpec[key] = spec end
	local function script() return K.genStandaloneFX({ vfxSpec[key] }, "VFX " .. vfxLabel[key]) end

	local copyText = (texture ~= "" and texture) or (inst.ClassName .. " @ " .. path)
	local actions = {
		act("Copy", function(btn)
			if not vfxSpec[key] then return K.flash(btn, "No data") end
			toClip(script(), "the VFX script")
			K.flash(btn, "Copied!")
		end, C.sel, 1, 1),
		runAct(function()
			if not vfxSpec[key] then error("no data captured") end
			K.runEvents({ vfxSpec[key] }, "VFX " .. vfxLabel[key])
		end, 1, 0.9),
		act("VIEW FULL CODE", function()
			if not vfxSpec[key] then error("no data captured") end
			openViewer("VFX - " .. vfxLabel[key], {
				{ name = "Script", get = function(cb) cb(script()) end },
			}, 1)
		end, C.sel, 1, 2.2),
		copyAct("ID", function() return copyText end, "the texture id", 2),
		{ line = 2, color = C.btn, state = function() return excludedVFX[key] and "Unexcl" or "Excl", excludedVFX[key] end,
			fn = function()
				excludedVFX[key] = not excludedVFX[key] or nil
				refreshAll()
			end },
	}
	addEntry("VFX", key, inst.ClassName .. ": " .. inst.Name, path .. "\n" .. detail, copyText, actions, C.vfx)
end

local function watchVFX(inst)
	if not VFX_CLASSES[inst.ClassName] then return end
	if inst:GetAttribute("_LoggerClone") or inst:GetAttribute("_Replay") then return end
	logVFX(inst)
	-- log again when it gets switched on
	if inst:IsA("ParticleEmitter") or inst:IsA("Beam") or inst:IsA("Trail")
		or inst:IsA("Fire") or inst:IsA("Smoke") or inst:IsA("Light") or inst:IsA("Sparkles") then
		inst:GetPropertyChangedSignal("Enabled"):Connect(function()
			if inst.Enabled then logVFX(inst) end
		end)
	end
end

-- spawned objects: swords, dummies, parts... that appear near you while an animation plays
function X.objOk(d)
	if d:GetAttribute("_LoggerClone") or d:GetAttribute("_Replay") then return false end
	if d:IsA("Terrain") or d:IsA("Camera") then return false end
	local p = d.Parent
	while p and p ~= workspace do
		if X.objSeen[p] or p:GetAttribute("_Replay") or p:GetAttribute("_LoggerClone") then return false end
		p = p.Parent
	end
	if not p then return false end
	if not (d:IsA("Tool") or d:IsA("Accoutrement")) then -- players' own bodies are not "spawned"
		if d:IsA("Model") and Players:GetPlayerFromCharacter(d) then return false end
		local m = d:FindFirstAncestorOfClass("Model")
		while m do
			if Players:GetPlayerFromCharacter(m) then return false end
			m = m.Parent and m.Parent:FindFirstAncestorOfClass("Model")
		end
	end
	if d:IsA("BasePart") then
		if d.Transparency >= 1 or d.Size.Magnitude > 300 then return false end -- invisible hitboxes / the map
	elseif d:IsA("Model") then
		if not d:FindFirstChildWhichIsA("BasePart", true) then return false end
	end
	return true
end

function X.watchObj(d)
	if not Run.alive or not X.objOn or not d.Parent then return end
	if not X.objOk(d) then return end
	local now = os.clock()
	if now - (X.objT or 0) > 1 then X.objT, X.objN = now, 0 end
	X.objN += 1
	if X.objN > 60 then return end
	X.objSeen[d] = true
	recordFX("obj", d)
end

-- cutscene camera: watched all the time, so cutscenes are caught even when nothing plays on your own character
function X.camActive(c)
	if workspace:GetAttribute("_ReplayCam") then return false end -- our own replay
	if c.CameraType == Enum.CameraType.Scriptable then return true end
	local subj, ch = c.CameraSubject, lp.Character
	return subj ~= nil and ch ~= nil and not subj:IsDescendantOf(ch) -- camera is looking at something that is not you
end

function X.camEnd(seg)
	X.camSeg = nil
	if seg.attached or not K.camKeep(seg.ev) then return end
	local la = X.lastAnim
	if la and seg.start >= la.start - 1 and seg.start - la.start < 10 then -- no window was open: use the animation that just played
		local cl = table.clone(seg.ev)
		cl.t = math.max(seg.start - la.start, 0)
		animFX[la.id] = fxWindows.merge(animFX[la.id], { cl })
		pcall(refreshExtra, la.id)
	end
end

function X.camStep()
	local c = workspace.CurrentCamera
	local ch = lp.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	if not c or not root then return end
	local now = os.clock()
	local seg = X.camSeg
	if X.camActive(c) then
		if not seg then
			seg = { start = now, rootCF = root.CFrame, ev = { kind = "cam", name = "Cutscene camera", t = 0, props = {}, cam = {}, dur = 0 } }
			X.camSeg = seg
			table.insert(X.camSegs, seg)
			while #X.camSegs > 12 do table.remove(X.camSegs, 1) end
			for _, w in ipairs(fxWindows) do
				if now <= w.finish then
					seg.attached = true
					local cl = table.clone(seg.ev)
					cl.t = math.max(now - w.start, 0)
					table.insert(w.events, cl)
				end
			end
		end
		local dt = now - seg.start
		local pts = seg.ev.cam
		local last = pts[#pts]
		if dt < 60 and #pts < 1200 and (not last or dt - last[1] >= 0.04) then
			pts[#pts + 1] = { dt, seg.rootCF:ToObjectSpace(c.CFrame), c.FieldOfView }
		end
	elseif seg then
		X.camEnd(seg)
	end
end

--// SFX logging ----------------------------------------------------------------------------------
local function logSFX(s, at)
	if not Run.alive or s.SoundId == "" then return end
	recordFX("sfx", s, nil, at)
	do
		local now = os.clock()
		if now - (X.lastRow[s] or 0) < 0.15 then return end -- Played signal + hook for the same call
		X.lastRow[s] = now
	end

	if not X.passes(s) then return end
	local id = s.SoundId
	if excludedSFX[id] then return end
	sfxLabel[id] = s.Name

	local okSpec, spec = pcall(K.buildSFXEvent, s, nil, 0)
	if okSpec and spec then sfxSpec[id] = spec end
	local function script() return K.genStandaloneFX({ sfxSpec[id] }, "SFX " .. (sfxLabel[id] or id)) end

	local detail = string.format(
		"%s\n%s\nVolume: %.2f | Speed: %.2f | Loop: %s | Length: %.2fs",
		K.shortPath(s), id, s.Volume, s.PlaybackSpeed, tostring(s.Looped), s.TimeLength
	)
	local actions = {
		act("Copy", function(btn)
			if not sfxSpec[id] then return K.flash(btn, "No data") end
			toClip(script(), "the SFX script")
			K.flash(btn, "Copied!")
		end, C.sel, 1, 1),
		runAct(function()
			if not sfxSpec[id] then error("no data captured") end
			K.runEvents({ sfxSpec[id] }, "SFX " .. (sfxLabel[id] or id))
		end, 1, 0.9),
		act("VIEW FULL CODE", function()
			if not sfxSpec[id] then error("no data captured") end
			openViewer("SFX - " .. (sfxLabel[id] or id), {
				{ name = "Script", get = function(cb) cb(script()) end },
			}, 1)
		end, C.sel, 1, 2.2),
		copyAct("ID", function() return id end, "the sound id", 2),
		{ line = 2, color = C.btn, state = function() return excludedSFX[id] and "Unexcl" or "Excl", excludedSFX[id] end,
			fn = function()
				excludedSFX[id] = not excludedSFX[id] or nil
				refreshAll()
			end },
	}
	addEntry("SFX", id, s.Name, detail, id, actions, C.sfx)
end

local hookedSounds = setmetatable({}, { __mode = "k" })
local function hookSound(s, fromAdded)
	if hookedSounds[s] then return end
	hookedSounds[s] = true
	local last = 0
	local function onPlay()
		if s:GetAttribute("_LoggerClone") or s:GetAttribute("_Replay") then return end
		local now = os.clock()
		if now - last < 0.05 then return end
		last = now
		logSFX(s)
	end
	s.Played:Connect(onPlay)
	s:GetPropertyChangedSignal("Playing"):Connect(function()
		if s.Playing then onPlay() end
	end)
	-- created and played in the same frame, before we could connect
	if fromAdded and s.Playing then task.defer(onPlay) end
end

