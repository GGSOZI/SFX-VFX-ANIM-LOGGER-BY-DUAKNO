	X.mkTool(tb, "Copy Everything", 110, C.sel, function(b) X.copyAnim(id, "all", b, "Copy Everything") end)
	X.mkTool(tb, "FX Editor", 76, C.btn, function() X.edOpen(id) end)
	X.mkTool(tb, "3D View", 70, C.sel, function() X.v3Open(id) end)
