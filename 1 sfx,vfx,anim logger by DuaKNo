--// FX editor ------------------------------------------------------------------------------------------
-- Timeline: every event has its own lane when events overlap, so nothing is ever hidden behind another
-- block (the timeline scrolls up/down as well as sideways). Tap a block to edit it, drag it to move it.
X.LANEH = 20

function X.edSnap(E)
	local s = {}
	for i, e in ipairs(E.events) do s[i] = { e = e, t = e.t, dur = e.dur, off = e.off } end
	return s
end

function X.edRestore(E, s)
	local list = {}
	for i, r in ipairs(s) do
		r.e.t, r.e.dur, r.e.off = r.t, r.dur, r.off
		list[i] = r.e
	end
	E.events = list
end

function X.edPush(E)
	table.insert(E.undo, X.edSnap(E))
	if #E.undo > 60 then table.remove(E.undo, 1) end
	E.redo = {}
end

function X.edCommit() -- the first edit turns the recording into your own editable copy
	local E = X.ed
	if E then
		X.fxEdit[E.id] = E.events
		E.dirty = true
	end
end

-- The Anim editor keeps each effect's ORIGINAL time (before any clip edit) and re-times every effect from it on the next clip edit.
-- When you move / shorten / switch off one effect here, that original time is updated too - so nothing else moves or snaps back.
function X.edRebase(E, before)
	local A = X.aeData and X.aeData[E.id]
	if not (A and A.baseFxMap and A.clips and #A.clips > 0) then return end
	local okL, starts, ends = pcall(X.aeLayout, A.clips)
	if not okL or not starts then return end
	for _, e in ipairs(E.events) do
		local b, r = before[e], A.baseFxMap[e]
		if b and r and (b.t ~= e.t or b.dur ~= e.dur or b.off ~= e.off) then
			r.off = e.off
			for i, c in ipairs(A.clips) do
				if e.t >= starts[i] - 1e-4 and e.t <= ends[i] + 1e-4 then
					local u = (e.t - starts[i]) * c.speed
					if e.dur then r.dur = e.dur * c.speed end
					if c.rev then
						local dur0 = (e.emit and not e.enabled) and 0 or (r.dur or 0)
						r.t = math.max(c.b - u - dur0, c.a)
					else
						r.t = c.a + u
					end
					break
				end
			end
		end
	end
end

function X.deepCopy(v, depth)
	if type(v) ~= "table" or (depth or 0) > 8 then return v end
	local out = {}
	for k, x in pairs(v) do out[k] = X.deepCopy(x, (depth or 0) + 1) end
	return out
end

function X.edChange(fn)
	local E = X.ed
	if not E then return end
	X.edPush(E)
	local before = {}
	for _, e in ipairs(E.events) do before[e] = { t = e.t, dur = e.dur, off = e.off } end
	fn()
	pcall(X.edRebase, E, before)
	X.edCommit()
	X.edRefresh()
end

function X.edUndo()
	local E = X.ed
	if not E or #E.undo == 0 then return end
	table.insert(E.redo, X.edSnap(E))
	X.edRestore(E, table.remove(E.undo))
	X.edCommit()
	X.edRefresh()
end

function X.edRedo()
	local E = X.ed
	if not E or #E.redo == 0 then return end
	table.insert(E.undo, X.edSnap(E))
	X.edRestore(E, table.remove(E.redo))
	X.edCommit()
	X.edRefresh()
end

function X.edClose()
	local E = X.ed
	X.ed = nil
	if E then pcall(function() E.win.destroy() end) end
end

function X.edReset()
	local E = X.ed
	if not E then return end
	X.edPush(E)
	X.fxEdit[E.id] = nil
	E.dirty = false
	E.sel = nil
	E.events = fxWindows.rawFor(E.id) or {}
	if #E.events == 0 then -- nothing recorded this session: the effects the saved copy started from
		local it = X.eds.items[E.id]
		if it and it.fxOrig and #it.fxOrig > 0 then
			local list = {}
			for i, e in ipairs(it.fxOrig) do list[i] = X.dec(e) end
			E.events = list
			X.fxEdit[E.id] = list
		end
	end
	X.edRefresh() -- the saved copy is never touched by a reset
end

function X.edRevertSaved() -- bring the SAVED effects of this animation back
	local E = X.ed
	if not E then return end
	local src = X.eds.items[E.id] or X.kept[E.id]
	if not (src and src.fx) then return out("This animation has no saved effects yet (press Save).") end
	X.edPush(E)
	local list = {}
	for i, e in ipairs(src.fx) do list[i] = X.dec(e) end
	X.fxEdit[E.id] = list
	E.events = list
	E.dirty = true
	E.sel = nil
	X.edRefresh()
end

function X.edSync(id) -- the Anim editor changed event times: redraw the FX editor if it shows the same animation
	local E = X.ed
	if not E or E.id ~= id then return end
	if X.fxEdit[id] then E.events = X.fxEdit[id] end
	X.edRefresh()
end

function X.edVisible()
	local E = X.ed
	local vis = {}
	local q = (E.query or ""):lower()
	for _, e in ipairs(E.events) do
		local isSfx = e.kind == "sfx"
		if E.filter == "all" or X.evSection(e) == E.filter then
			if q == "" then
				vis[#vis + 1] = e
			else
				local title, detail = X.evLines(e)
				local hay = title .. " " .. detail .. " " .. tostring(e.name) .. " " .. tostring(e.class or "") .. " " .. tostring(e.kind)
				for _, pr in ipairs(e.props or {}) do hay = hay .. " " .. tostring(pr[2]) end
				hay = hay:lower()
				local all = true
				for w in q:gmatch("%S+") do
					if not hay:find(w, 1, true) then
						all = false
						break
					end
				end
				if all then vis[#vis + 1] = e end
			end
		end
	end
	return vis
end

function X.edScrollTo(idx)
	local E = X.ed
	if E and E.list.Parent then E.list.CanvasPosition = Vector2.new(0, math.max((idx - 1) * (X.ROWH + 4) - 40, 0)) end
end

function X.edRefresh()
	X.edDraw()
	X.edList()
	X.edPanel()
end

function X.edSelect(e)
	local E = X.ed
	if not E then return end
	E.sel = e
	X.edRefresh()
	local idx = table.find(X.edVisible(), e)
	if idx then X.edScrollTo(idx) end
	local x = e.t * E.pps
	local cur = E.tl.CanvasPosition
	if x < cur.X or x > cur.X + E.tl.AbsoluteWindowSize.X - 40 then
		E.tl.CanvasPosition = Vector2.new(math.max(x - 40, 0), cur.Y)
	end
end

function X.edLayout()
	local E = X.ed
	if not E then return end
	local y = 44
	E.tl.Position = UDim2.new(0, 6, 0, y)
	E.tl.Size = UDim2.new(1, -12, 0, E.tlH)
	y += E.tlH + 4
	E.panel.Position = UDim2.new(0, 6, 0, y)
	E.panel.Size = UDim2.new(1, -12, 0, 66)
	y += 70
	E.info.Position = UDim2.new(0, 8, 0, y)
	E.info.Size = UDim2.new(1, -16, 0, 18)
	y += 20
	E.fbar.Position = UDim2.new(0, 6, 0, y)
	E.fbar.Size = UDim2.new(1, -12, 0, 30)
	y += 34
	E.list.Position = UDim2.new(0, 6, 0, y)
	E.list.Size = UDim2.new(1, -12, 1, -(y + 6))
end

function X.edDraw() -- timeline
	local E = X.ed
	if not E or not E.tl.Parent then return end
	table.sort(E.events, function(a, b) return a.t < b.t end)
	local keepPos = E.tl.CanvasPosition
	for _, c in ipairs(E.tl:GetChildren()) do c:Destroy() end

	local len = X.edLength(E.id)
	local last = 0
	for _, e in ipairs(E.events) do last = math.max(last, e.t + math.min(e.dur or 0.3, 4)) end
	local T = math.max(len, last, 1) + 0.5
	local pps = E.pps
	local W = T * pps + 20
	local LH = X.LANEH

	-- sections: effects and sounds always, spawned objects and the cutscene camera when something was logged.
	-- Inside a section every event gets its own lane when events overlap, so nothing is hidden behind another block.
	local SEC = {
		{ "vfx", "VISUAL EFFECTS", true },
		{ "sfx", "SOUNDS", true },
		{ "obj", "SPAWNED OBJECTS (swords, dummies, parts...)", false },
		{ "cam", "CUTSCENE CAMERA", false },
	}
	local lanes, place, count = {}, {}, {}
	for _, sc in ipairs(SEC) do
		lanes[sc[1]] = {}
		count[sc[1]] = 0
	end
	for _, e in ipairs(E.events) do
		local k = X.evSection(e)
		count[k] += 1
		local x = e.t * pps
		local w = (e.emit and not e.enabled) and 14 or (e.dur or (k == "sfx" and 1 or 0.5)) * pps
		w = math.clamp(w, 14, 360)
		local ln = lanes[k]
		local lane
		for i = 1, #ln do
			if x >= ln[i] + 2 then
				lane = i
				break
			end
		end
		if not lane then lane = #ln + 1 end
		ln[lane] = x + w
		place[e] = { x = x, w = w, lane = lane }
	end
	local top, order, y = {}, {}, 12
	for _, sc in ipairs(SEC) do
		local k = sc[1]
		if sc[3] or count[k] > 0 then
			local n = math.max(#lanes[k], 1)
			top[k] = y + 16
			order[#order + 1] = { k, sc[2], n }
			y = top[k] + n * LH + 8
		end
	end
	local H = y + 4
	E.tl.CanvasSize = UDim2.fromOffset(W, H)

	local function box(x, yy, w, h, color, tr)
		local f = Instance.new("Frame")
		f.Position = UDim2.fromOffset(x, yy)
		f.Size = UDim2.fromOffset(w, h)
		f.BackgroundColor3 = color
		f.BackgroundTransparency = tr or 0
		f.BorderSizePixel = 0
		f:SetAttribute("NoCorner", true)
		f.Parent = E.tl
		return f
	end
	local function text(x, yy, w, str, color, size)
		local l = Instance.new("TextLabel")
		l.Position = UDim2.fromOffset(x, yy)
		l.Size = UDim2.fromOffset(w, 14)
		l.BackgroundTransparency = 1
		l.Text = str
		l.TextColor3 = color
		l.Font = Th.font
		l.TextSize = size or 12
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.Parent = E.tl
		return l
	end

	for i, o in ipairs(order) do
		local k, label, n = o[1], o[2], o[3]
		box(0, top[k] - 2, W, n * LH + 4, (i % 2 == 1) and C.row1 or C.row2)
		for l = 1, n - 1 do box(0, top[k] + l * LH - 1, W, 1, C.outline, 0.6) end
		local extra = (n > 1) and ("  -  " .. n .. " rows (overlapping events)") or ""
		text(4, top[k] - 15, 520, string.format("%s (%d)%s", label, count[k], extra), X.kc(k), 11)
	end

	-- the ruler is also the scrub bar: drag on it to move the red line (the dummy and the effects follow)
	do
		local strip = Instance.new("TextButton")
		strip.AutoButtonColor = false
		strip.Text = ""
		strip.BackgroundTransparency = 1
		strip.Position = UDim2.fromOffset(0, 0)
		strip.Size = UDim2.fromOffset(W, 16)
		strip.ZIndex = 6
		strip:SetAttribute("NoCorner", true)
		strip.Parent = E.tl
		strip.InputBegan:Connect(function(input)
			if not K.isPress(input) then return end
			local P = X.tpEnsure(E.id)
			if not P then return end
			P.dragging = true
			E.tl.ScrollingEnabled = false
			local function setFrom(pos)
				local x = (pos.X - E.tl.AbsolutePosition.X) / X.guiScale() + E.tl.CanvasPosition.X
				X.tpSeek(P, math.max(x, 0) / E.pps, false)
			end
			setFrom(input.Position)
			local conn = UserInputService.InputChanged:Connect(function(i2)
				if isMove(i2) then setFrom(i2.Position) end
			end)
			input.Changed:Connect(function()
				if input.UserInputState ~= Enum.UserInputState.End then return end
				conn:Disconnect()
				P.dragging = false
				if E.tl.Parent then E.tl.ScrollingEnabled = true end
				X.tpSeek(P, P.t, true)
			end)
		end)
	end
	local step = pps >= 240 and 0.25 or (pps >= 100 and 0.5 or 1)
	for i = 0, math.floor(T / step) do
		local x = i * step * pps
		box(x, 0, 1, 10, C.outline)
		text(x + 3, 0, 44, string.format("%gs", i * step), C.sub, 11)
	end
	if len > 0 then -- where the animation itself ends
		local endLine = box(len * pps, 0, 2, H, C.anim)
		endLine.ZIndex = 2
		text(len * pps + 4, H - 14, 80, "anim end", C.anim, 11).ZIndex = 2
	end

	for _, e in ipairs(E.events) do
		local k = X.evSection(e)
		local p = place[e]
		local m = Instance.new("TextButton")
		m.AutoButtonColor = false
		m.Position = UDim2.fromOffset(p.x, top[k] + (p.lane - 1) * LH + 1)
		m.Size = UDim2.fromOffset(p.w, LH - 3)
		m.BackgroundColor3 = X.kc(k)
		m.BackgroundTransparency = e.off and 0.75 or 0
		m.BorderSizePixel = 0
		m.Text = p.w >= 40 and ((e == E.sel and "> " or "") .. tostring(e.name)) or ""
		m.TextColor3 = Color3.fromRGB(15, 15, 15)
		m.Font = Th.font
		m.TextSize = 12
		m.TextTruncate = Enum.TextTruncate.AtEnd
		m.ZIndex = (e == E.sel) and 5 or 3
		m:SetAttribute("NoCorner", true)
		-- tap = select, drag = move in time
		m.InputBegan:Connect(function(input)
			if not K.isPress(input) then return end
			local startX, lastX, moved = input.Position.X, input.Position.X, false
			E.tl.ScrollingEnabled = false
			local conn
			conn = UserInputService.InputChanged:Connect(function(i2)
				if not isMove(i2) then return end
				lastX = i2.Position.X
				if math.abs(lastX - startX) > 6 then moved = true end
				if moved then m.Position = UDim2.fromOffset(math.max(p.x + (lastX - startX) / X.guiScale(), 0), m.Position.Y.Offset) end
			end)
			input.Changed:Connect(function()
				if input.UserInputState ~= Enum.UserInputState.End then return end
				conn:Disconnect()
				if E.tl.Parent then E.tl.ScrollingEnabled = true end
				if moved then
					local nt = math.max(math.floor((p.x + (lastX - startX) / X.guiScale()) / pps / 0.05 + 0.5) * 0.05, 0)
					E.sel = e
					X.edChange(function() e.t = nt end)
				else
					X.edSelect(e)
				end
			end)
		end)
		m.Parent = E.tl
	end
	E.tl.CanvasPosition = keepPos
	X.edMoveHead(E, (X.pv and X.pv.id == E.id) and X.pv.t or (E.head or 0))
end

function X.edMoveHead(E, t) -- the red line of the FX timeline
	if not E.tl or not E.tl.Parent then return end
	E.head = t
	if not (E.headLine and E.headLine.Parent) then
		local h = Instance.new("Frame")
		h.Size = UDim2.new(0, 2, 1, 0)
		h.BackgroundColor3 = Color3.fromRGB(255, 90, 90)
		h.BorderSizePixel = 0
		h.ZIndex = 9
		h:SetAttribute("NoCorner", true)
		h.Parent = E.tl
		E.headLine = h
	end
	E.headLine.Position = UDim2.fromOffset(t * E.pps - 1, 0)
	E.headLine.Size = UDim2.new(0, 2, 0, math.max(E.tl.CanvasSize.Y.Offset, E.tl.AbsoluteSize.Y))
	if E.timeLbl and E.timeLbl.Parent then E.timeLbl.Text = string.format("%.2fs", t) end
	local P = X.pv
	if P and P.playing and not P.dragging then -- follow the line while it plays
		local cur, w = E.tl.CanvasPosition, E.tl.AbsoluteWindowSize.X
		local x = t * E.pps
		if x > cur.X + w - 30 or x < cur.X then E.tl.CanvasPosition = Vector2.new(math.max(x - 40, 0), cur.Y) end
	end
end

function X.edPanel() -- details + controls of the selected event
	local E = X.ed
	if not E or not E.panel.Parent then return end
	for _, c in ipairs(E.panel:GetChildren()) do c:Destroy() end
	local e = E.sel
	local lbl = Instance.new("TextLabel")
	lbl.Position = UDim2.new(0, 8, 0, 2)
	lbl.Size = UDim2.new(1, -16, 0, 22)
	lbl.BackgroundTransparency = 1
	lbl.RichText = true
	lbl.Font = Th.font
	lbl.TextSize = 15
	lbl.TextColor3 = C.sub
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.TextTruncate = Enum.TextTruncate.AtEnd
	lbl.Parent = E.panel
	if not e or not table.find(E.events, e) then
		E.sel = nil
		lbl.Text = "Tap a block on the timeline (or a row below) to edit it. Drag a block to move it in time."
		return
	end
	local title, detail = X.evLines(e)
	local isSfx = e.kind == "sfx"
	lbl.Text = string.format('<font color="%s"><b>%s</b></font>   %s', K.hex(X.kc(X.evSection(e))), K.esc(title), K.esc(detail))

	local bar = X.mkBar(E.panel, 28, 34)
	local function ch(fn) return function() X.edChange(fn) end end
	local tog = X.mkTool(bar, e.off and "OFF" or "ON", 48, e.off and C.danger or C.green, ch(function() e.off = (not e.off) or nil end))

	X.mkLabel(bar, "Start", 36)
	X.mkTool(bar, "-", 28, C.btn, ch(function() e.t = math.max(e.t - 0.05, 0) end))
