-- Runtime that plays the VFX / SFX events. Every effect runs inside pcall.
local FX_RUNTIME = [==[
local Debris = game:GetService("Debris")
local SoundService = game:GetService("SoundService")
local RunService = game:GetService("RunService")
local fxChar = lp.Character or lp.CharacterAdded:Wait()
local fxRoot = fxChar:WaitForChild("HumanoidRootPart")

local function mountFor(m)
	local att = Instance.new("Attachment")
	local part = m and m.part and fxChar:FindFirstChild(m.part, true)
	if part and part:IsA("BasePart") then
		att.CFrame = m.cf or CFrame.new()
		att.Parent = part
		return att, att
	end
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(0.2, 0.2, 0.2)
	p.CFrame = fxRoot.CFrame * ((m and m.cf) or CFrame.new())
	p:SetAttribute("_Replay", true)
	p.Parent = workspace
	att.Parent = p
	return att, p
end

local function setProps(inst, props)
	for _, kv in ipairs(props) do
		pcall(function() inst[kv[1]] = kv[2] end)
	end
end

local function mkPart(d)
	local ok, o = pcall(Instance.new, d.cls)
	local p = (ok and o and o:IsA("BasePart")) and o or Instance.new("Part")
	for _, kv in ipairs(d.props) do
		pcall(function() p[kv[1]] = kv[2] end)
	end
	p.Name = d.name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	for _, k in ipairs(d.kids or {}) do
		local okK, o2 = pcall(Instance.new, k.cls)
		if okK and o2 then
			for _, kv in ipairs(k.props) do
				pcall(function() o2[kv[1]] = kv[2] end)
			end
			o2.Parent = p
		end
	end
	return p
end

-- a spawned object (sword, dummy, parts...) rebuilt from its parts
local function playObj(e)
	local holder = Instance.new("Model")
	holder:SetAttribute("_Replay", true)
	holder.Name = e.name or "Spawned"
	local made = {}
	for i, d in ipairs(e.spec.parts) do
		local ok, p = pcall(mkPart, d)
		if ok and p then
			made[i] = p
			p.Parent = holder
		end
	end
	if next(made) == nil then
		holder:Destroy()
		return
	end
	local attached = e.mount and e.mount.part and fxChar:FindFirstChild(e.mount.part, true)
	local pivotCF
	if attached and attached:IsA("BasePart") then
		pivotCF = attached.CFrame * e.mount.cf
	else
		attached = nil
		pivotCF = fxRoot.CFrame * (e.rel or CFrame.new())
	end
	for i, d in ipairs(e.spec.parts) do
		if made[i] then made[i].CFrame = pivotCF * d.rel end
	end
	holder.Parent = workspace
	local life = (e.dur or 2.5)
	if attached then -- held / worn: follows the animation
		for _, p in pairs(made) do
			p.Anchored = false
			local w = Instance.new("WeldConstraint")
			w.Part0 = attached
			w.Part1 = p
			w.Parent = p
		end
	elseif e.path and #e.path >= 2 then -- flies / moves on its own
		local root0 = fxRoot.CFrame
		task.spawn(function()
			local t0 = os.clock()
			local path = e.path
			local i = 1
			while holder.Parent and os.clock() - t0 < life do
				local t = os.clock() - t0
				while i < #path - 1 and path[i + 1][1] < t do i += 1 end
				local a, b = path[i], path[i + 1]
				local al = math.clamp((t - a[1]) / math.max(b[1] - a[1], 1e-4), 0, 1)
				local pc = root0 * a[2]:Lerp(b[2], al)
				for k, d in ipairs(e.spec.parts) do
					if made[k] then made[k].CFrame = pc * d.rel end
				end
				RunService.Heartbeat:Wait()
			end
		end)
	end
	Debris:AddItem(holder, life + 0.3)
end

-- cutscene camera: plays the recorded camera path (relative to where you stand), then gives the camera back
local function playCam(e)
	local cam = workspace.CurrentCamera
	local pts = e.cam
	if not cam or not pts or #pts < 2 then return end
	local rootCF = fxRoot.CFrame
	local oldType, oldFov = cam.CameraType, cam.FieldOfView
	cam.CameraType = Enum.CameraType.Scriptable
	pcall(function() workspace:SetAttribute("_ReplayCam", true) end)
	local t0 = os.clock()
	local last = pts[#pts][1]
	local i = 1
	while os.clock() - t0 < last do
		local t = os.clock() - t0
		while i < #pts - 1 and pts[i + 1][1] < t do i += 1 end
		local a, b = pts[i], pts[i + 1]
		local al = math.clamp((t - a[1]) / math.max(b[1] - a[1], 1e-4), 0, 1)
		cam.CFrame = rootCF * a[2]:Lerp(b[2], al)
		cam.FieldOfView = a[3] + (b[3] - a[3]) * al
		RunService.RenderStepped:Wait()
	end
	cam.CameraType = oldType
	cam.FieldOfView = oldFov
	pcall(function() workspace:SetAttribute("_ReplayCam", nil) end)
end

local TweenService = game:GetService("TweenService")
local function playGui(e)
	local g = e.gui
	if not g or not g.nodes or #g.nodes == 0 then return end
	local insts = {}
	for i, n in ipairs(g.nodes) do
		local inst = Instance.new(n.c)
		inst.Name = n.n
		for _, kv in ipairs(n.pr) do pcall(function() inst[kv[1]] = kv[2] end) end
		insts[i] = inst
	end
	for i, n in ipairs(g.nodes) do
		if n.p > 0 and insts[n.p] then insts[i].Parent = insts[n.p] end
	end
	local root = insts[1]
	root:SetAttribute("_Replay", true)
	local okH, hui = pcall(function() return gethui() end)
	root.Parent = (okH and hui) or lp:WaitForChild("PlayerGui")
	task.spawn(function()
		local t0 = os.clock()
		for _, k in ipairs(g.keys or {}) do
			local w = k[1] - (os.clock() - t0)
			if w > 0 then task.wait(w) end
			local inst = insts[k[2]]
			if inst then
				pcall(function()
					local tv = typeof(k[4])
					if tv == "UDim2" or tv == "number" or tv == "Color3" or tv == "Vector2" or tv == "UDim" then
						TweenService:Create(inst, TweenInfo.new(0.06, Enum.EasingStyle.Linear), { [k[3]] = k[4] }):Play()
					else
						inst[k[3]] = k[4]
					end
				end)
			end
		end
	end)
	task.delay((e.dur or g.dur or 3) + 0.5, function() pcall(function() root:Destroy() end) end)
end

local function playFX(e)
	if e.kind == "gui" then return playGui(e) end
	if e.kind == "obj" then return playObj(e) end
	if e.kind == "cam" then return playCam(e) end
	if e.kind == "sfx" then
		local s = Instance.new("Sound")
		s:SetAttribute("_Replay", true)
		setProps(s, e.props)
		s.Parent = e.pos and fxRoot or SoundService
		s:Play()
		Debris:AddItem(s, e.dur or 5)
		return
	end

	local cls = e.class
	local fx = Instance.new(cls)
	fx:SetAttribute("_Replay", true)
	fx.Name = e.name or cls
	setProps(fx, e.props)
	local life = (e.dur or 2) + 2

	if cls == "Highlight" then
		fx.Adornee = fxChar
		fx.Parent = fxChar
	elseif cls == "Explosion" then
		fx.BlastPressure = 0
		fx.DestroyJointRadiusPercent = 0
		fx.Position = (fxRoot.CFrame * ((e.mount and e.mount.cf) or CFrame.new())).Position
		fx.Parent = workspace
	elseif cls == "Beam" or cls == "Trail" then
		local a0, h0 = mountFor(e.att0 or e.mount)
		local a1, h1 = mountFor(e.att1 or e.mount)
		fx.Attachment0, fx.Attachment1 = a0, a1
		fx.Parent = a0
		Debris:AddItem(h0, life)
		Debris:AddItem(h1, life)
	else
		local att, holder = mountFor(e.mount)
		if cls == "Fire" or cls == "Smoke" or cls == "Sparkles" then
			fx.Parent = att.Parent -- these legacy effects need a BasePart
		else
			fx.Parent = att
		end
		if cls == "ParticleEmitter" then
			if e.enabled then
				fx.Enabled = true
				task.delay(e.dur or 1.5, function() pcall(function() fx.Enabled = false end) end)
			else
				fx.Enabled = false
				fx:Emit(e.emit or 10)
			end
		end
		Debris:AddItem(holder, life)
	end
	Debris:AddItem(fx, life)
end

for _, e in ipairs(FX) do
	task.delay(e.t or 0, function()
		local ok, err = pcall(playFX, e)
		if not ok then warn("[FX] skipped:", err) end
	end)
end
]==]

function K.indentLines(s, prefix)
	return (s:gsub("[^\n]+", function(l) return prefix .. l end))
end

function K.mountStr(m)
	if not m then return "nil" end
	return string.format(
		"{ part = %s, cf = %s }",
		m.part and string.format("%q", m.part) or "nil", K.cfStr(m.cf or CFrame.new())
	)
end

function K.evStr(ev)
	local L = {}
	local head = { "t = " .. K.g(ev.t or 0), string.format("kind = %q", ev.kind) }
	if ev.class then head[#head + 1] = string.format("class = %q", ev.class) end
	head[#head + 1] = string.format("name = %q", ev.name or "")
	if ev.enabled ~= nil then head[#head + 1] = "enabled = " .. tostring(ev.enabled) end
	if ev.emit then head[#head + 1] = "emit = " .. K.g(ev.emit) end
	if ev.dur then head[#head + 1] = "dur = " .. K.g(ev.dur) end
	if ev.pos then head[#head + 1] = "pos = true" end
	L[#L + 1] = "{ " .. table.concat(head, ", ") .. ","
	if ev.mount then L[#L + 1] = "\tmount = " .. K.mountStr(ev.mount) .. "," end
	if ev.att0 then L[#L + 1] = "\tatt0 = " .. K.mountStr(ev.att0) .. "," end
	if ev.att1 then L[#L + 1] = "\tatt1 = " .. K.mountStr(ev.att1) .. "," end
	if ev.kind == "obj" and ev.spec then
		L[#L + 1] = "\trel = " .. K.cfStr(ev.rel or CFrame.new()) .. ","
		L[#L + 1] = "\tspec = " .. K.specStr(ev.spec) .. ","
		if ev.path and #ev.path >= 2 then
			local ps = {}
			for _, pt in ipairs(ev.path) do ps[#ps + 1] = string.format("{%s, %s}", K.g(pt[1]), K.cfStr(pt[2])) end
			L[#L + 1] = "\tpath = { " .. table.concat(ps, ", ") .. " },"
		end
	elseif ev.kind == "cam" and ev.cam then
		local cs = {}
		for _, pt in ipairs(ev.cam) do cs[#cs + 1] = string.format("{%s, %s, %s}", K.g(pt[1]), K.cfStr(pt[2]), K.g(pt[3])) end
		L[#L + 1] = "\tcam = { " .. table.concat(cs, ", ") .. " },"
	elseif ev.kind == "gui" and ev.gui then
		local ns = {}
		for _, n in ipairs(ev.gui.nodes) do
			local prs = {}
			for _, kv in ipairs(n.pr) do prs[#prs + 1] = string.format("{%q,%s}", kv[1], kv[2]) end
			ns[#ns + 1] = string.format("{c=%q,n=%q,p=%d,pr={%s}}", n.c, n.n, n.p, table.concat(prs, ","))
		end
		local ks = {}
		for _, k in ipairs(ev.gui.keys) do ks[#ks + 1] = string.format("{%s,%d,%q,%s}", K.g(k[1]), k[2], k[3], k[4]) end
		L[#L + 1] = "\tgui = { dur = " .. K.g(ev.gui.dur or 3) .. ", nodes = {\n\t\t" .. table.concat(ns, ",\n\t\t") .. " },\n\tkeys = {\n\t\t" .. table.concat(ks, ",\n\t\t") .. " } },"
	end
	L[#L + 1] = "\tprops = {"
	for _, kv in ipairs(ev.props) do
		L[#L + 1] = string.format("\t\t{%q, %s},", kv[1], kv[2])
	end
	L[#L + 1] = "\t} }"
	return table.concat(L, "\n")
end

-- the whole FX section: runs in its own thread inside pcall, so the animation never depends on it
function K.genFXBlock(events)
	local L = {}
	local function add(s) L[#L + 1] = s end
	add("-- VFX / SFX / spawned objects / cutscene camera: rebuilt from properties. Each runs inside pcall,")
	add("-- so if a sound or effect fails, the rest - and the animation - still play.")
	add("task.spawn(function()")
	add("\tlocal ok, err = pcall(function()")
	add("\t\tlocal FX = {")
	for _, ev in ipairs(events) do
		if not (ev.kind == "cam" and #(ev.cam or {}) < 2) and not (ev.kind == "obj" and not ev.spec) and not (ev.kind == "gui" and not ev.gui) then
			add(K.indentLines(K.evStr(ev), "\t\t\t") .. ",")
		end
	end
	add("\t\t}")
	add(K.indentLines(FX_RUNTIME, "\t\t"))
	add("\tend)")
	add('\tif not ok then warn("[FX] failed (animation unaffected):", err) end')
	add("end)")
	return table.concat(L, "\n")
end

function K.genStandaloneFX(events, title)
	return table.concat({
		"-- " .. title,
		"-- Rebuilt from properties - no original asset / instance needed",
		'local Players = game:GetService("Players")',
		"local lp = Players.LocalPlayer",
		"",
		K.genFXBlock(events),
		"",
	}, "\n")
end

function K.runEvents(events, title)
	if not loadstring then error("loadstring is not available in this executor") end
	local fn, err = loadstring(K.genStandaloneFX(events, title))
	if not fn then error(err) end
	fn()
end

-- Playback part of the frame-by-frame script.
-- The character's Animator is detached while playing and the SAME Animator is put back afterwards,
-- the animation plays once (unless LOOP_FOREVER), and it cancels itself if you move, jump or die -
-- so your normal animations keep working.
local PLAYBACK_CODE = [==[
-- stop a previous run of this script (if any)
if _G.StopRecreatedAnim then pcall(_G.StopRecreatedAnim) end

local char = lp.Character or lp.CharacterAdded:Wait()
local hum = char:WaitForChild("Humanoid")

local function notify(text)
	print("[RecreatedAnim] " .. text)
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", {
			Title = "Recreated anim", Text = text, Duration = 3,
		})
	end)
end

if hum.RigType.Name ~= RIG then
	notify("Captured on " .. RIG .. " but your character is " .. hum.RigType.Name .. " - can't play here.")
	return
end

local motors, count = {}, 0
for _, d in ipairs(char:GetDescendants()) do
	if d:IsA("Motor6D") and JOINTS[d.Name] and d.Part1 and not motors[d.Name] then
		motors[d.Name] = d
		count += 1
	end
end
if count == 0 then
	notify("No matching joints found on your character.")
	return
end

local function apply(pose)
	for name, cf in pairs(pose) do
		local m = motors[name]
		if m then m.Transform = cf end
	end
end

-- take the Animator(s) off the character while playing (we put the same ones back at the end)
local animate = char:FindFirstChild("Animate")
local animateWasDisabled = animate and animate.Disabled
local detached = {}

local function detachAnimators()
	for _, d in ipairs(hum:GetChildren()) do
		if d:IsA("Animator") then
			detached[#detached + 1] = d
			d.Parent = nil
		end
	end
end

if DISABLE_DEFAULT_ANIMATE then
	if animate then animate.Disabled = true end
	detachAnimators()
end

local accumulated = 0
local index = 1
local lastFrame
local conns = {}
local stopped = false
local startClock = os.clock()

local function stop()
	if stopped then return end
	stopped = true
	for _, c in ipairs(conns) do c:Disconnect() end
	table.clear(conns)
	for _, m in pairs(motors) do m.Transform = CFrame.new() end

	-- give the character its original Animator(s) back
	if #detached > 0 then
		for _, a in ipairs(hum:GetChildren()) do
			if a:IsA("Animator") then a:Destroy() end -- any replacement made while we played
		end
		for _, a in ipairs(detached) do a.Parent = hum end
	end
	if animate and DISABLE_DEFAULT_ANIMATE then animate.Disabled = animateWasDisabled end
	_G.StopRecreatedAnim = nil
end

table.insert(conns, hum.Died:Connect(stop))

table.insert(conns, RunService.Heartbeat:Connect(function(dt)
	if stopped then return end

	-- you moved / jumped: hand control back so your own animations work
	if CANCEL_ON_MOVE and os.clock() - startClock > 0.25 then
		if hum.MoveDirection.Magnitude > 0.1 or hum.Jump then
			stop()
			return
		end
	end

	accumulated += dt * SPEED
	if DISABLE_DEFAULT_ANIMATE then detachAnimators() end

	-- advance through the captured frames
	while frames[index] and accumulated >= frames[index].dt do
		accumulated -= frames[index].dt
		lastFrame = frames[index]
		index += 1
	end

	local nextFrame = frames[index]
	if not nextFrame then
		-- reached the end
		if lastFrame then apply(lastFrame.j) end
		if LOOP_FOREVER then
			index, accumulated = 1, 0
		else
			stop()
		end
		return
	end

	if lastFrame and SMOOTH then
		-- blend from the last frame toward the next one
		local alpha = math.clamp(accumulated / math.max(nextFrame.dt, 1e-6), 0, 1)
		for name, cf in pairs(nextFrame.j) do
			local m = motors[name]
			local from = lastFrame.j[name]
			if m and from then m.Transform = from:Lerp(cf, alpha) end
		end
	elseif lastFrame then
		apply(lastFrame.j)
	end
end))

-- call _G.StopRecreatedAnim() to stop early (only you can see this - it's client-side)
_G.StopRecreatedAnim = stop
notify(string.format("Playing (%d joints, %.2fs) - move or jump to cancel", count, LENGTH))
]==]

-- joints = { { name, part0, part1, frames = { {t, cf}, ... } }, ... }; fx = list of FX events or nil
function K.genDetailedCode(id, rig, length, looped, joints, fx, note)
	local L = {}
	local function add(s) table.insert(L, s) end

	local names = {}
	for _, j in ipairs(joints) do table.insert(names, j.part1 .. " [" .. j.name .. "]") end

	add("-- Animation: " .. K.animName(id) .. " | Type: " .. ((fx and #fx > 0) and "FULL FX" or "FRAME BY FRAME"))
	add("-- Recreated animation - runs WITHOUT the original animation")
	add("-- Source AnimationId: " .. (tostring(id):gsub("#saved$", "")))
	add(string.format("-- Rig: %s | Length: %.2fs | Original looped: %s", rig, length, tostring(looped)))
	add("-- Parts moved: " .. table.concat(names, ", "))
	if note then add("-- " .. note) end
	add("-- Every frame lists where each joint goes - e.g. the 'Left Shoulder' joint is")
	add("-- what moves the Left Arm (rot = degrees XYZ, just for reading).")
	if fx and #fx > 0 then
		add(string.format("-- Includes %d VFX/SFX events (rebuilt from properties, each inside pcall).", #fx))
	end
	add("")
	add('local Players = game:GetService("Players")')
	add('local RunService = game:GetService("RunService")')
	add("local lp = Players.LocalPlayer")
	add("")
	add("local LENGTH = " .. K.num(length))
	add("local SPEED = 1")
	add(string.format("local RIG = %q -- rig type this was captured on (must match yours)", rig))
	add("local SMOOTH = true -- blend between frames (false = exact frame steps)")
	add("local LOOP_FOREVER = false -- plays once; set true to repeat until _G.StopRecreatedAnim()")
	add("local CANCEL_ON_MOVE = true -- moving or jumping cancels it so your own animations work")
	add("local DISABLE_DEFAULT_ANIMATE = true -- detaches your Animator while playing, restored after")
	add("")
	add("local JOINTS = { -- the Motor6D joints this animation moves")
	for _, j in ipairs(joints) do
		add(string.format("\t[%q] = true, -- %s  (%s -> %s)", j.name, j.part1, j.part0, j.part1))
	end
	add("}")
	add("")
	add("-- one entry per frame: dt = seconds since the previous frame, j = where every joint goes")
	add("local frames = {")
	local base = joints[1].frames
	for i = 1, #base do
		local dt = i > 1 and (base[i][1] - base[i - 1][1]) or 0
		add(string.format("\t{ dt = %s, j = {", K.num(dt)))
		for _, j in ipairs(joints) do
			local cf = j.frames[i][2]
			local rx, ry, rz = cf:ToEulerAnglesXYZ()
			add(string.format(
				"\t\t[%q] = %s, -- %s rot %d, %d, %d",
				j.name, K.cfStr(cf), j.part1,
				math.floor(math.deg(rx) + 0.5), math.floor(math.deg(ry) + 0.5), math.floor(math.deg(rz) + 0.5)
			))
		end
		add("\t} },")
	end
	add("}")
	add("")
	if fx and #fx > 0 then
		add(K.genFXBlock(fx)) -- scheduled first, in its own thread; can never block the animation
		add("")
	end
	add(PLAYBACK_CODE)
	return table.concat(L, "\n")
end

--// RBXMX (KeyframeSequence) export ----------------------------------------------
function K.xmlEsc(s)
	return (tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;"))
end

local CF_TAGS = { "X", "Y", "Z", "R00", "R01", "R02", "R10", "R11", "R12", "R20", "R21", "R22" }
function K.cfXml(cf)
	local c = { cf:GetComponents() }
	local parts = { '<CoordinateFrame name="CFrame">' }
	for i, tag in ipairs(CF_TAGS) do
		parts[#parts + 1] = "<" .. tag .. ">" .. K.g(c[i]) .. "</" .. tag .. ">"
	end
	parts[#parts + 1] = "</CoordinateFrame>"
	return table.concat(parts)
end

local RBXMX_HEAD = '<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" '
	.. 'xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" '
	.. 'xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">'

function K.buildRbxmx(name, loop, priority, emitKeyframes)
	local lines, refN = {}, -1
	local function w(s) lines[#lines + 1] = s end
	local function ref() refN += 1 return refN end

	w(RBXMX_HEAD)
	w('<Meta name="ExplicitAutoJoints">true</Meta>')
	w(string.format('<Item class="KeyframeSequence" referent="RBX%d"><Properties>', ref()))
	w(string.format(
		'<bool name="Loop">%s</bool><string name="Name">%s</string><token name="Priority">%d</token>',
		tostring(loop), K.xmlEsc(name), priority
	))
	w("</Properties>")
	emitKeyframes(w, ref)
	w("</Item>")
	w("</roblox>")
	return table.concat(lines, "\n")
end

function K.keyframeOpen(ref, t)
	return string.format(
		'<Item class="Keyframe" referent="RBX%d"><Properties><string name="Name">Keyframe</string><float name="Time">%s</float></Properties>',
		ref(), K.g(t)
	)
end

function K.emitPoseInst(w, ref, pose)
	w(string.format('<Item class="Pose" referent="RBX%d"><Properties>', ref()))
	w(K.cfXml(pose.CFrame))
	w(string.format(
		'<token name="EasingDirection">%d</token><token name="EasingStyle">%d</token>',
		pose.EasingDirection.Value, pose.EasingStyle.Value
	))
	w(string.format('<string name="Name">%s</string><float name="Weight">%s</float>', K.xmlEsc(pose.Name), K.g(pose.Weight)))
	w("</Properties>")
	for _, c in ipairs(pose:GetChildren()) do
		if c:IsA("Pose") then K.emitPoseInst(w, ref, c) end
	end
	w("</Item>")
end

function K.rbxmxFromInstance(ks)
	local kfs = {}
	for _, c in ipairs(ks:GetChildren()) do
		if c:IsA("Keyframe") then table.insert(kfs, c) end
	end
	table.sort(kfs, function(a, b) return a.Time < b.Time end)
	if #kfs == 0 then error("empty KeyframeSequence") end
	return K.buildRbxmx(ks.Name, ks.Loop, ks.Priority.Value, function(w, ref)
		for _, kf in ipairs(kfs) do
			w(K.keyframeOpen(ref, kf.Time))
			for _, p in ipairs(kf:GetChildren()) do
				if p:IsA("Pose") then K.emitPoseInst(w, ref, p) end
			end
			w("</Item>")
		end
	end)
end

function K.emitCapturedPose(w, ref, name, cf, weight, kids, i)
	w(string.format('<Item class="Pose" referent="RBX%d"><Properties>', ref()))
	w(K.cfXml(cf))
	w('<token name="EasingDirection">0</token><token name="EasingStyle">0</token>')
	w(string.format('<string name="Name">%s</string><float name="Weight">%d</float>', K.xmlEsc(name), weight))
	w("</Properties>")
	for _, k in ipairs(kids[name] or {}) do
		K.emitCapturedPose(w, ref, k.name, k.samples[i][2], 1, kids, i)
	end
	w("</Item>")
end

function K.rbxmxFromCapture(name, loop, priority, motorsInfo)
	local kids, isChild, roots, seenRoot = {}, {}, {}, {}
	for _, mi in ipairs(motorsInfo) do
		kids[mi.parent] = kids[mi.parent] or {}
		table.insert(kids[mi.parent], mi)
		isChild[mi.name] = true
	end
	for _, mi in ipairs(motorsInfo) do
		if not isChild[mi.parent] and not seenRoot[mi.parent] then
			seenRoot[mi.parent] = true
			table.insert(roots, mi.parent)
		end
	end
	local n = math.huge
	for _, mi in ipairs(motorsInfo) do n = math.min(n, #mi.samples) end

	return K.buildRbxmx(name, loop, priority, function(w, ref)
		for i = 1, n do
			w(K.keyframeOpen(ref, motorsInfo[1].samples[i][1]))
			for _, rootName in ipairs(roots) do
				K.emitCapturedPose(w, ref, rootName, CFrame.new(), 0, kids, i)
			end
			w("</Item>")
		end
	end)
end

--// Getting the animation data (fast path: real keyframes; fallback: capture) -------
function K.fetchOriginalSequence(id)
	local ks = K.withTimeout(3, function()
		local objs = game:GetObjects(id)
		if typeof(objs) == "table" then
			for _, o in ipairs(objs) do
				if o:IsA("KeyframeSequence") then return o end
				local inner = o:FindFirstChildWhichIsA("KeyframeSequence", true)
				if inner then return inner end
			end
		end
		return nil
	end)
	if ks then return ks end
	return K.withTimeout(3, function()
		return game:GetService("KeyframeSequenceProvider"):GetKeyframeSequenceAsync(id)
	end)
end

local STYLE_MAP = {
	[Enum.PoseEasingStyle.Linear] = Enum.EasingStyle.Linear,
	[Enum.PoseEasingStyle.Bounce] = Enum.EasingStyle.Bounce,
	[Enum.PoseEasingStyle.Cubic] = Enum.EasingStyle.Cubic,
	[Enum.PoseEasingStyle.Elastic] = Enum.EasingStyle.Elastic,
}
local DIR_MAP = {
	[Enum.PoseEasingDirection.In] = Enum.EasingDirection.In,
	[Enum.PoseEasingDirection.Out] = Enum.EasingDirection.Out,
	[Enum.PoseEasingDirection.InOut] = Enum.EasingDirection.InOut,
}

function K.evalCurve(list, t)
	local n = #list
	if n == 1 or t <= list[1].t then return list[1].cf end
	if t >= list[n].t then return list[n].cf end
	for i = 1, n - 1 do
		local a, b = list[i], list[i + 1]
		if t >= a.t and t <= b.t then
			local span = b.t - a.t
			if span <= 0 then return b.cf end
			if b.style == Enum.PoseEasingStyle.Constant then return a.cf end
			local alpha = TweenService:GetValue(
				(t - a.t) / span,
				STYLE_MAP[b.style] or Enum.EasingStyle.Linear,
				DIR_MAP[b.dir] or Enum.EasingDirection.InOut
			)
			return a.cf:Lerp(b.cf, alpha)
		end
	end
	return list[n].cf
end

-- raw = { motors = { {motorName, part0, part1, samples = { {t, cf}, ... }}, ... }, looped, priorityName, priorityValue }
function K.rawFromSequence(ks, char)
	local kfs = {}
	for _, c in ipairs(ks:GetChildren()) do
		if c:IsA("Keyframe") then kfs[#kfs + 1] = c end
	end
	if #kfs == 0 then error("no keyframes") end
	table.sort(kfs, function(a, b) return a.Time < b.Time end)
	local length = kfs[#kfs].Time
	if length <= 0 then length = 0.1 end -- a single still pose (e.g. a Block pose): hold it for a moment

	local curves = {}
	for _, kf in ipairs(kfs) do
		for _, pose in ipairs(kf:GetDescendants()) do
			if pose:IsA("Pose") and pose.Weight > 0 then
				local list = curves[pose.Name]
				if not list then
					list = {}
					curves[pose.Name] = list
				end
				list[#list + 1] = { t = kf.Time, cf = pose.CFrame, style = pose.EasingStyle, dir = pose.EasingDirection }
			end
		end
	end

	local times = {}
	local steps = math.max(2, math.ceil(length / CAPTURE_STEP))
	for k = 0, steps do times[#times + 1] = math.min(k * (length / steps), length) end

	local motors, matched = {}, 0
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("Motor6D") and d.Part0 and d.Part1 then
			local curve = curves[d.Part1.Name]
			local samples = {}
			for _, t in ipairs(times) do
				samples[#samples + 1] = { t, curve and K.evalCurve(curve, t) or CFrame.new() }
			end
			if curve then matched += 1 end
			motors[#motors + 1] = { motorName = d.Name, part0 = d.Part0.Name, part1 = d.Part1.Name, samples = samples }
		end
	end
	if matched == 0 then error("rig mismatch - none of the animation's joints exist on your character") end

	return {
		motors = motors, looped = ks.Loop,
		priorityName = ks.Priority.Name, priorityValue = ks.Priority.Value,
	}
end

-- fallback: plays the animation on a hidden clone of your character (up to 4x speed) and samples it
function K.rawFromPlaying(id, char, progress)
	local oldArch = char.Archivable
	char.Archivable = true
	local dummy = char:Clone()
	char.Archivable = oldArch
	if not dummy then error("couldn't clone your character") end

	dummy.Name = "_AnimCaptureDummy"
	dummy:SetAttribute("_LoggerClone", true)
	for _, d in ipairs(dummy:GetDescendants()) do
		d:SetAttribute("_LoggerClone", true)
		if d:IsA("LuaSourceContainer") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = true
		end
	end
	dummy:PivotTo(CFrame.new(0, 20000, 0))

	local dHum = dummy:FindFirstChildOfClass("Humanoid")
	local holder = dHum or dummy:FindFirstChildWhichIsA("AnimationController", true)
	if not holder then -- a rig without Humanoid (cutscene prop / NPC): an AnimationController plays it
		holder = Instance.new("AnimationController")
		holder:SetAttribute("_LoggerClone", true)
		holder.Parent = dummy
	end
	if dHum then pcall(function() dHum.EvaluateStateMachine = false end) end
	local animator = holder:FindFirstChildOfClass("Animator") or dummy:FindFirstChildWhichIsA("Animator", true)
	if not animator then
		animator = Instance.new("Animator")
		animator:SetAttribute("_LoggerClone", true)
		animator.Parent = holder
	end
	dummy.Parent = workspace

	local motors = {}
	for _, d in ipairs(dummy:GetDescendants()) do
		if d:IsA("Motor6D") and d.Part0 and d.Part1 then table.insert(motors, d) end
	end

	local anim = Instance.new("Animation")
	anim.AnimationId = id
	local okLoad, track = pcall(function() return animator:LoadAnimation(anim) end)
	if not okLoad or not track then
		dummy:Destroy()
		error("couldn't load animation (not allowed / invalid id)")
	end
	ownTracks[track] = true

	local looped, priorityName, priorityValue, speed = track.Looped, track.Priority.Name, track.Priority.Value, track.Speed
	animInfo[id] = animInfo[id] or { priority = priorityName, looped = looped, speed = speed }
	track.Looped = false

	local waited = 0
	while track.Length == 0 and waited < 3 do waited += RunService.Heartbeat:Wait() end
	local length = track.Length
	local still = length == 0 -- a single still pose (e.g. Block): hold it and sample it
	if still then length = 0.2 end
	-- long animations are captured faster, very short ones slower so there are enough frames
	local speedMul = length < 0.8 and math.max(length / 0.8, 0.1) or math.clamp(length / 2, 1, 4)
	local step = math.min(CAPTURE_STEP, length / 24)
	progress(string.format("Capturing on a hidden rig (%.1fx speed)...", speedMul))

	local samples = {}
	for _, m in ipairs(motors) do samples[m] = {} end

	if still then track.Looped = true end
	track:Play(0, 1, speedMul)
	local startClock, nextT, firstPos, lastReport = os.clock(), 0, nil, 0
	local maxWall = length / speedMul + 3
	if still then
		for _ = 1, 4 do RunService.Heartbeat:Wait() end
		for _, m in ipairs(motors) do
			local cf = m.Transform
			samples[m] = { { 0, cf }, { length, cf } }
		end
	end
	while not still and track.IsPlaying and os.clock() - startClock < maxWall do
		RunService.Heartbeat:Wait()
		local pos = track.TimePosition
		if pos > 0 and pos >= nextT then
			firstPos = firstPos or pos
			for _, m in ipairs(motors) do
				table.insert(samples[m], { pos - firstPos, m.Transform })
			end
			nextT = pos + step * 0.9
			if os.clock() - lastReport > 0.25 then
				lastReport = os.clock()
				progress(string.format("Capturing... %d%%", math.floor(pos / length * 100)))
			end
		end
	end
	track:Stop(0)
	dummy:Destroy()

	local list = {}
	for _, m in ipairs(motors) do
		list[#list + 1] = { motorName = m.Name, part0 = m.Part0.Name, part1 = m.Part1.Name, samples = samples[m] }
	end
	return { motors = list, looped = looped, priorityName = priorityName, priorityValue = priorityValue }
end

function K.buildRecord(id, raw, rig)
	local identity = CFrame.new()
	local joints, allMotors, totalLength = {}, {}, 0
	for _, m in ipairs(raw.motors) do
		local s = m.samples
		if #s >= 2 then
			allMotors[#allMotors + 1] = { name = m.part1, parent = m.part0, samples = s }
			local moved = false
			for _, f in ipairs(s) do
				if K.cfDiffers(f[2], identity) then moved = true break end
			end
			if moved then
				joints[#joints + 1] = { name = m.motorName, part0 = m.part0, part1 = m.part1, frames = s }
				totalLength = math.max(totalLength, s[#s][1])
			end
		end
	end
	if #joints == 0 then
		error("no joints moved - the animation may be unusable here or made for another rig (your rig is " .. rig .. ")")
	end
	animInfo[id] = animInfo[id] or { priority = raw.priorityName, looped = raw.looped, speed = 1 }
	return {
		rig = rig, length = totalLength, looped = raw.looped, joints = joints, allMotors = allMotors,
		priorityValue = raw.priorityValue, cache = {}, rawFrames = #joints[1].frames,
	}
end

function K.captureDetail(id, progress)
	progress = progress or function() end
	local char = X.rigKeep[id] -- a cutscene animation is captured on the rig it really plays on (not on your own character)
	if char and not char:FindFirstChildWhichIsA("Motor6D", true) then char = nil end
	local hum
	if char then
		hum = char:FindFirstChildOfClass("Humanoid")
	else
		char = lp.Character
		hum = char and char:FindFirstChildOfClass("Humanoid")
		if not (char and hum and K.getRoot()) then error("character not ready") end
	end
	local rig = hum and hum.RigType.Name or "Custom"
	if not hum then -- no Humanoid: tell R6 / R15 apart by the joints it has
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("Motor6D") and (d.Name == "Root" or d.Name == "RightShoulder" or d.Name == "Waist") then
				rig = "R15"
				break
			elseif d:IsA("Motor6D") and (d.Name == "RootJoint" or d.Name == "Right Shoulder") then
				rig = "R6"
				break
			end
		end
	end

	-- fast path: the animation's real keyframes (instant, no waiting)
	progress("Fetching the animation's keyframes...")
	local ks = K.fetchOriginalSequence(id)
	if ks then
		local ok, raw = pcall(K.rawFromSequence, ks, char)
		if ok then
			progress("Building from keyframes...")
			local rec = K.buildRecord(id, raw, rig)
			rec.source = "keyframes"
			pcall(function() rbxmxCache[id] = { xml = K.rbxmxFromInstance(ks), source = "original" } end)
			return rec
		end
	end

	-- slow path: capture on a hidden rig
	progress("Keyframes not available - capturing on a hidden rig...")
	local raw = K.rawFromPlaying(id, char, progress)
	local rec = K.buildRecord(id, raw, rig)
	rec.source = "captured"
	return rec
end

-- simplified joints for the current quality (cached per quality)
function K.simplified(id)
	local d = details[id]
	local c = d.cache[QUALITY]
	if not c then
		local joints, kept, total = K.simplifyJoints(d.joints, QUALITY_TOL[QUALITY] or 0)
		c = { joints = joints, kept = kept, total = total }
		d.cache[QUALITY] = c
	end
	return c
end

function K.summaryFor(id)
	local d = details[id]
	local c = K.simplified(id)
	local names = {}
	for _, j in ipairs(d.joints) do names[#names + 1] = j.part1 .. " (" .. j.name .. ")" end
	return string.format(
		"Moved: %s | %d of %d frames (%s) | %.2fs | %s | %s",
		table.concat(names, ", "), c.kept, c.total, QUALITY, d.length, d.rig, d.source
	)
end

-- mode: nil = frame by frame only | "vfx" = + VFX only | "sfx" = + SFX only | "fx" = + VFX and SFX | "cut" = + cutscene camera | "all" = + spawned objects too
-- the key an FX event has in the Block / Excl lists: "v", "Class|Name|Texture"  or  "s", "SoundId"
function X.fxKey(e)
	local function unq(v) return (tostring(v):gsub('^"', ""):gsub('"$', "")) end
	if e.kind == "sfx" then
		for _, p in ipairs(e.props or {}) do
			if p[1] == "SoundId" then return "s", unq(p[2]) end
		end
		return "s", ""
	elseif e.kind == "vfx" then
		local tex = ""
		for _, p in ipairs(e.props or {}) do
			if p[1] == "Texture" then
				tex = unq(p[2])
				break
			end
		end
		return "v", tostring(e.class) .. "|" .. tostring(e.name) .. "|" .. tex
	end
	return nil
end

function X.fxBlocked(e)
	local t, k = X.fxKey(e)
	if t == "s" then return X.blockS[k] == true end
	if t == "v" then return X.blockV[k] == true end
	return false
end

function K.fxFilter(list, mode)
	if not list or not mode then return nil end
	local out = {}
	for _, e in ipairs(list) do
		local k = X.evSection(e)
		local both = mode == "fx" or mode == "cut" or mode == "all"
		if not X.fxBlocked(e) -- blocked VFX / SFX never appear in a generated script
			and ((k == "vfx" and (both or mode == "vfx")) or (k == "sfx" and (both or mode == "sfx"))
				or (k == "cam" and (mode == "cut" or mode == "all")) or (k == "obj" and (mode == "all" or (e.kind == "gui" and mode == "cut")))) then
			out[#out + 1] = e
		end
	end
	return out
end

function K.buildAnimCode(id, withFX)
	local mode = withFX
	if mode == true then mode = "fx" end
	local d = details[id]
	if not d then error("not captured yet") end
	local c = K.simplified(id)
	local note = string.format("Frames: %d kept of %d sampled (quality: %s)", c.kept, c.total, QUALITY)
		.. (X.keyNote and X.keyNote(id) or "")
	return K.genDetailedCode(id, d.rig, d.length, d.looped, c.joints, mode and K.fxFilter(fxWindows.liveFor(id), mode) or nil, note)
end

