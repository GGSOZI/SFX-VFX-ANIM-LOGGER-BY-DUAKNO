X.PAGE = 60

X.keyNote = function(id)
	local list = X.markers[id]
	if not list or #list == 0 then return "" end
	local parts, seen = {}, {}
	for _, k in ipairs(list) do
		local key = k[1] .. string.format("%.2f", k[2])
		if not seen[key] and #parts < 12 then
			seen[key] = true
			parts[#parts + 1] = string.format("%s@%.2fs", tostring(k[1]), k[2])
		end
	end
	return " | Keyframes: " .. table.concat(parts, ", ")
end

X.FXOK = {
	ParticleEmitter = true, Fire = true, Smoke = true, Sparkles = true,
	PointLight = true, SpotLight = true, SurfaceLight = true, Highlight = true,
}

-- Guess the effects that belong to an animation that was never seen playing:
-- everything in the same Tool / Model / folder as its Animation object, plus effects and
-- sounds in ReplicatedStorage whose name (or parent folder name) matches the animation name.
function X.relatedFX(e)
	local out, seen = {}, {}
	local function strip(s) return (tostring(s):lower():gsub("[^%w]", "")) end
	local ownName = strip(e.name)
	local sib = {} -- the other moves next to this animation: their effects are variants / other moves, not this one
	if not X.variants and e.inst and e.inst.Parent then
		for _, a in ipairs(e.inst.Parent:GetChildren()) do
			if a:IsA("Animation") and a ~= e.inst then
				local n = strip(a.Name)
				if n ~= "" and n ~= ownName then sib[#sib + 1] = n end
			end
		end
	end
	local function hayOf(d)
		local hay, p = strip(d.Name), d.Parent
		for _ = 1, 3 do
			if p and p ~= game then
				hay = hay .. " " .. strip(p.Name)
				p = p.Parent
			end
		end
		return hay
	end
	local function isVariant(d)
		if X.variants then return false end
		local hay = hayOf(d)
		for _, n in ipairs(sib) do
			if hay:find(n, 1, true) then return true end
		end
		if ownName ~= "" then
			local a, b = hay:find(ownName, 1, true)
			if a and hay:sub(b + 1, b + 1):match("%d") then return true end -- "Slash" vs "Slash2"
		end
		return false
	end
	local function consider(d)
		if #out >= 60 or seen[d] then return end
		seen[d] = true
		if isVariant(d) then return end
		local cls = d.ClassName
		if cls == "Sound" then
			if d.SoundId == "" then return end
			local ok, ev = pcall(K.buildSFXEvent, d, nil, 0)
			if ok and ev then
				ev.pos = true
				out[#out + 1] = ev
			end
		elseif X.FXOK[cls] then
			local ok, ev = pcall(K.buildVFXEvent, d, nil, tonumber(d:GetAttribute("EmitDelay")) or 0)
			if ok and ev then
				ev.mount = { cf = CFrame.new() } -- at your character
				out[#out + 1] = ev
			end
		end
	end

	local roots = {}
	local inst = e.inst
	if inst then
		local c = inst:FindFirstAncestorWhichIsA("Tool") or inst:FindFirstAncestorOfClass("Model")
		if c then roots[#roots + 1] = c end
		local p = inst.Parent
		if p and p.Parent and p.Parent ~= game and p ~= c then roots[#roots + 1] = p end
	end
	for _, r in ipairs(roots) do
		local n = 0
		for _, d in ipairs(r:GetDescendants()) do
			n += 1
			if n > 3000 then break end
			consider(d)
		end
	end

	local full = tostring(e.name or ""):lower():gsub("[^%w]", "")
	local tokens = {}
	if #full >= 3 then tokens[1] = full end
	if X.variants then -- single words only when variants are allowed (they also catch Slash2 / SlashAlt)
		for w in tostring(e.name or ""):gmatch("%u?%l+") do
			if #w >= 5 then tokens[#tokens + 1] = w:lower() end
		end
	end
	if #tokens > 0 then
		local rs = game:GetService("ReplicatedStorage")
		local n = 0
		for _, d in ipairs(rs:GetDescendants()) do
			n += 1
			if n > 40000 then break end
			if d.ClassName == "Sound" or X.FXOK[d.ClassName] then
				local hay, p = d.Name:lower(), d.Parent
				for _ = 1, 3 do
					if p and p ~= rs then
						hay = hay .. " " .. p.Name:lower()
						p = p.Parent
					end
				end
				for _, t in ipairs(tokens) do
					if hay:find(t, 1, true) then
						consider(d)
						break
					end
				end
			end
		end
	end
	pcall(X.relatedExtra, e, out)
	return out
end

-- models and 2D things (ScreenGuis / images) in storage whose name matches the animation
function X.relatedExtra(e, out)
	local full = (tostring(e.name or ""):lower():gsub("[^%w]", ""))
	if #full < 3 then return end
	local roots = { game:GetService("ReplicatedStorage"), game:GetService("StarterGui"), lp:FindFirstChild("PlayerGui"), game:GetService("ReplicatedFirst") }
	local taken = {}
	local function under(d)
		local p = d.Parent
		for _ = 1, 8 do
			if not p then return false end
			if taken[p] then return true end
			p = p.Parent
		end
		return false
	end
	local n = 0
	for _, r in ipairs(roots) do
		for _, d in ipairs(r:GetDescendants()) do
			n += 1
			if n > 60000 or #out >= 60 then return end
			local cls = d.ClassName
			if (cls == "Model" or cls == "ScreenGui" or cls == "Frame" or cls == "ImageLabel" or cls == "CanvasGroup")
				and not under(d) and not d:IsDescendantOf(gui) and not d:GetAttribute("_Replay") then
				local hay = (d.Name:lower():gsub("[^%w]", ""))
				local p = d.Parent
				for _ = 1, 2 do
					if p and p ~= game and p ~= r then
						hay = hay .. " " .. (p.Name:lower():gsub("[^%w]", ""))
						p = p.Parent
					end
				end
				if hay:find(full, 1, true) then
					local ev
					if cls == "Model" then
						local ok, r2 = pcall(K.buildObjEvent, d, nil, 0)
						if ok and r2 then
							ev = r2
							ev.mount, ev.path, ev.rel = nil, nil, CFrame.new(0, 0, -5) -- put it in front of you
						end
					else
						local ok, r2 = pcall(X.snapshotGui, d, true)
						if ok and r2 then ev = r2 end
					end
					if ev then
						taken[d] = true
						out[#out + 1] = ev
					end
				end
			end
		end
	end
end

function X.prepareFX(e)
	if fxWindows.related[e.id] then return end
	local ok, list = pcall(X.relatedFX, e)
	fxWindows.related[e.id] = (ok and list) or {}
end

-- play an animation on your own character while recording the FX the game triggers.
-- Yields until the recording is finished. Returns ok, number of FX events recorded.
function X.captureRun(id)
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if not animator then return false end
	local anim = Instance.new("Animation")
	anim.AnimationId = id
	local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
	if not ok or not track then return false end
	ownTracks[track] = true
	local waited = 0
	while track.Length == 0 and waited < 4 do waited += RunService.Heartbeat:Wait() end
	if track.Length == 0 then return false end
	openFXWindow(id, animator, track)
	track:Play()
	task.wait(track.Length + FX_POST + 0.6)
	pcall(function() track:Stop(0.1) end)
	local list = animFX[id]
	return true, list and #list or 0
end

function X.capture(id, btn, done)
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not (hum and hum:FindFirstChildOfClass("Animator")) then error("no animator on your character") end
	local label = btn.Text
	btn.Text = "Recording..."
	task.spawn(function()
		local ok = X.captureRun(id)
		if btn.Parent then btn.Text = ok and "Done" or "Fail" end
		task.delay(1.5, function() if btn.Parent then btn.Text = label end end)
		if done then pcall(done) end
	end)
end

-- Auto Capture: records every animation in the current Search list, one after another
function X.autoCapture()
	if X.auto then
		X.auto.stop = true
		X.sAuto.Text = "Stopping..."
		return
	end
	if not X.matches or #X.matches == 0 then
		X.sInfo.Text = "Scan the game and search first - Auto Capture records the animations in the list."
		return
	end
	local list = {}
	for _, e in ipairs(X.matches) do
		if not animFX[e.id] and #list < 300 then list[#list + 1] = e end
	end
	if #list == 0 then
		X.sInfo.Text = "Every animation in this list already has a recording."
		return
	end
	X.confirm(
		"Start Auto Capture?",
		string.format("This plays %d animations on your character one after another (about %d seconds) and records the VFX / SFX the game triggers. Narrow the list with the search box first if you only want some.", #list, #list * 4),
		function() X.autoRun(list) end,
		"Start"
	)
end

function X.autoRun(list)
	local A = { stop = false, played = 0, withFX = 0 }
	X.auto = A
	X.sAuto.Text = "Stop"
	task.spawn(function()
		for i, e in ipairs(list) do
			if A.stop or not Run.alive then break end
			X.sInfo.Text = string.format("Auto capture %d/%d: %s", i, #list, e.name)
			local ok, n = X.captureRun(e.id)
			if ok then
				A.played += 1
				if n and n > 0 then A.withFX += 1 end
			end
		end
		X.auto = nil
		if X.sAuto.Parent then X.sAuto.Text = "Auto Capture" end
		if Run.alive then
			X.sInfo.Text = string.format("Auto capture %s: %d played, %d recorded FX.", A.stop and "stopped" or "finished", A.played, A.withFX)
		end
	end)
end

function X.searchActions(e)
	local id = e.id
	local function frameBtn(text, withFX, w)
		return act(text, function(btn)
			local function finish()
				if withFX then X.prepareFX(e) end
				local okC, code = pcall(K.buildAnimCode, id, withFX)
				if okC then
					toClip(code, "the frame-by-frame script")
					btn.Text = "Copied!"
				else
					out("Failed: " .. tostring(code))
					btn.Text = "Fail"
				end
				task.delay(1.5, function() if btn.Parent then btn.Text = text end end)
			end
			if details[id] then return finish() end
			btn.Text = "Working..."
			requestDetail(id, function(ok, res)
				if not btn.Parent then return end
				if ok then
					finish()
				else
					out("Frame-by-frame failed: " .. tostring(res))
					btn.Text = "Fail"
					task.delay(1.5, function() if btn.Parent then btn.Text = text end end)
				end
			end, function(t) if btn.Parent then btn.Text = t:sub(1, 16) end end)
		end, C.sel, 1, w)
	end
	return {
		frameBtn("Copy", false, 1),
		frameBtn("Full-FX-CUTSCENE", "cut", 2.2),
		act("Preview", function() X.pvOpen(id, e) end, C.green, 1, 1),
		act("VIEW FULL CODE", function()
			X.prepareFX(e)
			openAnimViewer(id)
		end, C.sel, 1, 2.2),
		act("Capture", function(btn) X.capture(id, btn) end, nil, 2),
		act("FX Editor", function() X.prepareFX(e) X.edOpen(id) end, C.sel, 2),
		act("Save all", function(btn) X.saveAllBtn(id, btn) end, C.green, 2),
		{ line = 2, color = C.sel, state = function() return X.convLabel(id), false end, fn = function(btn) X.convCopy(id, btn) end },
		runAct(function() K.playAnim(id) end, 2, 1),
		copyAct("Code", function() return K.simpleCode(id) end, "the AnimationId script", 2),
		copyAct("ID", function() return id end, "the AnimationId", 2),
		{ line = 2, color = C.btn, state = function() local r = X.sv.map[id] return r and "Saved" or "Save", r ~= nil end,
			fn = function()
				X.svToggle(id, e.name)
				refreshAll()
			end },
		{ line = 2, color = C.btn, state = function() local r = X.sv.map[id] return (r and r.fav) and "Unfav" or "Fav", r ~= nil and r.fav == true end,
			fn = function()
				X.svFav(id, e.name)
				refreshAll()
			end },
	}
end

