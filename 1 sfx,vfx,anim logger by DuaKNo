		local bt, bk = X.fxKey(e)
		local isB = X.fxBlocked(e)
		X.mkTool(bar, isB and "Unblock" or "Block", 72, isB and C.danger or C.btn, function()
			X.blockToggle(bt, bk, tostring(e.name))
		end)
	end
	X.mkTool(bar, "To lib", 60, C.green, function(b)
		X.libSave({ e }, nil, b)
	end)
	X.mkTool(bar, "Duplicate", 76, C.btn, ch(function()
		local c = X.deepCopy(e) -- a real copy: editing one never changes the other
		c.t = e.t + 0.1
		table.insert(E.events, c)
		E.sel = c
	end))
	X.mkTool(bar, "Delete", 60, C.danger, ch(function()
		local i = table.find(E.events, e)
		if i then table.remove(E.events, i) end
		E.sel = nil
	end))
end

function X.edList() -- readable event list
	local E = X.ed
	if not E or not E.list.Parent then return end
	local keep = E.list.CanvasPosition
	for _, c in ipairs(E.list:GetChildren()) do
		if c:IsA("GuiObject") then c:Destroy() end
	end

	local off, cnt = 0, { vfx = 0, sfx = 0, obj = 0, cam = 0 }
	for _, e in ipairs(E.events) do
		if e.off then off += 1 end
		local k = X.evSection(e)
		cnt[k] += 1
	end

	local vis = X.edVisible()
	for i, e in ipairs(vis) do
		if i > 600 then break end
		local isSfx = e.kind == "sfx"
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, -6, 0, X.ROWH)
		row.BackgroundColor3 = (e == E.sel) and C.sel or (i % 2 == 1 and C.row1 or C.row2)
		row.BorderSizePixel = 0
		row.LayoutOrder = i
		row.Parent = E.list

		local stripe = Instance.new("Frame")
		stripe.Size = UDim2.new(0, 4, 1, 0)
		stripe.BackgroundColor3 = X.kc(X.evSection(e))
		stripe.BorderSizePixel = 0
		stripe:SetAttribute("NoCorner", true)
		stripe.Parent = row

		local tog = K.newButton(row, e.off and "OFF" or "ON", e.off and C.danger or C.green)
		tog.Position = UDim2.new(0, 10, 0.5, -14)
		tog.Size = UDim2.new(0, 46, 0, 28)
		tog.TextSize = 14
		tog.MouseButton1Click:Connect(function()
			X.edChange(function() e.off = (not e.off) or nil end)
		end)

		local title, detail = X.evLines(e)
		local lbl = Instance.new("TextButton")
		lbl.AutoButtonColor = false
		lbl.BackgroundTransparency = 1
		lbl.Position = UDim2.new(0, 62, 0, 0)
		lbl.Size = UDim2.new(1, -140, 1, 0)
		lbl.RichText = true
		lbl.Font = Th.font
		lbl.TextSize = 14
		lbl.TextColor3 = e.off and C.sub or C.text
		lbl.TextXAlignment = Enum.TextXAlignment.Left
		lbl.TextTruncate = Enum.TextTruncate.AtEnd
		lbl.Text = string.format('<b>%s</b>\n<font color="%s">%s</font>', K.esc(title), K.hex(C.sub), K.esc(detail))
		lbl.Parent = row
		lbl.MouseButton1Click:Connect(function() X.edSelect(e) end)

		local tm = K.newButton(row, string.format("%.2fs", e.t), C.btn)
		tm.Position = UDim2.new(1, -72, 0.5, -14)
		tm.Size = UDim2.new(0, 66, 0, 28)
		tm.TextSize = 14
		tm.MouseButton1Click:Connect(function() X.edSelect(e) end)
	end
	E.list.CanvasPosition = keep

	if #E.events == 0 then
		E.info.Text = "Nothing recorded for this animation yet. Play it in-game, press Capture, or use the Search tab."
	else
		E.info.Text = string.format(
			'%d events (%d off)  |  <font color="%s">%d VFX</font>  <font color="%s">%d SFX</font>  <font color="%s">%d OBJ</font>  <font color="%s">%d CAM</font>  |  %s%s',
			#E.events, off, K.hex(C.vfx), cnt.vfx, K.hex(C.sfx), cnt.sfx, K.hex(X.kc("obj")), cnt.obj, K.hex(X.kc("cam")), cnt.cam,
			E.dirty and "edited - Copy / Preview / Run use your edits" or "live recording",
			#vis > 600 and "  |  showing first 600 (search to narrow)" or ""
		)
	end
end

function X.edBulk() -- turn off / on / delete many events at once: by name, by time, by type
	local E = X.ed
	if not E then return end
	if E.bulk then pcall(function() E.bulk.destroy() end) end
	local win = createWindow({
		title = "Bulk edit - " .. K.animName(E.id),
		size = Vector2.new(440, 230),
		pos = UDim2.new(0.5, -220, 0.5, -115),
		minSize = Vector2.new(300, 200),
		miniText = "BK",
	})
	E.bulk = win
	local c = win.content
	local kinds = { "all", "vfx", "sfx", "obj", "cam" }
	local kindI = 1
	local bar1 = X.mkBar(c, 6, 34)
	X.mkLabel(bar1, "Name contains", 100)
	local nameBox = X.mkBox(bar1, 220, "", "slash, hit  (commas = several names)")
	local bar2 = X.mkBar(c, 46, 34)
	X.mkLabel(bar2, "Time from", 70)
	local fromBox = X.mkBox(bar2, 56, "", "0")
	X.mkLabel(bar2, "to", 22)
	local toBox = X.mkBox(bar2, 56, "", "end")
	local info = Instance.new("TextLabel")
	info.Position = UDim2.new(0, 10, 0, 126)
	info.Size = UDim2.new(1, -20, 0, 24)
	info.BackgroundTransparency = 1
	info.TextColor3 = C.sub
	info.Font = Th.font
	info.TextSize = 15
	info.TextXAlignment = Enum.TextXAlignment.Left
	info.Parent = c

	local function matches(e)
		local k = kinds[kindI]
		if k ~= "all" and X.evSection(e) ~= k then return false end
		local q = nameBox.Text:lower()
		if q:match("%S") then
			local hay = (tostring(e.name) .. " " .. tostring(e.class or "")):lower()
			local hit = false
			for part in q:gmatch("[^,]+") do
				part = part:match("^%s*(.-)%s*$")
				if part ~= "" and hay:find(part, 1, true) then
					hit = true
					break
				end
			end
			if not hit then return false end
		end
		local a, b = tonumber(fromBox.Text), tonumber(toBox.Text)
		if a and e.t < a - 1e-6 then return false end
		if b and e.t > b + 1e-6 then return false end
		return true
	end
	local function refresh()
		if not info.Parent then return end
		local n = 0
		for _, e in ipairs(E.events) do
			if matches(e) then n += 1 end
		end
		info.Text = string.format("%d of %d events match", n, #E.events)
	end
	for _, box in ipairs({ nameBox, fromBox, toBox }) do
		box:GetPropertyChangedSignal("Text"):Connect(refresh)
	end
	X.mkTool(bar2, "Type: All", 90, C.btn, function(b)
		kindI = kindI % #kinds + 1
		b.Text = "Type: " .. kinds[kindI]:upper():gsub("^ALL$", "All")
		refresh()
	end)

	local bar3 = X.mkBar(c, 86, 34)
	X.mkTool(bar3, "Turn OFF", 84, C.danger, function()
		X.edChange(function()
			for _, e in ipairs(E.events) do
				if matches(e) then e.off = true end
			end
		end)
		refresh()
	end)
	X.mkTool(bar3, "Turn ON", 76, C.green, function()
		X.edChange(function()
			for _, e in ipairs(E.events) do
				if matches(e) then e.off = nil end
			end
		end)
		refresh()
	end)
	X.mkTool(bar3, "Delete", 70, C.danger, function()
		X.edChange(function()
			local keep = {}
			for _, e in ipairs(E.events) do
				if matches(e) then
					if E.sel == e then E.sel = nil end
				else
					keep[#keep + 1] = e
				end
			end
			E.events = keep
		end)
		refresh()
	end)
	X.mkTool(bar3, "Close", 60, C.btn, function() win.destroy() end)
	refresh()
end

function X.edAdd() -- put your own sound / particles / light / object on the FX timeline
	local E = X.ed
	if not E then return end
	if E.addWin then pcall(function() E.addWin.destroy() end) end
	local win = createWindow({
		title = "Add FX / OBJ - " .. K.animName(E.id),
		size = Vector2.new(470, 290),
		pos = UDim2.new(0.5, -235, 0.5, -145),
		minSize = Vector2.new(320, 250),
		miniText = "+",
	})
	E.addWin = win
	local c = win.content
	local TYPES = {
		{ "SFX: sound", "sfx", "Sound id", "Volume", "1" },
		{ "VFX: particle burst", "particle", "Texture id", "Emit", "20" },
		{ "VFX: light flash", "light", "(none)", "Brightness", "3" },
		{ "OBJ: block", "block", "(none)", "Transp.", "0" },
		{ "OBJ: ball", "ball", "(none)", "Transp.", "0" },
		{ "OBJ: cylinder", "cylinder", "(none)", "Transp.", "0" },
		{ "OBJ: wedge", "wedge", "(none)", "Transp.", "0" },
	}
	local ti = 1
	local bar0 = X.mkBar(c, 6, 34)
	local typeBtn
	local bar1 = X.mkBar(c, 46, 34)
	X.mkLabel(bar1, "Start", 40)
	local startBox = X.mkBox(bar1, 60, "0")
	X.mkLabel(bar1, "Length", 50)
	local lenBox = X.mkBox(bar1, 60, "2")
	local bar2 = X.mkBar(c, 86, 34)
	local idLbl = X.mkLabel(bar2, "Sound id", 76)
	local idBox = X.mkBox(bar2, 250, "", "number or rbxassetid://...")
	local bar3 = X.mkBar(c, 126, 34)
	X.mkLabel(bar3, "Color", 44)
	local colBox = X.mkBox(bar3, 110, "255,255,255")
	local amtLbl = X.mkLabel(bar3, "Volume", 76)
	local amtBox = X.mkBox(bar3, 60, "1")
	local bar4 = X.mkBar(c, 166, 34)
	X.mkLabel(bar4, "Size", 36)
	local sizeBox = X.mkBox(bar4, 110, "2,2,2")
	X.mkLabel(bar4, "Offset", 50)
	local offBox = X.mkBox(bar4, 110, "0,0,-5")
	local hint = Instance.new("TextLabel")
	hint.Position = UDim2.new(0, 10, 0, 244)
	hint.Size = UDim2.new(1, -20, 0, 36)
	hint.BackgroundTransparency = 1
	hint.TextColor3 = C.sub
	hint.Font = Th.font
	hint.TextSize = 13
	hint.TextWrapped = true
	hint.TextXAlignment = Enum.TextXAlignment.Left
	hint.TextYAlignment = Enum.TextYAlignment.Top
	hint.Text = "Offset = x,y,z from your character (z -5 = in front). Size: objects use x,y,z; particles use the first number; lights use it as range."
	hint.Parent = c

	local function setType(i)
		ti = i
		local t = TYPES[i]
		typeBtn.Text = t[1]
		idLbl.Text = t[3]
		amtLbl.Text = t[4]
		amtBox.Text = t[5]
		if t[2] == "light" then sizeBox.Text = "16,16,16" elseif t[2] == "particle" then sizeBox.Text = "1.5,1.5,1.5" else sizeBox.Text = "2,2,2" end
		if t[2] == "sfx" then lenBox.Text = "3" elseif t[2] == "light" then lenBox.Text = "0.5" elseif t[2] == "particle" then lenBox.Text = "1.5" else lenBox.Text = "2.5" end
	end
	typeBtn = X.mkTool(bar0, TYPES[1][1], 190, C.sel, function() setType(ti % #TYPES + 1) end)
	setType(1)

	local function num(box, d) return tonumber(box.Text) or d end
	local function v3(box, a, b, cc)
		local x, y, z = tostring(box.Text):match("^%s*(%-?[%d%.]+)%s*,%s*(%-?[%d%.]+)%s*,%s*(%-?[%d%.]+)%s*$")
		if x then return tonumber(x) or a, tonumber(y) or b, tonumber(z) or cc end
		local one = tonumber(box.Text)
		if one then return one, one, one end
		return a, b, cc
	end
	local function color()
		local r, g, b = v3(colBox, 255, 255, 255)
		return Color3.fromRGB(math.clamp(r, 0, 255), math.clamp(g, 0, 255), math.clamp(b, 0, 255))
	end
	local function asset(txt)
		local d = tostring(txt):match("%d+")
		return d and ("rbxassetid://" .. d) or ""
	end

	local bar5 = X.mkBar(c, 206, 34)
	X.mkTool(bar5, "Add to timeline", 130, C.green, function()
		local kind = TYPES[ti][2]
		local T = math.max(num(startBox, 0), 0)
		local L = math.max(num(lenBox, 2), 0.1)
		local ox, oy, oz = v3(offBox, 0, 0, -5)
		local ev
		if kind == "sfx" then
			local id = asset(idBox.Text)
			if id == "" then return out("Add: type a sound id first.") end
			ev = { kind = "sfx", name = "Custom sound", t = T, dur = L, custom = true, props = {
				{ "SoundId", string.format("%q", id) }, { "Volume", K.g(num(amtBox, 1)) },
				{ "PlaybackSpeed", "1" }, { "Looped", "false" },
			} }
		elseif kind == "particle" then
			local tex = asset(idBox.Text)
			if tex == "" then tex = "rbxasset://textures/particles/sparkles_main.dds" end
			local sz = v3(sizeBox, 1.5, 1.5, 1.5)
			ev = { kind = "vfx", class = "ParticleEmitter", name = "Custom particles", t = T, dur = L, enabled = false, custom = true,
				emit = math.floor(num(amtBox, 20)), mount = { cf = CFrame.new(ox, oy, oz) }, props = {
					{ "Texture", string.format("%q", tex) }, { "Color", K.lit(ColorSequence.new(color())) },
					{ "Size", K.lit(NumberSequence.new(sz)) }, { "Lifetime", K.lit(NumberRange.new(0.5, 1)) },
					{ "Speed", K.lit(NumberRange.new(4, 9)) }, { "SpreadAngle", K.lit(Vector2.new(360, 360)) },
					{ "LightEmission", "1" }, { "Rate", "0" },
				} }
		elseif kind == "light" then
			local rng = v3(sizeBox, 16, 16, 16)
			ev = { kind = "vfx", class = "PointLight", name = "Custom light", t = T, dur = L, enabled = true, custom = true,
				mount = { cf = CFrame.new(ox, oy, oz) }, props = {
					{ "Brightness", K.g(num(amtBox, 3)) }, { "Color", K.lit(color()) }, { "Range", K.g(rng) },
				} }
		else
			local sx, sy, sz = v3(sizeBox, 2, 2, 2)
			local props = {
				{ "Size", K.lit(Vector3.new(sx, sy, sz)) }, { "Color", K.lit(color()) },
				{ "Material", "Enum.Material.Neon" }, { "Transparency", K.g(math.clamp(num(amtBox, 0), 0, 1)) },
			}
			local cls = "Part"
			if kind == "ball" then
				props[#props + 1] = { "Shape", "Enum.PartType.Ball" }
			elseif kind == "cylinder" then
				props[#props + 1] = { "Shape", "Enum.PartType.Cylinder" }
			elseif kind == "wedge" then
				cls = "WedgePart"
			end
			ev = { kind = "obj", class = cls, name = "Custom " .. kind, t = T, dur = L, props = {}, custom = true,
				rel = CFrame.new(ox, oy, oz),
				spec = { parts = { { cls = cls, name = kind, rel = CFrame.new(), props = props, kids = {} } } } }
		end
		X.edChange(function()
			table.insert(E.events, ev)
			E.sel = ev
		end)
		out(string.format("Added \"%s\" at %.2fs. Edit or move it on the timeline.", ev.name, T))
	end)
	X.mkTool(bar5, "Close", 60, C.btn, function() win.destroy() end)
end

