function X.addRow(e)
	local id = e.id
	animLabel[id] = animLabel[id] or e.name
	animInfo[id] = animInfo[id] or { priority = "Action", looped = false, speed = 1 }
	local detail = id .. "\n" .. e.path
	if #e.alt > 0 then detail = detail .. "\nAlso named: " .. table.concat(e.alt, ", ") end
	local ent = addEntry("Search", id, e.name, detail, id, X.searchActions(e), C.anim)
	if ent then
		entriesById[id] = entriesById[id] or {}
		table.insert(entriesById[id], ent)
		refreshExtra(id)
	end
end

function X.fxEventOf(e) -- an event for a Search result, placed in front of you
	local inst = e.inst
	if not inst and not e.ev then return nil end
	local okB, ev
	if e.ev then -- an effect the logger saw this session: its recorded event
		okB, ev = true, table.clone(e.ev)
	elseif e.kind == "VFX" then
		okB, ev = pcall(K.buildVFXEvent, inst, nil, 0)
	else
		okB, ev = pcall(K.buildSFXEvent, inst, nil, 0)
	end
	if okB and ev and e.kind == "VFX" then
		if ev.class == "Beam" or ev.class == "Trail" then
			ev.att0 = { cf = CFrame.new(-3, 1, -4) }
			ev.att1 = { cf = CFrame.new(3, 1, -4) }
			ev.mount = ev.att0
		else
			ev.mount = { cf = CFrame.new(0, 1, -4) }
		end
		ev.dur = ev.dur or 2
	end
	if not (okB and ev) then return nil end
	ev.t = 0
	return ev
end

function X.addFxRow(e)
	local isV = e.kind == "VFX"
	local title = isV and (e.class .. ": " .. e.name) or e.name
	local detail = e.path .. "\n" .. ((e.id ~= "" and e.id) or "(no id)") .. ((e.count or 1) > 1 and ("\nFound " .. e.count .. " times in the game") or "")
	local function ev()
		local x = X.fxEventOf(e)
		if not x then error("could not read this effect (it may have been removed from the game)") end
		return x
	end
	local function script() return K.genStandaloneFX({ ev() }, title) end
	local actions = {
		act("Copy", function(btn)
			toClip(script(), "the script")
			K.flash(btn, "Copied!")
		end, C.sel, 1, 1),
		runAct(function() K.runEvents({ ev() }, title) end, 1, 0.9),
		act("VIEW FULL CODE", function()
			openViewer(title, { { name = "Script", get = function(cb) cb(script()) end } }, 1)
		end, C.sel, 1, 2.2),
		copyAct("ID", function() return e.id ~= "" and e.id or e.name end, "the id", 2),
		act("To FX editor", function(btn)
			local E = X.ed
			if not E then return K.flash(btn, "Open FX editor") end
			local x = ev()
			X.edChange(function()
				table.insert(E.events, x)
				E.sel = x
			end)
			K.flash(btn, "Added")
		end, C.green, 2),
		act("To library", function(btn)
			local okE, x = pcall(ev)
			if not okE then return K.flash(btn, "Fail") end
			X.libSave({ x }, title, btn)
		end, C.green, 2),
	}
	addEntry("Search", "fx|" .. e.key, title, detail, e.id, actions, isV and C.vfx or C.sfx)
end

function X.more()
	local list = lists.Search
	local old = list:FindFirstChild("MoreBtn")
	if old then old:Destroy() end
	local to = math.min(X.shown + X.PAGE, #X.matches)
	local adder = X.sKind == "Anim" and X.addRow or X.addFxRow
	for i = X.shown + 1, to do adder(X.matches[i]) end
	X.shown = to
	local total = X.sKind == "VFX" and #(X.dbV or {}) or (X.sKind == "SFX" and #(X.dbS or {}) or #X.db)
	X.sInfo.Text = string.format("%d of %d %s match%s - showing %d", #X.matches, total, X.sKind == "Anim" and "animations" or (X.sKind .. " effects"),
		(X.sKind == "Anim" and X.cat ~= "All") and (" (" .. X.cat .. ")") or "", X.shown)
	if X.shown < #X.matches then
		local b = K.newButton(list, string.format("Show more (%d left)", #X.matches - X.shown), C.btn)
		b.Name = "MoreBtn"
		b.Size = UDim2.new(1, -6, 0, 34)
		b.LayoutOrder = 1000000
		b.MouseButton1Click:Connect(X.more)
	end
end

function X.render()
	if not X.db then
		X.sInfo.Text = "Press Scan game to list every animation in this game."
		return
	end
	local tokens = {}
	for w in X.sBox.Text:lower():gmatch("%S+") do tokens[#tokens + 1] = w end
	local matches = {}
	local src = X.sKind == "VFX" and (X.dbV or {}) or (X.sKind == "SFX" and (X.dbS or {}) or X.db)
	for _, e in ipairs(src) do
		local ok = true
		for _, t in ipairs(tokens) do
			if not e.hay:find(t, 1, true) then
				ok = false
				break
			end
		end
		if ok and X.sKind == "Anim" and X.cat ~= "All" then
			e.cat = e.cat or K.animCat(e)
			ok = e.cat == X.cat
		end
		if ok then matches[#matches + 1] = e end
	end
	if X.az then table.sort(matches, function(a, b) return tostring(a.name):lower() < tostring(b.name):lower() end) end
	X.matches, X.shown = matches, 0
	clearKind("Search")
	X.more()
end

function X.scan()
	if X.scanning then return end
	X.scanning = true
	X.sScan.Text = "Scanning..."
	X.sInfo.Text = "Scanning the whole game for animations..."
	local db, byId, count = {}, {}, 0
	local dbV, dbS, byV, byS = {}, {}, {}, {}
	local prefV, prefS, seenI = {}, {}, {} -- class|name|texture and sound ids already listed / instances already visited
	local CAP = 200000
	local FXC = { ParticleEmitter = true, Beam = true, Trail = true, Fire = true, Smoke = true, Sparkles = true,
		PointLight = true, SpotLight = true, SurfaceLight = true, Highlight = true, Explosion = true }
	local function addFx(d)
		local tex = ""
		pcall(function() tex = tostring(d.Texture) end) -- emitters / beams / trails have one, the rest error
		-- same name + texture but different settings (Rate, size, color...) are different effects: list each one
		local sig = ""
		local plist = VFX_PROPS[d.ClassName]
		if plist then
			for i = 1, #plist do -- every setting counts: two effects that differ in anything are two entries
				local okP, v = pcall(function() return d[plist[i]] end)
				if okP then sig = sig .. tostring(v) .. "," end
			end
		end
		pcall(function() sig = sig .. tostring(d:GetAttribute("EmitCount")) end)
		prefV[d.ClassName .. "|" .. d.Name .. "|" .. tex] = true
		local key = d.ClassName .. "|" .. d.Name .. "|" .. tex .. "|" .. sig
		local e = byV[key]
		if e then
			e.count += 1
			return
		end
		if #dbV >= CAP then return end
		e = { key = key, kind = "VFX", class = d.ClassName, name = d.Name, id = tex, path = d:GetFullName(), inst = d, count = 1 }
		byV[key] = e
		dbV[#dbV + 1] = e
	end
	local function addSnd(d)
		local id = d.SoundId
		if id == "" or id:find("^rbxasset://sounds/") or #dbS >= CAP then return end
		prefS[id] = true
		local okK, key = pcall(function() return id .. "|" .. d.Name .. "|" .. tostring(d.Volume) .. "|" .. tostring(d.PlaybackSpeed) .. "|" .. tostring(d.Looped) end)
		if not okK then key = id .. "|" .. d.Name end
		local e = byS[key]
		if e then
			e.count += 1
			return
		end
		e = { key = key, kind = "SFX", class = "Sound", name = d.Name, id = id, path = d:GetFullName(), inst = d, count = 1 }
		byS[key] = e
		dbS[#dbS + 1] = e
	end
	local function addValueSnd(id, name, path) -- a sound id kept in a value object (the Sound itself is only made when the game plays it)
		if prefS[id] or #dbS >= CAP then return end
		prefS[id] = true
		local snd = Instance.new("Sound")
		snd.Name = name
		snd.SoundId = id
		local e = { key = "val|" .. id, kind = "SFX", class = "Sound", name = name, id = id, path = path, inst = snd, count = 1 }
		byS["val|" .. id] = e
		dbS[#dbS + 1] = e
	end
	local function add(id, name, path, inst)
		if type(id) ~= "string" or id == "" or not id:find("%d") or id == "rbxassetid://0" then return end
		local e = byId[id]
		if e then
			if name ~= e.name and #e.alt < 8 and not table.find(e.alt, name) then e.alt[#e.alt + 1] = name end
			if not e.inst and inst then e.inst = inst end
			return
		end
		e = { id = id, name = (name ~= "" and name) or "(unnamed)", path = path or "?", inst = inst, alt = {} }
		byId[id] = e
		db[#db + 1] = e
	end
	local function visit(list)
		for _, d in ipairs(list) do
			count += 1
			if count % 2000 == 0 then task.wait() end
			local cn = d.ClassName
			if cn == "Animation" then
				if not seenI[d] then
					seenI[d] = true
					pcall(function() add(d.AnimationId, d.Name, d:GetFullName(), d) end)
				end
			elseif FXC[cn] then
				if not seenI[d] then
					seenI[d] = true
					pcall(addFx, d)
				end
			elseif cn == "Sound" then
				if not seenI[d] then
					seenI[d] = true
					pcall(addSnd, d)
				end
			elseif cn == "StringValue" or cn == "NumberValue" or cn == "IntValue" then
				pcall(function() -- ids kept as values: StringValue "rbxassetid://..." / NumberValue 123456
					local path = d:GetFullName()
					local low = path:lower()
					local isSnd = low:find("sound", 1, true) or low:find("sfx", 1, true) or low:find("audio", 1, true) or low:find("music", 1, true)
					if not (isSnd or X.isCutText(low)) then return end
					local v = d.Value
					local id
					if type(v) == "number" and v >= 100000 then
						id = "rbxassetid://" .. math.floor(v)
					elseif type(v) == "string" then
						id = v:match("rbxassetid://%d+") or (v:match("^%d%d%d%d%d%d+$") and ("rbxassetid://" .. v)) or nil
					end
					if id then
						if isSnd then addValueSnd(id, d.Name, path) else add(id, d.Name, path, nil) end
					end
				end)
			end
		end
	end
	local ok, err = pcall(function()
		local done = false
		if getinstances then done = pcall(function() visit(getinstances()) end) end
		if not done then visit(game:GetDescendants()) end
		if getnilinstances then -- effects / sounds / animations without a parent (some executors leave them out of getinstances)
			pcall(function()
				for _, n in ipairs(getnilinstances()) do
					if n.ClassName == "Animation" and not seenI[n] then
						seenI[n] = true
						add(n.AnimationId, n.Name, "(nil) " .. n.Name, n)
					end
					visit({ n })
					pcall(function() visit(n:GetDescendants()) end)
				end
			end)
		end
		for id, label in pairs(animLabel) do add(id, label, "(seen playing in this session)", nil) end
		-- everything the logger saw play this session, even when the game made it from code and no instance is left to scan
		for key, spec in pairs(vfxSpec) do
			if not prefV[key] and #dbV < CAP then
				local cls, nm, tx = tostring(key):match("^([^|]*)|([^|]*)|(.*)$")
				dbV[#dbV + 1] = { key = "log|" .. key, kind = "VFX", class = cls or "?", name = nm or tostring(key), id = tx or "",
					path = "(seen playing in this session)", ev = spec, count = 1 }
			end
		end
		for sid, spec in pairs(sfxSpec) do
			if not prefS[sid] and #dbS < CAP then
				dbS[#dbS + 1] = { key = "log|" .. sid, kind = "SFX", class = "Sound", name = sfxLabel[sid] or "Sound", id = sid,
					path = "(seen playing in this session)", ev = spec, count = 1 }
			end
		end
		for _, e in ipairs(db) do
			e.hay = (e.name .. " " .. e.path .. " " .. e.id .. " " .. table.concat(e.alt, " ")):lower()
		end
		table.sort(db, function(a, b) return a.name:lower() < b.name:lower() end)
		for _, list in ipairs({ dbV, dbS }) do
			for _, e in ipairs(list) do e.hay = (e.name .. " " .. e.class .. " " .. e.id .. " " .. e.path):lower() end
			table.sort(list, function(a, b) return a.name:lower() < b.name:lower() end)
		end
	end)
	X.scanning = false
	if X.sScan.Parent then X.sScan.Text = "Rescan" end
	if not ok then
		X.sInfo.Text = "Scan failed: " .. tostring(err)
		return
	end
	X.db, X.dbV, X.dbS = db, dbV, dbS
	X.render()
end

--// Live preview (clone of your character in front of you) ---------------------------------------
X.speeds = { 0.25, 0.5, 1, 1.5, 2 }

function X.pvStatus(text)
	local P = X.pv
	if P and P.status and P.status.Parent then P.status.Text = text end
end

function X.pvWatch(on, P)
	P = P or X.pv
	local cam = workspace.CurrentCamera
	if not P or not cam then return end
	if on then
		P.oldSubject = cam.CameraSubject
		cam.CameraSubject = P.hum
		P.watching = true
	else
		local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
		cam.CameraSubject = (P.oldSubject and P.oldSubject.Parent) and P.oldSubject or hum
		P.watching = false
	end
end

function X.pvPlace()
	local P, root = X.pv, K.getRoot()
	if not P or not root or not P.rig.Parent then return end
	P.rig:PivotTo(root.CFrame * CFrame.new(0, 0, -7) * CFrame.Angles(0, math.pi, 0))
end

function X.pvClose()
	local P = X.pv
	X.pv = nil
	if not P then return end
	P.gen = (P.gen or 0) + 1
	P.playing, P.paused = false, false
	pcall(X.v3Close)
	pcall(X.tpFxClear)
	pcall(function() if P.track then P.track:Stop(0) end end)
	pcall(function() if P.watching then X.pvWatch(false, P) end end)
	pcall(function() P.rig:Destroy() end)
	pcall(function() P.win.destroy() end)
end

-- run FX events on any model (the preview rig) instead of your own character
function X.runOn(events, title, rig)
	if not loadstring then error("loadstring is not available in this executor") end
	local nocam = {}
	for _, e in ipairs(events) do
		if e.kind ~= "cam" then nocam[#nocam + 1] = e end -- the preview must not take over your camera
	end
	local code = K.genStandaloneFX(nocam, title)
	code = code:gsub("local lp = Players%.LocalPlayer", "local lp = { Character = (getgenv and getgenv() or _G).__AVL_PreviewRig }", 1)
	-- every effect first checks that this run is still the current one: Pause / seek / stop cancel the ones that have not started yet
	code = code:gsub("local ok, err = pcall%(playFX, e%)", function()
		return "if (getgenv and getgenv() or _G).__AVL_Gen ~= __GEN then return end\n\t\t\tlocal ok, err = pcall(playFX, e)"
	end, 1)
	code = "local __GEN = (getgenv and getgenv() or _G).__AVL_Gen\n" .. code
	local fn, err = loadstring(code)
	if not fn then error(err) end
	local env = (getgenv and getgenv()) or _G
	env.__AVL_PreviewRig = rig
	fn()
end

--// Transport: ONE clock for the preview rig ------------------------------------------------------
-- P.t = the point of the animation the preview is at (seconds). The dummy's pose, the effects, the red line of
-- the Preview / FX Editor / Anim Editor windows and the 3D viewer all follow it. Pause holds everything there.
function X.tpBump() -- cancels every effect that was scheduled but has not started yet
	local env = (getgenv and getgenv()) or _G
	env.__AVL_Gen = (env.__AVL_Gen or 0) + 1
end

function X.tpEach(fn) -- every object the preview replay created (and everything inside it)
	local P = X.pv
	local function visit(root)
		if root:GetAttribute("_Replay") then
			fn(root)
			for _, d in ipairs(root:GetDescendants()) do fn(d) end
		end
	end
	for _, c in ipairs(workspace:GetChildren()) do visit(c) end
	for _, c in ipairs(SoundService:GetChildren()) do visit(c) end
	if P and P.rig.Parent then
		for _, d in ipairs(P.rig:GetDescendants()) do visit(d) end
	end
end

function X.tpFxClear()
	X.tpBump()
	local function kill(o)
		if o:GetAttribute("_Replay") then pcall(function() o:Destroy() end) end
	end
	for _, c in ipairs(workspace:GetChildren()) do kill(c) end
	for _, c in ipairs(SoundService:GetChildren()) do kill(c) end
	local P = X.pv
	if P and P.rig.Parent then
		for _, d in ipairs(P.rig:GetDescendants()) do kill(d) end
	end
end

function X.tpFreeze(on) -- freeze / unfreeze the particles and sounds that are on screen
	X.tpEach(function(o)
		if o:IsA("ParticleEmitter") then
			pcall(function() o.TimeScale = on and 0 or 1 end)
		elseif o:IsA("Sound") then
			pcall(function()
				if on then o:Pause() else o:Resume() end
			end)
		end
	end)
end

-- play the effects of animation `id` from time t on `rig`
--   withActive: also start the ones that are already running at t (their remaining time)
--   onlyActive: do not schedule the ones that are still to come (used when the preview is held on a point)
function X.fxFrom(rig, id, t, sp, withActive, onlyActive)
	local list = fxWindows.liveFor(id)
	if not list then return 0 end
	sp = math.max(sp or 1, 0.05)
	local scaled = {}
	for _, e in ipairs(list) do
		local burst = e.emit and not e.enabled
		local et, dur = e.t or 0, e.dur or (burst and 0 or 1)
		local c
		if et >= t - 1e-4 then
			if not onlyActive then
				c = table.clone(e)
				c.t = (et - t) / sp
				if c.dur then c.dur = c.dur / sp end
			end
		elseif burst then
			if withActive and onlyActive and t - et <= 0.3 then -- a burst that just happened: show it
				c = table.clone(e)
				c.t = 0
			end
		elseif withActive and et + dur > t then
			c = table.clone(e)
			c.t = 0
			c.dur = (et + dur - t) / sp
		end
		if c then scaled[#scaled + 1] = c end
	end
	if #scaled == 0 then return 0 end
	local ok, err = pcall(X.runOn, scaled, "Preview", rig)
	if not ok then X.pvStatus("FX failed: " .. tostring(err)) end
	return #scaled
end

function X.tpFxFrom(P, t, withActive, onlyActive)
	if P.fx then X.fxFrom(P.rig, P.id, t, P.speed, withActive, onlyActive) end
end

function X.tpLen(P) -- length of the scrub bar: the animation, or the last effect when that ends later
	local L = X.edLength(P.id) or 0
	if L <= 0 and P.track then
		local okL, tl = pcall(function() return P.track.Length end)
		if okL and tl then L = tl end
	end
	local last = 0
	if P.fx then
		for _, e in ipairs(fxWindows.liveFor(P.id) or {}) do
			last = math.max(last, (e.t or 0) + math.min(e.dur or 0.3, 4))
		end
	end
	return math.max(L, last, 0.1)
end

function X.pvLoad(P) -- loads the real animation on the preview rig (used to pose it when no frames were captured)
	if P.track and P.trackFor == P.id then return true end
	pcall(function() if P.track then P.track:Stop(0) end end)
	P.track, P.trackFor = nil, nil
	local anim = Instance.new("Animation")
	anim.AnimationId = P.id
	local ok, track = pcall(function() return P.animator:LoadAnimation(anim) end)
	if not ok or not track then return false end
	ownTracks[track] = true
	local waited = 0
	while track.Length == 0 and waited < 4 do waited += RunService.Heartbeat:Wait() end
	if track.Length == 0 then return false end
	track.Looped = false
	P.track, P.trackFor = track, P.id
	return true
end

function X.tpPose(P, t) -- put the dummy on the pose the animation has at time t
	if not P.rig.Parent then return end
	local d = details[P.id]
	if d and d.joints and #d.joints > 0 then
		local old = X.aeData[P.id]
		if old and old.d ~= d then X.aeData[P.id] = nil end
		local okA, A = pcall(X.aeInit, P.id)
		if okA and A then
			X.aePose(A, math.min(t, A.len), true)
			return
		end
	end
	local tr = P.track
	if tr and P.trackFor == P.id then
		pcall(function()
			if not tr.IsPlaying then tr:Play(0, 1, 0) end
			tr:AdjustSpeed(0)
			tr.TimePosition = math.clamp(t, 0, math.max(tr.Length - 0.001, 0))
		end)
	elseif not P.loading then
		P.loading = true
		task.spawn(function()
			X.pvLoad(P)
			P.loading = false
			if X.pv == P then X.tpPose(P, P.t or 0) end
		end)
	end
end

function X.tpStatus(P)
	if not (P.status and P.status.Parent) then return end
	local list = fxWindows.liveFor(P.id)
	local fxText = "FX off"
	if P.fx then
		fxText = (list and #list > 0) and (#list .. " FX events") or "no FX recorded yet (play it in-game or press Capture)"
	end
	X.pvStatus(string.format(
		"%s\n%.2fs at %sx | loop %s | %s\nDrag the bar to move the dummy and the effects to that point. Pause holds them there.",
		tostring(P.id), P.len or 0, tostring(P.speed), P.loop and "on" or "off", fxText
	))
end

function X.tpHeads(P, skip) -- move every red line / time label that shows this preview
	local len = math.max(P.len or X.tpLen(P), 0.01)
	local t = P.t or 0
	local fr = math.clamp(t / len, 0, 1)
	local txt = string.format("%.2fs / %.2fs", t, len)
	local scrubs = {}
	if P.scrub then scrubs[#scrubs + 1] = P.scrub end
	if X.v3 and X.v3.scrub and X.v3.id == P.id then scrubs[#scrubs + 1] = X.v3.scrub end
	for _, S in ipairs(scrubs) do
		if S.frame.Parent then
			S.line.Position = UDim2.new(fr, -1, 0, 0)
			S.fill.Size = UDim2.new(fr, 0, 1, 0)
			S.lbl.Text = txt
		end
	end
	local E = X.ed
	if E and E.id == P.id then pcall(X.edMoveHead, E, t) end
	local A = X.ae
	if A and A.id == P.id and skip ~= "ae" and not A.playing then
		A.head = math.clamp(t, 0, A.len)
		pcall(X.aeMoveHead, A, true)
	end
end

function X.tpUI(P) -- Play / Pause / Resume text of every transport button
	local txt = P.playing and "Pause" or (P.paused and "Resume" or "Play")
	local col = P.playing and C.danger or C.green
	local function set(b)
		if b and b.Parent then
			b.Text = txt
			K.paint(b, col)
		end
	end
	set(P.ui and P.ui.pause)
	local E = X.ed
	if E and E.id == P.id and E.ui then set(E.ui.play) end
	local V = X.v3
	if V and V.id == P.id and V.ui then set(V.ui.play) end
end

function X.tpPlay(P, from, keep)
	if not (P and P.rig.Parent) then return end
	P.gen = (P.gen or 0) + 1
	local my = P.gen
	P.len = X.tpLen(P)
	local t = from or P.t or 0
	if t >= P.len - 0.02 then
		t = 0
		keep = false
	end
	P.t = t
	P.playing, P.paused = true, false
	if keep then
		X.tpFreeze(false)
		X.tpFxFrom(P, t, false, false) -- only the effects that are still to come
	else
		X.tpFxClear()
		X.tpFxFrom(P, t, true, false)
	end
	X.tpPose(P, t)
	X.tpHeads(P)
	X.tpUI(P)
	X.tpStatus(P)
	task.spawn(function()
		local last, lenT = os.clock(), os.clock()
		while P.gen == my and P.rig.Parent and X.pv == P do
			RunService.RenderStepped:Wait()
			if P.gen ~= my then break end
			local now = os.clock()
			local dt = now - last
			last = now
			if not P.dragging then
				if now - lenT > 0.5 then
					lenT = now
					P.len = X.tpLen(P)
				end
				local nt = P.t + dt * P.speed
				if nt >= P.len then
					if P.loop then
						nt = 0
						X.tpFxClear()
						X.tpFxFrom(P, 0, true, false)
					else
						P.t = P.len
						X.tpPose(P, P.len)
						X.tpHeads(P)
						P.playing = false
						X.tpUI(P)
						break
					end
				end
				P.t = nt
				X.tpPose(P, nt)
				X.tpHeads(P)
			end
		end
	end)
end

function X.tpPause(P)
	if not P or not P.playing then return end
	P.gen += 1
	P.playing, P.paused = false, true
	X.tpBump()
	X.tpFreeze(true)
	X.tpUI(P)
end

function X.tpHalt(P) -- stop everything (another editor takes over the dummy)
	if not P then return end
	P.gen = (P.gen or 0) + 1
	if P.playing or P.paused then
		P.playing, P.paused = false, false
		pcall(X.tpFreeze, false)
		pcall(X.tpFxClear)
		pcall(X.tpUI, P)
	end
end

function X.tpToggle(P)
	if not P then return end
	if P.playing then
		X.tpPause(P)
	elseif P.paused then
		X.tpPlay(P, P.t, true)
	else
		X.tpPlay(P, P.t, false)
	end
end

function X.tpHold(P) -- on a point: show the effects that are active there, then freeze them
	X.tpFxClear()
	X.tpFxFrom(P, P.t, true, true)
	local my, t = P.gen, P.t
	task.delay(0.4, function()
		if X.pv == P and P.gen == my and P.paused and not P.playing and P.t == t then X.tpFreeze(true) end
	end)
end

-- move to time t. final = false while dragging (pose only), true when you let go
function X.tpSeek(P, t, final)
	if not (P and P.rig.Parent) then return end
	P.len = P.len or X.tpLen(P)
	t = math.clamp(t, 0, P.len)
	P.t = t
	X.tpPose(P, t)
	X.tpHeads(P)
	if not final then return end
	if P.playing then
		X.tpPlay(P, t, false)
	else
		P.paused = true
		X.tpHold(P)
		X.tpUI(P)
	end
end

function X.tpEnsure(id) -- the preview rig for this animation (opens the Preview window when needed)
	local P = X.pv
	if P and P.rig.Parent then
		if P.id ~= id then
			X.tpHalt(P)
			P.id, P.t, P.len, P.trackFor = id, 0, nil, nil
			P.len = X.tpLen(P)
			X.tpStatus(P)
			X.tpHeads(P)
		end
		return P
	end
	local ok, err = pcall(X.pvOpen, id, nil, true)
	if not ok then
		out("Preview failed: " .. tostring(err))
		return nil
	end
	return X.pv
end

-- the red scrub bar used by the Preview window and the 3D viewer
function X.mkScrub(parent, pos, size)
	local f = Instance.new("Frame")
	f.Position, f.Size = pos, size
	f.BackgroundColor3 = C.code
	f.BorderSizePixel = 0
	f.Active = true
	f.Parent = parent
	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.BackgroundColor3 = C.sel
	fill.BackgroundTransparency = 0.55
	fill.BorderSizePixel = 0
	fill:SetAttribute("NoCorner", true)
	fill.Parent = f
	local line = Instance.new("Frame")
	line.Size = UDim2.new(0, 2, 1, 0)
	line.BackgroundColor3 = Color3.fromRGB(255, 90, 90)
	line.BorderSizePixel = 0
	line.ZIndex = 3
	line:SetAttribute("NoCorner", true)
	line.Parent = f
	local lbl = Instance.new("TextLabel")
	lbl.Position = UDim2.new(0, 6, 0, 0)
	lbl.Size = UDim2.new(1, -12, 1, 0)
	lbl.BackgroundTransparency = 1
	lbl.TextColor3 = C.text
	lbl.Font = Th.font
	lbl.TextSize = 13
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.ZIndex = 2
	lbl.Text = "drag to move the red line"
	lbl.Parent = f
	f.InputBegan:Connect(function(input)
		if not K.isPress(input) then return end
		local P = X.pv
		if not (P and P.rig.Parent) then return end
		P.dragging = true
		local function setFrom(pos2)
			local rel = math.clamp((pos2.X - f.AbsolutePosition.X) / math.max(f.AbsoluteSize.X, 1), 0, 1)
			X.tpSeek(P, rel * (P.len or X.tpLen(P)), false)
		end
		setFrom(input.Position)
		local conn = UserInputService.InputChanged:Connect(function(i2)
			if isMove(i2) then setFrom(i2.Position) end
		end)
		input.Changed:Connect(function()
			if input.UserInputState ~= Enum.UserInputState.End then return end
			conn:Disconnect()
			P.dragging = false
			X.tpSeek(P, P.t, true)
		end)
	end)
	return { frame = f, fill = fill, line = line, lbl = lbl }
end

function X.pvPlay() -- "Replay": from the start
	local P = X.pv
	if not P or not P.rig.Parent then return end
	P.gen += 1
	local my = P.gen
	task.spawn(function()
		local d = details[P.id]
		if not (d and d.joints and #d.joints > 0) and not X.pvLoad(P) then
			return X.pvStatus("Could not load this animation on the preview rig (not allowed / invalid id).")
		end
		if my ~= P.gen or X.pv ~= P then return end
		X.tpPlay(P, 0, false)
	end)
end

function X.pvOpen(id, e, noPlay)
	if e and (e.search or X.guess) then X.prepareFX(e) end
	local P = X.pv
	if P and P.rig.Parent then
		if P.id ~= id then
			X.tpHalt(P)
			P.id, P.t, P.len, P.trackFor = id, 0, nil, nil
		end
		if not noPlay then X.pvPlay() else X.tpStatus(P) end
		return
	end
	X.pvClose()
	local char, root = lp.Character, K.getRoot()
	if not (char and root) then error("no character") end
	local wasArch = char.Archivable
	char.Archivable = true
	local rig = char:Clone()
	char.Archivable = wasArch
	if not rig then error("could not clone your character") end
	for _, d in ipairs(rig:GetDescendants()) do
		if d:IsA("LuaSourceContainer") then
			d:Destroy()
		else
			if d:IsA("BasePart") then
				d.CanCollide = false
				d.CanQuery = false
				d.CanTouch = false
			end
			if d:IsA("Animator") or d:IsA("Sound") or VFX_CLASSES[d.ClassName] then d:SetAttribute("_LoggerClone", true) end
		end
	end
	local hum = rig:FindFirstChildOfClass("Humanoid")
	local rroot = rig:FindFirstChild("HumanoidRootPart")
	if not hum or not rroot then
		rig:Destroy()
		error("clone has no humanoid")
	end
	rroot.Anchored = true -- only the root: the limbs must stay free to animate
	pcall(function() hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end)
	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator:SetAttribute("_LoggerClone", true)
		animator.Parent = hum
	end
	rig:SetAttribute("_LoggerClone", true)
	rig.Name = "AnimPreview"
	rig.Parent = workspace

	local win = createWindow({
		title = "Live Preview",
		size = Vector2.new(380, 304),
		pos = UDim2.new(1, -400, 0, 70),
		minSize = Vector2.new(330, 260),
		miniText = "PV",
		onClose = function() X.pvClose() end,
	})
	P = { id = id, rig = rig, hum = hum, animator = animator, loop = false, speed = 1, fx = true, token = 0, win = win,
		gen = 0, t = 0, playing = false, paused = false, ui = {} }
	X.pv = P

	local grid = Instance.new("Frame")
	grid.Size = UDim2.new(1, -12, 0, 142)
	grid.Position = UDim2.new(0, 6, 0, 6)
	grid.BackgroundTransparency = 1
	grid.Parent = win.content
	local gl = Instance.new("UIGridLayout")
	gl.CellSize = UDim2.new(1 / 3, -6, 0, 42)
	gl.CellPadding = UDim2.new(0, 6, 0, 8)
	gl.SortOrder = Enum.SortOrder.LayoutOrder
	gl.Parent = grid
	local function mk(text, order, color, fn)
		local b = K.newButton(grid, text, color or C.btn)
		b.LayoutOrder = order
		b.MouseButton1Click:Connect(function()
			local okF, errF = pcall(fn, b)
			if not okF then out("Preview: " .. tostring(errF)) end
		end)
		return b
	end
	mk("Replay", 1, C.sel, function() X.pvPlay() end)
	mk("Loop: Off", 2, C.btn, function(b)
		P.loop = not P.loop
		b.Text = P.loop and "Loop: On" or "Loop: Off"
		K.paint(b, P.loop and C.sel or C.btn)
		X.tpStatus(P)
	end)
	mk("Speed: 1x", 3, C.btn, function(b)
		local i = table.find(X.speeds, P.speed) or 3
		P.speed = X.speeds[i % #X.speeds + 1]
		b.Text = "Speed: " .. tostring(P.speed) .. "x"
		if P.playing then X.tpPlay(P, P.t, false) else X.tpStatus(P) end
	end)
	mk("FX: On", 4, C.sel, function(b)
		P.fx = not P.fx
		b.Text = P.fx and "FX: On" or "FX: Off"
		K.paint(b, P.fx and C.sel or C.btn)
		if not P.fx then X.tpFxClear() end
		P.len = X.tpLen(P)
		if P.playing then X.tpPlay(P, P.t, false) end
		X.tpStatus(P)
	end)
	mk("Move to me", 5, C.btn, function() X.pvPlace() end)
	mk("Watch: Off", 6, C.btn, function(b)
		X.pvWatch(not P.watching, P)
		b.Text = P.watching and "Watch: On" or "Watch: Off"
		K.paint(b, P.watching and C.sel or C.btn)
	end)
	P.ui.pause = mk("Play", 7, C.green, function() X.tpToggle(P) end)
	mk("3D View", 8, C.sel, function() X.v3Open(P.id) end)
	mk("Save", 9, C.green, function(b) X.edsSave(P.id, b) end)

	P.scrub = X.mkScrub(win.content, UDim2.new(0, 6, 0, 154), UDim2.new(1, -12, 0, 26))

	local status = Instance.new("TextLabel")
	status.Position = UDim2.new(0, 8, 0, 186)
	status.Size = UDim2.new(1, -16, 1, -192)
	status.BackgroundTransparency = 1
	status.TextColor3 = C.sub
	status.Font = Th.font
	status.TextSize = 14
	status.TextWrapped = true
	status.TextXAlignment = Enum.TextXAlignment.Left
	status.TextYAlignment = Enum.TextYAlignment.Top
	status.Text = id
	status.Parent = win.content
	P.status = status

	X.pvPlace()
	P.len = X.tpLen(P)
	X.tpHeads(P)
	if noPlay then X.tpStatus(P) else X.pvPlay() end
end

--// FX editor + timeline -----------------------------------------------------------------------
-- Opens a window with a timeline of every recorded VFX / SFX event and a list to edit them:
-- turn events ON/OFF, change their time. Copy Full+FX, Preview and Run all use your edits.
X.ROWH = 44

function X.edLength(id)
	local L = X.lens[id]
	if not L or L <= 0 then L = details[id] and details[id].length end
	return L or 0
end

function X.copyAnim(id, withFX, btn, text)
	text = text or btn.Text
	local function restore()
		task.delay(1.5, function() if btn.Parent then btn.Text = text end end)
	end
	local function finish()
		local okC, code = pcall(K.buildAnimCode, id, withFX)
		if okC then
			toClip(code, "the frame-by-frame script")
			btn.Text = "Copied!"
		else
			out("Failed: " .. tostring(code))
			btn.Text = "Fail"
		end
		restore()
	end
	if details[id] then return finish() end
	btn.Text = "Working..."
	requestDetail(id, function(ok, res)
		if not btn.Parent then return end
		if ok then
			finish()
		else
			out("Frame-by-frame failed: " .. tostring(res))
			btn.Text = "Fail"
			restore()
		end
	end, function(t) if btn.Parent then btn.Text = t:sub(1, 16) end end)
end

function X.evSection(e)
	if e.kind == "sfx" then return "sfx" end
	if e.kind == "obj" or e.kind == "gui" then return "obj" end
	if e.kind == "cam" then return "cam" end
	return "vfx"
end

function X.kc(k)
	if k == "vfx" then return C.vfx end
	if k == "sfx" then return C.sfx end
	if k == "obj" then return Color3.fromRGB(235, 165, 70) end
	return Color3.fromRGB(190, 125, 235)
end

function X.evLines(e)
	if e.kind == "gui" then
		local g = e.gui or {}
		return "2D GUI  " .. tostring(e.name), string.format("%d element%s  |  %d change%s  |  %.1fs", #(g.nodes or {}) - 1, #(g.nodes or {}) == 2 and "" or "s", #(g.keys or {}), #(g.keys or {}) == 1 and "" or "s", e.dur or g.dur or 3)
	elseif e.kind == "obj" then
		local n = e.spec and #e.spec.parts or 0
		local how = (e.mount and e.mount.part) and ("attached to " .. e.mount.part) or ((e.path and #e.path >= 2) and "moves" or "placed")
		return (e.dummy and "DUMMY  " or "OBJECT  ") .. tostring(e.name) .. "  (" .. tostring(e.class) .. ")",
			string.format("%d part%s  |  %s  |  %.1fs", n, n == 1 and "" or "s", how, e.dur or 2.5)
	elseif e.kind == "cam" then
		return "CAMERA  " .. tostring(e.name), string.format("cutscene camera  |  %d points  |  %.1fs", e.cam and #e.cam or 0, e.dur or 0)
	end
	local tag = X.fxBlocked(e) and "[BLOCKED]  " or ""
	if e.kind == "sfx" then
		local sid = ""
		for _, p in ipairs(e.props or {}) do
			if p[1] == "SoundId" then sid = tostring(p[2]):gsub('"', "") end
		end
		return tag .. "SFX  " .. tostring(e.name), string.format("%s  |  %.1fs", sid, e.dur or 3)
	end
	local detail
	if e.emit and not e.enabled then
		detail = string.format("burst x%d", e.emit)
	else
		detail = string.format("on for %.1fs", e.dur or 1.5)
	end
	return tag .. "VFX  " .. tostring(e.class) .. "  " .. tostring(e.name), detail
end

