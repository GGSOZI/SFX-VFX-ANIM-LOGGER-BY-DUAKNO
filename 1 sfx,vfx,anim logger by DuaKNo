--// FX editor + timeline -----------------------------------------------------------------------
-- Opens a window with a timeline of every recorded VFX / SFX event and a list to edit them:
-- turn events ON/OFF, change their time. Copy Full+FX, Preview and Run all use your edits.
X.ROWH = 44

function X.edLength(id)
	local L = X.lens[id]
	if not L or L <= 0 then L = details[id] and details[id].length end
	return L or 0
end

function X.copyAnim(id, withFX, btn, text)
	text = text or btn.Text
	local function restore()
		task.delay(1.5, function() if btn.Parent then btn.Text = text end end)
	end
	local function finish()
		local okC, code = pcall(K.buildAnimCode, id, withFX)
		if okC then
			toClip(code, "the frame-by-frame script")
			btn.Text = "Copied!"
		else
			out("Failed: " .. tostring(code))
			btn.Text = "Fail"
		end
		restore()
	end
	if details[id] then return finish() end
	btn.Text = "Working..."
	requestDetail(id, function(ok, res)
		if not btn.Parent then return end
		if ok then
			finish()
		else
			out("Frame-by-frame failed: " .. tostring(res))
			btn.Text = "Fail"
			restore()
		end
	end, function(t) if btn.Parent then btn.Text = t:sub(1, 16) end end)
end

function X.evSection(e)
	if e.kind == "sfx" then return "sfx" end
	if e.kind == "obj" then return "obj" end
	if e.kind == "cam" then return "cam" end
	return "vfx"
end

function X.kc(k)
	if k == "vfx" then return C.vfx end
	if k == "sfx" then return C.sfx end
	if k == "obj" then return Color3.fromRGB(235, 165, 70) end
	return Color3.fromRGB(190, 125, 235)
end

function X.evLines(e)
	if e.kind == "obj" then
		local n = e.spec and #e.spec.parts or 0
		local how = (e.mount and e.mount.part) and ("attached to " .. e.mount.part) or ((e.path and #e.path >= 2) and "moves" or "placed")
		return (e.dummy and "DUMMY  " or "OBJECT  ") .. tostring(e.name) .. "  (" .. tostring(e.class) .. ")",
			string.format("%d part%s  |  %s  |  %.1fs", n, n == 1 and "" or "s", how, e.dur or 2.5)
	elseif e.kind == "cam" then
		return "CAMERA  " .. tostring(e.name), string.format("cutscene camera  |  %d points  |  %.1fs", e.cam and #e.cam or 0, e.dur or 0)
	end
	if e.kind == "sfx" then
		local sid = ""
		for _, p in ipairs(e.props or {}) do
			if p[1] == "SoundId" then sid = tostring(p[2]):gsub('"', "") end
		end
		return "SFX  " .. tostring(e.name), string.format("%s  |  %.1fs", sid, e.dur or 3)
	end
	local detail
	if e.emit and not e.enabled then
		detail = string.format("burst x%d", e.emit)
	else
		detail = string.format("on for %.1fs", e.dur or 1.5)
	end
	return "VFX  " .. tostring(e.class) .. "  " .. tostring(e.name), detail
end

