		if P then X.tpSeek(P, 0, true) end
	end)
	X.mkTool(bar, "3D View", 70, C.sel, function() X.v3Open(id) end)
	X.mkTool(bar, "Save", 54, C.green, function(b) X.edsSave(id, b) end)
	X.mkTool(bar, "Rename", 66, C.btn, function() X.renameAnim(id) end)
	X.mkTool(bar, "Bulk", 50, C.btn, function() X.edBulk() end)
	X.mkTool(bar, "Find related", 96, C.green, function(b)
		if b:GetAttribute("busy") then return end
		b:SetAttribute("busy", true)
		local old = b.Text
		b.Text = "Searching..."
		task.spawn(function()
			local ok, list = pcall(X.relatedFX, { id = id, name = K.animName(id), inst = X.animInstOf[id] })
			local added = 0
			if ok and type(list) == "table" and X.ed == E then
				X.edChange(function()
					local have = {}
					for _, e in ipairs(E.events) do have[tostring(e.kind) .. "|" .. tostring(e.class) .. "|" .. tostring(e.name)] = true end
					for _, ev in ipairs(list) do
						local k = tostring(ev.kind) .. "|" .. tostring(ev.class) .. "|" .. tostring(ev.name)
						if not have[k] then
							have[k] = true
							ev.t = 0
							table.insert(E.events, ev)
							added += 1
						end
					end
				end)
			end
			if b.Parent then b.Text = added > 0 and ("Added " .. added) or "None found" end
			task.wait(2.5)
			if b.Parent then
				b.Text = old
				b:SetAttribute("busy", nil)
			end
		end)
