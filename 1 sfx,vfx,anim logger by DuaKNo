-- Runtime that plays the VFX / SFX events. Every effect runs inside pcall.
local FX_RUNTIME = [==[
local Debris = game:GetService("Debris")
local SoundService = game:GetService("SoundService")
local fxChar = lp.Character or lp.CharacterAdded:Wait()
local fxRoot = fxChar:WaitForChild("HumanoidRootPart")

local function mountFor(m)
	local att = Instance.new("Attachment")
	local part = m and m.part and fxChar:FindFirstChild(m.part, true)
	if part and part:IsA("BasePart") then
		att.CFrame = m.cf or CFrame.new()
		att.Parent = part
		return att, att
	end
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(0.2, 0.2, 0.2)
	p.CFrame = fxRoot.CFrame * ((m and m.cf) or CFrame.new())
	p:SetAttribute("_Replay", true)
	p.Parent = workspace
	att.Parent = p
	return att, p
end

local function setProps(inst, props)
	for _, kv in ipairs(props) do
		pcall(function() inst[kv[1]] = kv[2] end)
	end
end

local function playFX(e)
	if e.kind == "sfx" then
		local s = Instance.new("Sound")
		s:SetAttribute("_Replay", true)
		setProps(s, e.props)
		s.Parent = e.pos and fxRoot or SoundService
		s:Play()
		Debris:AddItem(s, e.dur or 5)
		return
	end

	local cls = e.class
	local fx = Instance.new(cls)
	fx:SetAttribute("_Replay", true)
	fx.Name = e.name or cls
	setProps(fx, e.props)
	local life = (e.dur or 2) + 2

	if cls == "Highlight" then
		fx.Adornee = fxChar
		fx.Parent = fxChar
	elseif cls == "Explosion" then
		fx.BlastPressure = 0
		fx.DestroyJointRadiusPercent = 0
		fx.Position = (fxRoot.CFrame * ((e.mount and e.mount.cf) or CFrame.new())).Position
		fx.Parent = workspace
	elseif cls == "Beam" or cls == "Trail" then
		local a0, h0 = mountFor(e.att0 or e.mount)
		local a1, h1 = mountFor(e.att1 or e.mount)
		fx.Attachment0, fx.Attachment1 = a0, a1
		fx.Parent = a0
		Debris:AddItem(h0, life)
		Debris:AddItem(h1, life)
	else
		local att, holder = mountFor(e.mount)
		if cls == "Fire" or cls == "Smoke" or cls == "Sparkles" then
			fx.Parent = att.Parent -- these legacy effects need a BasePart
		else
			fx.Parent = att
		end
		if cls == "ParticleEmitter" then
			if e.enabled then
				fx.Enabled = true
				task.delay(e.dur or 1.5, function() pcall(function() fx.Enabled = false end) end)
			else
				fx.Enabled = false
				fx:Emit(e.emit or 10)
			end
		end
		Debris:AddItem(holder, life)
	end
	Debris:AddItem(fx, life)
end

for _, e in ipairs(FX) do
	task.delay(e.t or 0, function()
		local ok, err = pcall(playFX, e)
		if not ok then warn("[FX] skipped:", err) end
	end)
end
]==]

local function indentLines(s, prefix)
	return (s:gsub("[^\n]+", function(l) return prefix .. l end))
end

local function mountStr(m)
	if not m then return "nil" end
	return string.format(
		"{ part = %s, cf = %s }",
		m.part and string.format("%q", m.part) or "nil", cfStr(m.cf or CFrame.new())
	)
end

local function evStr(ev)
	local L = {}
	local head = { "t = " .. g(ev.t or 0), string.format("kind = %q", ev.kind) }
	if ev.class then head[#head + 1] = string.format("class = %q", ev.class) end
	head[#head + 1] = string.format("name = %q", ev.name or "")
	if ev.enabled ~= nil then head[#head + 1] = "enabled = " .. tostring(ev.enabled) end
	if ev.emit then head[#head + 1] = "emit = " .. g(ev.emit) end
	if ev.dur then head[#head + 1] = "dur = " .. g(ev.dur) end
	if ev.pos then head[#head + 1] = "pos = true" end
	L[#L + 1] = "{ " .. table.concat(head, ", ") .. ","
	if ev.mount then L[#L + 1] = "\tmount = " .. mountStr(ev.mount) .. "," end
	if ev.att0 then L[#L + 1] = "\tatt0 = " .. mountStr(ev.att0) .. "," end
	if ev.att1 then L[#L + 1] = "\tatt1 = " .. mountStr(ev.att1) .. "," end
	L[#L + 1] = "\tprops = {"
	for _, kv in ipairs(ev.props) do
		L[#L + 1] = string.format("\t\t{%q, %s},", kv[1], kv[2])
	end
	L[#L + 1] = "\t} }"
	return table.concat(L, "\n")
end

-- the whole FX section: runs in its own thread inside pcall, so the animation never depends on it
local function genFXBlock(events)
	local L = {}
	local function add(s) L[#L + 1] = s end
	add("-- VFX / SFX: rebuilt from properties (no assets needed). Each effect runs inside pcall,")
	add("-- so if a sound or effect fails, the rest - and the animation - still play.")
	add("task.spawn(function()")
	add("\tlocal ok, err = pcall(function()")
	add("\t\tlocal FX = {")
	for _, ev in ipairs(events) do
		add(indentLines(evStr(ev), "\t\t\t") .. ",")
	end
	add("\t\t}")
	add(indentLines(FX_RUNTIME, "\t\t"))
	add("\tend)")
	add('\tif not ok then warn("[FX] failed (animation unaffected):", err) end')
	add("end)")
	return table.concat(L, "\n")
end

local function genStandaloneFX(events, title)
	return table.concat({
		"-- " .. title,
		"-- Rebuilt from properties - no original asset / instance needed",
		'local Players = game:GetService("Players")',
		"local lp = Players.LocalPlayer",
		"",
		genFXBlock(events),
		"",
	}, "\n")
end

local function runEvents(events, title)
	if not loadstring then error("loadstring is not available in this executor") end
	local fn, err = loadstring(genStandaloneFX(events, title))
	if not fn then error(err) end
	fn()
end

-- Playback part of the frame-by-frame script.
-- The character's Animator is detached while playing and the SAME Animator is put back afterwards,
-- the animation plays once (unless LOOP_FOREVER), and it cancels itself if you move, jump or die -
-- so your normal animations keep working.
local PLAYBACK_CODE = [==[
-- stop a previous run of this script (if any)
if _G.StopRecreatedAnim then pcall(_G.StopRecreatedAnim) end

local char = lp.Character or lp.CharacterAdded:Wait()
local hum = char:WaitForChild("Humanoid")

local function notify(text)
	print("[RecreatedAnim] " .. text)
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", {
