-- joints = { { name, part0, part1, frames = { {t, cf}, ... } }, ... }; fx = list of FX events or nil
local function genDetailedCode(id, rig, length, looped, joints, fx, note)
	local L = {}
	local function add(s) table.insert(L, s) end

	local names = {}
	for _, j in ipairs(joints) do table.insert(names, j.part1 .. " [" .. j.name .. "]") end

	add("-- Recreated animation - runs WITHOUT the original animation")
	add("-- Source AnimationId: " .. id)
	add(string.format("-- Rig: %s | Length: %.2fs | Original looped: %s", rig, length, tostring(looped)))
	add("-- Parts moved: " .. table.concat(names, ", "))
	if note then add("-- " .. note) end
	add("-- Every frame lists where each joint goes - e.g. the 'Left Shoulder' joint is")
	add("-- what moves the Left Arm (rot = degrees XYZ, just for reading).")
	if fx and #fx > 0 then
		add(string.format("-- Includes %d VFX/SFX events (rebuilt from properties, each inside pcall).", #fx))
	end
	add("")
	add('local Players = game:GetService("Players")')
	add('local RunService = game:GetService("RunService")')
	add("local lp = Players.LocalPlayer")
	add("")
	add("local LENGTH = " .. num(length))
	add("local SPEED = 1")
	add(string.format("local RIG = %q -- rig type this was captured on (must match yours)", rig))
	add("local SMOOTH = true -- blend between frames (false = exact frame steps)")
	add("local LOOP_FOREVER = false -- plays once; set true to repeat until _G.StopRecreatedAnim()")
	add("local CANCEL_ON_MOVE = true -- moving or jumping cancels it so your own animations work")
	add("local DISABLE_DEFAULT_ANIMATE = true -- detaches your Animator while playing, restored after")
	add("")
	add("local JOINTS = { -- the Motor6D joints this animation moves")
	for _, j in ipairs(joints) do
		add(string.format("\t[%q] = true, -- %s  (%s -> %s)", j.name, j.part1, j.part0, j.part1))
	end
	add("}")
	add("")
	add("-- one entry per frame: dt = seconds since the previous frame, j = where every joint goes")
	add("local frames = {")
	local base = joints[1].frames
	for i = 1, #base do
		local dt = i > 1 and (base[i][1] - base[i - 1][1]) or 0
		add(string.format("\t{ dt = %s, j = {", num(dt)))
		for _, j in ipairs(joints) do
			local cf = j.frames[i][2]
			local rx, ry, rz = cf:ToEulerAnglesXYZ()
			add(string.format(
				"\t\t[%q] = %s, -- %s rot %d, %d, %d",
				j.name, cfStr(cf), j.part1,
				math.floor(math.deg(rx) + 0.5), math.floor(math.deg(ry) + 0.5), math.floor(math.deg(rz) + 0.5)
			))
		end
		add("\t} },")
	end
	add("}")
	add("")
	if fx and #fx > 0 then
		add(genFXBlock(fx)) -- scheduled first, in its own thread; can never block the animation
		add("")
	end
	add(PLAYBACK_CODE)
	return table.concat(L, "\n")
end

--// RBXMX (KeyframeSequence) export ----------------------------------------------
local function xmlEsc(s)
	return (tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;"))
end

local CF_TAGS = { "X", "Y", "Z", "R00", "R01", "R02", "R10", "R11", "R12", "R20", "R21", "R22" }
local function cfXml(cf)
	local c = { cf:GetComponents() }
	local parts = { '<CoordinateFrame name="CFrame">' }
	for i, tag in ipairs(CF_TAGS) do
		parts[#parts + 1] = "<" .. tag .. ">" .. g(c[i]) .. "</" .. tag .. ">"
	end
	parts[#parts + 1] = "</CoordinateFrame>"
	return table.concat(parts)
end

local RBXMX_HEAD = '<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" '
	.. 'xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" '
	.. 'xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">'

local function buildRbxmx(name, loop, priority, emitKeyframes)
	local lines, refN = {}, -1
	local function w(s) lines[#lines + 1] = s end
	local function ref() refN += 1 return refN end

	w(RBXMX_HEAD)
	w('<Meta name="ExplicitAutoJoints">true</Meta>')
	w(string.format('<Item class="KeyframeSequence" referent="RBX%d"><Properties>', ref()))
	w(string.format(
		'<bool name="Loop">%s</bool><string name="Name">%s</string><token name="Priority">%d</token>',
		tostring(loop), xmlEsc(name), priority
	))
	w("</Properties>")
	emitKeyframes(w, ref)
	w("</Item>")
	w("</roblox>")
	return table.concat(lines, "\n")
end

local function keyframeOpen(ref, t)
	return string.format(
		'<Item class="Keyframe" referent="RBX%d"><Properties><string name="Name">Keyframe</string><float name="Time">%s</float></Properties>',
		ref(), g(t)
	)
end

local function emitPoseInst(w, ref, pose)
	w(string.format('<Item class="Pose" referent="RBX%d"><Properties>', ref()))
	w(cfXml(pose.CFrame))
	w(string.format(
		'<token name="EasingDirection">%d</token><token name="EasingStyle">%d</token>',
		pose.EasingDirection.Value, pose.EasingStyle.Value
	))
	w(string.format('<string name="Name">%s</string><float name="Weight">%s</float>', xmlEsc(pose.Name), g(pose.Weight)))
	w("</Properties>")
	for _, c in ipairs(pose:GetChildren()) do
		if c:IsA("Pose") then emitPoseInst(w, ref, c) end
	end
	w("</Item>")
end

local function rbxmxFromInstance(ks)
	local kfs = {}
	for _, c in ipairs(ks:GetChildren()) do
		if c:IsA("Keyframe") then table.insert(kfs, c) end
	end
	table.sort(kfs, function(a, b) return a.Time < b.Time end)
	if #kfs == 0 then error("empty KeyframeSequence") end
	return buildRbxmx(ks.Name, ks.Loop, ks.Priority.Value, function(w, ref)
		for _, kf in ipairs(kfs) do
			w(keyframeOpen(ref, kf.Time))
			for _, p in ipairs(kf:GetChildren()) do
				if p:IsA("Pose") then emitPoseInst(w, ref, p) end
			end
			w("</Item>")
		end
	end)
end

local function emitCapturedPose(w, ref, name, cf, weight, kids, i)
	w(string.format('<Item class="Pose" referent="RBX%d"><Properties>', ref()))
	w(cfXml(cf))
	w('<token name="EasingDirection">0</token><token name="EasingStyle">0</token>')
	w(string.format('<string name="Name">%s</string><float name="Weight">%d</float>', xmlEsc(name), weight))
	w("</Properties>")
	for _, k in ipairs(kids[name] or {}) do
		emitCapturedPose(w, ref, k.name, k.samples[i][2], 1, kids, i)
	end
	w("</Item>")
end

local function rbxmxFromCapture(name, loop, priority, motorsInfo)
	local kids, isChild, roots, seenRoot = {}, {}, {}, {}
	for _, mi in ipairs(motorsInfo) do
		kids[mi.parent] = kids[mi.parent] or {}
		table.insert(kids[mi.parent], mi)
		isChild[mi.name] = true
	end
	for _, mi in ipairs(motorsInfo) do
		if not isChild[mi.parent] and not seenRoot[mi.parent] then
			seenRoot[mi.parent] = true
			table.insert(roots, mi.parent)
		end
	end
	local n = math.huge
	for _, mi in ipairs(motorsInfo) do n = math.min(n, #mi.samples) end

	return buildRbxmx(name, loop, priority, function(w, ref)
		for i = 1, n do
			w(keyframeOpen(ref, motorsInfo[1].samples[i][1]))
			for _, rootName in ipairs(roots) do
				emitCapturedPose(w, ref, rootName, CFrame.new(), 0, kids, i)
			end
			w("</Item>")
		end
	end)
end

--// Getting the animation data (fast path: real keyframes; fallback: capture) -------
local function fetchOriginalSequence(id)
	local ks = withTimeout(3, function()
		local objs = game:GetObjects(id)
		if typeof(objs) == "table" then
			for _, o in ipairs(objs) do
				if o:IsA("KeyframeSequence") then return o end
				local inner = o:FindFirstChildWhichIsA("KeyframeSequence", true)
				if inner then return inner end
			end
		end
		return nil
	end)
	if ks then return ks end
	return withTimeout(3, function()
		return game:GetService("KeyframeSequenceProvider"):GetKeyframeSequenceAsync(id)
	end)
end

local STYLE_MAP = {
	[Enum.PoseEasingStyle.Linear] = Enum.EasingStyle.Linear,
	[Enum.PoseEasingStyle.Bounce] = Enum.EasingStyle.Bounce,
	[Enum.PoseEasingStyle.Cubic] = Enum.EasingStyle.Cubic,
	[Enum.PoseEasingStyle.Elastic] = Enum.EasingStyle.Elastic,
}
local DIR_MAP = {
	[Enum.PoseEasingDirection.In] = Enum.EasingDirection.In,
	[Enum.PoseEasingDirection.Out] = Enum.EasingDirection.Out,
	[Enum.PoseEasingDirection.InOut] = Enum.EasingDirection.InOut,
}

local function evalCurve(list, t)
	local n = #list
	if n == 1 or t <= list[1].t then return list[1].cf end
	if t >= list[n].t then return list[n].cf end
	for i = 1, n - 1 do
		local a, b = list[i], list[i + 1]
		if t >= a.t and t <= b.t then
			local span = b.t - a.t
			if span <= 0 then return b.cf end
			if b.style == Enum.PoseEasingStyle.Constant then return a.cf end
			local alpha = TweenService:GetValue(
				(t - a.t) / span,
				STYLE_MAP[b.style] or Enum.EasingStyle.Linear,
				DIR_MAP[b.dir] or Enum.EasingDirection.InOut
			)
			return a.cf:Lerp(b.cf, alpha)
		end
	end
	return list[n].cf
end

-- raw = { motors = { {motorName, part0, part1, samples = { {t, cf}, ... }}, ... }, looped, priorityName, priorityValue }
local function rawFromSequence(ks, char)
	local kfs = {}
	for _, c in ipairs(ks:GetChildren()) do
		if c:IsA("Keyframe") then kfs[#kfs + 1] = c end
	end
	if #kfs == 0 then error("no keyframes") end
	table.sort(kfs, function(a, b) return a.Time < b.Time end)
	local length = kfs[#kfs].Time
	if length <= 0 then error("animation has no duration") end

	local curves = {}
	for _, kf in ipairs(kfs) do
		for _, pose in ipairs(kf:GetDescendants()) do
			if pose:IsA("Pose") and pose.Weight > 0 then
				local list = curves[pose.Name]
				if not list then
					list = {}
					curves[pose.Name] = list
				end
				list[#list + 1] = { t = kf.Time, cf = pose.CFrame, style = pose.EasingStyle, dir = pose.EasingDirection }
			end
		end
	end

	local times = {}
	local steps = math.max(2, math.ceil(length / CAPTURE_STEP))
	for k = 0, steps do times[#times + 1] = math.min(k * (length / steps), length) end

	local motors, matched = {}, 0
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("Motor6D") and d.Part0 and d.Part1 then
			local curve = curves[d.Part1.Name]
			local samples = {}
			for _, t in ipairs(times) do
				samples[#samples + 1] = { t, curve and evalCurve(curve, t) or CFrame.new() }
			end
			if curve then matched += 1 end
			motors[#motors + 1] = { motorName = d.Name, part0 = d.Part0.Name, part1 = d.Part1.Name, samples = samples }
		end
	end
	if matched == 0 then error("rig mismatch - none of the animation's joints exist on your character") end

	return {
		motors = motors, looped = ks.Loop,
		priorityName = ks.Priority.Name, priorityValue = ks.Priority.Value,
	}
end

-- fallback: plays the animation on a hidden clone of your character (up to 4x speed) and samples it
local function rawFromPlaying(id, char, progress)
	local oldArch = char.Archivable
	char.Archivable = true
	local dummy = char:Clone()
	char.Archivable = oldArch
	if not dummy then error("couldn't clone your character") end

	dummy.Name = "_AnimCaptureDummy"
	dummy:SetAttribute("_LoggerClone", true)
	for _, d in ipairs(dummy:GetDescendants()) do
		d:SetAttribute("_LoggerClone", true)
		if d:IsA("LuaSourceContainer") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = true
		end
	end
	dummy:PivotTo(CFrame.new(0, 20000, 0))

	local dHum = dummy:FindFirstChildOfClass("Humanoid")
	if not dHum then dummy:Destroy() error("clone has no humanoid") end
	pcall(function() dHum.EvaluateStateMachine = false end)
	local animator = dHum:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator:SetAttribute("_LoggerClone", true)
		animator.Parent = dHum
	end
	dummy.Parent = workspace

	local motors = {}
	for _, d in ipairs(dummy:GetDescendants()) do
		if d:IsA("Motor6D") and d.Part0 and d.Part1 then table.insert(motors, d) end
	end

	local anim = Instance.new("Animation")
	anim.AnimationId = id
	local okLoad, track = pcall(function() return animator:LoadAnimation(anim) end)
	if not okLoad or not track then
		dummy:Destroy()
		error("couldn't load animation (not allowed / invalid id)")
	end
	ownTracks[track] = true

	local looped, priorityName, priorityValue, speed = track.Looped, track.Priority.Name, track.Priority.Value, track.Speed
	animInfo[id] = animInfo[id] or { priority = priorityName, looped = looped, speed = speed }
	track.Looped = false

	local waited = 0
	while track.Length == 0 and waited < 5 do waited += RunService.Heartbeat:Wait() end
	local length = track.Length
	if length == 0 then
		dummy:Destroy()
		error("animation failed to load (not allowed / invalid id)")
	end

	local speedMul = math.clamp(length / 2, 1, 4) -- long animations are captured faster
	progress(string.format("Capturing on a hidden rig (%.1fx speed)...", speedMul))

	local samples = {}
	for _, m in ipairs(motors) do samples[m] = {} end

	track:Play(0, 1, speedMul)
	local startClock, nextT, firstPos, lastReport = os.clock(), 0, nil, 0
	local maxWall = length / speedMul + 3
	while track.IsPlaying and os.clock() - startClock < maxWall do
		RunService.Heartbeat:Wait()
		local pos = track.TimePosition
		if pos > 0 and pos >= nextT then
			firstPos = firstPos or pos
			for _, m in ipairs(motors) do
				table.insert(samples[m], { pos - firstPos, m.Transform })
			end
			nextT = pos + CAPTURE_STEP * 0.9
			if os.clock() - lastReport > 0.25 then
				lastReport = os.clock()
				progress(string.format("Capturing... %d%%", math.floor(pos / length * 100)))
			end
		end
	end
	track:Stop(0)
	dummy:Destroy()

	local list = {}
	for _, m in ipairs(motors) do
		list[#list + 1] = { motorName = m.Name, part0 = m.Part0.Name, part1 = m.Part1.Name, samples = samples[m] }
	end
	return { motors = list, looped = looped, priorityName = priorityName, priorityValue = priorityValue }
end

local function buildRecord(id, raw, rig)
	local identity = CFrame.new()
	local joints, allMotors, totalLength = {}, {}, 0
	for _, m in ipairs(raw.motors) do
		local s = m.samples
		if #s >= 2 then
			allMotors[#allMotors + 1] = { name = m.part1, parent = m.part0, samples = s }
			local moved = false
			for _, f in ipairs(s) do
				if cfDiffers(f[2], identity) then moved = true break end
			end
			if moved then
				joints[#joints + 1] = { name = m.motorName, part0 = m.part0, part1 = m.part1, frames = s }
				totalLength = math.max(totalLength, s[#s][1])
			end
		end
	end
	if #joints == 0 then
		error("no joints moved - rig mismatch? (your rig is " .. rig .. ")")
	end
	animInfo[id] = animInfo[id] or { priority = raw.priorityName, looped = raw.looped, speed = 1 }
	return {
		rig = rig, length = totalLength, looped = raw.looped, joints = joints, allMotors = allMotors,
		priorityValue = raw.priorityValue, cache = {}, rawFrames = #joints[1].frames,
	}
end

local function captureDetail(id, progress)
	progress = progress or function() end
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not (char and hum and getRoot()) then error("character not ready") end
	local rig = hum.RigType.Name

	-- fast path: the animation's real keyframes (instant, no waiting)
	progress("Fetching the animation's keyframes...")
	local ks = fetchOriginalSequence(id)
	if ks then
		local ok, raw = pcall(rawFromSequence, ks, char)
		if ok then
			progress("Building from keyframes...")
			local rec = buildRecord(id, raw, rig)
			rec.source = "keyframes"
			pcall(function() rbxmxCache[id] = { xml = rbxmxFromInstance(ks), source = "original" } end)
			return rec
		end
	end

	-- slow path: capture on a hidden rig
	progress("Keyframes not available - capturing on a hidden rig...")
	local raw = rawFromPlaying(id, char, progress)
	local rec = buildRecord(id, raw, rig)
	rec.source = "captured"
	return rec
end

-- simplified joints for the current quality (cached per quality)
local function simplified(id)
	local d = details[id]
	local c = d.cache[QUALITY]
	if not c then
		local joints, kept, total = simplifyJoints(d.joints, QUALITY_TOL[QUALITY] or 0)
		c = { joints = joints, kept = kept, total = total }
		d.cache[QUALITY] = c
	end
	return c
end

local function summaryFor(id)
	local d = details[id]
	local c = simplified(id)
	local names = {}
	for _, j in ipairs(d.joints) do names[#names + 1] = j.part1 .. " (" .. j.name .. ")" end
	return string.format(
		"Moved: %s | %d of %d frames (%s) | %.2fs | %s | %s",
		table.concat(names, ", "), c.kept, c.total, QUALITY, d.length, d.rig, d.source
	)
end

local function buildAnimCode(id, withFX)
	local d = details[id]
	if not d then error("not captured yet") end
	local c = simplified(id)
	local note = string.format("Frames: %d kept of %d sampled (quality: %s)", c.kept, c.total, QUALITY)
	return genDetailedCode(id, d.rig, d.length, d.looped, c.joints, withFX and animFX[id] or nil, note)
end

