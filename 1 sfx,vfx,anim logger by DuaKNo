-- Deep hook: catches ParticleEmitter:Emit() and Sound:Play() calls (no property ever changes for
-- those, so nothing else can see them). Only works when the executor has hookmetamethod.
-- It is installed once; running the script again just swaps the handler.
do
	local env = (getgenv and getgenv()) or _G
	local H = env.__AVLHook
	if not H and X.deep and hookmetamethod and getnamecallmethod and newcclosure then
		H = {}
		local okH = pcall(function()
			local old
			old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
				local m = getnamecallmethod()
				if (m == "Emit" or m == "Play") and H.fn and typeof(self) == "Instance"
					and not (checkcaller and checkcaller()) then
					task.defer(H.fn, self, m, os.clock(), (...))
				end
				if setnamecallmethod then setnamecallmethod(m) end
				return old(self, ...)
			end))
		end)
		if okH then env.__AVLHook = H else H = nil end
	end
	if H then
		H.fn = function(inst, m, at, a1)
			if not Run.alive or not X.deep then return end
			pcall(function()
				if inst:GetAttribute("_Replay") or inst:GetAttribute("_LoggerClone") then return end
				local cls = inst.ClassName
				if m == "Emit" and cls == "ParticleEmitter" then
					logVFX(inst, { emit = math.max(tonumber(a1) or 1, 1), enabled = false }, at)
				elseif m == "Play" and cls == "Sound" then
					logSFX(inst, at)
				end
			end)
		end
	end
end

