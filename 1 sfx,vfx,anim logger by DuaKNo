	if K.countKeys(excludedSFX) > 0 then
		header("Excluded SFX (" .. K.countKeys(excludedSFX) .. ")")
		for id in pairs(excludedSFX) do
			addRow(C.sfx, sfxLabel[id] or "", id, "Unexcl", function()
				excludedSFX[id] = nil
				refreshAll()
			end)
		end
	end
end

refreshAll = function()
	for i = #updaters, 1, -1 do
		if not updaters[i]() then table.remove(updaters, i) end
	end
	local ex = K.countKeys(excluded) + K.countKeys(excludedVFX) + K.countKeys(excludedSFX)
	local bl = K.countKeys(blocked) + K.countKeys(X.blockV) + K.countKeys(X.blockS)
	tabButtons.Filters.Text = (ex + bl) > 0 and string.format("Filters (%d/%d)", ex, bl) or "Filters"
	rebuildFilters()
end

