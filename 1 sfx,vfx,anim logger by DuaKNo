--// Animation logging -----------------------------------------------------
local watched = {} -- [Animator] = { [track] = true }

local function stopAnimId(id)
	local n = 0
	for animator in pairs(watched) do
		for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
			if tr.Animation and tr.Animation.AnimationId == id then
				tr:Stop(0)
				n += 1
			end
		end
	end
	return n
end

-- Stop Mine: stops animations you started with Run, and a recreated (Detail) script if one is running
local function stopMine()
	local n = 0
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if animator then
		for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
			if ownTracks[tr] then
				tr:Stop(0)
				n += 1
			end
		end
	end
	if _G.StopRecreatedAnim then
		if pcall(_G.StopRecreatedAnim) then n += 1 end
		_G.StopRecreatedAnim = nil
	end
	return n
end

stopMineBtn.MouseButton1Click:Connect(function()
	flash(stopMineBtn, stopMine() > 0 and "Stopped" or "None")
end)

local function logAnim(animator, track)
	if ownTracks[track] then return end -- played by our Run / capture
	local anim = track.Animation
	local id = anim and anim.AnimationId or "?"
	if excluded[id] then return end
	if ownOnly and not isOwn(animator) then return end
	if blocked[id] then
		if blockedLogged[id] then return end -- log a blocked anim only once
		blockedLogged[id] = true
	end

	animInfo[id] = animInfo[id] or { priority = track.Priority.Name, looped = track.Looped, speed = track.Speed }

	local owner = animator:FindFirstAncestorOfClass("Model")
	local ownerName = owner and owner.Name or animator.Parent and animator.Parent.Name or "?"
	animLabel[id] = track.Name .. " / " .. ownerName
	local detail = string.format(
		"%s\nTrack: %s | Len: %.2fs | Prio: %s | Loop: %s | Speed: %.2f",
		id, track.Name, track.Length, track.Priority.Name, tostring(track.Looped), track.Speed
	)

	local actions = {
		actCopy(id),
		actRun(function() playAnim(id) end),
		{ text = "Stop", color = COL.orange, fn = function(btn)
			flash(btn, stopAnimId(id) > 0 and "Stopped" or "None")
		end },
		{ text = "Code", color = COL.blue, fn = function(btn)
			toClip(simpleCode(id))
			flash(btn, "Copied!")
		end },
		{ color = COL.purple, state = function() return excluded[id] and "Unexcl" or "Excl", excluded[id] end,
			fn = function()
				excluded[id] = not excluded[id] or nil
				refreshAll()
			end },
		{ color = COL.purple, state = function() return blocked[id] and "Unblock" or "Block", blocked[id] end,
			fn = function()
				blocked[id] = not blocked[id] or nil
				if blocked[id] then
					stopAnimId(id)
				else
					blockedLogged[id] = nil
				end
				refreshAll()
			end },
		{ text = "Detail", color = COL.green, fn = function(btn)
			if details[id] then
				toClip(details[id].code)
				flash(btn, "Copied!")
				return
			end
			btn.Text = "Rec..."
			requestDetail(id, function(ok, res)
				if not btn.Parent then return end
				if ok then
					toClip(res.code)
					btn.Text = "Copied!"
				else
					copyBox.Text = "Detail failed: " .. tostring(res)
					btn.Text = "Fail"
				end
				task.delay(1, function()
					if btn.Parent then btn.Text = "Detail" end
				end)
			end)
		end },
		{ text = "RBXMX", color = COL.green, fn = function(btn)
			btn.Text = "Working"
			requestRbxmx(id, function(ok, xml, source)
				if not btn.Parent then return end
				if not ok then
					copyBox.Text = "RBXMX failed: " .. tostring(xml)
					btn.Text = "Fail"
				else
					local fileName = "Anim_" .. (id:match("%d+") or "x") .. ".rbxmx"
					local howTo = 'game:GetObjects(getcustomasset("' .. fileName .. '"))[1]'
					if writefile and pcall(writefile, fileName, xml) then
						copyBox.Text = string.format("Saved %s (%s)\nLoad: %s", fileName, source, howTo)
						btn.Text = "Saved!"
					else
						toClip(xml)
						btn.Text = "Copied!"
					end
				end
				task.delay(1.5, function()
					if btn.Parent then btn.Text = "RBXMX" end
				end)
			end)
		end },
	}

	local ent = addEntry("Anim", id, ownerName, detail, id, actions)
	if ent then
		entriesById[id] = entriesById[id] or {}
		table.insert(entriesById[id], ent)
		if details[id] then
			ent.setExtra(details[id].summary)
		elseif detailedMode and not blocked[id] then
			requestDetail(id)
		end
	end
end

local function blockIfNeeded(track)
	if ownTracks[track] then return end
	local anim = track.Animation
	if anim and blocked[anim.AnimationId] then track:Stop(0) end
end

local function watchAnimator(animator)
	if watched[animator] then return end
	watched[animator] = {}
	animator.AnimationPlayed:Connect(blockIfNeeded) -- fast path for blocking
end

local acc = 0
RunService.Heartbeat:Connect(function(dt)
	acc += dt
	if next(blocked) == nil and acc < POLL_RATE then return end
	acc = 0
	for animator, seen in pairs(watched) do
		if not animator.Parent then
			watched[animator] = nil
		else
			local current = {}
			for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
				current[track] = true
				blockIfNeeded(track)
				if not seen[track] and not paused then
					seen[track] = true
					logAnim(animator, track)
				elseif not seen[track] then
					seen[track] = true -- remember it so it isn't logged after resume
				end
			end
			for t in pairs(seen) do
				if not current[t] then seen[t] = nil end
			end
		end
	end
end)

--// VFX logging -----------------------------------------------------------
local function describeVFX(inst)
	local c = inst.ClassName
	if c == "ParticleEmitter" then
		return inst.Texture, string.format(
			"Texture: %s\nRate: %s | Lifetime: %.1f-%.1f | Speed: %.1f-%.1f | Color: %s",
			inst.Texture, inst.Rate, inst.Lifetime.Min, inst.Lifetime.Max,
			inst.Speed.Min, inst.Speed.Max, fmtColor(inst.Color.Keypoints[1].Value)
		)
	elseif c == "Beam" then
		return inst.Texture, string.format("Texture: %s\nWidth: %.1f-%.1f | Segments: %d", inst.Texture, inst.Width0, inst.Width1, inst.Segments)
	elseif c == "Trail" then
		return inst.Texture, string.format("Texture: %s\nLifetime: %.2f | MinLength: %.2f", inst.Texture, inst.Lifetime, inst.MinLength)
	elseif c == "Fire" or c == "Smoke" then
		return "", string.format("Size: %.1f | Color: %s", inst.Size, fmtColor(inst.Color))
	elseif c == "Explosion" then
		return "", string.format("BlastRadius: %.1f | BlastPressure: %.0f", inst.BlastRadius, inst.BlastPressure)
	elseif c == "Highlight" then
		return "", string.format("Fill: %s | Outline: %s", fmtColor(inst.FillColor), fmtColor(inst.OutlineColor))
	elseif c:find("Light") then
		return "", string.format("Brightness: %.1f | Range: %.1f | Color: %s", inst.Brightness, inst.Range, fmtColor(inst.Color))
	end
	return "", ""
end

local function logVFX(inst)
	if ownOnly and not isOwn(inst) then return end
	local ok, texture, detail = pcall(describeVFX, inst)
	if not ok then return end
	local path = shortPath(inst)
	local key = inst.ClassName .. "|" .. inst.Name .. "|" .. tostring(texture)
	if excludedVFX[key] then return end
	vfxLabel[key] = inst.ClassName .. ": " .. inst.Name
	local copyText = (texture ~= "" and texture) or (inst.ClassName .. " @ " .. path)
	addEntry("VFX", key, inst.ClassName .. ": " .. inst.Name, path .. "\n" .. detail, copyText, {
		actCopy(copyText),
		actRun(function() playVFX(inst) end),
		{ color = COL.purple, state = function() return excludedVFX[key] and "Unexcl" or "Excl", excludedVFX[key] end,
			fn = function()
				excludedVFX[key] = not excludedVFX[key] or nil
				refreshAll()
			end },
	})
end

local function watchVFX(inst)
	if not VFX_CLASSES[inst.ClassName] then return end
	if inst:GetAttribute("_LoggerClone") then return end -- spawned by our Run / capture
	logVFX(inst)
	-- log again when it gets switched on
	if inst:IsA("ParticleEmitter") or inst:IsA("Beam") or inst:IsA("Trail")
		or inst:IsA("Fire") or inst:IsA("Smoke") or inst:IsA("Light") or inst:IsA("Sparkles") then
		inst:GetPropertyChangedSignal("Enabled"):Connect(function()
			if inst.Enabled then logVFX(inst) end
		end)
	end
end

--// Hook the world --------------------------------------------------------
for _, d in ipairs(workspace:GetDescendants()) do
	if d:IsA("Animator") and not d:GetAttribute("_LoggerClone") then watchAnimator(d) end
end

workspace.DescendantAdded:Connect(function(d)
	if d:IsA("Animator") then
		if not d:GetAttribute("_LoggerClone") then watchAnimator(d) end
	elseif VFX_CLASSES[d.ClassName] then
		task.defer(watchVFX, d)
	end
end)

-- Existing emitters: only log when they switch on / get re-enabled
for _, d in ipairs(workspace:GetDescendants()) do
	if d:IsA("ParticleEmitter") then
		d:GetPropertyChangedSignal("Enabled"):Connect(function()
			if d.Enabled then logVFX(d) end
		end)
	end
end

refreshAll()
