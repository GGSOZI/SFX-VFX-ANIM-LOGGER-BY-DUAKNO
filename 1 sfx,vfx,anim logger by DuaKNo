function X.keepRig(id, owner)
	if X.rigKeep[id] or not owner then return end
	pcall(function()
		local has = false
		for _, d in ipairs(owner:GetDescendants()) do
			if d:IsA("Motor6D") then
				has = true
				break
			end
		end
		if not has then return end
		local oa = owner.Archivable
		owner.Archivable = true
		local c = owner:Clone()
		owner.Archivable = oa
		if not c then return end
		c.Parent = nil
		X.rigKeep[id] = c
		table.insert(X.rigKeepOrder, id)
		while #X.rigKeepOrder > 12 do
			local oldId = table.remove(X.rigKeepOrder, 1)
			local oc = X.rigKeep[oldId]
			X.rigKeep[oldId] = nil
			if oc then pcall(function() oc:Destroy() end) end
		end
	end)
end

