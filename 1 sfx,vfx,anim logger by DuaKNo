function X.dsDrag(el, item, key) -- drag = move it, tap = open its settings
	local lim = X.DS_LIM[(key == "joy" and "joy") or (key == "jump" and "jump") or "btn"]
	local moved = false
	local function openIt()
		X.ds.sel = key
		X.dsLast = key
		X.dsPanelOpen = true
		X.dsMark()
		local okP, err = pcall(function()
			X.dsPanelShow()
			X.dsProps()
		end)
		if not okP then X.dsMsg("settings window error: " .. tostring(err)) end
	end
	X.dsOpenIt = X.dsOpenIt or {}
	el.InputBegan:Connect(function(input)
		if not K.isPress(input) then return end
		local pv = X.dsPv
		if not (pv and pv.Parent) then return end
		local p0, x0, y0 = input.Position, item.x, item.y
		moved = false
		X.ds.sel = key
		X.dsLast = key
		X.dsMark()
		local conn
		conn = UserInputService.InputChanged:Connect(function(i2)
			if not isMove(i2) then return end
			local d = i2.Position - p0
			if not moved and math.abs(d.X) + math.abs(d.Y) < 22 then return end -- a finger always wobbles a little: that still counts as a tap
			moved = true
			local as = pv.AbsoluteSize
			item.x = math.clamp(x0 + d.X / math.max(as.X, 1), lim[1], lim[2])
			item.y = math.clamp(y0 + d.Y / math.max(as.Y, 1), lim[3], lim[4])
			el.Position = UDim2.new(item.x, 0, item.y, 0)
		end)
		input.Changed:Connect(function()
			if input.UserInputState ~= Enum.UserInputState.End then return end
			conn:Disconnect()
			if moved then
				X.svDirty = true
				if X.dsPanelOpen then openIt() end -- the open settings follow the button you just moved
			else
				openIt()
			end
		end)
	end)
	el.Activated:Connect(function() -- the normal tap / click as well, in case the press events are missed
		if not moved then openIt() end
	end)
end

