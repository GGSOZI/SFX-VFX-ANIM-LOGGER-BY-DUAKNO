-- variants = { { name = "Frames", get = function(cb, setStatus) cb(code) / cb(nil, err) end }, ... }
local viewerCount = 0
local function openViewer(titleText, variants, startIndex, toolId)
	viewerCount += 1
	local off = (viewerCount % 6) * 22
	local win = createWindow({
