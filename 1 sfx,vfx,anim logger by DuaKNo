function X.httpPost(path, body)
	local req = request or http_request or (syn and syn.request) or (fluxus and fluxus.request)
	if not req then return nil, "this executor has no request()" end
	if X.ACCESS_URL:find("YOUR-WORKER", 1, true) then return nil, "server not set up yet: set X.ACCESS_URL in the script (design-server/README.md)" end
	local ok, res = pcall(req, {
		Url = (X.ACCESS_URL:gsub("/+$", "")) .. path, Method = "POST",
		Headers = { ["Content-Type"] = "application/json" }, Body = HttpService:JSONEncode(body),
	})
	if not ok or type(res) ~= "table" then return nil, "could not reach the server" end
	local okJ, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
	if not okJ or type(data) ~= "table" then return nil, "bad answer from the server" end
	if data.ok ~= true then return nil, tostring(data.error or "denied") end
	return data
end

function X.hwid()
	local ok, v = pcall(function() return game:GetService("RbxAnalyticsService"):GetClientId() end)
