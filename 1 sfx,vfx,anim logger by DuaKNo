-- take the Animator(s) off the character while playing (we put the same ones back at the end)
local animate = char:FindFirstChild("Animate")
local animateWasDisabled = animate and animate.Disabled
local detached = {}

local function detachAnimators()
	for _, d in ipairs(hum:GetChildren()) do
		if d:IsA("Animator") then
			detached[#detached + 1] = d
			d.Parent = nil
		end
