	runBtn.Size = UDim2.new(0, 64, 1, 0)
	runBtn.Position = UDim2.new(1, -134, 0, 0)

	local copyBtn = newButton(bar, "Copy", C.sel)
	copyBtn.Size = UDim2.new(0, 64, 1, 0)
	copyBtn.Position = UDim2.new(1, -64, 0, 0)

	local view = createCodeView(content, UDim2.new(0, 4, 0, 38), UDim2.new(1, -8, 1, -68))

	local status = Instance.new("TextLabel")
	status.Position = UDim2.new(0, 6, 1, -26)
	status.Size = UDim2.new(1, -250, 0, 22)
	status.BackgroundTransparency = 1
	status.TextColor3 = C.sub
	status.Font = Th.font
	status.TextSize = 15
	status.TextXAlignment = Enum.TextXAlignment.Left
	status.Text = ""
	status.Parent = content

	-- easy scrolling: jump buttons (long scripts are painful to drag)
	local function nav(label, xOff, fn)
		local b = newButton(content, label, C.btn)
		b.Size = UDim2.new(0, 46, 0, 24)
		b.Position = UDim2.new(1, xOff, 1, -27)
		b.TextSize = 14
		b.MouseButton1Click:Connect(function()
			local sf = view.frame
			local maxY = math.max(sf.CanvasSize.Y.Offset - sf.AbsoluteSize.Y, 0)
			local page = math.max(sf.AbsoluteSize.Y - 40, 40)
			sf.CanvasPosition = Vector2.new(sf.CanvasPosition.X, math.clamp(fn(sf.CanvasPosition.Y, page, maxY), 0, maxY))
		end)
	end
	nav("Top", -218, function() return 0 end)
	nav("PgUp", -168, function(y, page) return y - page end)
	nav("PgDn", -118, function(y, page) return y + page end)
	nav("End", -68, function(_, _, maxY) return maxY end)
	local current, token, currentIndex = nil, 0, startIndex or 1
	local tabButtonsV = {}

	local function show(i)
		currentIndex = i
		token += 1
		local my = token
		current = nil
		for j, b in ipairs(tabButtonsV) do paint(b, j == i and C.sel or C.btn) end
		view.hideRaw()
		pcall(view.setCode, "")
		status.Text = "Generating..."
		local t0 = os.clock()
		task.spawn(function()
			local okGen, errGen = pcall(variants[i].get, function(code, err)
				if my ~= token or not view.frame.Parent then return end
				if not code then
					warn("[Logger] code generation failed: " .. tostring(err))
					status.Text = "Failed: " .. tostring(err)
					view.showRaw("-- Could not generate the code:\n-- " .. tostring(err) .. "\n-- Click the tab again or lower Quality to retry.")
					return
				end
				code = Clip.stamp(code)
				current = code
				view.hideRaw()
				local ok, n = pcall(view.setCode, code)
				if ok then
					status.Text = string.format("%d lines, %d characters (%.1fs)", n, #code, os.clock() - t0)
				else
					warn("[Logger] code view failed: " .. tostring(n))
					view.showRaw(code)
					status.Text = "Colored view failed (" .. tostring(n) .. ") - showing plain text. Copy still works."
				end
			end, function(text)
				if my == token and status.Parent then status.Text = text end
			end)
			if not okGen and my == token and status.Parent then
				warn("[Logger] generator error: " .. tostring(errGen))
				status.Text = "Failed: " .. tostring(errGen)
				view.showRaw("-- Generator error:\n-- " .. tostring(errGen))
			end
		end)
	end

	for i, v in ipairs(variants) do
		local b = newButton(tabsRow, v.name, C.btn)
		b.Size = UDim2.new(0, 92, 1, 0)
		b.MouseButton1Click:Connect(function() show(i) end)
		tabButtonsV[i] = b
	end

	qualityBtn.MouseButton1Click:Connect(function()
		cycleQuality()
		qualityBtn.Text = "Quality: " .. QUALITY
		show(currentIndex)
	end)

	runBtn.MouseButton1Click:Connect(function()
		if not current then return flash(runBtn, "Wait...") end
		local loader = loadstring or load
		local fn, cerr = loader(current)
		if not fn then
			status.Text = "Run failed to compile: " .. tostring(cerr)
			return flash(runBtn, "Error")
		end
		task.spawn(function()
			local ok, rerr = pcall(fn)
			if not ok then
				warn("[Logger] run error: " .. tostring(rerr))
				if status.Parent then status.Text = "Run error: " .. tostring(rerr) end
			end
		end)
		flash(runBtn, "Ran!")
	end)

	copyBtn.MouseButton1Click:Connect(function()
		if not current then return flash(copyBtn, "Wait...") end
		if Clip.set(current) then
			flash(copyBtn, "Copied!")
		else
			status.Text = "No clipboard in this executor - select the text and copy it manually."
		end
	end)

	show(currentIndex)
	return win
end

