	end
	if K.countKeys(excludedVFX) > 0 then
		header("Excluded VFX (" .. K.countKeys(excludedVFX) .. ")")
		for key in pairs(excludedVFX) do
			addRow(C.vfx, vfxLabel[key] or key, key, "Unexcl", function()
