	local fbar = Instance.new("Frame")
	fbar.BackgroundTransparency = 1
	fbar.Parent = content
	E.fbar = fbar
	local chips = {}
	local function paintChips()
		for name, b in pairs(chips) do K.paint(b, E.filter == name and C.sel or C.btn) end
