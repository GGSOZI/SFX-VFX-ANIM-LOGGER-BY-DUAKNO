	end)

	local function render(extra)
		local text = string.format(
			'<font color="%s"><b>%s</b></font>\n<font color="#a5a5a5">%s</font>',
			hex(titleColor or C.text), esc(title), esc(detail)
		)
		if extra then
			text ..= string.format('\n<font color="#8fd3ff">%s</font>', esc(extra))
		end
		label.Text = text
	end
	render()

	local btnRow = Instance.new("Frame")
	btnRow.Size = UDim2.new(1, -8, 0, 0)
	btnRow.AutomaticSize = Enum.AutomaticSize.Y
	btnRow.BackgroundTransparency = 1
	btnRow.LayoutOrder = 2
	btnRow.Parent = row
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.new(0.25, -3, 0, 22)
	grid.CellPadding = UDim2.new(0, 3, 0, 3)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = btnRow
	local btnPad = Instance.new("UIPadding")
	btnPad.PaddingLeft = UDim.new(0, 6)
	btnPad.Parent = btnRow

	for i, a in ipairs(actions) do
		local b = newButton(btnRow, a.text or "", a.color or C.btn)
