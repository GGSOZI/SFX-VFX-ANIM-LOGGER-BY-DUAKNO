--// Auto-protect: when the script makes the game lag or spam, it finds the busiest part, turns it off and tells you ---

function X.timed(name, fn, ...) -- runs a logging job and measures how much time it takes
	if X.off[name] then return end
	local t0 = os.clock()
	local ok, err = pcall(fn, ...)
	local dt = os.clock() - t0
	local c = X.cost[name]
	if not c then
		c = { ms = 0, n = 0, rate = 0, rms = 0, hot = 0 }
		X.cost[name] = c
	end
	if dt < 0.1 then c.ms += dt * 1000 end -- longer = the job waited (yielded), not real work
	c.n += 1
	if not ok and os.clock() - (X.errT or 0) > 5 then
		X.errT = os.clock()
		warn("[Logger] " .. name .. " error: " .. tostring(err))
	end
end

function X.guardBanner()
	local names = {}
	for _, k in ipairs(X.GUARD_ORDER) do
		if X.off[k] and X.offWhy[k] ~= "turned off by you" then names[#names + 1] = X.GUARD[k] end
	end
	if #names == 0 then
		if X.banner then X.banner.Visible = false end
		return
	end
	if not X.banner then
		local b = Instance.new("TextButton")
		b.AnchorPoint = Vector2.new(0.5, 0)
		b.Position = UDim2.new(0.5, 0, 0, 52)
		b.Size = UDim2.new(0, 340, 0, 56)
		b.BackgroundColor3 = C.danger
		b.BorderSizePixel = 0
		b.TextColor3 = Color3.fromRGB(255, 255, 255)
		b.Font = Th.font
		b.TextSize = 14
		b.TextWrapped = true
		b.ZIndex = 100
		b.Parent = gui
		local bs = Instance.new("UIScale")
		bs.Name = "AVLScale"
		bs.Scale = X.guiScale()
		bs.Parent = b
		b.MouseButton1Click:Connect(function()
			local keys = {}
			for k in pairs(X.off) do keys[#keys + 1] = k end
			for _, k in ipairs(keys) do X.guardBack(k) end
		end)
		X.banner = b
	end
	X.banner.Visible = true
	X.banner.Text = "Auto-protect turned OFF: " .. table.concat(names, ", ") .. " (it was causing lag). Tap here to turn back on, or Settings > Auto-protect."
end

function X.guardTrip(name, why)
	X.off[name] = true
	X.offWhy[name] = why
	local msg = string.format(
		"Auto-protect: %s turned OFF - %s. To turn it back on: tap the red bar at the top, or Settings > Auto-protect > %s.",
		X.GUARD[name], why, X.GUARD[name]
	)
	out(msg)
	warn("[Logger] " .. msg)
	X.guardBanner()
	K.syncUI()
end

function X.guardBack(name)
	X.off[name] = nil
	X.offWhy[name] = nil
	X.cost[name] = nil
	X.guardBanner()
	K.syncUI()
end

function X.guardStep(dt)
	local g = X.g
	g.frames += 1
	g.time += dt
	g.worst = math.max(g.worst, dt)
	if g.time < 1 then return end
	local fps, avgDt = g.frames / g.time, g.time / g.frames
	local top, topMs = nil, 0
	for name, c in pairs(X.cost) do
		c.rms, c.rate = c.ms / g.time, c.n / g.time
		if c.rms > topMs and not X.off[name] then top, topMs = name, c.rms end
		c.ms, c.n = 0, 0
	end
	local lagging = avgDt > 0.045 or g.worst > 0.3
	g.frames, g.time, g.worst = 0, 0, 0
	if not X.guardOn or os.clock() - X.t0 < 6 then return end
	for name, c in pairs(X.cost) do -- spam: far too many events every second
		if not X.off[name] and c.rate > 80 then
			c.hot += 1
			if c.hot >= 2 then
				return X.guardTrip(name, string.format("it was handling %d events per second (spam)", c.rate))
			end
		else
			c.hot = 0
		end
	end
	if lagging and top and topMs > 50 then -- lag: the busiest part of the script goes off
		X.guardTrip(top, string.format("it used %d ms of every second while the game ran at %d FPS", topMs, fps))
	end
end

