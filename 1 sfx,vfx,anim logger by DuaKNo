		end, C.sel, 1, 1),
		runAct(function()
			if not sfxSpec[id] then error("no data captured") end
			runEvents({ sfxSpec[id] }, "SFX " .. (sfxLabel[id] or id))
		end, 1, 0.9),
		act("VIEW FULL CODE", function()
			if not sfxSpec[id] then error("no data captured") end
			openViewer("SFX - " .. (sfxLabel[id] or id), {
				{ name = "Script", get = function(cb) cb(script()) end },
			}, 1)
		end, C.sel, 1, 2.2),
		copyAct("ID", function() return id end, "the sound id", 2),
		{ line = 2, color = C.btn, state = function() return excludedSFX[id] and "Unexcl" or "Excl", excludedSFX[id] end,
			fn = function()
				excludedSFX[id] = not excludedSFX[id] or nil
				refreshAll()
			end },
	}
	addEntry("SFX", id, s.Name, detail, id, actions, C.sfx)
end

local hookedSounds = setmetatable({}, { __mode = "k" })
local function hookSound(s, fromAdded)
	if hookedSounds[s] then return end
	hookedSounds[s] = true
	local last = 0
	local function onPlay()
		if s:GetAttribute("_LoggerClone") or s:GetAttribute("_Replay") then return end
		local now = os.clock()
		if now - last < 0.05 then return end
		last = now
		logSFX(s)
	end
	s.Played:Connect(onPlay)
	s:GetPropertyChangedSignal("Playing"):Connect(function()
		if s.Playing then onPlay() end
	end)
	-- created and played in the same frame, before we could connect
	if fromAdded and s.Playing then task.defer(onPlay) end
end

